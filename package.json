{
  "name": "dsh-jev",
  "version": "0.1.0",
  "description": "Jev (System One decision model) plugin suite for DeepSeek Harness (dsh)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./loop-guard": {
      "types": "./lib/loop-guard.d.ts",
      "default": "./lib/loop-guard.js"
    },
    "./safety-guard": {
      "types": "./lib/safety-guard.d.ts",
      "default": "./lib/safety-guard.js"
    },
    "./tool-pruner": {
      "types": "./lib/tool-pruner.d.ts",
      "default": "./lib/tool-pruner.js"
    },
    "./metrics": {
      "types": "./lib/metrics.d.ts",
      "default": "./lib/metrics.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typesafe-client": {
      "types": "./lib/typesafe-client.d.ts",
      "default": "./lib/typesafe-client.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangxaochen/dsh-jev.git"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.js",
    "pretest": "tsc && node scripts/bundle-client.js",
    "test": "node --test tests/*.spec.ts",
    "sync:desktop": "pnpm run build && node -e \"const fs = require('fs'), path = require('path'), dest = path.join(process.env.USERPROFILE, '.dsh/profiles/desktop/node_modules/dsh-jev'); fs.cpSync('lib', path.join(dest, 'lib'), {recursive: true, force: true}); fs.copyFileSync('package.json', path.join(dest, 'package.json')); fs.copyFileSync('cordis.patch.yml', path.join(dest, 'cordis.patch.yml')); console.log('Successfully synced dsh-jev to desktop!');\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "typesafe",
    "typesafe-ai",
    "jev",
    "system-one",
    "guardrails"
  ],
  "author": "zhangxaochen",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
