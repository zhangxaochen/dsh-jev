{
  "name": "dsh-jev",
  "version": "0.2.0",
  "description": "Jev (System One decision model) plugin suite for DeepSeek Harness (dsh)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./loop-guard": {
      "types": "./lib/loop-guard.d.ts",
      "default": "./lib/loop-guard.js"
    },
    "./safety-guard": {
      "types": "./lib/safety-guard.d.ts",
      "default": "./lib/safety-guard.js"
    },
    "./tool-pruner": {
      "types": "./lib/tool-pruner.d.ts",
      "default": "./lib/tool-pruner.js"
    },
    "./metrics": {
      "types": "./lib/metrics.d.ts",
      "default": "./lib/metrics.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typesafe-client": {
      "types": "./lib/typesafe-client.d.ts",
      "default": "./lib/typesafe-client.js"
    },
    "./decisions": {
      "types": "./lib/decisions.d.ts",
      "default": "./lib/decisions.js"
    },
    "./bench-summary": {
      "types": "./lib/bench-summary.d.ts",
      "default": "./lib/bench-summary.js"
    },
    "./ask-tools": {
      "types": "./lib/ask-tools.d.ts",
      "default": "./lib/ask-tools.js"
    },
    "./skill-router": {
      "types": "./lib/skill-router.d.ts",
      "default": "./lib/skill-router.js"
    },
    "./result-shaper": {
      "types": "./lib/result-shaper.d.ts",
      "default": "./lib/result-shaper.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangxaochen/dsh-jev.git"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.js",
    "pretest": "tsc && node scripts/bundle-client.js && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "drill": "node scripts/drill.mjs",
    "test": "node --import ./tests/isolate.mjs --test tests/*.spec.ts",
    "probe": "node --experimental-strip-types tests/probe.ts",
    "verify:live": "node --experimental-strip-types tests/live-verify.ts",
    "verify:tools": "node --experimental-strip-types tests/live-tools.ts",
    "verify:pruner": "node --experimental-strip-types tests/live-pruner.ts",
    "verify:router": "node --experimental-strip-types tests/live-router.ts",
    "verify:turn": "node --experimental-strip-types tests/live-turn.ts",
    "verify:shaper": "node --experimental-strip-types tests/live-shaper.ts",
    "verify:dsh": "node tests/integration-dsh.mjs",
    "bench": "node --experimental-strip-types bench/run.ts",
    "bench:offline": "node --experimental-strip-types bench/run.ts --offline",
    "doctor": "node scripts/doctor.js",
    "sync": "pnpm run build && node scripts/sync-profiles.js",
    "sync:desktop": "pnpm run build && node scripts/sync-profiles.js --profile desktop"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "typesafe",
    "typesafe-ai",
    "jev",
    "system-one",
    "guardrails"
  ],
  "author": "zhangxaochen",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
